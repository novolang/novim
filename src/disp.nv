// disp.nv — pure display/text-geometry helpers for novim's renderer.
//
// Self-contained computation only (no `[io]`, no terminal writes, no editor
// state): number formatting for the gutter, UTF-8 / tab / visual-column math,
// the Novo tokenizer + per-column syntax colours, and the tree-sitter capture →
// colour mapping.  The renderer in main.nv calls these to decide WHAT to paint;
// it owns the actual emission.  Depends only on `util` (cs_or) and the opaque
// `colorscheme.Colorscheme` (field reads), so it lives outside main.nv.

use util
use colorscheme

// ── Number formatting (line-number gutter) ───────────────────────────────────

// Right-align `n` in a `width`-char field (space-padded).
fn pad_num(n: Int, width: Int) -> Str
    var s = str.from_int(n)
    while str.len(s) < width
        s = " " + s
    s

// Left-justify a number in `width` columns (pad spaces on the right).  Used
// for the active line number in hybrid number+relativenumber mode, where
// neovim pins the cursor line's absolute number flush-left — most-significant
// digit fixed at the gutter's left edge, extending rightward.
fn pad_num_l(n: Int, width: Int) -> Str
    var s = str.from_int(n)
    while str.len(s) < width
        s = s + " "
    s

// Decimal digit count of a non-negative Int (min 1).
fn num_digits(n: Int) -> Int
    var v = if n < 0
        0 - n
    else
        n
    var d = 1
    while v >= 10
        v = v / 10
        d = d + 1
    d

// A run of `n` spaces.
fn nspaces(n: Int) -> Str
    var s = ""
    var i = 0
    while i < n
        s = s + " "
        i = i + 1
    s

// ── UTF-8 / tabs / visual columns ────────────────────────────────────────────

// True for a UTF-8 continuation byte (10xxxxxx) — these add no display column.
fn is_utf8_cont(b: Int) -> Bool
    b >= 128 and b < 192

// Expand tabs in `s` to the next `ts`-column tab stop (multi-byte characters
// count as one column).
fn expand_tabs(s: Str, ts: Int) -> Str
    if ts <= 0
        return s
    var out = ""
    var col = 0
    let n = str.len(s)
    var i = 0
    while i < n
        let b = str.byte_at(s, i) ?? 0
        if b == '\t'
            let nextstop = (col / ts + 1) * ts
            while col < nextstop
                out = out + " "
                col = col + 1
        else
            out = out + str.from_byte(b)
            if not is_utf8_cont(b)   // count one column per character
                col = col + 1
        i = i + 1
    out

// Visual column of byte index `cx` within `s` once tabs are expanded — used
// to place the hardware cursor over the rendered (tab-expanded) text.
fn vis_col(s: Str, cx: Int, ts: Int) -> Int
    var col = 0
    var i = 0
    let stop = if cx > str.len(s)
        str.len(s)
    else
        cx
    while i < stop
        let b = str.byte_at(s, i) ?? 0
        if b == '\t' and ts > 0
            col = (col / ts + 1) * ts
        else if not is_utf8_cont(b)   // UTF-8 continuation bytes add no column
            col = col + 1
        i = i + 1
    col

// Horizontal counterpart of `scroll_to`: shift the visual-column viewport
// offset `left` so the cursor's visual column stays within a `width`-wide
// text area.  No side margin (cursor sits at the very edge before scrolling).
fn hscroll_to(left: Int, viscol: Int, width: Int) -> Int
    let w = if width < 1
        1
    else
        width
    var l = left
    if viscol < l
        l = viscol
    if viscol >= l + w
        l = viscol - w + 1
    if l < 0
        l = 0
    l

// Byte offset of line `n` in the newline-joined buffer (sum of preceding line
// lengths + 1 per join) — maps tree-sitter byte spans onto a rendered line.
fn byte_offset_of_line(lines: [Str], n: Int) -> Int
    var off = 0
    var i = 0
    while i < n and i < list.len(lines)
        off = off + str.len(lines[i]) + 1
        i = i + 1
    off

// ── Novo tokenizer + per-column syntax colours ───────────────────────────────

fn nv_ident_start(b: Int) -> Bool
    b >= 'a' and b <= 'z' or b >= 'A' and b <= 'Z' or b == '_'

fn nv_ident_char(b: Int) -> Bool
    nv_ident_start(b) or b >= '0' and b <= '9'

fn nv_keyword(w: Str) -> Bool
    w == "fn" or w == "let" or w == "var" or w == "mut" or w == "if" or w == "elif" or w == "else" or w == "while" or w == "for" or w == "in" or w == "return" or w == "struct" or w == "enum" or w == "trait" or w == "impl" or w == "match" or w == "and" or w == "or" or w == "not" or w == "true" or w == "false" or w == "async" or w == "await" or w == "import" or w == "type" or w == "alias" or w == "break" or w == "continue" or w == "then" or w == "pub" or w == "as" or w == "None" or w == "Some"

// ── Effect clauses ───────────────────────────────────────────────────────────
//
// `[io]`, `[net, ipc]`, `[ai]` — the labels a Novo signature carries.  The
// palette gives each one a FIXED colour (palette.md rule 4: an effect reads
// the same in the docs, in help output, and here), so they are scanned
// lexically and overlaid on whichever highlighter produced the line.  That
// is deliberate: the effect vocabulary is closed and unambiguous at the
// token level, so it does not need a parse — and doing it here means the
// tree-sitter path agrees with the native one instead of depending on
// whether a grammar happens to capture effect labels at all.
//
// Two things keep the scan honest:
//
//   * every label inside the brackets must be an effect name, so `[Int]`,
//     `[Str]` and a list literal are left alone;
//   * the `[` must not directly follow an identifier, `)` or `]`, so a
//     subscript like `xs[time]` is an index, not an effect clause.
//
// What it cannot tell apart: a standalone list literal whose sole element
// is a variable named after an effect (`[time]`).  It costs a colour, not
// a meaning, and effect names are stdlib module names — so a local called
// `time` is already the shadowing warning's problem, not this scanner's.
fn nv_effect_lead_ok(s: Str, i: Int) -> Bool
    if i == 0
        return true
    let b = str.byte_at(s, i - 1) ?? 0
    not (nv_ident_char(b) or b == ']' or b == ')')

// Flat [start, end, colour] byte-span triples for every effect clause in `s`:
// the whole bracketed run in the bracket colour, then each label in its own,
// so a later-wins overlay paints brackets and separators teal with the labels
// standing out inside them.
fn effect_spans(s: Str, d: Int) -> [Int]
    var out: [Int] = []
    let n = str.len(s)
    var i = 0
    while i < n
        if (str.byte_at(s, i) ?? 0) == '[' and nv_effect_lead_ok(s, i)
            var j = i + 1
            var ok = true
            var any = false
            var labels: [Int] = []
            var done = false
            while not done
                while j < n and (str.byte_at(s, j) ?? 0) == ' '
                    j = j + 1
                let ws = j
                while j < n and nv_ident_char(str.byte_at(s, j) ?? 0)
                    j = j + 1
                if j == ws
                    ok = false
                    done = true
                else
                    let c = colorscheme.effect_color(str.slice(s, ws, j), d)
                    if c < 0
                        ok = false
                        done = true
                    else
                        labels = list.append(labels, [ws, j, c])
                        any = true
                        while j < n and (str.byte_at(s, j) ?? 0) == ' '
                            j = j + 1
                        let nx = str.byte_at(s, j) ?? 0
                        if nx == ','
                            j = j + 1
                        else if nx == ']'
                            done = true
                        else
                            ok = false
                            done = true
            if ok and any and j < n and (str.byte_at(s, j) ?? 0) == ']'
                out = list.append(out, [i, j + 1, colorscheme.effect_bracket_color(d)])
                out = list.append(out, labels)
                i = j + 1
            else
                i = i + 1
        else
            i = i + 1
    out

// Overlay effect-clause colours onto a per-column colour vector whose index
// IS the byte index (the native tokenizer's, over a tab-expanded line).
// Rebuilt rather than mutated, and later spans win — the same shape
// ts_line_syncols resolves its overlapping tree-sitter spans with.
fn apply_effect_spans(cols: [Int], s: Str, d: Int) -> [Int]
    let sp = effect_spans(s, d)
    if list.len(sp) == 0
        return cols
    var out: [Int] = []
    let n = list.len(cols)
    var i = 0
    while i < n
        var c = cols[i]
        var k = 0
        while k < list.len(sp)
            if i >= sp[k] and i < sp[k + 1]
                c = sp[k + 2]
            k = k + 3
        out = list.append(out, [c])
        i = i + 1
    out

// Per-column fg colour slot for a (tab-expanded) Novo line.  0 = default.
// A slot is whatever colorscheme.fg_params encodes — a packed truecolor
// triple or a 256-colour index — so the depth `d` picks the tier.
// `kw`/`strc`/`cmt`/`num` are the keyword/string/comment/number colours.
fn syntax_colors(s: Str, kw: Int, strc: Int, cmt: Int, num: Int, d: Int) -> [Int]
    var col: [Int] = []
    let n = str.len(s)
    var i = 0
    while i < n
        let b = str.byte_at(s, i) ?? 0
        if b == '/' and i + 1 < n and (str.byte_at(s, i + 1) ?? 0) == '/'   // // comment
            while i < n
                col = list.append(col, [cmt])
                i = i + 1
        else if b == '"'   // " string
            col = list.append(col, [strc])
            i = i + 1
            while i < n and (str.byte_at(s, i) ?? 0) != '"'
                col = list.append(col, [strc])
                i = i + 1
            if i < n
                col = list.append(col, [strc])
                i = i + 1
        else if nv_ident_start(b)   // identifier / keyword
            let start = i
            while i < n and nv_ident_char(str.byte_at(s, i) ?? 0)
                i = i + 1
            let c = if nv_keyword(str.slice(s, start, i))
                kw
            else
                0
            var j = start
            while j < i
                col = list.append(col, [c])
                j = j + 1
        else if b >= '0' and b <= '9'   // number
            while i < n and ((str.byte_at(s, i) ?? 0) >= '0' and (str.byte_at(s, i) ?? 0) <= '9' or (str.byte_at(s, i) ?? 0) == '.' or (str.byte_at(s, i) ?? 0) == '_')
                col = list.append(col, [num])
                i = i + 1
        else
            col = list.append(col, [0])
            i = i + 1
    apply_effect_spans(col, s, d)

// ── Tree-sitter capture → colour ─────────────────────────────────────────────

// The fg colour slot for a tree-sitter capture kind (see ts.ts_capture_kind).  The
// keyword/string/comment/number kinds honour the [colorscheme] (so themes drive
// them, like the native tokenizer); type/function/constant/module use sensible
// defaults.  -1 = no colour (variables stay default fg).
fn ts_color_for_kind(kind: Int, cs: colorscheme.Colorscheme) -> Int
    if kind == 0
        util.cs_or(cs.kw_fg, 170)
    else if kind == 1
        util.cs_or(cs.type_fg, 81)
    else if kind == 2
        util.cs_or(cs.str_fg, 150)
    else if kind == 3
        util.cs_or(cs.cmt_fg, 245)
    else if kind == 4
        util.cs_or(cs.fn_fg, 78)
    else if kind == 5
        util.cs_or(cs.num_fg, 215)
    else if kind == 6
        util.cs_or(cs.const_fg, 215)
    else if kind == 8
        util.cs_or(cs.mod_fg, 80)
    else
        0 - 1

// Per-(expanded-)column fg colour slot for one line, from tree-sitter capture
// `spans` (flat start/end/kind triples over the whole buffer).  `line_start` is
// the line's byte offset; tabs expand to `tabstop` columns so the colours line
// up with emit_line_styled's expanded view.  Later spans override earlier on
// overlap.  Returns [] semantics-compatible with syntax_colors (0 = default).
fn ts_line_syncols(spans: [Int], line_start: Int, raw: Str, tabstop: Int,
                   cs: colorscheme.Colorscheme) -> [Int]
    let rlen = str.len(raw)
    let line_end = line_start + rlen
    // line-local spans (filtered once): start, end (line-relative), colour
    var ls: [Int] = []
    var k = 0
    while k < list.len(spans)
        if spans[k + 1] > line_start and spans[k] < line_end
            ls = list.append(ls,
                [spans[k] - line_start, spans[k + 1] - line_start, ts_color_for_kind(spans[k + 2], cs)])
        k = k + 3
    // Effect labels last, so they win over whatever the grammar called them.
    // Rule 4 says an effect carries its colour everywhere; a tree-sitter
    // grammar has no effect capture to carry it with, so the lexical scan
    // supplies it on this path too.
    ls = list.append(ls, effect_spans(raw, cs.depth))
    var cols: [Int] = []
    var b = 0
    var vc = 0
    while b < rlen
        var color = 0
        var m = 0
        while m < list.len(ls)
            if b >= ls[m] and b < ls[m + 1] and ls[m + 2] >= 0
                color = ls[m + 2]
            m = m + 3
        let ch = str.byte_at(raw, b) ?? 0
        if ch == '\t'
            let w = tabstop - vc % tabstop
            var t = 0
            while t < w
                cols = list.append(cols, [color])
                t = t + 1
            vc = vc + w
        else
            cols = list.append(cols, [color])
            vc = vc + 1
        b = b + 1
    cols
