// disp.nv — pure display/text-geometry helpers for novim's renderer.
//
// Self-contained computation only (no `[io]`, no terminal writes, no editor
// state): number formatting for the gutter, UTF-8 / tab / visual-column math,
// the Novo tokenizer + per-column syntax colours, and the tree-sitter capture →
// colour mapping.  The renderer in main.nv calls these to decide WHAT to paint;
// it owns the actual emission.  Depends only on `util` (cs_or) and the opaque
// `colorscheme.Colorscheme` (field reads), so it lives outside main.nv.

use util
use colorscheme

// ── Number formatting (line-number gutter) ───────────────────────────────────

// Right-align `n` in a `width`-char field (space-padded).
fn pad_num(n: Int, width: Int) -> Str
    var s = str.from_int(n)
    while str.len(s) < width
        s = " " + s
    s

// Left-justify a number in `width` columns (pad spaces on the right).  Used
// for the active line number in hybrid number+relativenumber mode, where
// neovim pins the cursor line's absolute number flush-left — most-significant
// digit fixed at the gutter's left edge, extending rightward.
fn pad_num_l(n: Int, width: Int) -> Str
    var s = str.from_int(n)
    while str.len(s) < width
        s = s + " "
    s

// Decimal digit count of a non-negative Int (min 1).
fn num_digits(n: Int) -> Int
    var v = if n < 0 then 0 - n else n
    var d = 1
    while v >= 10
        v = v / 10
        d = d + 1
    d

// A run of `n` spaces.
fn nspaces(n: Int) -> Str
    var s = ""
    var i = 0
    while i < n
        s = s + " "
        i = i + 1
    s

// ── UTF-8 / tabs / visual columns ────────────────────────────────────────────

// True for a UTF-8 continuation byte (10xxxxxx) — these add no display column.
fn is_utf8_cont(b: Int) -> Bool
    b >= 128 and b < 192

// Expand tabs in `s` to the next `ts`-column tab stop (multi-byte characters
// count as one column).
fn expand_tabs(s: Str, ts: Int) -> Str
    if ts <= 0
        return s
    var out = ""
    var col = 0
    let n = str.len(s)
    let mut i = 0
    while i < n
        let b = str.byte_at(s, i) ?? 0
        if b == '\t'
            let nextstop = ((col / ts) + 1) * ts
            while col < nextstop
                out = out + " "
                col = col + 1
        else
            out = out + str.from_char(b)
            if not is_utf8_cont(b)               // count one column per character
                col = col + 1
        i = i + 1
    out

// Visual column of byte index `cx` within `s` once tabs are expanded — used
// to place the hardware cursor over the rendered (tab-expanded) text.
fn vis_col(s: Str, cx: Int, ts: Int) -> Int
    var col = 0
    let mut i = 0
    let stop = if cx > str.len(s) then str.len(s) else cx
    while i < stop
        let b = str.byte_at(s, i) ?? 0
        if b == '\t' and ts > 0
            col = ((col / ts) + 1) * ts
        elif not is_utf8_cont(b)               // UTF-8 continuation bytes add no column
            col = col + 1
        i = i + 1
    col

// Horizontal counterpart of `scroll_to`: shift the visual-column viewport
// offset `left` so the cursor's visual column stays within a `width`-wide
// text area.  No side margin (cursor sits at the very edge before scrolling).
fn hscroll_to(left: Int, viscol: Int, width: Int) -> Int
    let w = if width < 1 then 1 else width
    var l = left
    if viscol < l
        l = viscol
    if viscol >= l + w
        l = viscol - w + 1
    if l < 0
        l = 0
    l

// Byte offset of line `n` in the newline-joined buffer (sum of preceding line
// lengths + 1 per join) — maps tree-sitter byte spans onto a rendered line.
fn byte_offset_of_line(lines: [Str], n: Int) -> Int
    var off = 0
    var i = 0
    while i < n and i < list.len(lines)
        off = off + str.len(lines[i]) + 1
        i = i + 1
    off

// ── Novo tokenizer + per-column syntax colours ───────────────────────────────

fn nv_ident_start(b: Int) -> Bool
    (b >= 'a' and b <= 'z') or (b >= 'A' and b <= 'Z') or b == '_'

fn nv_ident_char(b: Int) -> Bool
    nv_ident_start(b) or (b >= '0' and b <= '9')

fn nv_keyword(w: Str) -> Bool
    w == "fn" or w == "let" or w == "var" or w == "mut" or w == "if" or w == "elif" or w == "else" or w == "while" or w == "for" or w == "in" or w == "return" or w == "struct" or w == "enum" or w == "trait" or w == "impl" or w == "match" or w == "and" or w == "or" or w == "not" or w == "true" or w == "false" or w == "async" or w == "await" or w == "import" or w == "type" or w == "break" or w == "continue" or w == "then" or w == "pub" or w == "as" or w == "None" or w == "Some"

// Per-column 256-colour fg index for a (tab-expanded) Novo line.  0 = default.
// `kw`/`strc`/`cmt`/`num` are the keyword/string/comment/number colours.
fn syntax_colors(s: Str, kw: Int, strc: Int, cmt: Int, num: Int) -> [Int]
    var col: [Int] = []
    let n = str.len(s)
    var i = 0
    while i < n
        let b = str.byte_at(s, i) ?? 0
        if b == '/' and i + 1 < n and (str.byte_at(s, i + 1) ?? 0) == '/'   // // comment
            while i < n
                col = list.append(col, [cmt])
                i = i + 1
        elif b == '"'                                                       // " string
            col = list.append(col, [strc])
            i = i + 1
            while i < n and (str.byte_at(s, i) ?? 0) != '"'
                col = list.append(col, [strc])
                i = i + 1
            if i < n
                col = list.append(col, [strc])
                i = i + 1
        elif nv_ident_start(b)                                              // identifier / keyword
            let start = i
            while i < n and nv_ident_char(str.byte_at(s, i) ?? 0)
                i = i + 1
            let c = if nv_keyword(str.slice(s, start, i)) then kw else 0
            var j = start
            while j < i
                col = list.append(col, [c])
                j = j + 1
        elif b >= '0' and b <= '9'                                        // number
            while i < n and ((str.byte_at(s, i) ?? 0) >= '0' and (str.byte_at(s, i) ?? 0) <= '9' or (str.byte_at(s, i) ?? 0) == '.' or (str.byte_at(s, i) ?? 0) == '_')
                col = list.append(col, [num])
                i = i + 1
        else
            col = list.append(col, [0])
            i = i + 1
    col

// ── Tree-sitter capture → colour ─────────────────────────────────────────────

// 256-colour fg for a tree-sitter capture kind (see ts.ts_capture_kind).  The
// keyword/string/comment/number kinds honour the [colorscheme] (so themes drive
// them, like the native tokenizer); type/function/constant/module use sensible
// defaults.  -1 = no colour (variables stay default fg).
fn ts_color_for_kind(kind: Int, cs: colorscheme.Colorscheme) -> Int
    if kind == 0
        util.cs_or(cs.kw_fg, 170)
    elif kind == 1
        util.cs_or(cs.type_fg, 81)
    elif kind == 2
        util.cs_or(cs.str_fg, 150)
    elif kind == 3
        util.cs_or(cs.cmt_fg, 245)
    elif kind == 4
        util.cs_or(cs.fn_fg, 78)
    elif kind == 5
        util.cs_or(cs.num_fg, 215)
    elif kind == 6
        util.cs_or(cs.const_fg, 215)
    elif kind == 8
        util.cs_or(cs.mod_fg, 80)
    else
        0 - 1

// Per-(expanded-)column 256-colour fg for one line, from tree-sitter capture
// `spans` (flat start/end/kind triples over the whole buffer).  `line_start` is
// the line's byte offset; tabs expand to `tabstop` columns so the colours line
// up with emit_line_styled's expanded view.  Later spans override earlier on
// overlap.  Returns [] semantics-compatible with syntax_colors (0 = default).
fn ts_line_syncols(spans: [Int], line_start: Int, raw: Str, tabstop: Int, cs: colorscheme.Colorscheme) -> [Int]
    let rlen = str.len(raw)
    let line_end = line_start + rlen
    // line-local spans (filtered once): start, end (line-relative), colour
    var ls: [Int] = []
    var k = 0
    while k < list.len(spans)
        if spans[k + 1] > line_start and spans[k] < line_end
            ls = list.append(ls, [spans[k] - line_start, spans[k + 1] - line_start, ts_color_for_kind(spans[k + 2], cs)])
        k = k + 3
    var cols: [Int] = []
    var b = 0
    var vc = 0
    while b < rlen
        var color = 0
        var m = 0
        while m < list.len(ls)
            if b >= ls[m] and b < ls[m + 1] and ls[m + 2] >= 0
                color = ls[m + 2]
            m = m + 3
        let ch = str.byte_at(raw, b) ?? 0
        if ch == '\t'
            let w = tabstop - (vc % tabstop)
            var t = 0
            while t < w
                cols = list.append(cols, [color])
                t = t + 1
            vc = vc + w
        else
            cols = list.append(cols, [color])
            vc = vc + 1
        b = b + 1
    cols
