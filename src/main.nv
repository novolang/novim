// novim — a modal terminal editor written in Novo.
//
// The buffer is a plain `[Str]` line vector.  The editor loads a file, drives
// an interactive ANSI TUI, and supports a deterministic `--batch` mode used by
// the test harness.  docs/LSP-DESIGN.md covers the language-server side and
// docs/LANGUAGES.md the per-filetype table.
//
// The interactive TUI uses the host-TTY primitives std.pty exposes (raw mode,
// host stdin/stdout byte, poll, winsize) — the same surface novomux/novoterm
// drive.  `novo_pty_` references also trip the stdlib's conditional-link so
// libutil is pulled in.

use util
use lsp
use nvregex
use ts
use wlayout
use colorscheme
use disp
use excmd
use exhelp
use nvmap
use fuzzy
use throttle
use tslang

// Editor state.  The cursor is 0-based (line, col); the buffer is a line vector.
struct Editor
    lines: [Str]
    cy:    Int
    cx:    Int

// Normal-mode input state carried across bytes: `count` accumulates a numeric
// prefix (e.g. `5j`); `pending` is the awaiting-second-key operator (0 none,
// 1 `g` for gg, 2 `d` for dd, 3 `y` for yy); `mode` is Normal/Insert/Visual;
// `reg` + `reg_lw` are the unnamed yank/delete register (linewise when reg_lw,
// characterwise otherwise).
struct InputState
    count:   Int
    pending: Int
    mode:    Int          // 0 Normal, 1 Insert, 2 Visual-char, 3 Visual-line
    reg:     Str
    reg_lw:  Bool
    search:  Str          // last `/pattern`, for n / N
    avy:     Int          // visual-mode selection anchor: line / col
    avx:     Int

// feed()'s result: the new editor + the new input state.
struct Step
    ed: Editor
    st: InputState

// The clean initial state (empty register).  Used once at editor start.
fn ist_new() -> InputState
    InputState { count: 0, pending: 0, mode: 0, reg: "", reg_lw: false, search: "", avy: 0, avx: 0 }

// End-of-command reset: clear count/pending, return to Normal, but PRESERVE
// the register so a later `p` can paste an earlier `yy`/`dd`.
fn ist_done(st: InputState) -> InputState
    InputState { count: 0, pending: 0, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx }

// Enter Insert mode, preserving the register.
fn ist_insert(st: InputState) -> InputState
    InputState { count: 0, pending: 0, mode: 1, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx }

// Replace the unnamed register (used by the driver to seed it from the OS
// clipboard before a paste); everything else about `st` is preserved.
fn ist_set_reg(st: InputState, reg: Str, lw: Bool) -> InputState
    InputState { count: st.count, pending: st.pending, mode: st.mode, reg: reg, reg_lw: lw, search: st.search, avy: st.avy, avx: st.avx }

// A copy of `st` with no search pattern — used only to render with search
// highlight suppressed (`:noh`) while the real `st.search` is kept for `n`/`N`.
fn ist_blank_search(st: InputState) -> InputState
    InputState { count: st.count, pending: st.pending, mode: st.mode, reg: st.reg, reg_lw: st.reg_lw, search: "", avy: st.avy, avx: st.avx }

// Record the last search pattern (after `/pattern<Enter>`).
fn ist_set_search(st: InputState, pat: Str) -> InputState
    InputState { count: 0, pending: 0, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: pat, avy: st.avy, avx: st.avx }

// ── Buffer ──────────────────────────────────────────────────────

@intent("""Load `path` into a line vector.  A missing/unreadable file, or an
empty file, yields a single empty line — a fresh scratch buffer — so the cursor
always has somewhere to sit.""")
fn buf_load(path: Str) -> [Str] [fs]
    let Some(s) = fs.read(path) else return [""]
    let ls = file_lines(s)
    if list.len(ls) == 0 then [""] else ls

// The lines of a file's text or a process's output, where each line
// ends in a newline.  `str.split_lines` keeps the empty segment after a
// final newline, which here is the end of the last line, not a line of
// its own, so it is dropped.  Buffer text joined with `buf_text` has no
// final newline and is split with `str.split_lines` itself.
fn file_lines(text: Str) -> [Str]
    let ls = str.split_lines(text)
    let n = list.len(ls)
    if n > 0 and str.len(ls[n - 1]) == 0 then list.take(ls, n - 1) else ls

// ── Command / search history persistence ─────────────────────────────────────
// One entry per line in $XDG_STATE_HOME/novim/history (else
// ~/.local/state/novim/history): `:cmd` for Ex commands, `/pat` for searches.
fn history_file() -> Str [io]
    let xdg = process.env("XDG_STATE_HOME") ?? ""
    let base = if str.len(xdg) > 0 then xdg else path.join(process.env("HOME") ?? "", ".local/state")
    path.join(path.join(base, "novim"), "history")

// Keep only the last `n` entries.
fn hist_cap(var xs: [Str], n: Int) -> [Str]
    let total = list.len(xs)
    if total <= n
        return xs
    var out: [Str] = []
    var i = total - n
    while i < total
        out = list.push(out, xs[i])
        i = i + 1
    out

// Parse one kind's entries from the file text (kind 0 = `:` commands, 1 = `/`
// searches), oldest first, capped to the last 500.
fn hist_parse(text: Str, kind: Int) -> [Str]
    let pre = if kind == 0 then ':' else '/'
    let lines = str.split_lines(text)
    var out: [Str] = []
    var i = 0
    while i < list.len(lines)
        let ln = lines[i]
        if str.len(ln) > 0 and (str.byte_at(ln, 0) ?? 0) == pre
            out = list.push(out, str.slice(ln, 1, str.len(ln)))
        i = i + 1
    hist_cap(var out, 500)

// Load persisted history of one kind at startup.
fn history_load(kind: Int) -> [Str] [io, fs]
    hist_parse(fs.read(history_file()) ?? "", kind)

// Ensure the history dir exists and compact the file to its last 1000 lines.
fn history_init() [io, fs]
    let f = history_file()
    let _ = fs.mkdir_all(path.dirname(f))
    let cur = fs.read(f) ?? ""
    if str.len(cur) > 0
        let kept = hist_cap(file_lines(cur), 1000)
        let _ = fs.write(f, str.join(kept, str.from_char('\n')) + str.from_char('\n'))

// Append one executed entry (best-effort; failures are ignored).
fn history_append(prefix: Str, entry: Str) [io, fs]
    let _ = fs.append(history_file(), prefix + entry + str.from_char('\n'))

// ── Pins (harpoon slots) ────────────────────────────────────────────────────
// Slot i holds a file path + the cursor at pin time; per-project, persisted
// under the state dir keyed by the project root, written on change.

// The absolute cwd.  `path.absolute(".")` spells it with a trailing "/." which
// has to come off — but only when something is left underneath: at the
// filesystem root the whole string is "/.", and stripping blindly yields the
// empty string, which is not a directory any more and collapses every caller
// keyed on it onto one key.
fn cwd_abs() -> Str [fs]
    let d = path.absolute(".")
    let dn = str.len(d)
    if dn > 2 and str.slice(d, dn - 2, dn) == "/."
        str.slice(d, 0, dn - 2)
    elif dn == 2 and str.slice(d, 0, 2) == "/."
        "/"
    else
        d

// The project root: the nearest ancestor of the cwd containing `.git` or
// `novo.toml`, else the absolute cwd itself.  Never empty — an empty root would
// key every rootless directory onto a single shared state file.
fn project_root() -> Str [fs]
    let d = cwd_abs()
    var probe = d
    var found = ""
    var scanning = true
    while scanning
        if fs.exists(path.join(probe, ".git")) or fs.exists(path.join(probe, "novo.toml"))
            found = probe
            scanning = false
        else
            let parent = path.dirname(probe)
            if parent == probe or str.len(parent) == 0
                scanning = false
            else
                probe = parent
    if str.len(found) > 0 then found else d

// Resolve a possibly-relative path against the cwd.  Pins are stored absolute:
// the pin file is keyed by the PROJECT ROOT, so the same list is read from
// every directory of the project, and a path relative to whichever directory
// did the pinning names a different file (usually no file) from any other.
fn abs_of(p: Str) -> Str [fs]
    if str.len(p) == 0 or (str.byte_at(p, 0) ?? 0) == '/' then p else path.absolute(p)

// The short spelling of an absolute path for display and for opening: relative
// to the cwd when it sits underneath, else absolute.  Both spellings open the
// same file; this only keeps the status line and the picker rows readable.
fn rel_of(p: Str) -> Str [fs]
    let c = cwd_abs()
    let cn = str.len(c)
    if cn > 0 and str.len(p) > cn + 1 and str.slice(p, 0, cn) == c and (str.byte_at(p, cn) ?? 0) == '/'
        str.slice(p, cn + 1, str.len(p))
    else
        p

// Encode a root path into a filename component (slashes → '%').
fn pins_key(root: Str) -> Str
    var out = ""
    var i = 0
    let n = str.len(root)
    while i < n
        let b = str.byte_at(root, i) ?? 0
        out = out + (if b == '/' then "%" else str.from_byte(b))
        i = i + 1
    out

fn pins_file(root: Str) -> Str [io]
    let xdg = process.env("XDG_STATE_HOME") ?? ""
    let base = if str.len(xdg) > 0 then xdg else path.join(process.env("HOME") ?? "", ".local/state")
    path.join(path.join(base, "novim"), "pins-" + pins_key(root))

// One line per slot: `path<TAB>y<TAB>x`; an empty line is a free slot.
fn pins_save(root: Str, pp: [Str], py: [Int], px: [Int]) [io, fs]
    let f = pins_file(root)
    let _ = fs.mkdir_all(path.dirname(f))
    var out = ""
    var i = 0
    let n = list.len(pp)
    while i < n
        if str.len(pp[i]) > 0
            out = out + pp[i] + str.from_char('\t') + str.from_int(py[i]) + str.from_char('\t') + str.from_int(px[i])
        out = out + str.from_char('\n')
        i = i + 1
    let _ = fs.write(f, out)

// The slot table: parallel lists, slot i free when `p[i]` is empty.
struct Pins
    p: [Str]
    y: [Int]
    x: [Int]

@intent("""Read the slot table for `root`.  A stored path that is not absolute
predates the absolute-path rule and is resolved against the root — the closest
guess available, since the directory it was written from is not recorded.""")
fn pins_load(root: Str) -> Pins [io, fs]
    var pp: [Str] = []
    var py: [Int] = []
    var px: [Int] = []
    let raw = fs.read(pins_file(root)) ?? ""
    if str.len(raw) > 0
        let plines = str.split_lines(raw)
        var pli = 0
        while pli < list.len(plines)
            let pln = plines[pli]
            let pt1 = util.index_of_byte(pln, '\t')
            var slot = ""
            var sy = 0
            var sx = 0
            if pt1 > 0
                let pt2 = util.index_of_byte_from(pln, '\t', pt1 + 1)
                if pt2 > pt1
                    let stored = str.slice(pln, 0, pt1)
                    slot = if (str.byte_at(stored, 0) ?? 0) == '/' then stored else path.join(root, stored)
                    sy = str.to_int(str.slice(pln, pt1 + 1, pt2)) ?? 0
                    sx = str.to_int(str.slice(pln, pt2 + 1, str.len(pln))) ?? 0
            pp = list.push(pp, slot)
            py = list.push(py, sy)
            px = list.push(px, sx)
            pli = pli + 1
    Pins { p: pp, y: py, x: px }

// The slot holding `p`, or -1.  A path pins once, so there is at most one —
// but the scan reports the LAST match so that a table which somehow holds
// duplicates still converges on one slot instead of alternating.
fn pins_slot_of(pp: [Str], p: Str) -> Int
    var i = 0
    var found = 0 - 1
    while i < list.len(pp)
        if pp[i] == p
            found = i
        i = i + 1
    found

// The lowest free slot, or one past the end when every slot is taken.
fn pins_free_slot(pp: [Str]) -> Int
    var i = 0
    var slot = 0 - 1
    while i < list.len(pp) and slot < 0
        if str.len(pp[i]) == 0
            slot = i
        i = i + 1
    if slot >= 0 then slot else list.len(pp)

@intent("""Write `p` and its cursor into `slot`, growing the table with free
slots as needed, and clearing any OTHER slot already holding `p` — a path pins
once, so an explicit `:pin N` on an already-pinned file moves it rather than
leaving the same file reachable from two slots.""")
fn pins_put(pn: Pins, slot: Int, p: Str, y: Int, x: Int) -> Pins
    var pp = pn.p[:]
    var py = pn.y[:]
    var px = pn.x[:]
    let prev = pins_slot_of(pp, p)
    if prev >= 0 and prev != slot
        pp = util.set_str_at(pp, prev, "")
    while list.len(pp) <= slot
        pp = list.push(pp, "")
        py = list.push(py, 0)
        px = list.push(px, 0)
    pp = util.set_str_at(pp, slot, p)
    py = util.set_int_at(py, slot, y)
    px = util.set_int_at(px, slot, x)
    Pins { p: pp, y: py, x: px }

@intent("""Clamp the cursor into the buffer bounds, following the vim
normal-mode rule: cx sits on the last glyph (len-1), or col 0 on an empty
line.""")
fn clamp(ed: Editor) -> Editor
    let n = list.len(ed.lines)
    var cy = ed.cy
    if cy < 0
        cy = 0
    if cy >= n
        cy = n - 1
    if cy < 0
        cy = 0
    let cl = if cy >= 0 and cy < n then ed.lines[cy] else ""
    let ll = str.len(cl)
    // The last glyph starts at the start of the last character, which is not
    // `ll - 1` when that byte continues a multi-byte sequence.
    let maxx = if ll > 0 then util.u8_start(cl, ll - 1) else 0
    var cx = ed.cx
    if cx < 0
        cx = 0
    if cx > maxx
        cx = maxx
    else
        cx = util.u8_start(cl, cx)       // never inside a multi-byte character
    Editor { lines: ed.lines, cy: cy, cx: cx }

// ── Input ───────────────────────────────────────────────────────

fn line_at(ed: Editor, y: Int) -> Str
    if y >= 0 and y < list.len(ed.lines) then ed.lines[y] else ""

// Column of the first non-blank glyph on `line` (0 if all blank/empty).
fn first_nonblank(line: Str) -> Int
    let n = str.len(line)
    let mut i = 0
    while i < n
        let c = str.byte_at(line, i) ?? 0
        if c != 32 and c != 9          // not space / tab
            return i
        i = i + 1
    0

// The leading whitespace (tabs + spaces) of a line, for auto-indent.  Returns
// the whole line when it is blank.
fn leading_ws(line: Str) -> Str
    let n = str.len(line)
    var i = 0
    while i < n and ((str.byte_at(line, i) ?? 0) == ' ' or (str.byte_at(line, i) ?? 0) == '\t')
        i = i + 1
    str.slice(line, 0, i)

// Move to row `ny` (clamped into the buffer), keeping the cursor's column in
// characters: the byte index differs between two lines when either holds a
// multi-byte character.  The cursor clamps onto the last character of a
// shorter line.
fn move_rows(ed: Editor, ny: Int) -> Editor
    let n = list.len(ed.lines)
    var cy = ny
    if cy >= n
        cy = n - 1
    if cy < 0
        cy = 0
    clamp(Editor { lines: ed.lines, cy: cy, cx: util.u8_same_col(line_at(ed, ed.cy), ed.cx, line_at(ed, cy)) })

// One h/j/k/l step (clamped).
fn motion_hjkl(ed: Editor, b: Int) -> Editor
    if b == 'h'          // 'h' — left, one character
        clamp(Editor { lines: ed.lines, cy: ed.cy, cx: util.u8_prev(line_at(ed, ed.cy), ed.cx) })
    elif b == 'l'        // 'l' — right, one character
        clamp(Editor { lines: ed.lines, cy: ed.cy, cx: util.u8_next(line_at(ed, ed.cy), ed.cx) })
    elif b == 'j'        // 'j' — down
        move_rows(ed, ed.cy + 1)
    elif b == 'k'        // 'k' — up
        move_rows(ed, ed.cy - 1)
    else
        ed

fn repeat_hjkl(ed: Editor, b: Int, times: Int) -> Editor
    var e = ed
    let mut k = 0
    while k < times
        e = motion_hjkl(e, b)
        k = k + 1
    e

// ── Word motions (w / b / e) ────────────────────────────────────
// Vim word semantics: a "word" is a maximal run of word chars
// (alnum + `_`) OR a maximal run of other punctuation; whitespace
// separates.  class 0 = whitespace, 1 = word, 2 = punctuation.

// char_class_of moved to util.nv (shared by word motions + Ex-command parsing).

// Class of the character that starts at byte x of line y; out-of-range / past
// end-of-line reads as whitespace (the inter-line / trailing gap).  Positions
// are byte indexes of character starts; every step below moves by `u8_next` /
// `u8_prev`, so a position is never inside a multi-byte character.
fn class_at(ed: Editor, y: Int, x: Int) -> Int
    util.class_at_u8(line_at(ed, y), x)

// Like `class_at`, but for WORD motions (`W`/`E`/`B`): `big` collapses
// punctuation into the word class, so a WORD is any whitespace-delimited run.
fn class_at_w(ed: Editor, y: Int, x: Int, big: Bool) -> Int
    let c = class_at(ed, y, x)
    if big and c == 2 then 1 else c

// `w` — forward to the start of the next word.  Skips the rest of the
// current run, then skips whitespace (crossing line boundaries), landing
// on the next non-blank; clamps at end-of-buffer.
fn motion_w(ed: Editor, big: Bool) -> Editor
    let nlines = list.len(ed.lines)
    var y = ed.cy
    var x = ed.cx
    let cc0 = class_at_w(ed, y, x, big)
    if cc0 != 0
        var go = true
        var g = 0
        while go and g < 1000000
            g = g + 1
            if x < str.len(line_at(ed, y)) and class_at_w(ed, y, x, big) == cc0
                x = util.u8_next(line_at(ed, y), x)
            else
                go = false
    var done = false
    var g2 = 0
    while not done and g2 < 1000000
        g2 = g2 + 1
        let ll = str.len(line_at(ed, y))
        if x < ll
            if class_at_w(ed, y, x, big) == 0
                x = util.u8_next(line_at(ed, y), x)
            else
                done = true
        elif y + 1 < nlines
            y = y + 1
            x = 0
        else
            x = util.u8_last(line_at(ed, y))
            done = true
    clamp(Editor { lines: ed.lines, cy: y, cx: x })

// `e` — forward to the end of the next word.
fn motion_e(ed: Editor, big: Bool) -> Editor
    let nlines = list.len(ed.lines)
    var y = ed.cy
    var x = ed.cx
    // step one position forward
    if util.u8_next(line_at(ed, y), x) < str.len(line_at(ed, y))
        x = util.u8_next(line_at(ed, y), x)
    elif y + 1 < nlines
        y = y + 1
        x = 0
    // skip whitespace forward to a word
    var done = false
    var g = 0
    while not done and g < 1000000
        g = g + 1
        let ll = str.len(line_at(ed, y))
        if x < ll
            if class_at_w(ed, y, x, big) == 0
                x = util.u8_next(line_at(ed, y), x)
            else
                done = true
        elif y + 1 < nlines
            y = y + 1
            x = 0
        else
            done = true
    // advance to the end of this run
    let cc = class_at_w(ed, y, x, big)
    if cc != 0
        var go = true
        var g2 = 0
        while go and g2 < 1000000
            g2 = g2 + 1
            let nx = util.u8_next(line_at(ed, y), x)
            if nx < str.len(line_at(ed, y)) and class_at_w(ed, y, nx, big) == cc
                x = nx
            else
                go = false
    clamp(Editor { lines: ed.lines, cy: y, cx: x })

// `b` — backward to the start of the current/previous word.
fn motion_b(ed: Editor, big: Bool) -> Editor
    var y = ed.cy
    var x = ed.cx
    // step one position back
    if x > 0
        x = util.u8_prev(line_at(ed, y), x)
    elif y > 0
        y = y - 1
        x = util.u8_last(line_at(ed, y))
    // skip whitespace backward
    var done = false
    var g = 0
    while not done and g < 1000000
        g = g + 1
        if class_at_w(ed, y, x, big) == 0 and not (y == 0 and x == 0)
            if x > 0
                x = util.u8_prev(line_at(ed, y), x)
            elif y > 0
                y = y - 1
                x = util.u8_last(line_at(ed, y))
            else
                done = true
        else
            done = true
    // skip back to the start of this run (within the line)
    let cc = class_at_w(ed, y, x, big)
    if cc != 0
        var go = true
        var g2 = 0
        while go and g2 < 1000000
            g2 = g2 + 1
            let px = util.u8_prev(line_at(ed, y), x)
            if x > 0 and class_at_w(ed, y, px, big) == cc
                x = px
            else
                go = false
    clamp(Editor { lines: ed.lines, cy: y, cx: x })

// kind: 0=w 1=b 2=e (word, alnum/punct runs); 3=W 4=B 5=E (WORD, whitespace-
// delimited).
fn repeat_word(ed: Editor, kind: Int, times: Int) -> Editor
    var e = ed
    let big = kind >= 3
    let k = kind % 3
    let mut i = 0
    while i < times
        if k == 0
            e = motion_w(e, big)
        elif k == 1
            e = motion_b(e, big)
        else
            e = motion_e(e, big)
        i = i + 1
    e

// ── Editing (insert mode) ───────────────────────────────────────

// Replace line `y` with `s` (returns a fresh line vector).
fn set_line(lines: [Str], y: Int, s: Str) -> [Str]
    var ls: [Str] = []
    let mut i = 0
    let n = list.len(lines)
    while i < n
        if i == y
            ls = list.append(ls, [s])
        else
            ls = list.append(ls, [lines[i]])
        i = i + 1
    ls

// Clamp for INSERT mode: cx may sit one past the last glyph (cx == len)
// so text can be appended at the end of a line.
fn clamp_insert(ed: Editor) -> Editor
    let n = list.len(ed.lines)
    var cy = ed.cy
    if cy < 0
        cy = 0
    if cy >= n
        cy = n - 1
    if cy < 0
        cy = 0
    let ll = if cy >= 0 and cy < n then str.len(ed.lines[cy]) else 0
    var cx = ed.cx
    if cx < 0
        cx = 0
    if cx > ll
        cx = ll
    Editor { lines: ed.lines, cy: cy, cx: cx }

// Insert byte `b` at the cursor and advance one column.
fn insert_char(ed: Editor, b: Int) -> Editor
    let line = line_at(ed, ed.cy)
    let before = str.slice(line, 0, ed.cx)
    let after = str.slice(line, ed.cx, str.len(line))
    let merged = before + str.from_byte(b) + after
    Editor { lines: set_line(ed.lines, ed.cy, merged), cy: ed.cy, cx: ed.cx + 1 }

// Split the current line at the cursor (Enter in insert mode).  Auto-indent:
// the new line inherits the current line's leading whitespace and the cursor
// lands just past it.
fn insert_newline(ed: Editor) -> Editor
    let line = line_at(ed, ed.cy)
    let before = str.slice(line, 0, ed.cx)
    let after = str.slice(line, ed.cx, str.len(line))
    let indent = leading_ws(line)
    let ilen = str.len(indent)            // snapshot: the concat below can invalidate `indent`
    let newafter = indent + after
    var ls: [Str] = []
    let mut i = 0
    let n = list.len(ed.lines)
    while i < n
        if i == ed.cy
            ls = list.append(ls, [before])
            ls = list.append(ls, [newafter])
        else
            ls = list.append(ls, [ed.lines[i]])
        i = i + 1
    Editor { lines: ls, cy: ed.cy + 1, cx: ilen }

// Backspace: delete the glyph before the cursor, or join with the line
// above when at column 0.
fn backspace(ed: Editor) -> Editor
    if ed.cx > 0
        let line = line_at(ed, ed.cy)
        let from = util.u8_prev(line, ed.cx)         // the whole character, not its last byte
        let merged = str.slice(line, 0, from) + str.slice(line, ed.cx, str.len(line))
        Editor { lines: set_line(ed.lines, ed.cy, merged), cy: ed.cy, cx: from }
    elif ed.cy > 0
        let prev = line_at(ed, ed.cy - 1)
        let cur = line_at(ed, ed.cy)
        let joincol = str.len(prev)
        var ls: [Str] = []
        let mut i = 0
        let n = list.len(ed.lines)
        while i < n
            if i == ed.cy - 1
                ls = list.append(ls, [prev + cur])
            elif i == ed.cy
                // skip — merged into the previous line
                i = i
            else
                ls = list.append(ls, [ed.lines[i]])
            i = i + 1
        Editor { lines: ls, cy: ed.cy - 1, cx: joincol }
    else
        ed

// Open a fresh line below (`o`) or above (`O`) and enter it.  Auto-indent: the
// new line inherits the current line's leading whitespace; the cursor lands
// just past it so typing begins at the matching indent.
fn open_line(ed: Editor, below: Bool) -> Editor
    let at = if below then ed.cy + 1 else ed.cy
    let indent = leading_ws(line_at(ed, ed.cy))
    var ls: [Str] = []
    let mut i = 0
    let n = list.len(ed.lines)
    while i < n
        if i == at
            ls = list.append(ls, [indent])
        ls = list.append(ls, [ed.lines[i]])
        i = i + 1
    if at >= n          // opening below the last line
        ls = list.append(ls, [indent])
    Editor { lines: ls, cy: at, cx: str.len(indent) }

// Delete the glyph under the cursor (`x`); cursor clamps onto the new
// last glyph if it ran off the end.
fn delete_char_at(ed: Editor) -> Editor
    let line = line_at(ed, ed.cy)
    if str.len(line) == 0
        ed
    else
        let merged = str.slice(line, 0, ed.cx) + str.slice(line, util.u8_next(line, ed.cx), str.len(line))
        clamp(Editor { lines: set_line(ed.lines, ed.cy, merged), cy: ed.cy, cx: ed.cx })

fn repeat_delete_char(ed: Editor, times: Int) -> Editor
    var e = ed
    let mut k = 0
    while k < times
        e = delete_char_at(e)
        k = k + 1
    e

// Delete from the cursor to end of line (`D`).
fn delete_to_eol(ed: Editor) -> Editor
    let line = line_at(ed, ed.cy)
    clamp(Editor { lines: set_line(ed.lines, ed.cy, str.slice(line, 0, ed.cx)), cy: ed.cy, cx: ed.cx })

// ── Register: yank / delete-lines / paste ─────────────

// Clear a pending operator but keep the count + register (used when the
// second key of d/y/g isn't the doubling key — reprocess it fresh).
fn ist_clear_pending(st: InputState) -> InputState
    InputState { count: st.count, pending: 0, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx }

// Join `n` lines starting at cy into a single Str with '\n' separators —
// the linewise register payload (round-trips through str.split_lines).
fn join_lines(ed: Editor, n: Int) -> Str
    let total = list.len(ed.lines)
    var acc = ""
    var i = ed.cy
    var cnt = 0
    while i < total and cnt < n
        if cnt > 0
            acc = acc + str.from_char('\n')
        acc = acc + ed.lines[i]
        i = i + 1
        cnt = cnt + 1
    acc

// `yy` / `Nyy` — yank `n` lines into the (linewise) register; cursor stays.
fn op_yank_lines(ed: Editor, st: InputState, n: Int) -> Step
    Step { ed: ed, st: InputState { count: 0, pending: 0, mode: 0, reg: join_lines(ed, n), reg_lw: true, search: st.search, avy: st.avy, avx: st.avx } }

// `dd` / `Ndd` — yank `n` lines into the register, then remove them.
fn op_delete_lines(ed: Editor, st: InputState, n: Int) -> Step
    let payload = join_lines(ed, n)
    let total = list.len(ed.lines)
    var ls: [Str] = []
    let mut i = 0
    while i < total
        if i < ed.cy or i >= ed.cy + n
            ls = list.append(ls, [ed.lines[i]])
        i = i + 1
    if list.len(ls) == 0
        ls = list.append(ls, [""])      // the buffer always keeps one line
    var ncy = ed.cy
    if ncy >= list.len(ls)
        ncy = list.len(ls) - 1
    Step { ed: clamp(Editor { lines: ls, cy: ncy, cx: 0 }), st: InputState { count: 0, pending: 0, mode: 0, reg: payload, reg_lw: true, search: st.search, avy: st.avy, avx: st.avx } }

// `p` / `P` — paste the register after/before the cursor.  Linewise inserts
// whole lines below/above; characterwise inserts text at the cursor.
fn paste(ed: Editor, st: InputState, after: Bool) -> Editor
    if str.len(st.reg) == 0
        return ed
    if st.reg_lw
        let plines = str.split_lines(st.reg)
        let np = list.len(plines)
        let at = if after then ed.cy + 1 else ed.cy
        var ls: [Str] = []
        let mut i = 0
        let total = list.len(ed.lines)
        while i < total
            if i == at
                let mut j = 0
                while j < np
                    ls = list.append(ls, [plines[j]])
                    j = j + 1
            ls = list.append(ls, [ed.lines[i]])
            i = i + 1
        if at >= total
            let mut j = 0
            while j < np
                ls = list.append(ls, [plines[j]])
                j = j + 1
        clamp(Editor { lines: ls, cy: at, cx: 0 })
    else
        let line = line_at(ed, ed.cy)
        let want = if after then util.u8_after(line, ed.cx) else ed.cx
        let col = if want > str.len(line) then str.len(line) else want
        let merged = str.slice(line, 0, col) + st.reg + str.slice(line, col, str.len(line))
        clamp(Editor { lines: set_line(ed.lines, ed.cy, merged), cy: ed.cy, cx: col + str.len(st.reg) - 1 })

// ── Char-level edits: ~ toggle case, r replace, J join ───────

// The case map of one character, by code point: kind 0 = toggle, 1 = lower,
// 2 = upper.  The letters of ASCII and of Latin-1 (À-Þ and à-þ, which holds
// å ø æ and their capitals) change; every other character is left as it is.
fn case_cp(cp: Int, kind: Int) -> Int
    let is_up = (cp >= 'A' and cp <= 'Z') or (cp >= 192 and cp <= 222 and cp != 215)
    let is_lo = (cp >= 'a' and cp <= 'z') or (cp >= 224 and cp <= 254 and cp != 247)
    if is_up and kind != 2
        cp + 32
    elif is_lo and kind != 1
        cp - 32
    else
        cp

// The text of `s` with the case map applied to the characters that start in the
// bytes `[lo, hi)`.  A character is replaced as a whole, so a two-byte letter
// stays two bytes.
fn case_text(s: Str, lo: Int, hi: Int, kind: Int) -> Str
    let n = str.len(s)
    var out = ""
    var i = 0
    while i < n
        let nx = util.u8_next(s, i)
        if i >= lo and i < hi
            let cp = util.u8_decode(s, i)
            let m = case_cp(cp, kind)
            if m != cp
                out = out + str.from_char(m)
            else
                out = out + str.slice(s, i, nx)
        else
            out = out + str.slice(s, i, nx)
        i = nx
    out

// `Ctrl-A` / `Ctrl-X` — increment / decrement the (decimal) number at or after
// the cursor on the current line by `delta`; cursor lands on its last digit.
fn op_incdec(ed: Editor, delta: Int) -> Editor
    let line = line_at(ed, ed.cy)
    let n = str.len(line)
    var s = ed.cx
    while s < n and not ((str.byte_at(line, s) ?? 0) >= '0' and (str.byte_at(line, s) ?? 0) <= '9')
        s = s + 1
    if s >= n
        return ed                                       // no number on the rest of the line
    var start = s
    while start > 0 and (str.byte_at(line, start - 1) ?? 0) >= '0' and (str.byte_at(line, start - 1) ?? 0) <= '9'
        start = start - 1
    var endd = s
    while endd < n and (str.byte_at(line, endd) ?? 0) >= '0' and (str.byte_at(line, endd) ?? 0) <= '9'
        endd = endd + 1
    let neg = start > 0 and (str.byte_at(line, start - 1) ?? 0) == '-'
    let numstart = if neg then start - 1 else start
    let mag = match str.to_int(str.slice(line, start, endd))
        None => 0
        Some(v) => v
    let signed = if neg then 0 - mag else mag
    let newstr = str.from_int(signed + delta)
    let newline = str.slice(line, 0, numstart) + newstr + str.slice(line, endd, n)
    clamp(Editor { lines: set_line(ed.lines, ed.cy, newline), cy: ed.cy, cx: numstart + str.len(newstr) - 1 })

// `~` / `N~` — toggle the case of `n` characters from the cursor, advancing the
// cursor past the last one (vim).  Stops at end of line.
fn op_toggle_case(ed: Editor, n: Int) -> Editor
    let line = line_at(ed, ed.cy)
    if str.len(line) == 0
        return ed
    let hi = util.u8_fwd(line, ed.cx, n)
    clamp(Editor { lines: set_line(ed.lines, ed.cy, case_text(line, ed.cx, hi, 0)), cy: ed.cy, cx: hi })

// `r<c>` / `Nr<c>` — replace `n` characters under/after the cursor with the
// character of code point `rc`.  Vim no-ops when fewer than `n` characters
// remain on the line; cursor ends on the last replaced character.
fn op_replace_char(ed: Editor, rc: Int, n: Int) -> Editor
    let line = line_at(ed, ed.cy)
    let ll = str.len(line)
    if ll == 0 or util.u8_count(line, ed.cx, ll) < n
        return ed
    let one = str.from_char(rc)
    var rep = ""
    var k = 0
    while k < n
        rep = rep + one
        k = k + 1
    let s = str.slice(line, 0, ed.cx) + rep + str.slice(line, util.u8_fwd(line, ed.cx, n), ll)
    clamp(Editor { lines: set_line(ed.lines, ed.cy, s), cy: ed.cy, cx: ed.cx + (n - 1) * str.len(one) })

// `J` / `NJ` — join the current line with the following line(s): `NJ` joins
// `n` lines (so `J` and `2J` both join 2).  With `space` (plain `J`) each
// pulled-up line's leading blanks collapse to a single separating space;
// without it (`gJ`) the lines are concatenated verbatim.  Cursor lands on the
// first join column.  No-op on the last line.
fn op_join_lines(ed: Editor, n: Int, space: Bool) -> Editor
    let joins = if n > 1 then n - 1 else 1
    var merged = line_at(ed, ed.cy)
    var dropped = 0
    var joincol = -1
    var k = 0
    while k < joins and (ed.cy + 1 + dropped) < list.len(ed.lines)
        let nxt = ed.lines[ed.cy + 1 + dropped]
        let piece = if space then str.slice(nxt, first_nonblank(nxt), str.len(nxt)) else nxt
        if joincol < 0
            joincol = str.len(merged)
        let sep = if space and str.len(merged) != 0 then " " else ""
        merged = merged + sep + piece
        dropped = dropped + 1
        k = k + 1
    if dropped == 0
        return ed
    let total = list.len(ed.lines)
    var ls: [Str] = []
    let mut i = 0
    while i < total
        let drop = i > ed.cy and i <= ed.cy + dropped
        if i == ed.cy
            ls = list.append(ls, [merged])
        elif not drop
            ls = list.append(ls, [ed.lines[i]])
        i = i + 1
    let cx = if joincol < 0 then 0 else joincol
    clamp(Editor { lines: ls, cy: ed.cy, cx: cx })

// ── Indent: >> and << ───────────────────────────────────────

// Add one indent level.  We indent with a real tab byte — its rendered width
// follows `tabstop` (see expand_tabs), so the indent respects the user's
// width without `feed` needing to see Options.  Blank lines are left alone
// (vim doesn't indent them).
fn indent_one(line: Str) -> Str
    if str.len(line) == 0 then line else str.from_char('\t') + line

// Remove one indent level: a single leading tab, or — for space-indented
// files — up to a tab's worth (capped at 8) of leading spaces.
fn dedent_one(line: Str) -> Str
    let n = str.len(line)
    if n == 0
        return line
    if (str.byte_at(line, 0) ?? 0) == '\t'
        return str.slice(line, 1, n)
    var k = 0
    while k < 8 and k < n and (str.byte_at(line, k) ?? 0) == ' '
        k = k + 1
    str.slice(line, k, n)

// ── `gc` comment toggle ──────────────────────────────────────────────────────

// The line-comment prefix for a file, by extension (`//` for C-family/Novo/JS/
// Go/Rust, `#` for Python/shell/TOML/YAML, `--` for Lua/SQL, `"` for Vim).
fn comment_prefix(path: Str) -> Str
    let e = if str.len(path.ext(path)) >= 1 then str.slice(path.ext(path), 1, str.len(path.ext(path))) else ""
    if e == "py" or e == "sh" or e == "bash" or e == "zsh" or e == "rb" or e == "pl" or e == "toml" or e == "yaml" or e == "yml" or e == "conf" or e == "cfg" or e == "r" or e == "ex" or e == "exs"
        "#"
    elif e == "lua" or e == "sql" or e == "hs"
        "--"
    elif e == "vim"
        str.from_char('"')
    else
        "//"

// True if `line`'s first non-blank run starts with `prefix` (already commented).
fn line_commented(line: Str, prefix: Str) -> Bool
    let f = first_nonblank(line)
    let pl = str.len(prefix)
    f + pl <= str.len(line) and str.slice(line, f, f + pl) == prefix

// The smallest leading-whitespace width over the non-blank lines in [lo, hi].
fn min_indent_col(lines: [Str], lo: Int, hi: Int) -> Int
    var m = 0 - 1
    var y = lo
    while y <= hi
        let line = lines[y]
        if str.len(str.trim(line)) > 0
            let f = first_nonblank(line)
            if m < 0 or f < m
                m = f
        y = y + 1
    if m < 0 then 0 else m

// Strip a leading comment from `line`: remove `prefix` at the first non-blank
// column, plus one following space if present.
fn uncomment_line(line: Str, prefix: Str) -> Str
    let f = first_nonblank(line)
    let pl = str.len(prefix)
    let rest_at = if f + pl < str.len(line) and (str.byte_at(line, f + pl) ?? 0) == ' ' then f + pl + 1 else f + pl
    str.slice(line, 0, f) + str.slice(line, rest_at, str.len(line))

// Toggle line-comments over `lines[lo..hi]` with `prefix`: if every non-blank
// line is already commented, uncomment; else comment (inserting `prefix `  at
// the block's minimum indent so the markers align).  Blank lines untouched.
fn comment_toggle(var lines: [Str], lo: Int, hi: Int, prefix: Str) -> [Str]
    var any = false
    var all = true
    var y = lo
    while y <= hi
        if str.len(str.trim(lines[y])) > 0
            any = true
            if not line_commented(lines[y], prefix)
                all = false
        y = y + 1
    if not any
        return lines
    var out = lines[:]
    if all
        y = lo
        while y <= hi
            if str.len(str.trim(out[y])) > 0
                out = set_line(out, y, uncomment_line(out[y], prefix))
            y = y + 1
    else
        let col = min_indent_col(lines, lo, hi)
        y = lo
        while y <= hi
            let line = out[y]
            if str.len(str.trim(line)) > 0
                out = set_line(out, y, str.slice(line, 0, col) + prefix + " " + str.slice(line, col, str.len(line)))
            y = y + 1
    out

// `>>` / `N>>` (right) and `<<` / `N<<` (left): shift `n` lines from the
// cursor by one indent level.  Cursor lands on the first non-blank of the
// current line (vim).
fn op_indent(ed: Editor, st: InputState, n: Int, right: Bool) -> Step
    let total = list.len(ed.lines)
    var ls: [Str] = []
    let mut i = 0
    while i < total
        if i >= ed.cy and i < ed.cy + n
            ls = list.append(ls, [if right then indent_one(ed.lines[i]) else dedent_one(ed.lines[i])])
        else
            ls = list.append(ls, [ed.lines[i]])
        i = i + 1
    let fnb = first_nonblank(if ed.cy < list.len(ls) then ls[ed.cy] else "")
    Step { ed: clamp(Editor { lines: ls, cy: ed.cy, cx: fnb }), st: ist_done(st) }

// Indent/dedent the line range [lo, hi] (used by `>`/`<` over a motion).
fn op_indent_lines(ed: Editor, st: InputState, lo: Int, hi: Int, right: Bool) -> Step
    op_indent(Editor { lines: ed.lines, cy: lo, cx: 0 }, st, hi - lo + 1, right)

// Second key of a `>` / `<` operator: doubled → line(s), a linewise motion →
// that line range.
fn feed_indent(ed: Editor, st: InputState, right: Bool, b: Int) -> Step
    let trigger = if right then '>' else '<'
    if b == trigger                              // >> / <<
        return op_indent(ed, st, if st.count > 0 then st.count else 1, right)
    let tgt = motion_target(ed, b, st.count)
    if tgt.ok and tgt.linewise
        let lo = if ed.cy < tgt.ty then ed.cy else tgt.ty
        let hi = if ed.cy < tgt.ty then tgt.ty else ed.cy
        return op_indent_lines(ed, st, lo, hi, right)
    feed(ed, ist_clear_pending(st), b)           // not a linewise motion — cancel

// ── Find-char motions f/F/t/T ───────────────────────────────

// Index of the start of the `count`-th character of code point `ch` strictly
// after `from` in `line`, or -1.
fn find_char_fwd(line: Str, ch: Int, from: Int, count: Int) -> Int
    let n = str.len(line)
    var found = 0
    var i = util.u8_after(line, from)
    while i < n
        if util.u8_decode(line, i) == ch
            found = found + 1
            if found == count
                return i
        i = util.u8_next(line, i)
    -1

// Index of the start of the `count`-th character of code point `ch` strictly
// before `from` in `line`, or -1.
fn find_char_bwd(line: Str, ch: Int, from: Int, count: Int) -> Int
    var found = 0
    var i = from
    while i > 0
        i = util.u8_prev(line, i)
        if util.u8_decode(line, i) == ch
            found = found + 1
            if found == count
                return i
    -1

// Move the cursor to a found char.  forward/back; `till` stops one character
// short (t/T vs f/F).  No move when the char isn't found on the line.
fn move_find(ed: Editor, ch: Int, forward: Bool, till: Bool, count: Int) -> Editor
    let line = line_at(ed, ed.cy)
    if forward
        let idx = find_char_fwd(line, ch, ed.cx, count)
        if idx < 0 then ed else clamp(Editor { lines: ed.lines, cy: ed.cy, cx: if till then util.u8_prev(line, idx) else idx })
    else
        let idx = find_char_bwd(line, ch, ed.cx, count)
        if idx < 0 then ed else clamp(Editor { lines: ed.lines, cy: ed.cy, cx: if till then util.u8_after(line, idx) else idx })

// ── % matching pair ──────────────────────────────────────────

fn is_open_bracket(ch: Int) -> Bool
    ch == '(' or ch == '[' or ch == '{'            // ( [ {

fn is_close_bracket(ch: Int) -> Bool
    ch == ')' or ch == ']' or ch == '}'            // ) ] }

fn bracket_close_of(ch: Int) -> Int
    if ch == '(' then ')' elif ch == '[' then ']' else '}'       // ( [ {  → ) ] }

fn bracket_open_of(ch: Int) -> Int
    if ch == ')' then '(' elif ch == ']' then '[' else '{'       // ) ] }  → ( [ {

// Walk forward from (sy,sx) to the close that matches `open_ch`/`close_ch`.
fn scan_match_fwd(ed: Editor, sy: Int, sx: Int, open_ch: Int, close_ch: Int) -> Editor
    var depth = 0
    var y = sy
    var x = sx
    let ny = list.len(ed.lines)
    while y < ny
        let line = line_at(ed, y)
        let n = str.len(line)
        while x < n
            let ch = str.byte_at(line, x) ?? 0
            if ch == open_ch
                depth = depth + 1
            elif ch == close_ch
                if depth == 0
                    return clamp(Editor { lines: ed.lines, cy: y, cx: x })
                depth = depth - 1
            x = x + 1
        y = y + 1
        x = 0
    ed

// Walk backward from (sy,sx) to the open that matches.
fn scan_match_bwd(ed: Editor, sy: Int, sx: Int, open_ch: Int, close_ch: Int) -> Editor
    var depth = 0
    var y = sy
    var x = sx
    while y >= 0
        while x >= 0
            let ch = str.byte_at(line_at(ed, y), x) ?? 0
            if ch == close_ch
                depth = depth + 1
            elif ch == open_ch
                if depth == 0
                    return clamp(Editor { lines: ed.lines, cy: y, cx: x })
                depth = depth - 1
            x = x - 1
        y = y - 1
        if y >= 0
            x = str.len(line_at(ed, y)) - 1
    ed

// The (inner) word under the cursor, for `*` / `#`.
fn word_under_cursor(ed: Editor) -> Str
    let to = textobj_word(ed, false, false)
    if to.ok and to.vr.sy == to.vr.ey
        str.slice(line_at(ed, to.vr.sy), to.vr.sx, util.u8_after(line_at(ed, to.vr.sy), to.vr.ex))
    else
        ""

// `%` — jump to the bracket matching the one at/after the cursor on the line.
fn match_pair(ed: Editor) -> Editor
    let line = line_at(ed, ed.cy)
    let n = str.len(line)
    var bx = ed.cx
    var bch = 0
    while bx < n and bch == 0
        let ch = str.byte_at(line, bx) ?? 0
        if is_open_bracket(ch) or is_close_bracket(ch)
            bch = ch
        else
            bx = bx + 1
    if bch == 0
        return ed
    if is_open_bracket(bch)
        scan_match_fwd(ed, ed.cy, bx + 1, bch, bracket_close_of(bch))
    else
        scan_match_bwd(ed, ed.cy, bx - 1, bracket_open_of(bch), bch)

// ── Operator + motion: d / c / y over a motion ───────────────

// A motion's resolved destination, as an operator target.  Charwise targets
// stay on the cursor's line (cross-line word motions clamp to the line edge);
// `inclusive` means the target glyph is part of the span (e / $-ish).
struct MTarget
    ty:        Int
    tx:        Int
    ok:        Bool
    linewise:  Bool
    inclusive: Bool

fn mt(ty: Int, tx: Int, lw: Bool, inc: Bool) -> MTarget
    MTarget { ty: ty, tx: tx, ok: true, linewise: lw, inclusive: inc }

fn mt_none(ed: Editor) -> MTarget
    MTarget { ty: ed.cy, tx: ed.cx, ok: false, linewise: false, inclusive: false }

// Find-char as an operator target (df{c} / dt{c} / dF{c} / dT{c}).  Forward
// f/t are inclusive (delete through the found char, or up to it for t);
// backward F/T are exclusive of the cursor's own glyph.  Not found → no span.
fn find_target(ed: Editor, ch: Int, forward: Bool, till: Bool, count: Int) -> MTarget
    let line = line_at(ed, ed.cy)
    if forward
        let idx = find_char_fwd(line, ch, ed.cx, count)
        if idx < 0 then mt_none(ed) else mt(ed.cy, if till then util.u8_prev(line, idx) else idx, false, true)
    else
        let idx = find_char_bwd(line, ch, ed.cx, count)
        if idx < 0 then mt_none(ed) else mt(ed.cy, if till then util.u8_after(line, idx) else idx, false, false)

// Row of the `count`-th paragraph boundary (an empty line) below the cursor.
// Stops at the last line when the buffer ends first.
fn para_fwd(ed: Editor, count: Int) -> Int
    let n = list.len(ed.lines)
    var cy = ed.cy
    var c = 0
    while c < count
        var i = cy + 1
        while i < n and str.len(line_at(ed, i)) != 0
            i = i + 1
        cy = if i >= n then n - 1 else i
        c = c + 1
    cy

// Row of the `count`-th paragraph boundary above the cursor (or the first line).
fn para_bwd(ed: Editor, count: Int) -> Int
    var cy = ed.cy
    var c = 0
    while c < count
        var i = cy - 1
        while i >= 0 and str.len(line_at(ed, i)) != 0
            i = i - 1
        cy = if i < 0 then 0 else i
        c = c + 1
    cy

@intent("""Resolve a motion byte to an operator target (the range an operator
like d/c/y should act over) relative to the cursor, with charwise/linewise and
inclusive/exclusive flags set per vim's motion table.  `rawcount` is 0 when no
count was typed; most motions default it to 1, but `G` needs the raw value (no
count → last line, not line 1).""")
fn motion_target(ed: Editor, b: Int, rawcount: Int) -> MTarget
    let count = if rawcount > 0 then rawcount else 1
    let line = line_at(ed, ed.cy)
    let llen = str.len(line)
    if b == 'l'                                  // l
        return mt(ed.cy, util.u8_fwd(line, ed.cx, count), false, false)
    if b == 'h'                                  // h
        return mt(ed.cy, util.u8_back(line, ed.cx, count), false, false)
    if b == '0'                                  // 0
        return mt(ed.cy, 0, false, false)
    if b == '$'                                  // $
        return mt(ed.cy, llen, false, false)
    if b == '^'                                  // ^
        return mt(ed.cy, first_nonblank(line), false, false)
    if b == 'w'                                  // w
        let e = repeat_word(ed, 0, count)
        return mt(ed.cy, if e.cy > ed.cy then llen else e.cx, false, false)
    if b == 'e'                                  // e (inclusive)
        let e = repeat_word(ed, 2, count)
        return mt(ed.cy, if e.cy > ed.cy then util.u8_last(line) else e.cx, false, true)
    if b == 'b'                                  // b
        let e = repeat_word(ed, 1, count)
        return mt(ed.cy, if e.cy < ed.cy then 0 else e.cx, false, false)
    if b == 'W'                                  // W
        let e = repeat_word(ed, 3, count)
        return mt(ed.cy, if e.cy > ed.cy then llen else e.cx, false, false)
    if b == 'E'                                  // E (inclusive)
        let e = repeat_word(ed, 5, count)
        return mt(ed.cy, if e.cy > ed.cy then util.u8_last(line) else e.cx, false, true)
    if b == 'B'                                  // B
        let e = repeat_word(ed, 4, count)
        return mt(ed.cy, if e.cy < ed.cy then 0 else e.cx, false, false)
    if b == 'j'                                  // j — linewise down
        return mt(ed.cy + count, 0, true, false)
    if b == 'k'                                  // k — linewise up
        return mt(ed.cy - count, 0, true, false)
    if b == 'G'                                  // G — linewise to line
        return mt(if rawcount > 0 then rawcount - 1 else list.len(ed.lines) - 1, 0, true, false)
    if b == '}'                                  // } — paragraph forward (linewise)
        return mt(para_fwd(ed, count), 0, true, false)
    if b == '{'                                  // { — paragraph backward (linewise)
        return mt(para_bwd(ed, count), 0, true, false)
    MTarget { ty: ed.cy, tx: ed.cx, ok: false, linewise: false, inclusive: false }

// End-of-command state carrying a fresh CHARWISE register (used by d/c/y over
// a charwise motion).  `ins` selects Insert mode (the `c` operator).
fn ist_reg_cw(st: InputState, text: Str, ins: Bool) -> InputState
    InputState { count: 0, pending: 0, mode: if ins then 1 else 0, reg: text, reg_lw: false, search: st.search, avy: st.avy, avx: st.avx }

@intent("""Apply operator `opb` (d/c/y) over the LINEWISE range between the
cursor line and `ty`.  Yank loads the linewise register and parks the cursor at
the range top; delete removes the lines; change removes them, leaves one blank
line, and enters Insert.  The buffer always keeps at least one line.""")
fn apply_linewise_op(ed: Editor, st: InputState, opb: Int, ty: Int) -> Step
    let total = list.len(ed.lines)
    var lo = if ed.cy < ty then ed.cy else ty
    var hi = if ed.cy < ty then ty else ed.cy
    if lo < 0
        lo = 0
    if hi >= total
        hi = total - 1
    var payload = ""
    var i = lo
    while i <= hi
        if i > lo
            payload = payload + str.from_char('\n')
        payload = payload + ed.lines[i]
        i = i + 1
    if opb == 'y'                                // y — yank, cursor to lo
        return Step { ed: clamp(Editor { lines: ed.lines, cy: lo, cx: 0 }), st: InputState { count: 0, pending: 0, mode: 0, reg: payload, reg_lw: true, search: st.search, avy: st.avy, avx: st.avx } }
    // d / c — remove lines lo..hi; c leaves one blank line and enters Insert.
    var ls: [Str] = []
    let mut j = 0
    while j < total
        let keep = j < lo or j > hi
        if keep
            ls = list.append(ls, [ed.lines[j]])
        elif opb == 'c' and j == lo
            ls = list.append(ls, [""])            // c: the replacement blank line
        j = j + 1
    if list.len(ls) == 0
        ls = list.append(ls, [""])               // buffer always keeps one line
    var ncy = lo
    if ncy >= list.len(ls)
        ncy = list.len(ls) - 1
    let ins = opb == 'c'
    Step { ed: clamp_insert(Editor { lines: ls, cy: ncy, cx: 0 }), st: InputState { count: 0, pending: 0, mode: if ins then 1 else 0, reg: payload, reg_lw: true, search: st.search, avy: st.avy, avx: st.avx } }

@intent("""Apply operator `opb` (d/c/y) over a resolved motion target,
dispatching to the linewise path or the charwise path per the target's flags
and honouring inclusive/exclusive end handling.  A target with `ok == false` is
a no-op that just ends the command.""")
fn apply_motion_op(ed: Editor, st: InputState, opb: Int, tgt: MTarget) -> Step
    if not tgt.ok
        return Step { ed: ed, st: ist_done(st) }
    if tgt.linewise
        return apply_linewise_op(ed, st, opb, tgt.ty)
    let line = line_at(ed, ed.cy)
    let llen = str.len(line)
    var lo = if ed.cx < tgt.tx then ed.cx else tgt.tx
    var hi = if ed.cx < tgt.tx then tgt.tx else ed.cx
    if tgt.inclusive
        hi = util.u8_after(line, hi)              // through the whole last character
    if hi > llen
        hi = llen
    if lo < 0
        lo = 0
    let removed = str.slice(line, lo, hi)
    if opb == 'y'                                // y — yank, cursor to span start
        return Step { ed: clamp(Editor { lines: ed.lines, cy: ed.cy, cx: lo }), st: ist_reg_cw(st, removed, false) }
    let newline = str.slice(line, 0, lo) + str.slice(line, hi, llen)
    let nls = set_line(ed.lines, ed.cy, newline)
    let ins = opb == 'c'                         // c enters Insert at the gap
    if ins
        return Step { ed: clamp_insert(Editor { lines: nls, cy: ed.cy, cx: lo }), st: ist_reg_cw(st, removed, true) }
    Step { ed: clamp(Editor { lines: nls, cy: ed.cy, cx: lo }), st: ist_reg_cw(st, removed, false) }

// Dispatch the second key of an operator (`pcode` is its pending code, `opb`
// its byte d/c/y).  Doubled operator → linewise; a count digit accumulates;
// `cw` is remapped to `ce` (vim); any other motion resolves + applies; an
// unknown key cancels the operator and is reprocessed fresh.
fn feed_operator(ed: Editor, st: InputState, opb: Int, pcode: Int, b: Int) -> Step
    if b == opb                                   // dd / cc / yy — linewise
        return apply_linewise_op(ed, st, opb, ed.cy + (if st.count > 1 then st.count - 1 else 0))
    if b >= '1' and b <= '9'                    // count digit after the operator
        return Step { ed: ed, st: InputState { count: st.count * 10 + (b - '0'), pending: pcode, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == '0' and st.count > 0                 // '0' continues a count
        return Step { ed: ed, st: InputState { count: st.count * 10, pending: pcode, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    // Multi-key motions: f/F/t/T await a target char, g awaits a second g.
    // Encode (operator, motion) in a paired pending code so the char/second-g
    // handler knows which operator to apply (df{c}, dt{c}, dgg, ...).
    let opidx = if opb == 'd' then 0 elif opb == 'c' then 1 else 2
    if b == 'f'                                  // f — pending 20/24/28
        return Step { ed: ed, st: InputState { count: st.count, pending: 20 + opidx * 4 + 0, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'F'                                  // F — pending 21/25/29
        return Step { ed: ed, st: InputState { count: st.count, pending: 20 + opidx * 4 + 1, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 't'                                  // t — pending 22/26/30
        return Step { ed: ed, st: InputState { count: st.count, pending: 20 + opidx * 4 + 2, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'T'                                  // T — pending 23/27/31
        return Step { ed: ed, st: InputState { count: st.count, pending: 20 + opidx * 4 + 3, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'g'                                  // g — await second g (dgg): pending 32/33/34
        return Step { ed: ed, st: InputState { count: st.count, pending: 32 + opidx, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'i'                                  // i — inner text object: pending 40/42/44
        return Step { ed: ed, st: InputState { count: st.count, pending: 40 + opidx * 2 + 0, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'a'                                  // a — around text object: pending 41/43/45
        return Step { ed: ed, st: InputState { count: st.count, pending: 40 + opidx * 2 + 1, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == '%'                                  // % — to the matching bracket (inclusive, may span lines)
        let m = match_pair(ed)
        if m.cy == ed.cy and m.cx == ed.cx
            return Step { ed: ed, st: ist_done(st) }   // no match — cancel
        let before = m.cy < ed.cy or (m.cy == ed.cy and m.cx < ed.cx)
        let vr = if before then VRange { sy: m.cy, sx: m.cx, ey: ed.cy, ex: ed.cx } else VRange { sy: ed.cy, sx: ed.cx, ey: m.cy, ex: m.cx }
        return apply_char_vr(ed, st, opb, vr)
    let mb = if opb == 'c' and b == 'w' then 'e' else b   // cw behaves like ce
    let tgt = motion_target(ed, mb, st.count)               // raw count (0 = none)
    if tgt.ok
        return apply_motion_op(ed, st, opb, tgt)
    feed(ed, ist_clear_pending(st), b)            // not a motion — cancel + reprocess

// ── Visual mode: v / V + motions + operators on a selection ──────

// Normalised selection bounds (start <= end) between the anchor (avy,avx) and
// the cursor.
struct VRange
    sy: Int
    sx: Int
    ey: Int
    ex: Int

fn visual_range(st: InputState, ed: Editor) -> VRange
    let a_first = st.avy < ed.cy or (st.avy == ed.cy and st.avx <= ed.cx)
    if a_first
        VRange { sy: st.avy, sx: st.avx, ey: ed.cy, ex: ed.cx }
    else
        VRange { sy: ed.cy, sx: ed.cx, ey: st.avy, ex: st.avx }

// Selected text for the register (charwise, inclusive of the end glyph).
fn vyank_char_text(ed: Editor, vr: VRange) -> Str
    if vr.sy == vr.ey
        let line = line_at(ed, vr.sy)
        let hi = util.u8_after(line, vr.ex)
        str.slice(line, vr.sx, hi)
    else
        let first = line_at(ed, vr.sy)
        var acc = str.slice(first, vr.sx, str.len(first))
        var i = vr.sy + 1
        while i < vr.ey
            acc = acc + str.from_char('\n') + line_at(ed, i)
            i = i + 1
        let last = line_at(ed, vr.ey)
        let hi = util.u8_after(last, vr.ex)
        acc + str.from_char('\n') + str.slice(last, 0, hi)

// Buffer after deleting a charwise selection (first/last partial line merged,
// middle lines removed).
fn vdelete_char_lines(ed: Editor, vr: VRange) -> [Str]
    if vr.sy == vr.ey
        let line = line_at(ed, vr.sy)
        let hi = util.u8_after(line, vr.ex)
        set_line(ed.lines, vr.sy, str.slice(line, 0, vr.sx) + str.slice(line, hi, str.len(line)))
    else
        let first = line_at(ed, vr.sy)
        let last = line_at(ed, vr.ey)
        let hi = util.u8_after(last, vr.ex)
        let merged = str.slice(first, 0, vr.sx) + str.slice(last, hi, str.len(last))
        let total = list.len(ed.lines)
        var ls: [Str] = []
        let mut i = 0
        while i < total
            if i < vr.sy
                ls = list.append(ls, [ed.lines[i]])
            elif i == vr.sy
                ls = list.append(ls, [merged])
            elif i > vr.ey
                ls = list.append(ls, [ed.lines[i]])
            i = i + 1
        ls

// Apply d / y / c (opb byte) over an arbitrary CHARWISE range `vr` (may span
// lines).  Single trailing return.
//
// `vr` is snapshotted into scalar Int locals BEFORE any call that allocates a
// heap string: passing a nested struct field (e.g. `to.vr` from a text object)
// into a helper that allocates can corrupt the still-live `vr` here under the
// LLVM backend — `vr.ex` was observed picking up a byte of freed string data
// (length-16+ lines only; the SSO→heap boundary).  Reading the four fields up
// front, then rebuilding a fresh VRange per callee, sidesteps it.
fn apply_char_vr(ed: Editor, st: InputState, opb: Int, vr: VRange) -> Step
    let vsy = vr.sy
    let vsx = vr.sx
    let vey = vr.ey
    let vex = vr.ex
    let txt = vyank_char_text(ed, VRange { sy: vsy, sx: vsx, ey: vey, ex: vex })
    let is_yank = opb == 'y'
    let ins = opb == 'c'
    let nls = if is_yank then ed.lines else vdelete_char_lines(ed, VRange { sy: vsy, sx: vsx, ey: vey, ex: vex })
    let ne = if ins then clamp_insert(Editor { lines: nls, cy: vsy, cx: vsx }) else clamp(Editor { lines: nls, cy: vsy, cx: vsx })
    Step { ed: ne, st: ist_reg_cw(st, txt, ins) }

fn visual_apply_char(ed: Editor, st: InputState, opb: Int) -> Step
    apply_char_vr(ed, st, opb, visual_range(st, ed))

// Apply d / y / c to a LINEWISE selection by delegating to apply_linewise_op
// over [sy, ey].
fn visual_apply_line(ed: Editor, st: InputState, opb: Int) -> Step
    let vr = visual_range(st, ed)
    apply_linewise_op(Editor { lines: ed.lines, cy: vr.sy, cx: 0 }, st, opb, vr.ey)

// ── Text objects: iw/aw, i"/a", i(/a(, i{/a{, i[/a[ ───────────
// A text object resolves to a charwise range (or ok=false when there's no
// object under the cursor).  Used by operators (diw, ci", yi(...) and visual
// (viw, vi"...).

struct TObj
    vr:       VRange
    ok:       Bool
    linewise: Bool        // paragraph objects (ip/ap) span whole lines

fn tobj(sy: Int, sx: Int, ey: Int, ex: Int) -> TObj
    TObj { vr: VRange { sy: sy, sx: sx, ey: ey, ex: ex }, ok: true, linewise: false }

fn tobj_none() -> TObj
    TObj { vr: VRange { sy: 0, sx: 0, ey: 0, ex: 0 }, ok: false, linewise: false }

// A linewise text object covering whole lines [lo, hi] (ip / ap).
fn tobj_lw(lo: Int, hi: Int) -> TObj
    TObj { vr: VRange { sy: lo, sx: 0, ey: hi, ex: 0 }, ok: true, linewise: true }

// Char class for word objects; `big` (WORD) folds punctuation into the word
// class so a WORD is any whitespace-delimited run.
fn wcls(line: Str, x: Int, big: Bool) -> Int
    let k = util.class_at_u8(line, x)
    if big and k == 2 then 1 else k

// iw / aw (and iW / aW when `big`) — the word/WORD (or whitespace run) under the
// cursor.  `around` adds trailing whitespace, or leading when there is none.
fn textobj_word(ed: Editor, around: Bool, big: Bool) -> TObj
    let line = line_at(ed, ed.cy)
    let n = str.len(line)
    if n == 0
        return tobj_none()
    let cx = if ed.cx >= n then util.u8_last(line) else util.u8_start(line, ed.cx)
    let cls = wcls(line, cx, big)
    // `lo` and `hi` are the starts of the first and the last character of the
    // object; each step moves a whole character.
    var lo = cx
    while lo > 0 and wcls(line, util.u8_prev(line, lo), big) == cls
        lo = util.u8_prev(line, lo)
    var hi = cx
    while util.u8_next(line, hi) < n and wcls(line, util.u8_next(line, hi), big) == cls
        hi = util.u8_next(line, hi)
    if around
        var added = false
        while util.u8_next(line, hi) < n and wcls(line, util.u8_next(line, hi), big) == 0
            hi = util.u8_next(line, hi)
            added = true
        if not added
            while lo > 0 and wcls(line, util.u8_prev(line, lo), big) == 0
                lo = util.u8_prev(line, lo)
    tobj(ed.cy, lo, ed.cy, hi)

// i" / a" (and ' / `) — the first quote pair on the line at/after the cursor.
fn textobj_quote(ed: Editor, q: Int, around: Bool) -> TObj
    let line = line_at(ed, ed.cy)
    let n = str.len(line)
    var inq = false
    var qstart = 0 - 1
    var op = 0 - 1
    var cl = 0 - 1
    var i = 0
    while i < n and cl < 0
        if (str.byte_at(line, i) ?? 0) == q
            if not inq
                inq = true
                qstart = i
            else
                inq = false
                if i >= ed.cx
                    op = qstart
                    cl = i
        i = i + 1
    if cl < 0
        return tobj_none()
    if around
        tobj(ed.cy, op, ed.cy, cl)
    else
        tobj(ed.cy, op + 1, ed.cy, util.u8_prev(line, cl))   // the end is the start of the last inner character

// A buffer position with a found flag (bracket-pair search).
struct Pos
    y:  Int
    x:  Int
    ok: Bool

// Scan backward from (sy,sx) for the unmatched open bracket (the one enclosing
// the cursor), counting matched pairs.
fn match_open_back(ed: Editor, sy: Int, sx: Int, open_ch: Int, close_ch: Int) -> Pos
    var depth = 0
    var y = sy
    var x = sx
    while y >= 0
        while x >= 0
            let ch = str.byte_at(line_at(ed, y), x) ?? 0
            if ch == close_ch
                depth = depth + 1
            elif ch == open_ch
                if depth == 0
                    return Pos { y: y, x: x, ok: true }
                depth = depth - 1
            x = x - 1
        y = y - 1
        if y >= 0
            x = str.len(line_at(ed, y)) - 1
    Pos { y: 0, x: 0, ok: false }

// Scan forward from (sy,sx) for the close matching an already-open bracket.
fn match_close_fwd(ed: Editor, sy: Int, sx: Int, open_ch: Int, close_ch: Int) -> Pos
    var depth = 0
    var y = sy
    var x = sx
    let ny = list.len(ed.lines)
    while y < ny
        let line = line_at(ed, y)
        let n = str.len(line)
        while x < n
            let ch = str.byte_at(line, x) ?? 0
            if ch == open_ch
                depth = depth + 1
            elif ch == close_ch
                if depth == 0
                    return Pos { y: y, x: x, ok: true }
                depth = depth - 1
            x = x + 1
        y = y + 1
        x = 0
    Pos { y: 0, x: 0, ok: false }

// i( / a( etc. — the bracket pair enclosing the cursor, spanning lines.
fn textobj_bracket(ed: Editor, open_ch: Int, close_ch: Int, around: Bool) -> TObj
    let line = line_at(ed, ed.cy)
    let on_open = ed.cx < str.len(line) and (str.byte_at(line, ed.cx) ?? 0) == open_ch
    let op = if on_open then Pos { y: ed.cy, x: ed.cx, ok: true } else match_open_back(ed, ed.cy, ed.cx - 1, open_ch, close_ch)
    if not op.ok
        return tobj_none()
    let cl = match_close_fwd(ed, op.y, op.x + 1, open_ch, close_ch)
    if not cl.ok
        return tobj_none()
    if around
        tobj(op.y, op.x, cl.y, cl.x)
    else
        tobj(op.y, op.x + 1, cl.y, if cl.x > 0 then util.u8_prev(line_at(ed, cl.y), cl.x) else 0 - 1)

// ip / ap — the paragraph under the cursor: a maximal run of non-blank lines
// (or of blank lines, when the cursor sits on one).  `around` also takes the
// trailing blank lines, or the leading ones when there is no trailing run.
fn textobj_paragraph(ed: Editor, around: Bool) -> TObj
    let n = list.len(ed.lines)
    let onblank = str.len(line_at(ed, ed.cy)) == 0
    var lo = ed.cy
    while lo > 0 and (str.len(line_at(ed, lo - 1)) == 0) == onblank
        lo = lo - 1
    var hi = ed.cy
    while hi + 1 < n and (str.len(line_at(ed, hi + 1)) == 0) == onblank
        hi = hi + 1
    if around
        var added = false
        while hi + 1 < n and (str.len(line_at(ed, hi + 1)) == 0) == (not onblank)
            hi = hi + 1
            added = true
        if not added
            while lo > 0 and (str.len(line_at(ed, lo - 1)) == 0) == (not onblank)
                lo = lo - 1
    tobj_lw(lo, hi)

// Resolve an object char (the byte after i / a) to a range.
fn text_object(ed: Editor, obj: Int, around: Bool) -> TObj
    if obj == 'p'                                          // p — paragraph (linewise)
        textobj_paragraph(ed, around)
    elif obj == 'w'                                        // w
        textobj_word(ed, around, false)
    elif obj == 'W'                                        // W — WORD (whitespace-delimited)
        textobj_word(ed, around, true)
    elif obj == '"' or obj == '\'' or obj == '`'          // " ' `
        textobj_quote(ed, obj, around)
    elif obj == '(' or obj == ')' or obj == 'b'          // ( ) b
        textobj_bracket(ed, '(', ')', around)
    elif obj == '{' or obj == '}' or obj == 'B'          // { } B
        textobj_bracket(ed, '{', '}', around)
    elif obj == '[' or obj == ']'                         // [ ]
        textobj_bracket(ed, '[', ']', around)
    else
        tobj_none()

// Apply an operator over a text object; no-op + reset if there's no object.
fn apply_text_object(ed: Editor, st: InputState, opb: Int, obj: Int, around: Bool) -> Step
    let to = text_object(ed, obj, around)
    if to.ok
        if to.linewise
            let lo = to.vr.sy
            let hi = to.vr.ey
            return apply_linewise_op(Editor { lines: ed.lines, cy: lo, cx: 0 }, st, opb, hi)
        return apply_char_vr(ed, st, opb, to.vr)
    Step { ed: ed, st: ist_done(st) }

fn visual_apply(ed: Editor, st: InputState, opb: Int) -> Step
    if st.mode == 3
        return visual_apply_line(ed, st, opb)
    visual_apply_char(ed, st, opb)

// `>` / `<` over the selected lines, then back to Normal on the first line.
fn visual_indent(ed: Editor, st: InputState, right: Bool) -> Step
    let vr = visual_range(st, ed)
    let total = list.len(ed.lines)
    var ls: [Str] = []
    let mut i = 0
    while i < total
        if i >= vr.sy and i <= vr.ey
            ls = list.append(ls, [if right then indent_one(ed.lines[i]) else dedent_one(ed.lines[i])])
        else
            ls = list.append(ls, [ed.lines[i]])
        i = i + 1
    let fnb = first_nonblank(if vr.sy < list.len(ls) then ls[vr.sy] else "")
    Step { ed: clamp(Editor { lines: ls, cy: vr.sy, cx: fnb }), st: ist_done(st) }

// Move the cursor for a (single-byte) motion in visual mode.
fn visual_motion(ed: Editor, b: Int, cnt: Int) -> Editor
    if b == 'h' or b == 'l' or b == 'j' or b == 'k'
        repeat_hjkl(ed, b, cnt)
    elif b == 'w'
        repeat_word(ed, 0, cnt)
    elif b == 'b'
        repeat_word(ed, 1, cnt)
    elif b == 'e'
        repeat_word(ed, 2, cnt)
    elif b == 'W'
        repeat_word(ed, 3, cnt)
    elif b == 'B'
        repeat_word(ed, 4, cnt)
    elif b == 'E'
        repeat_word(ed, 5, cnt)
    elif b == '0'
        clamp(Editor { lines: ed.lines, cy: ed.cy, cx: 0 })
    elif b == '$'
        clamp(Editor { lines: ed.lines, cy: ed.cy, cx: util.u8_last(line_at(ed, ed.cy)) })
    elif b == '^'
        clamp(Editor { lines: ed.lines, cy: ed.cy, cx: first_nonblank(line_at(ed, ed.cy)) })
    elif b == 'G'
        move_rows(ed, list.len(ed.lines) - 1)
    elif b == '%'
        match_pair(ed)
    elif b == '}'
        clamp(Editor { lines: ed.lines, cy: para_fwd(ed, cnt), cx: 0 })
    elif b == '{'
        clamp(Editor { lines: ed.lines, cy: para_bwd(ed, cnt), cx: 0 })
    else
        ed

// State that stays in visual mode (preserve anchor + register, reset count).
fn ist_visual_keep(st: InputState, mode: Int) -> InputState
    InputState { count: 0, pending: 0, mode: mode, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx }

// Stay in visual mode but set a pending sub-state (await an f/F/t/T target
// char, or a second g) — preserves the count so `3fx` etc. work.
fn ist_visual_pending(st: InputState, pcode: Int) -> InputState
    InputState { count: st.count, pending: pcode, mode: st.mode, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx }

// `~` / `u` / `U` on the visual selection → back to Normal.
fn visual_case(ed: Editor, st: InputState, kind: Int) -> Step
    let vr = visual_range(st, ed)
    let total = list.len(ed.lines)
    var ls: [Str] = []
    let mut i = 0
    while i < total
        if i >= vr.sy and i <= vr.ey
            let line = ed.lines[i]
            let lo = if st.mode == 3 then 0 elif i == vr.sy then vr.sx else 0
            let hi = if st.mode == 3 then str.len(line) elif i == vr.ey then util.u8_after(line, vr.ex) else str.len(line)
            ls = list.append(ls, [case_text(line, lo, hi, kind)])
        else
            ls = list.append(ls, [ed.lines[i]])
        i = i + 1
    Step { ed: clamp(Editor { lines: ls, cy: vr.sy, cx: vr.sx }), st: ist_done(st) }

// ── Case operators gu / gU / g~ + motion ─────────────────────
// kind: 0 toggle, 1 lower, 2 upper.

// Apply a case map to whole lines [lo, hi].
fn case_line_span(ed: Editor, st: InputState, kind: Int, lo: Int, hi: Int) -> Step
    let total = list.len(ed.lines)
    var ls: [Str] = []
    let mut i = 0
    while i < total
        if i >= lo and i <= hi
            ls = list.append(ls, [case_text(ed.lines[i], 0, str.len(ed.lines[i]), kind)])
        else
            ls = list.append(ls, [ed.lines[i]])
        i = i + 1
    Step { ed: clamp(Editor { lines: ls, cy: if lo < 0 then 0 else lo, cx: 0 }), st: ist_done(st) }

// Apply a case map over a CHARWISE range `vr` (may span lines), like visual_case.
fn case_char_vr(ed: Editor, vr: VRange, kind: Int) -> [Str]
    let total = list.len(ed.lines)
    var ls: [Str] = []
    let mut i = 0
    while i < total
        if i >= vr.sy and i <= vr.ey
            let line = ed.lines[i]
            let lo = if i == vr.sy then vr.sx else 0
            let hi = if i == vr.ey then util.u8_after(line, vr.ex) else str.len(line)
            ls = list.append(ls, [case_text(line, lo, hi, kind)])
        else
            ls = list.append(ls, [ed.lines[i]])
        i = i + 1
    ls

// gu/gU/g~ over a text object (giw / gUi" / g~ip, ...).
fn apply_case_textobj(ed: Editor, st: InputState, kind: Int, obj: Int, around: Bool) -> Step
    let to = text_object(ed, obj, around)
    if not to.ok
        return Step { ed: ed, st: ist_done(st) }
    let vsy = to.vr.sy
    let vsx = to.vr.sx
    let vey = to.vr.ey
    let vex = to.vr.ex
    if to.linewise
        return case_line_span(ed, st, kind, vsy, vey)
    let ls = case_char_vr(ed, VRange { sy: vsy, sx: vsx, ey: vey, ex: vex }, kind)
    Step { ed: clamp(Editor { lines: ls, cy: vsy, cx: vsx }), st: ist_done(st) }

// The second part of a gu/gU/g~ command (pcode keeps the operator pending
// across a count).  Doubled (guu/gUU/g~~) → line; a charwise motion → that
// span; a linewise motion → those lines.
fn feed_case(ed: Editor, st: InputState, kind: Int, pcode: Int, b: Int) -> Step
    let trigger = if kind == 1 then 'u' elif kind == 2 then 'U' else '~'
    if b == trigger                              // guu / gUU / g~~ — line(s)
        let cnt = if st.count > 0 then st.count else 1
        return case_line_span(ed, st, kind, ed.cy, ed.cy + cnt - 1)
    if b >= '1' and b <= '9'
        return Step { ed: ed, st: InputState { count: st.count * 10 + (b - '0'), pending: pcode, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == '0' and st.count > 0
        return Step { ed: ed, st: InputState { count: st.count * 10, pending: pcode, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'i'                                 // i — inner text object (pending 53/55/57)
        return Step { ed: ed, st: InputState { count: st.count, pending: 53 + kind * 2 + 0, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'a'                                 // a — around text object (pending 54/56/58)
        return Step { ed: ed, st: InputState { count: st.count, pending: 53 + kind * 2 + 1, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    let tgt = motion_target(ed, b, st.count)
    if tgt.ok and tgt.linewise
        let lo = if ed.cy < tgt.ty then ed.cy else tgt.ty
        let hi = if ed.cy < tgt.ty then tgt.ty else ed.cy
        return case_line_span(ed, st, kind, lo, hi)
    if tgt.ok
        let lo = if ed.cx < tgt.tx then ed.cx else tgt.tx
        var hi = if ed.cx < tgt.tx then tgt.tx else ed.cx
        if tgt.inclusive
            hi = util.u8_after(line_at(ed, ed.cy), hi)
        return Step { ed: clamp(Editor { lines: set_line(ed.lines, ed.cy, case_text(line_at(ed, ed.cy), lo, hi, kind)), cy: ed.cy, cx: lo }), st: ist_done(st) }
    feed(ed, ist_clear_pending(st), b)           // invalid — cancel + reprocess

// `J` joins the selected lines → back to Normal.
fn visual_join(ed: Editor, st: InputState) -> Step
    let vr = visual_range(st, ed)
    let nlines = vr.ey - vr.sy + 1
    Step { ed: op_join_lines(Editor { lines: ed.lines, cy: vr.sy, cx: 0 }, nlines, true), st: ist_done(st) }

// `p` replaces the selection with the register's contents; the replaced text
// becomes the new register.  Delete then paste-before at the gap.
fn visual_paste(ed: Editor, st: InputState) -> Step
    let vr = visual_range(st, ed)
    let del = visual_apply(ed, st, 'd')               // del.st.reg = removed text
    let tmp = InputState { count: 0, pending: 0, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx }
    // For a charwise selection paste at the exact gap column (vr.sx, which
    // may be past end-of-line); paste-before clamps it to len → append.
    let ped = if st.mode == 2 then Editor { lines: del.ed.lines, cy: del.ed.cy, cx: vr.sx } else del.ed
    let pasted = paste(ped, tmp, false)
    Step { ed: pasted, st: del.st }

// `vi"` / `va(` … — set the selection to a text object, staying in visual.
fn visual_set_textobj(ed: Editor, st: InputState, obj: Int, around: Bool) -> Step
    let to = text_object(ed, obj, around)
    if to.ok
        if to.linewise                       // paragraph → switch to Visual-line
            let lo = to.vr.sy
            let hi = to.vr.ey
            return Step { ed: clamp(Editor { lines: ed.lines, cy: hi, cx: 0 }), st: InputState { count: 0, pending: 0, mode: 3, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: lo, avx: 0 } }
        return Step { ed: clamp(Editor { lines: ed.lines, cy: to.vr.ey, cx: to.vr.ex }), st: InputState { count: 0, pending: 0, mode: st.mode, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: to.vr.sy, avx: to.vr.sx } }
    Step { ed: ed, st: ist_visual_keep(st, st.mode) }

// The character columns of a blockwise selection, left and right inclusive.
// The cursor and the anchor are byte indexes into their own lines, and a column
// of the block is a column of characters, so each corner is turned into the
// number of characters before it on its own line (`å` before a corner moves it
// one column, not two).  Every row then finds the bytes of those columns on its
// own line with util.u8_fwd.
struct BlockCols
    lo: Int
    hi: Int

fn vblock_cols(ed: Editor, avy: Int, avx: Int) -> BlockCols
    let ac = util.u8_count(line_at(ed, avy), 0, avx)
    let cc = util.u8_count(line_at(ed, ed.cy), 0, ed.cx)
    BlockCols { lo: if ac < cc then ac else cc, hi: if ac < cc then cc else ac }

@intent("""Handle one byte in Visual mode (mode 2 = charwise, 3 = linewise):
motions extend the selection from its fixed anchor, operators (d/x/y/c/>/</~/u/U/J/p)
act on the selection and return to Normal, and text-object keys reshape the
selection.""")
// Delete the column rectangle of a blockwise selection: from every row in
// [ylo,yhi] cut out character columns [lo, hi] (inclusive), clamped to each
// line's length so a short (ragged) row loses only what it has.  Cursor lands at
// the top-left corner; leaves Visual.
fn vblock_delete(ed: Editor, st: InputState) -> Step
    let ylo = if st.avy < ed.cy then st.avy else ed.cy
    let yhi = if st.avy < ed.cy then ed.cy else st.avy
    let cols = vblock_cols(ed, st.avy, st.avx)
    var lines = ed.lines[:]
    var y = ylo
    while y <= yhi
        let line = if y < list.len(lines) then lines[y] else ""
        let n = str.len(line)
        let blo = util.u8_fwd(line, 0, cols.lo)
        if blo < n
            let bhi = util.u8_fwd(line, blo, cols.hi - cols.lo + 1)
            lines = set_line(lines, y, str.slice(line, 0, blo) + str.slice(line, bhi, n))
        y = y + 1
    let corner = if ylo < list.len(lines) then util.u8_fwd(lines[ylo], 0, cols.lo) else 0
    Step { ed: clamp(Editor { lines: lines, cy: ylo, cx: corner }), st: ist_done(st) }

// Fill every cell of a blockwise selection with `ch` (the `r<char>` form): on
// each row, overwrite character columns [lo, hi] that the line actually has (vim
// never pads past end-of-line), one `ch` for every character replaced.  Esc
// cancels.  Leaves Visual.
fn vblock_fill(ed: Editor, st: InputState, ch: Int) -> Step
    if ch == '\e'
        return Step { ed: ed, st: ist_done(st) }
    let ylo = if st.avy < ed.cy then st.avy else ed.cy
    let yhi = if st.avy < ed.cy then ed.cy else st.avy
    let cols = vblock_cols(ed, st.avy, st.avx)
    var lines = ed.lines[:]
    var y = ylo
    while y <= yhi
        let line = if y < list.len(lines) then lines[y] else ""
        let n = str.len(line)
        let blo = util.u8_fwd(line, 0, cols.lo)
        if blo < n
            let bhi = util.u8_fwd(line, blo, cols.hi - cols.lo + 1)
            let one = str.from_char(ch)
            var rep = ""
            var k = util.u8_count(line, blo, bhi)
            while k > 0
                rep = rep + one
                k = k - 1
            lines = set_line(lines, y, str.slice(line, 0, blo) + rep + str.slice(line, bhi, n))
        y = y + 1
    let corner = if ylo < list.len(lines) then util.u8_fwd(lines[ylo], 0, cols.lo) else 0
    Step { ed: clamp(Editor { lines: lines, cy: ylo, cx: corner }), st: ist_done(st) }

// Yank the column rectangle into the unnamed register: each row's [lo, hi]
// segment (clamped to the line) joined by newlines — so `p` (and the OS
// clipboard, when synced) gets the column's text.  Leaves Visual; no buffer
// change.  (True blockwise paste — re-inserting column-wise — is a follow-on.)
fn vblock_yank(ed: Editor, st: InputState) -> Step
    let ylo = if st.avy < ed.cy then st.avy else ed.cy
    let yhi = if st.avy < ed.cy then ed.cy else st.avy
    let cols = vblock_cols(ed, st.avy, st.avx)
    var acc = ""
    var y = ylo
    while y <= yhi
        let line = if y < list.len(ed.lines) then ed.lines[y] else ""
        let n = str.len(line)
        let blo = util.u8_fwd(line, 0, cols.lo)
        let seg = if blo < n then str.slice(line, blo, util.u8_fwd(line, blo, cols.hi - cols.lo + 1)) else ""
        if y > ylo
            acc = acc + str.from_char('\n')
        acc = acc + seg
        y = y + 1
    Step { ed: clamp(Editor { lines: ed.lines, cy: ylo, cx: util.u8_fwd(line_at(ed, ylo), 0, cols.lo) }), st: InputState { count: 0, pending: 0, mode: 0, reg: acc, reg_lw: false, search: st.search, avy: st.avy, avx: st.avx } }

// Shift every line spanned by the block one shiftwidth right (indent) or left
// (dedent) — like vim, this acts on whole lines, not just the column band.
fn vblock_shift(ed: Editor, st: InputState, right: Bool) -> Step
    let ylo = if st.avy < ed.cy then st.avy else ed.cy
    let yhi = if st.avy < ed.cy then ed.cy else st.avy
    var lines = ed.lines[:]
    var y = ylo
    while y <= yhi
        let line = if y < list.len(lines) then lines[y] else ""
        let nl = if right then indent_one(line) else dedent_one(line)
        lines = set_line(lines, y, nl)
        y = y + 1
    Step { ed: clamp(Editor { lines: lines, cy: ylo, cx: 0 }), st: ist_done(st) }

// Enter Insert for a blockwise `I` / `A` / `c`: `I` at the block's left column,
// `A` just past its right column (padding a short first row with spaces), `c`
// deletes the block first then inserts at the left.  Only the first row is
// edited live; the driver records the column band and, on Esc, replays this
// row's inserted text onto every other selected row (block_replicate).
fn feed_vblock_insert(ed: Editor, st: InputState, b: Int) -> Step
    let ylo = if st.avy < ed.cy then st.avy else ed.cy
    let cols = vblock_cols(ed, st.avy, st.avx)
    if b == 'A'
        let col = cols.hi + 1
        let line = if ylo < list.len(ed.lines) then ed.lines[ylo] else ""
        let nch = util.u8_count(line, 0, str.len(line))
        let padded = if nch < col then line + disp.nspaces(col - nch) else line
        return Step { ed: clamp_insert(Editor { lines: set_line(ed.lines, ylo, padded), cy: ylo, cx: util.u8_fwd(padded, 0, col) }), st: ist_insert(st) }
    if b == 'c'
        let del = vblock_delete(ed, st)
        let first = if ylo < list.len(del.ed.lines) then del.ed.lines[ylo] else ""
        return Step { ed: clamp_insert(Editor { lines: del.ed.lines, cy: ylo, cx: util.u8_fwd(first, 0, cols.lo) }), st: ist_insert(st) }
    let first = if ylo < list.len(ed.lines) then ed.lines[ylo] else ""
    return Step { ed: clamp_insert(Editor { lines: ed.lines, cy: ylo, cx: util.u8_fwd(first, 0, cols.lo) }), st: ist_insert(st) }

// Replay the first row's block-insert onto rows [ylo+1, yhi]: the inserted text
// is what row `ylo` grew by since insert began (`flen0` = its length in bytes
// then, `nch0` in characters), i.e. the bytes that start at character column
// `col` of that row.  `col` is a character column and every row finds its own
// byte offset for it.  For `A` (append) a short row is space-padded to `col`
// characters first; for `I`/`c` a row shorter than `col` is skipped (vim).
// Called by the driver when a block-insert ends; the undo snapshot taken at
// `Ctrl-V` already covers the whole change.
fn block_replicate(ed: Editor, ylo: Int, yhi: Int, col: Int, flen0: Int, nch0: Int, append: Bool) -> Editor
    let first = if ylo < list.len(ed.lines) then ed.lines[ylo] else ""
    let flen = str.len(first)
    let grew = flen - flen0
    let bcol = util.u8_fwd(first, 0, col)
    let ins = if grew > 0 and col <= nch0 and bcol + grew <= flen then str.slice(first, bcol, bcol + grew) else ""
    if str.len(ins) == 0
        return ed
    var lines = ed.lines[:]
    var y = ylo + 1
    while y <= yhi
        let line = if y < list.len(lines) then lines[y] else ""
        let nch = util.u8_count(line, 0, str.len(line))
        if append
            let padded = if nch < col then line + disp.nspaces(col - nch) else line
            let at = util.u8_fwd(padded, 0, col)
            lines = set_line(lines, y, str.slice(padded, 0, at) + ins + str.slice(padded, at, str.len(padded)))
        elif col <= nch
            let at = util.u8_fwd(line, 0, col)
            lines = set_line(lines, y, str.slice(line, 0, at) + ins + str.slice(line, at, str.len(line)))
        y = y + 1
    Editor { lines: lines, cy: ylo, cx: bcol }

fn feed_visual(ed: Editor, st: InputState, b: Int) -> Step
    let cntp = if st.count > 0 then st.count else 1
    // Pending multi-key motions (extend the selection, stay visual).
    if st.pending == '\b'                           // f<char>
        return Step { ed: move_find(ed, b, true, false, cntp), st: ist_visual_keep(st, st.mode) }
    if st.pending == '\t'                           // F<char>
        return Step { ed: move_find(ed, b, false, false, cntp), st: ist_visual_keep(st, st.mode) }
    if st.pending == '\n'                          // t<char>
        return Step { ed: move_find(ed, b, true, true, cntp), st: ist_visual_keep(st, st.mode) }
    if st.pending == 11                          // T<char>
        return Step { ed: move_find(ed, b, false, true, cntp), st: ist_visual_keep(st, st.mode) }
    if st.pending == 1                           // g<g> — gg (to line / count)
        if b == 'g'
            let tgt = if st.count > 0 then st.count - 1 else 0
            return Step { ed: move_rows(ed, tgt), st: ist_visual_keep(st, st.mode) }
        return Step { ed: ed, st: ist_visual_keep(st, st.mode) }   // not gg — drop
    if st.pending == 48                          // i<obj> — inner text object
        return visual_set_textobj(ed, st, b, false)
    if st.pending == 49                          // a<obj> — around text object
        return visual_set_textobj(ed, st, b, true)
    if st.pending == 60                          // blockwise r<char> — fill every cell
        return vblock_fill(ed, st, b)
    if b == '\e'                                   // Esc — leave visual
        return Step { ed: ed, st: ist_done(st) }
    if b == 'v'                                 // v
        if st.mode == 2
            return Step { ed: ed, st: ist_done(st) }
        return Step { ed: ed, st: ist_visual_keep(st, 2) }
    if b == 'V'                                 // V
        if st.mode == 3
            return Step { ed: ed, st: ist_done(st) }
        return Step { ed: ed, st: ist_visual_keep(st, 3) }
    if b == 'o'                                 // o — swap anchor and cursor
        return Step { ed: clamp(Editor { lines: ed.lines, cy: st.avy, cx: st.avx }), st: InputState { count: 0, pending: 0, mode: st.mode, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: ed.cy, avx: ed.cx } }
    if b >= '1' and b <= '9'                    // count digit
        return Step { ed: ed, st: InputState { count: st.count * 10 + (b - '0'), pending: 0, mode: st.mode, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == '0' and st.count > 0
        return Step { ed: ed, st: InputState { count: st.count * 10, pending: 0, mode: st.mode, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    // Blockwise visual (mode 5) operators: delete/fill act on the column
    // rectangle, not a charwise run.  Block insert/append/change (I/A/c) and
    // yank/paste are not implemented; they ignore the key and stay selected.  Motions
    // and the Esc/v/V/o/count handlers above fall through to the shared code.
    if st.mode == 5
        if b == 'd' or b == 'x'                 // delete the block
            return vblock_delete(ed, st)
        if b == 'y'                             // yank the column
            return vblock_yank(ed, st)
        if b == 'r'                             // r<char> — fill every cell
            return Step { ed: ed, st: ist_visual_pending(st, 60) }
        if b == 'I' or b == 'A' or b == 'c'     // block insert / append / change
            return feed_vblock_insert(ed, st, b)
        if b == '>'                             // shift the spanned lines right
            return vblock_shift(ed, st, true)
        if b == '<'                             // shift the spanned lines left
            return vblock_shift(ed, st, false)
        if b == 's' or b == '~' or b == 'u' or b == 'U' or b == 'J' or b == 'p' or b == 'i' or b == 'a'
            return Step { ed: ed, st: ist_visual_keep(st, 5) }
    if b == 'd' or b == 'x'                     // d / x — delete selection
        return visual_apply(ed, st, 'd')
    if b == 'y'                                  // y — yank selection
        return visual_apply(ed, st, 'y')
    if b == 'c' or b == 's'                      // c / s — change selection
        return visual_apply(ed, st, 'c')
    if b == '>'                                  // > — indent selection
        return visual_indent(ed, st, true)
    if b == '<'                                  // < — dedent selection
        return visual_indent(ed, st, false)
    if b == '~'                                  // ~ — toggle case of selection
        return visual_case(ed, st, 0)
    if b == 'u'                                  // u — lowercase selection
        return visual_case(ed, st, 1)
    if b == 'U'                                  // U — uppercase selection
        return visual_case(ed, st, 2)
    if b == 'J'                                  // J — join the selected lines
        return visual_join(ed, st)
    if b == 'p'                                  // p — replace selection with register
        return visual_paste(ed, st)
    if b == 'o'                                  // o — swap the cursor and the anchor
        return Step { ed: clamp(Editor { lines: ed.lines, cy: st.avy, cx: st.avx }), st: InputState { count: 0, pending: 0, mode: st.mode, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: ed.cy, avx: ed.cx } }
    // Multi-key motion entry: await a target char (f/F/t/T) or a second g.
    if b == 'f'
        return Step { ed: ed, st: ist_visual_pending(st, 8) }
    if b == 'F'
        return Step { ed: ed, st: ist_visual_pending(st, 9) }
    if b == 't'
        return Step { ed: ed, st: ist_visual_pending(st, 10) }
    if b == 'T'
        return Step { ed: ed, st: ist_visual_pending(st, 11) }
    if b == 'g'
        return Step { ed: ed, st: ist_visual_pending(st, 1) }
    if b == 'i'                                 // i — await inner text-object char
        return Step { ed: ed, st: ist_visual_pending(st, 48) }
    if b == 'a'                                 // a — await around text-object char
        return Step { ed: ed, st: ist_visual_pending(st, 49) }
    // Single-byte motion: move the cursor, stay in visual mode (anchor fixed).
    Step { ed: visual_motion(ed, b, cntp), st: ist_visual_keep(st, st.mode) }

@intent("""Handle one byte in Insert mode: Esc returns to Normal (stepping the
cursor left, vim-style), Enter splits the line, Backspace deletes back, and
printables (plus tab) insert at the cursor.  Other control bytes are ignored.""")
fn feed_insert(ed: Editor, st: InputState, b: Int) -> Step
    if b == '\e'                         // Esc → Normal (cursor steps left, vim)
        let e = clamp(Editor { lines: ed.lines, cy: ed.cy, cx: ed.cx - 1 })
        return Step { ed: e, st: ist_done(st) }
    if b == '\r' or b == '\n'              // Enter → split line
        return Step { ed: insert_newline(ed), st: st }
    if b == '\x7f' or b == '\b'              // Backspace / DEL
        return Step { ed: backspace(ed), st: st }
    if b == '\t' or (b >= ' ' and b < '\x7f') // printable (+ tab) → insert
        return Step { ed: insert_char(ed, b), st: st }
    if b >= 128 and b < 256                  // a byte of a UTF-8 character: the terminal sends them one at a time
        return Step { ed: insert_char(ed, b), st: st }
    Step { ed: ed, st: st }            // ignore other control bytes

// Overtype the char at the cursor (Replace mode), advancing one column;
// appends when already at end-of-line.  The character replaced is the whole
// one at the cursor, which is more than one byte when it is multi-byte.  A
// continuation byte (10xxxxxx) of the character being typed replaces nothing:
// its lead byte already took the place of the old character, so it goes in
// beside it.
fn overtype_char(ed: Editor, b: Int) -> Editor
    let line = line_at(ed, ed.cy)
    let n = str.len(line)
    if util.u8_cont(b)
        return insert_char(ed, b)
    let hi = util.u8_next(line, ed.cx)
    let newline = if ed.cx < n then str.slice(line, 0, ed.cx) + str.from_byte(b) + str.slice(line, hi, n) else line + str.from_byte(b)
    clamp_insert(Editor { lines: set_line(ed.lines, ed.cy, newline), cy: ed.cy, cx: ed.cx + 1 })

@intent("""Handle one byte in Replace mode (`R`): printables overwrite the char
at the cursor instead of inserting.  Backspace just steps left (it does not
restore the overwritten character).""")
fn feed_replace(ed: Editor, st: InputState, b: Int) -> Step
    if b == '\e'                         // Esc → Normal (cursor steps left)
        return Step { ed: clamp(Editor { lines: ed.lines, cy: ed.cy, cx: ed.cx - 1 }), st: ist_done(st) }
    if b == '\r' or b == '\n'              // Enter → split line
        return Step { ed: insert_newline(ed), st: st }
    if b == '\x7f' or b == '\b'              // Backspace → step left
        return Step { ed: clamp_insert(Editor { lines: ed.lines, cy: ed.cy, cx: util.u8_prev(line_at(ed, ed.cy), ed.cx) }), st: st }
    if b == '\t' or (b >= ' ' and b < '\x7f') // printable → overwrite
        return Step { ed: overtype_char(ed, b), st: st }
    if b >= 128 and b < 256                  // a byte of a UTF-8 character
        return Step { ed: overtype_char(ed, b), st: st }
    Step { ed: ed, st: st }

// ── The target character of r, f, F, t, T ─────────────────────────
// The command after `r` or `f` takes one character, and a terminal sends a
// multi-byte character one byte at a time.  `feed` therefore holds the bytes of
// such a target in the pending code: the code of the waiting command in the low
// 8 bits, and above them the count of continuation bytes still to come (2 bits)
// and the bits of the code point read so far.  The command itself (`feed_cmd`)
// then receives the whole code point, `229` for å, as its byte.

// True when the state waits for the target character of a command: `r`, the
// find commands, an operator's find form, the find commands in Visual mode and
// the blockwise `r`.
fn awaits_target(st: InputState) -> Bool
    if st.mode == 0
        st.pending == 4 or (st.pending >= 8 and st.pending <= 11) or (st.pending >= 20 and st.pending <= 31)
    elif st.mode == 2 or st.mode == 3 or st.mode == 5
        (st.pending >= 8 and st.pending <= 11) or st.pending == 60
    else
        false

// Leave the command that waits for a target, in the mode it was typed in.
fn target_cancel(st: InputState) -> InputState
    if st.mode == 0
        ist_done(st)
    else
        ist_visual_keep(st, st.mode)

// The lead byte `b` of a multi-byte target: remember its payload and how many
// bytes follow.  A byte that leads no character cancels the command.
fn feed_target_head(ed: Editor, st: InputState, b: Int) -> Step
    let k = util.u8_lead_len(b)
    if k == 1
        return Step { ed: ed, st: target_cancel(st) }
    let payload = if k == 2 then b & 31 elif k == 3 then b & 15 else b & 7
    Step { ed: ed, st: ist_visual_pending(st, st.pending + 256 * ((k - 1) + 4 * payload)) }

// A byte after the lead byte of a target.  A continuation byte joins the code
// point, and the last one runs the command with it.  Any other byte ends the
// half-typed character without a target and is read as a key of its own.
fn feed_target_tail(ed: Editor, st: InputState, b: Int) -> Step
    let p = st.pending % 256
    let code = st.pending / 256
    let rem = code % 4
    let payload = code / 4
    if b >= 128 and b < 192
        let cp = payload * 64 + (b - 128)
        if rem == 1
            return feed_cmd(ed, ist_visual_pending(st, p), cp)
        return Step { ed: ed, st: ist_visual_pending(st, p + 256 * ((rem - 1) + 4 * cp)) }
    feed(ed, target_cancel(st), b)

@intent("""The pure input core: fold one input byte into (editor, input-state).
Dispatches by mode — Insert/Visual/Replace delegate to their handlers; Normal
mode resolves counts (`5j`, `10G`), motions, operators, and pending multi-key
commands.  No I/O: the driver owns the buffer, registers, undo, and the screen;
`feed` only transforms editor + input state so it stays deterministic and
testable.  A multi-byte target of `r` or `f` is gathered here, byte by byte,
and reaches the command as one code point.""")
fn feed(ed: Editor, st: InputState, b: Int) -> Step
    if st.pending >= 256
        return feed_target_tail(ed, st, b)
    if b >= 128 and awaits_target(st)
        return feed_target_head(ed, st, b)
    feed_cmd(ed, st, b)

// One key, or one whole target character, through the mode that owns it.
fn feed_cmd(ed: Editor, st: InputState, b: Int) -> Step
    // Insert mode owns every byte until Esc.
    if st.mode == 1
        return feed_insert(ed, st, b)
    // Visual mode: charwise (2) / linewise (3) / blockwise (5).
    if st.mode == 2 or st.mode == 3 or st.mode == 5
        return feed_visual(ed, st, b)
    // Replace mode: overtype.
    if st.mode == 4
        return feed_replace(ed, st, b)
    // Operators awaiting a second key (pending: 1=g, 2=d, 3=y).
    if st.pending == 1
        if b == 'g'                   // `gg` — go to line (count or 1)
            let tgt = if st.count > 0 then st.count - 1 else 0
            return Step { ed: move_rows(ed, tgt), st: ist_done(st) }
        if b == 'u'                   // `gu` — lowercase operator
            return Step { ed: ed, st: InputState { count: st.count, pending: 51, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
        if b == 'U'                   // `gU` — uppercase operator
            return Step { ed: ed, st: InputState { count: st.count, pending: 52, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
        if b == '~'                   // `g~` — toggle-case operator
            return Step { ed: ed, st: InputState { count: st.count, pending: 50, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
        if b == 'J'                   // `gJ` — join line(s) without a space
            return Step { ed: op_join_lines(ed, if st.count > 0 then st.count else 1, false), st: ist_done(st) }
        return feed(ed, ist_clear_pending(st), b)     // not g-command — reprocess fresh
    if st.pending == 50                // g~<motion> — toggle case
        return feed_case(ed, st, 0, 50, b)
    if st.pending == 51                // gu<motion> — lowercase
        return feed_case(ed, st, 1, 51, b)
    if st.pending == 52                // gU<motion> — uppercase
        return feed_case(ed, st, 2, 52, b)
    if st.pending >= 53 and st.pending <= 58   // g~/gu/gU + text object; byte = object char
        let code = st.pending - 53
        let ckind = code / 2
        let around = (code - ckind * 2) == 1
        return apply_case_textobj(ed, st, ckind, b, around)
    if st.pending == 2                 // `d` — operator awaiting a motion (or dd)
        return feed_operator(ed, st, 'd', 2, b)
    if st.pending == 3                 // `y` — operator awaiting a motion (or yy)
        return feed_operator(ed, st, 'y', 3, b)
    if st.pending == 7                 // `c` — operator awaiting a motion (or cc)
        return feed_operator(ed, st, 'c', 7, b)
    if st.pending == 4                 // `r<c>` — next byte is the replacement
        if b == '\e'                     // Esc cancels the replace
            return Step { ed: ed, st: ist_done(st) }
        return Step { ed: op_replace_char(ed, b, if st.count > 0 then st.count else 1), st: ist_done(st) }
    if st.pending == 5                 // `>` — indent right (>> or >motion)
        return feed_indent(ed, st, true, b)
    if st.pending == 6                 // `<` — indent left (<< or <motion)
        return feed_indent(ed, st, false, b)
    // Find-char motions: pending 8=f 9=F 10=t 11=T await the target.
    if st.pending == '\b'                 // f<char>
        if b == '\e'
            return Step { ed: ed, st: ist_done(st) }
        return Step { ed: move_find(ed, b, true, false, if st.count > 0 then st.count else 1), st: ist_done(st) }
    if st.pending == '\t'                 // F<char>
        if b == '\e'
            return Step { ed: ed, st: ist_done(st) }
        return Step { ed: move_find(ed, b, false, false, if st.count > 0 then st.count else 1), st: ist_done(st) }
    if st.pending == '\n'                // t<char>
        if b == '\e'
            return Step { ed: ed, st: ist_done(st) }
        return Step { ed: move_find(ed, b, true, true, if st.count > 0 then st.count else 1), st: ist_done(st) }
    if st.pending == 11                // T<char>
        if b == '\e'
            return Step { ed: ed, st: ist_done(st) }
        return Step { ed: move_find(ed, b, false, true, if st.count > 0 then st.count else 1), st: ist_done(st) }
    // Operator + find-char: pending 20..31 encodes (operator,
    // find-type); the byte is the target char.  df{c} / dt{c} / dF{c} / dT{c}
    // for d / c / y.
    if st.pending >= 20 and st.pending <= 31
        if b == '\e'
            return Step { ed: ed, st: ist_done(st) }
        let code = st.pending - 20
        let opidx = code / 4
        let ftidx = code - opidx * 4
        let opb = if opidx == 0 then 'd' elif opidx == 1 then 'c' else 'y'
        let forward = ftidx == 0 or ftidx == 2
        let till = ftidx == 2 or ftidx == 3
        let tgt = find_target(ed, b, forward, till, if st.count > 0 then st.count else 1)
        return apply_motion_op(ed, st, opb, tgt)
    // Operator + gg: pending 32/33/34 = d/c/y awaiting the second g.
    if st.pending >= ' ' and st.pending <= 34
        if b == 'g'                   // second g — linewise [top, cursor]
            let opb = if st.pending == ' ' then 'd' elif st.pending == 33 then 'c' else 'y'
            return apply_linewise_op(ed, st, opb, if st.count > 0 then st.count - 1 else 0)
        return feed(ed, ist_clear_pending(st), b)   // not gg — cancel + reprocess
    // Operator + text object: pending 40..45 encodes (operator,
    // inner/around); the byte is the object char (w " ' ` ( ) b { } B [ ]).
    if st.pending >= 40 and st.pending <= 45
        let code = st.pending - 40
        let opidx = code / 2
        let around = (code - opidx * 2) == 1
        let opb = if opidx == 0 then 'd' elif opidx == 1 then 'c' else 'y'
        return apply_text_object(ed, st, opb, b, around)
    // Count digits.  `0` is a count digit only when a count is already
    // building; otherwise `0` is the "first column" motion.
    if b >= '1' and b <= '9'         // '1'-'9'
        return Step { ed: ed, st: InputState { count: st.count * 10 + (b - '0'), pending: 0, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == '0' and st.count > 0      // '0' continues a count
        return Step { ed: ed, st: InputState { count: st.count * 10, pending: 0, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    let cnt = if st.count > 0 then st.count else 1
    if b == 'h' or b == 'l' or b == 'j' or b == 'k'      // h l j k
        return Step { ed: repeat_hjkl(ed, b, cnt), st: ist_done(st) }
    if b == 'w'                       // 'w' — next word start
        return Step { ed: repeat_word(ed, 0, cnt), st: ist_done(st) }
    if b == 'b'                       // 'b' — previous word start
        return Step { ed: repeat_word(ed, 1, cnt), st: ist_done(st) }
    if b == 'e'                       // 'e' — next word end
        return Step { ed: repeat_word(ed, 2, cnt), st: ist_done(st) }
    if b == 'W'                       // 'W' — next WORD start (whitespace-delimited)
        return Step { ed: repeat_word(ed, 3, cnt), st: ist_done(st) }
    if b == 'B'                       // 'B' — previous WORD start
        return Step { ed: repeat_word(ed, 4, cnt), st: ist_done(st) }
    if b == 'E'                       // 'E' — next WORD end
        return Step { ed: repeat_word(ed, 5, cnt), st: ist_done(st) }
    if b == '0'                       // '0' — first column
        return Step { ed: clamp(Editor { lines: ed.lines, cy: ed.cy, cx: 0 }), st: ist_done(st) }
    if b == '$'                       // '$' — end of line
        return Step { ed: clamp(Editor { lines: ed.lines, cy: ed.cy, cx: util.u8_last(line_at(ed, ed.cy)) }), st: ist_done(st) }
    if b == '^'                       // '^' — first non-blank
        return Step { ed: clamp(Editor { lines: ed.lines, cy: ed.cy, cx: first_nonblank(line_at(ed, ed.cy)) }), st: ist_done(st) }
    if b == '}'                       // '}' — next paragraph (blank line)
        return Step { ed: clamp(Editor { lines: ed.lines, cy: para_fwd(ed, cnt), cx: 0 }), st: ist_done(st) }
    if b == '{'                       // '{' — previous paragraph (blank line)
        return Step { ed: clamp(Editor { lines: ed.lines, cy: para_bwd(ed, cnt), cx: 0 }), st: ist_done(st) }
    if b == 'g'                       // 'g' — await second g
        return Step { ed: ed, st: InputState { count: st.count, pending: 1, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'd'                       // 'd' — await operator target (dd)
        return Step { ed: ed, st: InputState { count: st.count, pending: 2, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'y'                       // 'y' — await operator target (yy)
        return Step { ed: ed, st: InputState { count: st.count, pending: 3, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'p'                       // 'p' — paste after
        return Step { ed: paste(ed, st, true), st: ist_done(st) }
    if b == 'P'                       // 'P' — paste before
        return Step { ed: paste(ed, st, false), st: ist_done(st) }
    if b == 'n'                       // 'n' — repeat search forward
        return Step { ed: find_next(ed, st.search, true), st: ist_done(st) }
    if b == 'N'                       // 'N' — repeat search backward
        return Step { ed: find_next(ed, st.search, false), st: ist_done(st) }
    if b == '*' or b == '#'          // '*' / '#' — search the word under the cursor
        let w = word_under_cursor(ed)
        if str.len(w) == 0
            return Step { ed: ed, st: ist_done(st) }
        return Step { ed: find_next(ed, w, b == '*'), st: ist_set_search(st, w) }
    if b == 'G'                       // 'G' — go to line (count or last)
        let tgt = if st.count > 0 then st.count - 1 else list.len(ed.lines) - 1
        return Step { ed: move_rows(ed, tgt), st: ist_done(st) }
    if b == '%'                       // '%' — jump to the matching bracket
        return Step { ed: match_pair(ed), st: ist_done(st) }
    if b == 'R'                       // 'R' — enter Replace (overtype) mode
        return Step { ed: ed, st: InputState { count: 0, pending: 0, mode: 4, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    // Insert-mode entry.  Position the cursor (insert-clamped so
    // it may sit at end-of-line) and switch to Insert.
    if b == 'i'                       // 'i' — insert before cursor
        return Step { ed: ed, st: ist_insert(st) }
    if b == 'a'                       // 'a' — append after cursor
        return Step { ed: clamp_insert(Editor { lines: ed.lines, cy: ed.cy, cx: util.u8_next(line_at(ed, ed.cy), ed.cx) }), st: ist_insert(st) }
    if b == 'I'                     // 'I' — insert at first non-blank
        return Step { ed: Editor { lines: ed.lines, cy: ed.cy, cx: first_nonblank(line_at(ed, ed.cy)) }, st: ist_insert(st) }
    if b == 'A'                       // 'A' — append at end of line
        return Step { ed: Editor { lines: ed.lines, cy: ed.cy, cx: str.len(line_at(ed, ed.cy)) }, st: ist_insert(st) }
    if b == 'o'                       // 'o' — open line below
        return Step { ed: open_line(ed, true), st: ist_insert(st) }
    if b == 'O'                       // 'O' — open line above
        return Step { ed: open_line(ed, false), st: ist_insert(st) }
    // Deletes.
    if b == 'x'                       // 'x' — delete char(s) under cursor (→ register)
        let xl = line_at(ed, ed.cy)
        let xhi = util.u8_fwd(xl, ed.cx, cnt)
        return Step { ed: repeat_delete_char(ed, cnt), st: ist_reg_cw(st, str.slice(xl, ed.cx, xhi), false) }
    if b == 'D'                       // 'D' — delete to end of line (→ register)
        let dl = line_at(ed, ed.cy)
        return Step { ed: delete_to_eol(ed), st: ist_reg_cw(st, str.slice(dl, ed.cx, str.len(dl)), false) }
    if b == 'X'                       // 'X' — delete char(s) before the cursor (→ register)
        let xline = line_at(ed, ed.cy)
        let lo = util.u8_back(xline, ed.cx, cnt)
        let nls = set_line(ed.lines, ed.cy, str.slice(xline, 0, lo) + str.slice(xline, ed.cx, str.len(xline)))
        return Step { ed: clamp(Editor { lines: nls, cy: ed.cy, cx: lo }), st: ist_reg_cw(st, str.slice(xline, lo, ed.cx), false) }
    if b == 'Y'                       // 'Y' — yank line(s) (= yy)
        return apply_linewise_op(ed, st, 'y', ed.cy + (if cnt > 1 then cnt - 1 else 0))
    if b == 'S'                       // 'S' — change whole line(s) (= cc)
        return apply_linewise_op(ed, st, 'c', ed.cy + (if cnt > 1 then cnt - 1 else 0))
    if b == '\x01'                       // Ctrl-A — increment the number
        return Step { ed: op_incdec(ed, cnt), st: ist_done(st) }
    if b == '\x18'                       // Ctrl-X — decrement the number
        return Step { ed: op_incdec(ed, 0 - cnt), st: ist_done(st) }
    // Visual mode entry: anchor the selection at the cursor.  A
    // count pre-extends the selection (`3v` = 3 chars, `2V` = 2 lines).
    if b == 'v'                       // 'v' — charwise visual
        let ne = clamp(Editor { lines: ed.lines, cy: ed.cy, cx: util.u8_fwd(line_at(ed, ed.cy), ed.cx, cnt - 1) })
        return Step { ed: ne, st: InputState { count: 0, pending: 0, mode: 2, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: ed.cy, avx: ed.cx } }
    if b == 'V'                       // 'V' — linewise visual
        let ne = move_rows(ed, ed.cy + cnt - 1)
        return Step { ed: ne, st: InputState { count: 0, pending: 0, mode: 3, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: ed.cy, avx: ed.cx } }
    if b == '\x16'                    // Ctrl-V — blockwise visual (column selection)
        return Step { ed: ed, st: InputState { count: 0, pending: 0, mode: 5, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: ed.cy, avx: ed.cx } }
    // Char-level edits.
    if b == '~'                       // '~' — toggle case (count chars), advance
        return Step { ed: op_toggle_case(ed, cnt), st: ist_done(st) }
    if b == 'J'                       // 'J' — join line(s) with a space
        return Step { ed: op_join_lines(ed, cnt, true), st: ist_done(st) }
    if b == 'r'                       // 'r' — await the replacement byte
        return Step { ed: ed, st: InputState { count: st.count, pending: 4, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == '>'                       // '>' — await second '>' (indent right)
        return Step { ed: ed, st: InputState { count: st.count, pending: 5, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == '<'                       // '<' — await second '<' (indent left)
        return Step { ed: ed, st: InputState { count: st.count, pending: 6, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    // Operator + motion: c awaits a motion (like d/y); f/F/t/T
    // await a target char.
    if b == 'c'                       // 'c' — change operator (awaits motion)
        return Step { ed: ed, st: InputState { count: st.count, pending: 7, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'f'                       // 'f' — find char forward
        return Step { ed: ed, st: InputState { count: st.count, pending: 8, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'F'                       // 'F' — find char backward
        return Step { ed: ed, st: InputState { count: st.count, pending: 9, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 't'                       // 't' — till char forward
        return Step { ed: ed, st: InputState { count: st.count, pending: 10, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'T'                       // 'T' — till char backward
        return Step { ed: ed, st: InputState { count: st.count, pending: 11, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'C'                       // 'C' — change to end of line
        let cline = line_at(ed, ed.cy)
        let tail = str.slice(cline, ed.cx, str.len(cline))
        let nls = set_line(ed.lines, ed.cy, str.slice(cline, 0, ed.cx))
        return Step { ed: clamp_insert(Editor { lines: nls, cy: ed.cy, cx: ed.cx }), st: ist_reg_cw(st, tail, true) }
    if b == 's'                       // 's' — substitute char(s): delete then insert
        let sline = line_at(ed, ed.cy)
        let sl = str.len(sline)
        let shi = util.u8_fwd(sline, ed.cx, cnt)
        let sremoved = str.slice(sline, ed.cx, shi)
        let snls = set_line(ed.lines, ed.cy, str.slice(sline, 0, ed.cx) + str.slice(sline, shi, sl))
        return Step { ed: clamp_insert(Editor { lines: snls, cy: ed.cy, cx: ed.cx }), st: ist_reg_cw(st, sremoved, true) }
    Step { ed: ed, st: ist_done(st) }     // unknown — reset

// ── Ex command line ─────────────────────────────────────────────
// Ex-command parsing — ExResult / exec_ex, the `is_*` / `*_arg` / `*_kind`
// classifiers, and the `:s` / `:g` predicates — lives in excmd.nv.  The
// Editor-typed appliers (ex_substitute / ex_goto / ex_global) stay here.

// ── :s substitute ────────────────────────────────────────────
// `:s/pat/repl/[g]` on the current line, `:%s/pat/repl/[g]` on every line; the
// pattern is a vim-magic-subset regex (nvregex).  `g` replaces every occurrence
// on a line, else just the first.

@intent("""Apply a `:s` / `:%s` substitution and return the new editor.  Honours
the leading `%` (whole buffer vs current line), any delimiter, and the `g`
(global-in-line) flag; the pattern is a vim-magic-subset regex and the
replacement supports `&` (whole match) and `\\1`-`\\9` backrefs.""")
fn ex_substitute(ed: Editor, cmd: Str) -> Editor
    let c = str.trim(cmd)
    let alllines = (str.byte_at(c, 0) ?? 0) == '%'
    let p = if alllines then 1 else 0
    let delim = str.byte_at(c, p + 1) ?? 0
    let body = str.slice(c, p + 2, str.len(c))                  // after "s<delim>"
    let d1 = util.index_of_byte(body, delim)
    let pat = if d1 < 0 then body else str.slice(body, 0, d1)
    let after1 = if d1 < 0 then "" else str.slice(body, d1 + 1, str.len(body))
    let d2 = util.index_of_byte(after1, delim)
    let repl = if d2 < 0 then after1 else str.slice(after1, 0, d2)
    let flags = if d2 < 0 then "" else str.slice(after1, d2 + 1, str.len(after1))
    let global = util.index_of_byte(flags, 'g') >= 0                // 'g'
    let atoms = nvregex.re_compile(pat)
    if alllines
        var ls: [Str] = []
        let total = list.len(ed.lines)
        let mut i = 0
        while i < total
            ls = list.append(ls, [nvregex.re_replace_line(atoms, ed.lines[i], repl, global)])
            i = i + 1
        clamp(Editor { lines: ls, cy: ed.cy, cx: 0 })
    else
        clamp(Editor { lines: set_line(ed.lines, ed.cy, nvregex.re_replace_line(atoms, line_at(ed, ed.cy), repl, global)), cy: ed.cy, cx: 0 })

// ── :g / :v global delete ────────────────────────────────────
// `:g/pat/d` deletes every line containing `pat`; `:v/pat/d` (or `:g!/pat/d`)
// deletes every line NOT containing it.  Only the `d` command is supported.

// ── :N goto-line ─────────────────────────────────────────────
// `:N` (a line number) or `:$` (last line) moves the cursor to that line's
// first non-blank.  Driver-level, like :s / :g.

// True if any buffer has unsaved changes (active vs disk, or a stored buffer
// vs its saved text).  Used by the `:q` guard.
fn buffers_modified(bt: [Str], bd: [Str], cur: Int, atext: Str, adisk: Str) -> Bool
    if atext != adisk
        return true
    var i = 0
    while i < list.len(bt)
        if i != cur and bt[i] != bd[i]
            return true
        i = i + 1
    false

// What `:wa` did, separated from what it says.  `wrote` counts writes
// that LANDED; `failed` counts the ones that did not, and `first_fail`
// names one of them for the status line.  Counting attempts instead is
// what let `:wa` report "wrote 3 buffer(s)" for three writes that never
// reached the disk, and `:wqa` then quit on that count.
struct WriteAll
    wrote: Int
    failed: Int
    first_fail: Str

// Write every modified buffer to disk.  The active buffer's live copy is
// `ed` (vs `adisk`); stored buffers compare their joined text to their
// saved text.
fn write_all_bufs(paths: [Str], texts: [Str], disks: [Str], cur: Int, ed: Editor, adisk: Str) -> WriteAll [fs]
    var wrote = 0
    var failed = 0
    var first_fail = ""
    var i = 0
    let nb = list.len(paths)
    while i < nb
        var attempted = false
        var ok = true
        if i == cur
            if buf_text(ed) != adisk
                attempted = true
                ok = save_buf(paths[i], ed.lines)
        else
            if texts[i] != disks[i]
                attempted = true
                ok = save_buf_text(paths[i], texts[i])
        if attempted
            if ok
                wrote = wrote + 1
            else
                failed = failed + 1
                if str.len(first_fail) == 0
                    first_fail = paths[i]
        i = i + 1
    WriteAll { wrote: wrote, failed: failed, first_fail: first_fail }

// Apply a `:s`/`:%s` substitution to newline-joined buffer text (for `:bufdo`
// over a stored, non-active buffer).  Editor construction stays in this shallow
// helper to keep the struct-after-call shape out of the deep dispatch nesting.
fn sub_text(text: Str, sub: Str) -> Str
    let plines = str.split_lines(text)
    let bed = ex_substitute(Editor { lines: plines, cy: 0, cx: 0 }, sub)
    buf_text(bed)

// Append a whole-buffer undo record (pre-change text) to a serialized undo
// stack — lets `:bufdo` edits on stored buffers stay undoable after a switch.
fn undo_push_text(serial_undo: Str, pretext: Str) -> Str
    let plines = str.split_lines(pretext)
    serial_undo + snap_ser(Snapshot { lines: plines, cy: 0, cx: 0 })

// Mark every buffer clean (saved-text := current-text) after a write-all.
fn mark_all_saved(texts: [Str], disks: [Str]) -> [Str]
    var d = disks[:]
    var i = 0
    while i < list.len(texts)
        d = util.set_str_at(d, i, texts[i])
        i = i + 1
    d

// A one-line buffer list for `:ls`, marking the current with [..].
// Render the `:ls` buffer-list overlay over the top rows; the current buffer is
// marked with `>`.  Dismissed by the next keypress (the normal render repaints).
// Truncate or space-pad `s` to exactly `w` columns (overlay rows must fully
// cover what's beneath them).
fn pad_to(s: Str, w: Int) -> Str
    let n = str.len(s)
    if n >= w then str.slice(s, 0, w) else s + disp.nspaces(w - n)

// A run of `n` horizontal box-drawing dashes.
fn hbar(n: Int) -> Str
    var s = ""
    var i = 0
    while i < n
        s = s + "─"
        i = i + 1
    s

// Top border with a centered title: `┌── Title ──┐` (w display columns).
fn box_top(title: Str, w: Int) -> Str
    let tl = str.len(title) + 2
    let fill = w - 2 - tl
    let lf = if fill > 0 then fill / 2 else 0
    let rf = if fill > 0 then fill - lf else 0
    "┌" + hbar(lf) + " " + title + " " + hbar(rf) + "┐"

fn box_bot(w: Int) -> Str
    "└" + hbar(w - 2) + "┘"

// The picker's results-list height (interior rows) for a terminal of `rows`:
// total overlay = results box (list + 2 border rows) + a 3-row prompt box.
fn picker_maxh(rows: Int) -> Int
    let oh = if rows - 4 < 20 then rows - 4 else 20
    if oh - 5 > 0 then oh - 5 else 1

// The rank sitting on the window's far edge, so the drawn rows are ranks
// [off, off+maxh) and the selection is always one of them.  Derived from the
// selection rather than carried as state: a source may grow its candidate list
// while the picker is open (`:grep` streams rows in as rg produces them), and a
// stored offset would then point into a list that has re-ranked underneath it.
fn picker_off(sel: Int, maxh: Int) -> Int
    if sel >= maxh then sel - maxh + 1 else 0

// Ranks [off, off+maxh) of `ranked` — exactly the rows the overlay draws.
fn picker_window(ranked: [Int], off: Int, maxh: Int) -> [Int]
    var out: [Int] = []
    var i = if off > 0 then off else 0
    let hi = off + maxh
    while i < list.len(ranked) and i < hi
        out = list.push(out, ranked[i])
        i = i + 1
    out

@intent("""Draw the interactive picker overlay, telescope style: a bordered
Results box (title centered in the top border) with the fuzzy-ranked rows drawn
BOTTOM-UP — the best of them sits on the bottom interior row, adjacent to the
prompt — and the selection in reverse video with a `>` marker; below it a
bordered 3-row prompt box carrying the source title, the `> query` line, and a
right-aligned `nmatch / total` counter.  Parks the terminal cursor at the prompt
insertion point.  Modal: the driver routes all input here while active.

`top_idx` is the VISIBLE window of ranked candidate indices (picker_window), not
the whole ranking, and `sel` indexes into that window — so the list scrolls past
a screenful while every drawn row stays a real candidate.""")
fn draw_picker(cands: [Str], marks: [Str], top_idx: [Int], sel: Int, query: Str, nmatch: Int, total: Int, title: Str, rows: Int, cols: Int, cs: colorscheme.Colorscheme) [io]
    let selcol = colorscheme.sel_sgr(cs)   // same slot the buffer's Visual selection uses
    let h = list.len(top_idx)
    let maxh = picker_maxh(rows)
    let boxw = if cols - 8 < 90 then cols - 8 else 90
    let iw = boxw - 2                        // interior width
    let x0 = (cols - boxw) / 2 + 1
    let y0 = 2
    // ── results box ──
    cup(y0, x0)
    emit(box_top("Results", boxw))
    var ri = 0
    while ri < maxh
        // interior row `ri` counted from the BOTTOM: rank ri sits at
        // y0 + maxh - ri; rows above the ranked count render blank.
        cup(y0 + maxh - ri, x0)
        emit("│")
        if ri < h
            let row = (if ri == sel then "> " else "  ") + marks[top_idx[ri]] + cands[top_idx[ri]]
            if ri == sel
                sgr(selcol)
            emit(pad_to(row, iw))
            if ri == sel
                sgr("0")
        else
            emit(disp.nspaces(iw))
        emit("│")
        ri = ri + 1
    cup(y0 + maxh + 1, x0)
    emit(box_bot(boxw))
    // ── prompt box ──
    let yp = y0 + maxh + 2
    cup(yp, x0)
    emit(box_top(title, boxw))
    cup(yp + 1, x0)
    emit("│")
    let counter = str.from_int(nmatch) + " / " + str.from_int(total)
    let ptext = "> " + query
    let gap = iw - str.len(ptext) - str.len(counter) - 1
    if gap >= 1
        emit(ptext + disp.nspaces(gap) + counter + " ")
    else
        emit(pad_to(ptext, iw))
    emit("│")
    cup(yp + 2, x0)
    emit(box_bot(boxw))
    cup(yp + 1, x0 + 3 + str.len(query))

fn draw_buflist(paths: [Str], cur: Int, rows: Int) [io]
    var bi = 0
    var shown = 0                       // the `[help]` buffer is unlisted
    let maxn = if rows - 2 > 0 then rows - 2 else 1
    while bi < list.len(paths) and shown < maxn
        if paths[bi] != exhelp.help_path()
            cup(shown + 1, 1)
            csi()
            emit("K")
            let mark = if bi == cur then "> " else "  "
            emit(mark + str.from_int(bi + 1) + "  " + util.basename_of(paths[bi]))
            shown = shown + 1
        bi = bi + 1
    cup(shown + 1, 1)
    csi()
    emit("K")
    emit("-- :b <n> to switch · any key to dismiss --")

fn ex_goto(ed: Editor, cmd: Str) -> Editor
    let c = str.trim(cmd)
    let nl = list.len(ed.lines)
    var target = nl - 1
    if c != "$"
        var v = 0
        var i = 0
        let n = str.len(c)
        while i < n
            v = v * 10 + ((str.byte_at(c, i) ?? 0) - '0')
            i = i + 1
        target = v - 1                      // :N is 1-indexed
    if target < 0
        target = 0
    if target > nl - 1
        target = nl - 1
    clamp(Editor { lines: ed.lines, cy: target, cx: first_nonblank(line_at(ed, target)) })

@intent("""Apply a `:g/pat/d` family command: delete every line matching `pat`
(`:g!`/`:v` invert to delete non-matching lines).  The pattern is the same
vim-magic-subset regex used by search and `:s`.""")
fn ex_global(ed: Editor, cmd: Str) -> Editor
    let c = str.trim(cmd)
    let c0 = str.byte_at(c, 0) ?? 0
    let bang = c0 == 'g' and (str.byte_at(c, 1) ?? 0) == '!'
    let invert = c0 == 'v' or bang                            // v / g! → keep matching
    let p = if bang then 2 else 1
    let delim = str.byte_at(c, p) ?? 0
    let body = str.slice(c, p + 1, str.len(c))
    let d1 = util.index_of_byte(body, delim)
    let pat = if d1 < 0 then body else str.slice(body, 0, d1)
    let cmdpart = if d1 < 0 then "" else str.trim(str.slice(body, d1 + 1, str.len(body)))
    if cmdpart != "d" or str.len(pat) == 0
        return ed                                             // only :…/d supported
    let atoms = nvregex.re_compile(pat)
    var ls: [Str] = []
    let total = list.len(ed.lines)
    let mut i = 0
    while i < total
        let matches = nvregex.re_matches_line(atoms, ed.lines[i])
        let keep = if invert then matches else not matches
        if keep
            ls = list.append(ls, [ed.lines[i]])
        i = i + 1
    if list.len(ls) == 0
        ls = list.append(ls, [""])                            // buffer keeps one line
    var ncy = ed.cy
    if ncy >= list.len(ls)
        ncy = list.len(ls) - 1
    clamp(Editor { lines: ls, cy: ncy, cx: 0 })

// Byte-wise lexicographic `a < b` (a prefix sorts before its extension).
fn str_lt(a: Str, b: Str) -> Bool
    let la = str.len(a)
    let lb = str.len(b)
    let n = if la < lb then la else lb
    var i = 0
    while i < n
        let ca = str.byte_at(a, i) ?? 0
        let cb = str.byte_at(b, i) ?? 0
        if ca != cb
            return ca < cb
        i = i + 1
    la < lb

// First (optionally `-`-signed) decimal integer in `s`; 0 if the line has no
// digit.  Used by `:sort n` — matches vim's "sort by the first number" rule.
fn parse_first_int(s: Str) -> Int
    let n = str.len(s)
    var i = 0
    while i < n and not ((str.byte_at(s, i) ?? 0) >= '0' and (str.byte_at(s, i) ?? 0) <= '9')
        i = i + 1
    if i >= n
        return 0
    let neg = i > 0 and (str.byte_at(s, i - 1) ?? 0) == '-'
    var v = 0
    while i < n and (str.byte_at(s, i) ?? 0) >= '0' and (str.byte_at(s, i) ?? 0) <= '9'
        v = v * 10 + ((str.byte_at(s, i) ?? 0) - '0')
        i = i + 1
    if neg then 0 - v else v

// Comparator for `:sort n` / `:sort i`: numeric by first integer (lexicographic
// tie-break), else case-folded lexicographic, else plain lexicographic.
fn line_lt(a: Str, b: Str, numeric: Bool, icase: Bool) -> Bool
    if numeric
        let ka = parse_first_int(a)
        let kb = parse_first_int(b)
        if ka != kb then ka < kb else str_lt(a, b)
    elif icase
        str_lt(str.lower(a), str.lower(b))
    else
        str_lt(a, b)

// Two lines share a sort key (for the `u` dedup) under the active mode.
fn same_key(a: Str, b: Str, numeric: Bool, icase: Bool) -> Bool
    if numeric
        parse_first_int(a) == parse_first_int(b)
    elif icase
        str.lower(a) == str.lower(b)
    else
        a == b

// Stable selection sort by `line_lt` — used only for the `n` / `i` modes (the
// plain/reverse path uses the faster builtin `list.sort`).  O(n²); fine for
// editor buffers, a decorate-sort speedup is a noted follow-on.
fn csort(lines: [Str], numeric: Bool, icase: Bool) -> [Str]
    let n = list.len(lines)
    var used: [Bool] = []
    var k = 0
    while k < n
        used = list.push(used, false)
        k = k + 1
    var out: [Str] = []
    var produced = 0
    while produced < n
        var best = 0 - 1
        var j = 0
        while j < n
            if not used[j] and (best < 0 or line_lt(lines[j], lines[best], numeric, icase))
                best = j
            j = j + 1
        used = util.set_bool_at(used, best, true)
        out = list.push(out, lines[best])
        produced = produced + 1
    out

// Sort + reverse + dedup a block of lines under the active flags (shared by the
// whole-buffer and range paths of `:sort`).
// `lines` is the caller's list (the buffer the undo history still holds),
// so the builtin sort runs on a copy.
fn sort_apply(lines: [Str], rev: Bool, uniq: Bool, numeric: Bool, icase: Bool) -> [Str]
    let base = if numeric or icase then csort(lines, numeric, icase) else list.sort(list.clone(lines))
    let n = list.len(base)
    var ls: [Str] = []
    var i = 0
    while i < n
        let idx = if rev then n - 1 - i else i
        let line = base[idx]
        // unique: skip a line whose key matches the previous kept one — equal
        // keys are adjacent in sorted order (and stay adjacent when reversed).
        let dup = uniq and list.len(ls) > 0 and same_key(ls[list.len(ls) - 1], line, numeric, icase)
        if not dup
            ls = list.push(ls, line)
        i = i + 1
    ls

@intent("""Sort the buffer's lines (`:sort`), or just a line range (`:%sort`,
`:2,5sort`, `:.,$sort`).  `:sort!` reverses; `u` drops duplicates; `n` sorts by
the first number; `i` is case-insensitive.  Cursor lands on the first sorted
line.""")
fn ex_sort(ed: Editor, cmd: Str, vlo: Int, vhi: Int) -> Editor
    let nl = list.len(ed.lines)
    let rs = excmd.parse_range(cmd, vlo, vhi, ed.cy, nl)
    let fl = excmd.sort_flags(rs.body)
    let rev = fl[0] == 1
    let uniq = fl[1] == 1
    let numeric = fl[2] == 1
    let icase = fl[3] == 1
    if rs.has
        // Sort only lines[rs.lo .. rs.hi]; splice the result back between the
        // untouched prefix and suffix.
        var seg: [Str] = []
        var s = rs.lo
        while s <= rs.hi
            seg = list.push(seg, ed.lines[s])
            s = s + 1
        let sorted_seg = sort_apply(seg, rev, uniq, numeric, icase)
        var ls: [Str] = []
        var p = 0
        while p < rs.lo
            ls = list.push(ls, ed.lines[p])
            p = p + 1
        var q = 0
        while q < list.len(sorted_seg)
            ls = list.push(ls, sorted_seg[q])
            q = q + 1
        var r = rs.hi + 1
        while r < nl
            ls = list.push(ls, ed.lines[r])
            r = r + 1
        if list.len(ls) == 0
            ls = list.push(ls, "")
        clamp(Editor { lines: ls, cy: rs.lo, cx: 0 })
    else
        var ls = sort_apply(ed.lines, rev, uniq, numeric, icase)
        if list.len(ls) == 0
            ls = list.push(ls, "")           // buffer always keeps one line
        clamp(Editor { lines: ls, cy: 0, cx: 0 })

// Append the block lines `blk` to `ls` (helper for ex_linemove's splice).
fn push_block(ls: [Str], blk: [Str]) -> [Str]
    var out = ls[:]
    var i = 0
    let n = list.len(blk)
    while i < n
        out = list.push(out, blk[i])
        i = i + 1
    out

@intent("""Apply `:move` (copy=false) / `:copy` (copy=true) of a line range to
after the resolved target address.  With no range it is the current line; with a
range (`:2,5m0`, `:'<,'>t$`) the whole block moves/copies.  Move can't relocate
a range into itself (no-op).  Cursor lands on the first moved/copied line.""")
fn ex_linemove(ed: Editor, cmd: Str, copy: Bool, vlo: Int, vhi: Int) -> Editor
    let nl = list.len(ed.lines)
    let rs = excmd.parse_range(cmd, vlo, vhi, ed.cy, nl)
    let lo = if rs.has then rs.lo else ed.cy
    let hi = if rs.has then rs.hi else ed.cy
    var tgt = excmd.move_addr(rs.body, ed.cy, nl)
    if tgt < 0 - 1
        tgt = 0 - 1                          // clamp to "before first line"
    if tgt > nl - 1
        tgt = nl - 1
    let cnt = hi - lo + 1
    var blk: [Str] = []
    var bi = lo
    while bi <= hi
        blk = list.push(blk, ed.lines[bi])
        bi = bi + 1
    if copy
        var ls: [Str] = []
        if tgt < 0
            ls = push_block(ls, blk)         // copy to the very top
        var i = 0
        while i < nl
            ls = list.push(ls, ed.lines[i])
            if i == tgt
                ls = push_block(ls, blk)
            i = i + 1
        let ncy = if tgt < 0 then 0 else tgt + 1
        clamp(Editor { lines: ls, cy: ncy, cx: first_nonblank(blk[0]) })
    elif tgt >= lo - 1 and tgt <= hi
        ed                                   // can't move a range into itself (`:m .`)
    else
        var ls: [Str] = []
        if tgt < 0
            ls = push_block(ls, blk)         // move to the very top
        var i = 0
        while i < nl
            if i < lo or i > hi
                ls = list.push(ls, ed.lines[i])
            if i == tgt
                ls = push_block(ls, blk)
            i = i + 1
        // Moving up (tgt<lo): block lands at tgt+1.  Moving down (tgt>hi):
        // removing the block first shifts the target up by `cnt`.
        let ncy = if tgt < 0 then 0 elif tgt < lo then tgt + 1 else tgt - cnt + 1
        clamp(Editor { lines: ls, cy: ncy, cx: first_nonblank(blk[0]) })

@intent("""`:d` / `:delete` — delete a line range (the current line with no
range; `:2,5d` / `:'<,'>d` a block).  Cursor settles on the line that follows
the deleted block.  The buffer always keeps at least one line.""")
fn ex_delete(ed: Editor, cmd: Str, vlo: Int, vhi: Int) -> Editor
    let nl = list.len(ed.lines)
    let rs = excmd.parse_range(cmd, vlo, vhi, ed.cy, nl)
    let lo = if rs.has then rs.lo else ed.cy
    let hi = if rs.has then rs.hi else ed.cy
    var ls: [Str] = []
    var i = 0
    while i < nl
        if i < lo or i > hi
            ls = list.push(ls, ed.lines[i])
        i = i + 1
    if list.len(ls) == 0
        ls = list.push(ls, "")
    var ncy = lo
    if ncy > list.len(ls) - 1
        ncy = list.len(ls) - 1
    clamp(Editor { lines: ls, cy: ncy, cx: 0 })

@intent("""`:>` / `:<` — shift a line range right/left by one indent level
(repeatable: `:>>` is two).  No range → the current line; `:2,5>` / `:'<,'>>` a
block.  Reuses indent_one/dedent_one so it honours the same tab/space rule as
`>>`.""")
// One indent level with expandtab awareness: `et` inserts `ts` spaces, else a
// hard tab (indent_one).  Blank lines are left alone either way.
fn indent_one_et(line: Str, et: Bool, ts: Int) -> Str
    if str.len(line) == 0
        line
    elif et
        disp.nspaces(ts) + line
    else
        indent_one(line)

// Remove one indent level: a leading tab, or up to `ts` leading spaces.
fn dedent_one_et(line: Str, ts: Int) -> Str
    let n = str.len(line)
    if n == 0
        return line
    if (str.byte_at(line, 0) ?? 0) == '\t'
        return str.slice(line, 1, n)
    var k = 0
    while k < ts and k < n and (str.byte_at(line, k) ?? 0) == ' '
        k = k + 1
    str.slice(line, k, n)

fn ex_shift(ed: Editor, cmd: Str, vlo: Int, vhi: Int, et: Bool, ts: Int) -> Editor
    let nl = list.len(ed.lines)
    let amt = excmd.shift_amount(cmd)
    let rs = excmd.parse_range(cmd, vlo, vhi, ed.cy, nl)
    let lo = if rs.has then rs.lo else ed.cy
    let hi = if rs.has then rs.hi else ed.cy
    let levels = if amt < 0 then 0 - amt else amt
    let right = amt > 0
    var ls: [Str] = []
    var i = 0
    while i < nl
        if i >= lo and i <= hi
            var line = ed.lines[i]
            var k = 0
            while k < levels
                line = if right then indent_one_et(line, et, ts) else dedent_one_et(line, ts)
                k = k + 1
            ls = list.push(ls, line)
        else
            ls = list.push(ls, ed.lines[i])
        i = i + 1
    clamp(Editor { lines: ls, cy: lo, cx: first_nonblank(ls[lo]) })

@intent("""`:retab` — replace each line's LEADING whitespace with spaces at the
current tabstop (a tab advances to the next `ts` multiple, so mixed tab/space
indents keep their visual width).  Bare `:retab` covers the whole buffer
(vim behaviour); a range (`:2,5retab`, `:'<,'>retab`) limits it.  Non-leading
tabs are left untouched.""")
fn ex_retab(ed: Editor, cmd: Str, vlo: Int, vhi: Int, ts: Int) -> Editor
    let nl = list.len(ed.lines)
    let rs = excmd.parse_range(cmd, vlo, vhi, ed.cy, nl)
    let lo = if rs.has then rs.lo else 0
    let hi = if rs.has then rs.hi else nl - 1
    var ls: [Str] = []
    var i = 0
    while i < nl
        if i >= lo and i <= hi
            let line = ed.lines[i]
            let n = str.len(line)
            var w = 0                        // visual width of the leading run
            var j = 0
            var scan = true
            while scan and j < n
                let c = str.byte_at(line, j) ?? 0
                if c == '\t'
                    w = w + (ts - w % ts)    // advance to the next tabstop
                    j = j + 1
                elif c == ' '
                    w = w + 1
                    j = j + 1
                else
                    scan = false
            ls = list.push(ls, disp.nspaces(w) + str.slice(line, j, n))
        else
            ls = list.push(ls, ed.lines[i])
        i = i + 1
    clamp(Editor { lines: ls, cy: ed.cy, cx: ed.cx })

// Serialise the line buffer to file text (one trailing newline per line).
fn buf_to_str(lines: [Str]) -> Str
    var s = ""
    let n = list.len(lines)
    let mut i = 0
    while i < n
        s = s + lines[i] + str.from_char('\n')
        i = i + 1
    s

// Returns whether the write landed.  An editor that reports a write it
// did not perform is a data-loss report, not a degradation, so every
// caller here checks: the status line says E212 instead of the
// confirmation, the buffer stays marked modified, and a `:wq` / `:wn`
// that was going to leave the file does not.
fn save_buf(path: Str, lines: [Str]) -> Bool [fs]
    fs.write(path, buf_to_str(lines))

// Save a buffer held as newline-joined text (a stored, non-active buffer) —
// splits to lines so the on-disk form matches `:w` (one trailing newline/line).
fn save_buf_text(path: Str, text: Str) -> Bool [fs]
    save_buf(path, str.split_lines(text))

// vim's message for a write that could not be opened.  Same code, same
// wording, because a novim user reaching for it will search for the
// vim one.
fn write_failed_msg(path: Str) -> Str
    "E212: can't open file for writing: " + path

// vim-style write confirmation for the status line: `"path" NL, NB written`.
fn wrote_msg(path: Str, lines: [Str]) -> Str
    let txt = buf_to_str(lines)
    str.from_char('"') + path + str.from_char('"') + " " + str.from_int(list.len(lines)) + "L, " + str.from_int(str.len(txt)) + "B written"

// ── Key-sequence decoding + keymaps ───────────────────

// Decode `\e`=Esc `\n`/`\r`=Enter `\t`=Tab `\b`=Backspace `\\`=backslash
// into their real bytes, returning a new string.  Used for both `--batch`
// key strings and `[keymaps]` right-hand sides.
// Hex digit value, or -1 if `b` isn't a hex digit.
fn hex_val(b: Int) -> Int
    if b >= '0' and b <= '9'
        b - '0'
    elif b >= 'a' and b <= 'f'
        b - 'a' + 10
    elif b >= 'A' and b <= 'F'
        b - 'A' + 10
    else
        0 - 1

fn decode_escapes(s: Str) -> Str
    var out = ""
    let n = str.len(s)
    let mut i = 0
    while i < n
        let b = str.byte_at(s, i) ?? 0
        if b == '\\' and i + 1 < n
            let nx = str.byte_at(s, i + 1) ?? 0
            if nx == 'e'
                out = out + str.from_char('\e')
                i = i + 2
            elif nx == 'n' or nx == 'r'
                out = out + str.from_char('\r')
                i = i + 2
            elif nx == 't'
                out = out + str.from_char('\t')
                i = i + 2
            elif nx == 'b'
                out = out + str.from_byte('\x7f')
                i = i + 2
            elif nx == '\\'
                out = out + str.from_char(92)
                i = i + 2
            elif nx == 'x' and i + 3 < n and hex_val(str.byte_at(s, i + 2) ?? 0) >= 0 and hex_val(str.byte_at(s, i + 3) ?? 0) >= 0
                out = out + str.from_byte(hex_val(str.byte_at(s, i + 2) ?? 0) * 16 + hex_val(str.byte_at(s, i + 3) ?? 0))
                i = i + 4
            else
                out = out + str.from_byte(b)
                i = i + 1
        else
            out = out + str.from_byte(b)
            i = i + 1
    out

// `--batch` has no clock, so it cannot tell an Alt chord from an Escape followed
// by a key by how soon the key comes.  It takes the spelling `\M<key>` for the
// chord (`\Ma` is Alt-a) and rewrites it to `\xff<key>`; the batch loop reads
// the 0xFF byte, which never occurs in UTF-8 text, and resolves the pair.  A
// plain `\e` followed by a key stays two keys.  `\T` is the same kind of mark
// for time: 'timeoutlen' passes with no key typed, so Insert-mode keys held as
// the start of a map (`a` of `aa`) are typed as they are; it is rewritten to
// `\xfe`.  An escaped backslash (`\\M`) is a backslash and an M.
fn batch_meta_marks(keys: Str) -> Str
    let sb = str.builder_new()
    let n = str.len(keys)
    var i = 0
    while i < n
        let b = str.byte_at(keys, i) ?? 0
        if b == '\\' and i + 1 < n
            let nx = str.byte_at(keys, i + 1) ?? 0
            if nx == 'M'
                str.builder_append(sb, "\\xff")
            elif nx == 'T'
                str.builder_append(sb, "\\xfe")
            else
                str.builder_append_char(sb, b)
                str.builder_append_char(sb, nx)
            i = i + 2
        else
            str.builder_append_char(sb, b)
            i = i + 1
    let out = str.builder_to_str(sb)
    str.builder_drop(sb)
    out

// `--batch` reads the kitty keyboard protocol's key report too, spelled as the
// terminal sends it (`\e[91;3u` is Alt-[, `\e[27u` is Escape).  At `i`, an ESC
// of `s`, the report that starts there as `[code, mods, length]` (mods is 1 when
// the report has none), or `[]` when what follows is not `[ digits (; digits) u`.
fn batch_csi_u(s: Str, i: Int) -> [Int]
    var j = i + 1
    if (str.byte_at(s, j) ?? 0) != '['
        return []
    j = j + 1
    var cp = 0
    var digits = 0
    while (str.byte_at(s, j) ?? 0) >= '0' and (str.byte_at(s, j) ?? 0) <= '9'
        cp = cp * 10 + ((str.byte_at(s, j) ?? 0) - '0')
        digits = digits + 1
        j = j + 1
    if digits == 0
        return []
    var mods = 1
    if (str.byte_at(s, j) ?? 0) == ';'
        j = j + 1
        mods = 0
        digits = 0
        while (str.byte_at(s, j) ?? 0) >= '0' and (str.byte_at(s, j) ?? 0) <= '9'
            mods = mods * 10 + ((str.byte_at(s, j) ?? 0) - '0')
            digits = digits + 1
            j = j + 1
        if digits == 0
            return []
    if (str.byte_at(s, j) ?? 0) != 'u'
        return []
    [cp, mods, j + 1 - i]

// A user keymap: the Normal-mode key sequence `lhs[i]` (a byte string — one
// byte for a single-key remap, several for a multi-key one like `<leader>w`,
// `vv`, `;p`) is replaced by the already-decoded `rhs[i]`.  Single-byte LHS are
// applied inside `feed` (feed_mapped); multi-byte LHS are matched by the
// driver's prefix-buffer (run_interactive), since they need to span keystrokes.
// A user keymap.  `kmode[i]` is the mode class the map applies in: 0 = Normal,
// 1 = Visual (charwise/linewise/block).  Single-byte Normal LHS are also applied
// inside `feed` (feed_mapped); the driver's prefix-buffer matches everything.
struct Keymap
    lhs:   [Str]
    rhs:   [Str]
    kmode: [Int]

fn keymap_empty() -> Keymap
    Keymap { lhs: [], rhs: [], kmode: [] }

// The remapped sequence for a single Normal-mode byte `b` (SINGLE-byte LHS), or
// "" — used by feed_mapped + key_free; multi-byte maps are the driver's job.
fn keymap_lookup(km: Keymap, b: Int) -> Str
    let n = list.len(km.lhs)
    let mut i = 0
    while i < n
        if km.kmode[i] == 0 and str.len(km.lhs[i]) == 1 and (str.byte_at(km.lhs[i], 0) ?? 0) == b
            return km.rhs[i]
        i = i + 1
    ""

// Index of the LHS in mode class `mclass` that exactly equals `s`, or -1.  The
// driver matcher owns ALL maps in interactive mode (single- and multi-byte) so a
// remapped RHS that needs driver-level handling — `:vsplit<CR>`, `<C-d>zz`,
// `>gv` — is re-fed through the full dispatch, not just `feed`.
fn keymap_seq_idx(km: Keymap, s: Str, mclass: Int) -> Int
    var i = 0
    while i < list.len(km.lhs)
        if km.kmode[i] == mclass and km.lhs[i] == s and not is_alt_lhs(km.lhs[i])
            return i
        i = i + 1
    0 - 1

// True if `s` is a strict prefix of some LHS in mode class `mclass` (more keys
// could still complete a mapping) — the signal to keep buffering.  An Alt chord
// is not a sequence typed over time, so its ESC does not count as a prefix: a
// lone Escape must not wait for a key.  That holds for `ESC [` too (Alt-[, which
// only a terminal with the kitty keyboard protocol can send apart from a cursor
// key): counted as a prefix, it would hold every Escape typed in Insert mode.
fn keymap_is_prefix(km: Keymap, s: Str, mclass: Int) -> Bool
    let sn = str.len(s)
    var i = 0
    while i < list.len(km.lhs)
        let l = km.lhs[i]
        if km.kmode[i] == mclass and not is_alt_lhs(l)
            if str.len(l) > sn and str.slice(l, 0, sn) == s
                return true
        i = i + 1
    false

// True for the LHS of an Alt chord: ESC and one more byte, which is not `[`
// (that starts a cursor or function key sequence).  `ESC O` is a chord too,
// though it starts a function-key sequence as well; the loop tells them apart.
fn is_chord_lhs(l: Str) -> Bool
    str.len(l) == 2 and (str.byte_at(l, 0) ?? 0) == '\e' and (str.byte_at(l, 1) ?? 0) != '['

// True for any two-byte LHS made of ESC and one key, `ESC [` included.  `ESC [`
// is not matched as an ESC-led chord (it opens a cursor-key sequence), but it is
// the Alt-[ chord all the same, which a terminal with the kitty keyboard
// protocol reports unambiguously.
fn is_alt_lhs(l: Str) -> Bool
    str.len(l) == 2 and (str.byte_at(l, 0) ?? 0) == '\e'

// ── Alt chords ──────────────────────────────────────────────────────────────
// A terminal sends Alt and a key as ESC followed by the key (xterm's
// metaSendsEscape, the default in the other terminals as well).  The same two
// bytes are also an Escape followed by a command, typed fast.  Vim tells them
// apart by time (`ttimeoutlen`); so does the interactive loop: a second byte
// that is there at once, or within `ttimeoutlen` milliseconds, makes a chord
// when a map for it exists, and otherwise nothing changes.  Maps are matched by
// the class of the mode the chord arrives in.

// The map class a lookup uses: 0 Normal, 1 Visual, 2 Insert and Replace, 3 the
// `:` and `/` lines; -1 where maps do not apply.
fn map_class(mode: Int, line_input: Bool) -> Int
    if line_input
        3
    elif mode == 0
        0
    elif mode == 2 or mode == 3 or mode == 5
        1
    elif mode == 1 or mode == 4
        2
    else
        0 - 1

// True when every byte of `s` is a printable ASCII character (0x20-0x7e).
fn all_printable(s: Str) -> Bool
    var i = 0
    while i < str.len(s)
        let b = str.byte_at(s, i) ?? 0
        if b < 32 or b > 126
            return false
        i = i + 1
    true

// True when `s` holds no control byte: text a user could type, UTF-8 included.
fn no_control(s: Str) -> Bool
    var i = 0
    while i < str.len(s)
        let b = str.byte_at(s, i) ?? 0
        if b < 32 or b == 127
            return false
        i = i + 1
    true

// An Insert-mode map that types text: two or more printable keys on the left
// (`aa`), text without a control byte on the right (`å`).  Such a map needs no
// Ex command and no Normal-mode command to run, so `--batch` can take it.
fn is_text_pair(l: Str, r: Str, mode: Int) -> Bool
    mode == 2 and str.len(l) >= 2 and all_printable(l) and no_control(r)

// `base` with the Alt-chord maps of `more` appended (see is_chord_lhs), and the
// Insert-mode maps that type text (see is_text_pair).
fn keymap_with_chords(base: Keymap, more: Keymap) -> Keymap
    var lhs = base.lhs[:]
    var rhs = base.rhs[:]
    var kmode = base.kmode[:]
    var i = 0
    while i < list.len(more.lhs)
        let l = more.lhs[i]
        if is_alt_lhs(l) or is_text_pair(l, more.rhs[i], more.kmode[i])
            lhs = list.push(lhs, l)
            rhs = list.push(rhs, more.rhs[i])
            kmode = list.push(kmode, more.kmode[i])
        i = i + 1
    Keymap { lhs: lhs, rhs: rhs, kmode: kmode }

// True when `b`, read after `ESC O`, continues a function-key sequence: the
// finals of F1-F4 (`P`-`S`) and of the application-mode cursor keys (`A`-`D`,
// `F`, `H`), or the digits and `;` of a modified key.
fn ss3_continues(b: Int) -> Bool
    (b >= 'A' and b <= 'D') or b == 'F' or b == 'H' or (b >= 'P' and b <= 'S') or (b >= '0' and b <= '9') or b == ';'

// Index of the map in class `mc` whose LHS is the Alt chord ESC `c`, or -1.
fn meta_idx(km: Keymap, mc: Int, c: Int) -> Int
    meta_idx_str(km, mc, str.from_byte(c))

// Index of the map in class `mc` whose LHS is ESC and the bytes `key` (one
// character, UTF-8 when it is not ASCII), or -1.  Alt-[ is found here too,
// though the ESC form of it is never delivered as a chord.
fn meta_idx_str(km: Keymap, mc: Int, key: Str) -> Int
    let want = str.from_byte('\e') + key
    var i = 0
    while i < list.len(km.lhs)
        if km.kmode[i] == mc and km.lhs[i] == want
            return i
        i = i + 1
    0 - 1

// ── The kitty keyboard protocol ─────────────────────────────────────────────
// novim pushes flag 1 on start (term_enter).  A terminal that has the protocol
// then sends Escape and the Alt and Ctrl chords as `CSI code ; mods u`, where
// `code` is the Unicode value of the key as it is on the keyboard without Shift
// and `mods` is 1 plus Shift 1, Alt 2, Ctrl 4, Super 8 (Caps and Num Lock are
// 64 and 128 and are ignored).  The sequence is read as the key it stands for,
// so `<M-[>` and `<M-{>` match without the wait the ESC form needs, and Escape
// is delivered at once.

// The character a key makes with Shift held, on a US keyboard, for the keys
// whose shifted form is not a capital: the inverse of what a terminal does to
// name the key.  A character that is not an unshifted key is returned as it is.
fn kitty_shifted(cp: Int) -> Int
    if cp >= 'a' and cp <= 'z'
        cp - 32
    elif cp == '1'
        '!'
    elif cp == '2'
        '@'
    elif cp == '3'
        '#'
    elif cp == '4'
        '$'
    elif cp == '5'
        '%'
    elif cp == '6'
        '^'
    elif cp == '7'
        '&'
    elif cp == '8'
        '*'
    elif cp == '9'
        '('
    elif cp == '0'
        ')'
    elif cp == '-'
        '_'
    elif cp == '='
        '+'
    elif cp == '['
        '{'
    elif cp == ']'
        '}'
    elif cp == '\\'
        '|'
    elif cp == ';'
        ':'
    elif cp == '\''
        '"'
    elif cp == ','
        '<'
    elif cp == '.'
        '>'
    elif cp == '/'
        '?'
    elif cp == '`'
        '~'
    else
        cp

// True when the modifier value of a key report has Alt.
fn kitty_alt(mods: Int) -> Bool
    mods > 1 and (mods - 1) / 2 % 2 == 1

// The bytes the key of a report stands for, without the ESC an Alt adds: the
// character (UTF-8) with Shift applied, or the control byte with Ctrl; "" for a
// key with Super or Hyper held or no character at all.
fn kitty_keybytes(cp: Int, mods: Int) -> Str
    let m = if mods > 1 then mods - 1 else 0
    if m / 8 % 2 == 1 or cp <= 0 or (cp >= 57344 and cp <= 63743)   // Super or Hyper; no character; a functional key
        return ""
    let shifted = if m % 2 == 1 then kitty_shifted(cp) else cp
    if m / 4 % 2 == 1
        let cb = nvmap.ctrl_byte(cp)
        if cb >= 0
            return str.from_byte(cb)
        if cp == ' '
            return ""              // Ctrl-Space is a NUL, which nothing here reads
    str.from_char(shifted)

// True when a map in class `mc` has an Alt chord for its whole LHS.
fn has_meta_map(km: Keymap, mc: Int) -> Bool
    var i = 0
    while i < list.len(km.lhs)
        if km.kmode[i] == mc and is_chord_lhs(km.lhs[i])
            return true
        i = i + 1
    false

// Load `[keymaps]` from a config file: lines `lhs = "rhs"` (rhs may use
// `\e` etc.).  Comments (`#`) and blank lines are skipped; section headers
// (`[name]`) gate which section we're in.  Missing file → empty keymap.
fn load_keymaps(cfg_path: Str) -> Keymap [fs]
    let Some(content) = fs.read(cfg_path) else return keymap_empty()
    var lhs: [Str] = []
    var rhs: [Str] = []
    var kmode: [Int] = []
    let lines = str.split_lines(content)
    var in_km = false
    let mut i = 0
    let n = list.len(lines)
    while i < n
        let raw = str.trim(lines[i])
        if str.len(raw) > 0 and (str.byte_at(raw, 0) ?? 0) != 35    // not a '#' comment
            if (str.byte_at(raw, 0) ?? 0) == 91                     // '[' section
                in_km = raw == "[keymaps]"
            elif in_km
                let eq = util.index_of_byte(raw, 61)                     // '='
                if eq > 0
                    let lkey = util.strip_quotes(str.trim(str.slice(raw, 0, eq)))
                    let rseq = util.strip_quotes(str.trim(util.strip_inline_comment(str.slice(raw, eq + 1, str.len(raw)))))
                    // Skip `[keymaps]` directives that aren't remaps (e.g.
                    // `import_nvim = true`) — else they'd become bogus LHS
                    // (`import_nvim` made `i` a multi-key prefix, stalling
                    // Insert-mode entry until the next key).
                    if str.len(lkey) >= 1 and lkey != "import_nvim"
                        lhs = list.append(lhs, [decode_escapes(lkey)])
                        rhs = list.append(rhs, [decode_escapes(rseq)])
                        kmode = list.append(kmode, [0])    // TOML maps are Normal mode
        i = i + 1
    Keymap { lhs: lhs, rhs: rhs, kmode: kmode }

// True when the config opts into Neovim keymap import (`[keymaps] import_nvim =
// true`).  Reuses the same flat section reader as the other loaders.
fn keymaps_import_nvim(cfg_path: Str) -> Bool [fs]
    let Some(content) = fs.read(cfg_path) else return false
    let lines = str.split_lines(content)
    var in_km = false
    var on = false
    var i = 0
    let n = list.len(lines)
    while i < n
        let raw = str.trim(lines[i])
        if str.len(raw) > 0 and (str.byte_at(raw, 0) ?? 0) != 35
            if (str.byte_at(raw, 0) ?? 0) == 91
                in_km = raw == "[keymaps]"
            elif in_km
                let eq = util.index_of_byte(raw, 61)
                if eq > 0 and str.trim(str.slice(raw, 0, eq)) == "import_nvim"
                    on = parse_bool_val(util.strip_inline_comment(str.slice(raw, eq + 1, str.len(raw))))
        i = i + 1
    on

// How long, in milliseconds, the loop waits after an ESC for the key of an Alt
// chord (Vim's `ttimeoutlen`, whose Neovim default is 50).  `[options]
// ttimeoutlen = N`; 0 never waits, so a chord counts only when its second byte
// is already there.  The wait happens only in a mode where a map for an Alt
// chord exists; everywhere else a lone ESC is delivered at once.  A chord's two
// bytes leave a terminal in one write, so the window matters over a slow link,
// and for terminals (novoterm among them) that write the two bytes separately.
// The cost: ESC followed by a command key within this time, in a mode with such
// a map, is read as the chord and not as Escape and the command.
fn load_ttimeoutlen(cfg_path: Str) -> Int [fs]
    let Some(content) = fs.read(cfg_path) else return 50
    let lines = str.split_lines(content)
    var in_opt = false
    var ms = 50
    var i = 0
    let n = list.len(lines)
    while i < n
        let raw = str.trim(lines[i])
        if str.len(raw) > 0 and (str.byte_at(raw, 0) ?? 0) != 35
            if (str.byte_at(raw, 0) ?? 0) == 91
                in_opt = raw == "[options]"
            elif in_opt
                let eq = util.index_of_byte(raw, 61)
                if eq > 0
                    let key = str.trim(str.slice(raw, 0, eq))
                    if key == "ttimeoutlen" or key == "ttm"
                        let v = util.parse_color_val(util.strip_inline_comment(str.slice(raw, eq + 1, str.len(raw))))
                        if v >= 0
                            ms = v
        i = i + 1
    ms

// Vim's 'timeoutlen' when neither the config nor the Neovim config sets it.
fn timeoutlen_default() -> Int
    1000

// How long, in milliseconds, the loop holds the keys typed so far when they are
// the start of a longer map (Vim's 'timeoutlen').  `[options] timeoutlen = N` in
// the novim config; -1 when it is not set there.  load_timeoutlen below is the
// whole rule.
fn config_timeoutlen(cfg_path: Str) -> Int [fs]
    let Some(content) = fs.read(cfg_path) else return 0 - 1
    let lines = str.split_lines(content)
    var in_opt = false
    var ms = 0 - 1
    var i = 0
    let n = list.len(lines)
    while i < n
        let raw = str.trim(lines[i])
        if str.len(raw) > 0 and (str.byte_at(raw, 0) ?? 0) != 35
            if (str.byte_at(raw, 0) ?? 0) == 91
                in_opt = raw == "[options]"
            elif in_opt
                let eq = util.index_of_byte(raw, 61)
                if eq > 0
                    let key = str.trim(str.slice(raw, 0, eq))
                    if key == "timeoutlen" or key == "tm"
                        let v = util.parse_color_val(util.strip_inline_comment(str.slice(raw, eq + 1, str.len(raw))))
                        if v >= 0
                            ms = v
        i = i + 1
    ms

// The 'timeoutlen' to use: `[options] timeoutlen` of the novim config if set,
// else, when `[keymaps] import_nvim = true`, the `vim.o.timeoutlen` of the
// Neovim config (the owner's is 250), else Vim's 1000.
fn load_timeoutlen(cfg_path: Str, nvim_dir: Str) -> Int [fs]
    let own = config_timeoutlen(cfg_path)
    if own >= 0
        return own
    if keymaps_import_nvim(cfg_path)
        let nv = nvmap.find_timeoutlen(collect_lua(nvim_dir, 0))
        if nv >= 0
            return nv
    timeoutlen_default()

// Assemble a Keymap from the nvim config dir: find the leader (default `\`), then
// scrape the Normal-mode maps (kmode 0) and the Visual-mode `v`/`x` maps
// (kmode 1), appended onto `base` (the TOML-loaded keymaps).
fn import_nvim_keymaps(dir: Str, base: Keymap) -> Keymap [fs]
    let text = collect_lua(dir, 0)
    let ml = nvmap.find_mapleader(text)
    let leader = if str.len(ml) > 0 then ml else str.from_char('\\')
    var lhs = base.lhs[:]
    var rhs = base.rhs[:]
    var kmode = base.kmode[:]
    // Normal (mode class 0)
    let np = nvmap.scrape_mode_maps(text, leader, "n")
    var i = 0
    while i + 1 < list.len(np)
        lhs = list.push(lhs, np[i])
        rhs = list.push(rhs, np[i + 1])
        kmode = list.push(kmode, 0)
        i = i + 2
    // Visual (`v` and `x`) → mode class 1
    let vp = nvmap.scrape_mode_maps(text, leader, "v")
    var j = 0
    while j + 1 < list.len(vp)
        lhs = list.push(lhs, vp[j])
        rhs = list.push(rhs, vp[j + 1])
        kmode = list.push(kmode, 1)
        j = j + 2
    let xp = nvmap.scrape_mode_maps(text, leader, "x")
    var k = 0
    while k + 1 < list.len(xp)
        lhs = list.push(lhs, xp[k])
        rhs = list.push(rhs, xp[k + 1])
        kmode = list.push(kmode, 1)
        k = k + 2
    // Insert (mode class 2) — these typically resolve to `<C-o>…` RHS.
    let ip = nvmap.scrape_mode_maps(text, leader, "i")
    var m = 0
    while m + 1 < list.len(ip)
        lhs = list.push(lhs, ip[m])
        rhs = list.push(rhs, ip[m + 1])
        kmode = list.push(kmode, 2)
        m = m + 2
    // Command-line (mode class 3): `:` and `/` have no map matcher, so the only
    // maps that can fire there are Alt chords, which the loop looks up directly.
    // A `"c"` map with any other LHS is not imported.
    let cp = cmdline_chord_maps(text, leader)
    var q = 0
    while q + 1 < list.len(cp)
        lhs = list.push(lhs, cp[q])
        rhs = list.push(rhs, cp[q + 1])
        kmode = list.push(kmode, 3)
        q = q + 2
    Keymap { lhs: lhs, rhs: rhs, kmode: kmode }

// The `"c"` maps of `text` whose whole LHS is an Alt chord (ESC and one key), as
// `[lhs0, rhs0, …]`; the rest have nothing in novim to fire them.
fn cmdline_chord_maps(text: Str, leader: Str) -> [Str]
    var out: [Str] = []
    let cp = nvmap.scrape_mode_maps(text, leader, "c")
    var q = 0
    while q + 1 < list.len(cp)
        if str.len(cp[q]) == 2 and (str.byte_at(cp[q], 0) ?? 0) == '\e'
            out = list.push(out, cp[q])
            out = list.push(out, cp[q + 1])
        q = q + 2
    out

// ── Options ──────────────────────────────────────────
@intent("""Editor settings, loaded from the `[options]` config section and
toggled live by `:set`.  `number`/`relativenumber` drive the line-number gutter,
`hlsearch` the search highlighting, `wrap` soft line wrapping, `syntax` the Novo
highlighter, `tabstop` the tab-expansion width, and `expandtab` makes the Tab
key insert `tabstop` spaces instead of a hard tab (vim's `et`).""")
struct Options
    number:         Bool
    relativenumber: Bool
    hlsearch:       Bool
    wrap:           Bool
    syntax:         Bool
    tabstop:        Int
    expandtab:      Bool

fn options_default() -> Options
    Options { number: false, relativenumber: false, hlsearch: true, wrap: false, syntax: true, tabstop: 8, expandtab: false }

// `o` with syntax highlighting off.  --no-color / NO_COLOR go through here
// as well as through the colorscheme: the token classes fall back to the
// tokenizer's own indices when a scheme sets none, and effect labels carry
// FIXED colours by palette rule 4 — so a colourless scheme alone would
// still paint the buffer.  Turning the highlighter off is what actually
// makes "no colour" true.  `:syntax on` still works afterwards: the flag
// picks the startup state, it does not lock it.
fn options_no_syntax(o: Options) -> Options
    Options { number: o.number, relativenumber: o.relativenumber, hlsearch: o.hlsearch, wrap: o.wrap, syntax: false, tabstop: o.tabstop, expandtab: o.expandtab }

fn parse_bool_val(s: Str) -> Bool
    str.trim(util.strip_quotes(str.trim(s))) == "true"

fn load_options(cfg_path: Str) -> Options [fs]
    let Some(content) = fs.read(cfg_path) else return options_default()
    var number = false
    var relativenumber = false
    var hlsearch = true
    var wrap = false
    var syntax = true
    var tabstop = 8
    var expandtab = false
    let lines = str.split_lines(content)
    var in_opt = false
    let mut i = 0
    let n = list.len(lines)
    while i < n
        let raw = str.trim(lines[i])
        if str.len(raw) > 0 and (str.byte_at(raw, 0) ?? 0) != 35
            if (str.byte_at(raw, 0) ?? 0) == 91
                in_opt = raw == "[options]"
            elif in_opt
                let eq = util.index_of_byte(raw, 61)
                if eq > 0
                    let key = str.trim(str.slice(raw, 0, eq))
                    let valr = util.strip_inline_comment(str.slice(raw, eq + 1, str.len(raw)))
                    if key == "number" or key == "nu"
                        number = parse_bool_val(valr)
                    elif key == "relativenumber" or key == "rnu"
                        relativenumber = parse_bool_val(valr)
                    elif key == "hlsearch" or key == "hls"
                        hlsearch = parse_bool_val(valr)
                    elif key == "wrap"
                        wrap = parse_bool_val(valr)
                    elif key == "syntax" or key == "syn"
                        syntax = parse_bool_val(valr)
                    elif key == "tabstop" or key == "ts"
                        let tv = util.parse_color_val(valr)
                        if tv > 0
                            tabstop = tv
                    elif key == "expandtab" or key == "et"
                        expandtab = parse_bool_val(valr)
        i = i + 1
    Options { number: number, relativenumber: relativenumber, hlsearch: hlsearch, wrap: wrap, syntax: syntax, tabstop: tabstop, expandtab: expandtab }

// Number formatting (pad_num / pad_num_l / num_digits) and `nspaces` moved to
// disp.nv (pure display helpers).

// ── `:set` (runtime options) ────────────────────────────────────────────
// `:set number`, `:set nonumber`, `:set rnu!`, `:set tabstop=4`, and several
// space-separated at once.  Booleans: `<opt>` on, `no<opt>` off, `<opt>!`
// toggle.  Aliases: nu rnu hls ts.

fn is_set(cmd: Str) -> Bool
    let c = str.trim(cmd)
    c == "set" or (str.len(c) >= 4 and str.slice(c, 0, 4) == "set ")

// The option token of a `:set <opt>` command (after "set ", trimmed).
fn set_arg(cmd: Str) -> Str
    let c = str.trim(cmd)
    if str.len(c) >= 4 and str.slice(c, 0, 4) == "set " then str.trim(str.slice(c, 4, str.len(c))) else ""

// `:set treesitter` family — the tree-sitter toggle is a driver concern (not an
// Options field), so it's handled outside apply_set.
fn is_ts_set(cmd: Str) -> Bool
    let a = set_arg(cmd)
    a == "treesitter" or a == "ts" or a == "notreesitter" or a == "nots" or a == "treesitter!" or a == "ts!"

fn ts_set_value(cmd: Str, cur: Bool) -> Bool
    let a = set_arg(cmd)
    if a == "treesitter!" or a == "ts!"
        not cur
    elif str.starts_with(a, "no")
        false
    else
        true

// Apply one `:set` token to the options.
fn apply_set_token(o: Options, tok: Str) -> Options
    let t = str.trim(tok)
    if str.len(t) == 0
        return o
    let eq = util.index_of_byte(t, '=')
    if eq > 0                                       // name=value (tabstop=4)
        let nm = str.trim(str.slice(t, 0, eq))
        let v = util.parse_color_val(str.slice(t, eq + 1, str.len(t)))
        if (nm == "tabstop" or nm == "ts") and v > 0
            return Options { number: o.number, relativenumber: o.relativenumber, hlsearch: o.hlsearch, wrap: o.wrap, syntax: o.syntax, tabstop: v, expandtab: o.expandtab }
        return o
    let n = str.len(t)
    let bang = (str.byte_at(t, n - 1) ?? 0) == '!'          // trailing !
    let body = if bang then str.slice(t, 0, n - 1) else t
    let neg = str.len(body) >= 2 and str.slice(body, 0, 2) == "no"
    let name = if neg then str.slice(body, 2, str.len(body)) else body
    if name == "number" or name == "nu"
        return Options { number: if bang then (not o.number) elif neg then false else true, relativenumber: o.relativenumber, hlsearch: o.hlsearch, wrap: o.wrap, syntax: o.syntax, tabstop: o.tabstop, expandtab: o.expandtab }
    elif name == "relativenumber" or name == "rnu"
        return Options { number: o.number, relativenumber: if bang then (not o.relativenumber) elif neg then false else true, hlsearch: o.hlsearch, wrap: o.wrap, syntax: o.syntax, tabstop: o.tabstop, expandtab: o.expandtab }
    elif name == "hlsearch" or name == "hls"
        return Options { number: o.number, relativenumber: o.relativenumber, hlsearch: if bang then (not o.hlsearch) elif neg then false else true, wrap: o.wrap, syntax: o.syntax, tabstop: o.tabstop, expandtab: o.expandtab }
    elif name == "wrap"
        return Options { number: o.number, relativenumber: o.relativenumber, hlsearch: o.hlsearch, wrap: if bang then (not o.wrap) elif neg then false else true, syntax: o.syntax, tabstop: o.tabstop, expandtab: o.expandtab }
    elif name == "syntax" or name == "syn"
        return Options { number: o.number, relativenumber: o.relativenumber, hlsearch: o.hlsearch, wrap: o.wrap, syntax: if bang then (not o.syntax) elif neg then false else true, tabstop: o.tabstop, expandtab: o.expandtab }
    elif name == "expandtab" or name == "et"
        return Options { number: o.number, relativenumber: o.relativenumber, hlsearch: o.hlsearch, wrap: o.wrap, syntax: o.syntax, tabstop: o.tabstop, expandtab: if bang then (not o.expandtab) elif neg then false else true }
    else
        o

// Apply a `:set a b c` command (space-separated tokens) to the options.
fn apply_set(o: Options, cmd: Str) -> Options
    let c = str.trim(cmd)
    if str.len(c) <= 3
        return o
    let args = str.slice(c, 4, str.len(c))
    var result = o
    var tok = ""
    var i = 0
    let m = str.len(args)
    while i < m
        let b = str.byte_at(args, i) ?? 0
        if b == ' '
            if str.len(tok) > 0
                result = apply_set_token(result, tok)
                tok = ""
        else
            tok = tok + str.from_byte(b)
        i = i + 1
    if str.len(tok) > 0
        result = apply_set_token(result, tok)
    result

// ── Search (/pattern, n / N) ─────────────────────────

// First occurrence of `needle` in `hay` at or after column `from`; -1 if
// none.  A literal substring match (search navigation is not a regex).
fn find_in_line(hay: Str, needle: Str, from: Int) -> Int
    let hl = str.len(hay)
    let nl = str.len(needle)
    if nl == 0
        return 0 - 1
    var i = if from < 0 then 0 else from
    while i + nl <= hl
        if str.slice(hay, i, i + nl) == needle
            return i
        i = i + 1
    0 - 1

// Last occurrence of `needle` in `hay` strictly before column `before`
// (before < 0 → search the whole line); -1 if none.
fn find_last_in_line(hay: Str, needle: Str, before: Int) -> Int
    let hl = str.len(hay)
    let nl = str.len(needle)
    if nl == 0
        return 0 - 1
    let cap = if before < 0 then hl else before
    var found = 0 - 1
    var i = 0
    while i + nl <= hl and i < cap
        if str.slice(hay, i, i + nl) == needle
            found = i
        i = i + 1
    found

// Move the cursor to the next (`forward`) / previous occurrence of
// `pattern`, wrapping around the buffer.  Unchanged if no match anywhere.
fn find_next(ed: Editor, pattern: Str, forward: Bool) -> Editor
    if str.len(pattern) == 0
        return ed
    let atoms = nvregex.re_compile(pattern)
    let total = list.len(ed.lines)
    if forward
        var y = ed.cy
        var startcol = util.u8_after(line_at(ed, ed.cy), ed.cx)
        var steps = 0
        while steps <= total
            let col = nvregex.re_find_in_line(atoms, line_at(ed, y), startcol)
            if col >= 0
                return Editor { lines: ed.lines, cy: y, cx: col }
            y = (y + 1) % total
            startcol = 0
            steps = steps + 1
        ed
    else
        var y = ed.cy
        var before = ed.cx
        var steps = 0
        while steps <= total
            let col = nvregex.re_find_last_in_line(atoms, line_at(ed, y), before)
            if col >= 0
                return Editor { lines: ed.lines, cy: y, cx: col }
            y = y - 1
            if y < 0
                y = total - 1
            before = 0 - 1
            steps = steps + 1
        ed

// ── Batch (headless test) mode ──────────────────────────────────

// `novim --batch "<keys>" <file>`: load, feed each key byte through the
// same handler the interactive loop uses, then print the final buffer
// followed by `cursor=<line>:<col>` and exit.  Fully deterministic.
// Decodes `\e`=Esc, `\n`/`\r`=Enter, `\t`=Tab, `\b`=Backspace,
// `\\`=backslash so test sequences embed control keys in ASCII
// (e.g. `iHello\e`, `:w\n`).  `:` opens the Ex command line.  `\M<key>` is an
// Alt chord (see batch_meta_marks).
@intent("""Feed one already-decoded byte through `feed`, first expanding any
Normal-mode keymap remap of `b` into its byte sequence (replayed through `feed`
so remapped sequences behave exactly like typed ones).""")
fn feed_mapped(ed: Editor, st: InputState, km: Keymap, b: Int) -> Step
    let seq = if st.mode == 0 then keymap_lookup(km, b) else ""
    if str.len(seq) == 0
        return feed(ed, st, b)
    var e = ed
    var s = st
    let mut j = 0
    let m = str.len(seq)
    while j < m
        let step = feed(e, s, str.byte_at(seq, j) ?? 0)
        e = step.ed
        s = step.st
        j = j + 1
    Step { ed: e, st: s }

// ── `.` repeat ──────────────────────────────────────────────────────────
// Repeat the last buffer-changing command.  Kept in the DRIVER (not the pure
// feed) by recording the raw byte sequence of each change command and
// replaying it on `.`.  The recorded bytes re-run through the same feed_mapped
// (keymaps included), so insert-mode text, counts, and operator+motion all
// repeat faithfully.

// Perf: str.join is one O(n) pass.  `acc = acc + line` would be O(n²), and
// since this runs several times per keystroke (undo + dot change-detection) it
// made insert mode crawl on large files.
@intent("Serialize the buffer's lines to a single newline-joined string.")
fn buf_text(ed: Editor) -> Str
    str.join(ed.lines, str.from_char('\n'))

// Counts are included (a leading digit may precede an edit, e.g. `3x`).  Yank
// (`y`) is excluded: it changes no buffer text, so `.` never repeats it.
// `g`/`v`/`V` may start a command that doesn't change the buffer (gg, vy, v
// cancel) — change detection below only records an undo when buf_text actually
// changed, so those no-op cases push nothing.
@intent("True if byte `b` can begin a buffer-changing command — lets navigation keystrokes skip the per-keystroke snapshot/compare.")
fn is_edit_start(b: Int) -> Bool
    if b >= '0' and b <= '9'                               // count digit (may precede an edit)
        return true
    // i a I A · o O · x X D · J ~ r · s S c C · p P · d > < · R · ^A ^X · g · v V ^V
    let edits = ['i', 'a', 'I', 'A', 'o', 'O', 'x', 'X', 'D', 'J', '~', 'r', 's', 'S', 'c', 'C', 'p', 'P', 'd', '>', '<', 'R', '\x01', '\x18', 'g', 'v', 'V', '\x16']
    var found = false
    let mut i = 0
    let n = list.len(edits)
    while i < n
        if edits[i] == b
            found = true
        i = i + 1
    found

// The per-session dot state: `last` = the recorded change to repeat; `cur` =
// bytes of the in-progress command; `snap` = buffer text when it began;
// `active` = whether a command is being recorded right now.
// Replay a recorded byte sequence through feed_mapped.
fn replay_seq(ed: Editor, st: InputState, km: Keymap, seq: Str) -> Step
    var e = ed
    var s = st
    let m = str.len(seq)
    let mut j = 0
    while j < m
        let step = feed_mapped(e, s, km, str.byte_at(seq, j) ?? 0)
        e = step.ed
        s = step.st
        j = j + 1
    Step { ed: e, st: s }

// ── `.` repeat + undo/redo ──────────────────────────────────────────────
// Both are DRIVER-level session state so `feed` stays pure.  `EditState`
// carries the dot-repeat recording (`last`/`cur`/`snaptxt`/`active`) plus an
// undo/redo stack of buffer snapshots.  This is sound because novim never
// mutates a line vector in place — every edit rebuilds it via list.append —
// so a Snapshot that holds the old `[Str]` reference stays valid forever.

// A point-in-time buffer + cursor, pushed onto the undo/redo stacks.
struct Snapshot
    lines: [Str]
    cy:    Int
    cx:    Int

struct EditState
    last:     Str          // dot: last change command's bytes
    cur:      Str          // dot: in-progress command bytes
    snaptxt:  Str          // dot: buf_text at command start (change detection)
    active:   Bool         // a command is being recorded
    snaped:   Snapshot     // undo: editor at command start
    var undos:    [Snapshot]   // undo stack (last = most recent pre-change state)
    var redos:    [Snapshot]   // redo stack
    regs:     [Str]        // named registers a-z: contents
    reglw:    [Bool]       // named registers a-z: linewise flag
    rreg:     Int          // register selected for the current command (0 = none, 1-26 = a-z)
    awaitreg: Bool         // true after `"`, awaiting the register letter
    marky:    [Int]        // marks a-z: line (-1 = unset)
    markx:    [Int]        // marks a-z: column
    awaitmark: Int         // 0 none, 1 set (m), 2 jump-exact (`), 3 jump-line (')
    recording: Int         // macros: register being recorded into (0 none, 1-26)
    macrobuf:  Str         // keystrokes recorded so far
    awaitmac:  Int         // 0 none, 1 await q-register, 2 await @-register
    lastmacro: Int         // last replayed macro register (for @@), 0 none
    lvy:       Int         // gv: last visual selection — anchor line
    lvx:       Int         // gv: anchor column
    lvey:      Int         // gv: cursor-end line
    lvex:      Int         // gv: cursor-end column
    lvmode:    Int         // gv: 0 none, 2 charwise, 3 linewise
    findc:     Int         // ; / , : last f/F/t/T target char (0 = none yet)
    findt:     Int         // ; / , : last find type (8 f, 9 F, 10 t, 11 T)
    giy:       Int         // gi: last insert-leave position — line (-1 = none)
    gix:       Int         // gi: last insert-leave column

struct EditStep
    ed: Editor
    st: InputState
    es: EditState

fn lines_empty() -> [Str]
    var x: [Str] = []
    x

fn snaps_empty() -> [Snapshot]
    var x: [Snapshot] = []
    x

fn snap_empty() -> Snapshot
    Snapshot { lines: lines_empty(), cy: 0, cx: 0 }

fn snap_of(ed: Editor) -> Snapshot
    Snapshot { lines: ed.lines, cy: ed.cy, cx: ed.cx }

// ── per-buffer undo: serialize a snapshot stack to a flat Str ────────────
// Buffers keep their own undo/redo history across `:bn`/`:e`/etc.  Each
// buffer's stacks are stashed as serialized strings in parallel `[Str]` arrays,
// the same flat storage shape `bufs_text` uses — a deliberately simple,
// uniform representation rather than threading `[[Snapshot]]` through the driver.

// Serialize one snapshot as "cy,cx,LEN:TEXT" (TEXT = lines joined by \n; the
// LEN prefix makes each record self-delimiting whatever TEXT contains).
fn snap_ser(s: Snapshot) -> Str
    let text = str.join(s.lines, str.from_char('\n'))
    str.from_int(s.cy) + "," + str.from_int(s.cx) + "," + str.from_int(str.len(text)) + ":" + text

// Serialize a snapshot stack as the concatenation of its records.
fn snaps_ser(ss: [Snapshot]) -> Str
    var out = ""
    var i = 0
    while i < list.len(ss)
        out = out + snap_ser(ss[i])
        i = i + 1
    out

// Parse a snapshot stack back from snaps_ser's output.
fn snaps_de(s: Str) -> [Snapshot]
    var out = snaps_empty()
    let n = str.len(s)
    var p = 0
    while p < n
        let c1 = util.index_of_byte_from(s, ',', p)         // ','
        let c2 = util.index_of_byte_from(s, ',', c1 + 1)    // ','
        let c3 = util.index_of_byte_from(s, ':', c2 + 1)    // ':'
        if c1 < 0 or c2 < 0 or c3 < 0
            return out
        let cy = str.to_int(str.slice(s, p, c1)) ?? 0
        let cx = str.to_int(str.slice(s, c1 + 1, c2)) ?? 0
        let ln = str.to_int(str.slice(s, c2 + 1, c3)) ?? 0
        let tstart = c3 + 1
        let text = str.slice(s, tstart, tstart + ln)
        let lns = str.split_lines(text)
        let lines = if list.len(lns) == 0 then [""] else lns
        out = list.append(out, [Snapshot { lines: lines, cy: cy, cx: cx }])
        p = tstart + ln
    out

// Serialize an Int list as comma-joined decimals (per-buffer marks storage).
fn ints_ser(xs: [Int]) -> Str
    var out = ""
    var i = 0
    while i < list.len(xs)
        if i > 0
            out = out + ","
        out = out + str.from_int(xs[i])
        i = i + 1
    out

// Parse a comma-joined Int list back into the 26 mark slots (-1 = unset; an
// empty string — a buffer with no marks set yet — yields a fresh slot array).
fn marks_de(s: Str) -> [Int]
    if str.len(s) == 0
        return marks_empty()
    var out: [Int] = []
    let n = str.len(s)
    var p = 0
    while p <= n
        let c = util.index_of_byte_from(s, ',', p)
        let endp = if c < 0 then n else c
        let v = str.to_int(str.slice(s, p, endp)) ?? (0 - 1)
        out = list.append(out, [v])
        p = if c < 0 then n + 1 else c + 1
    while list.len(out) < 26
        out = list.append(out, [0 - 1])
    out

// Parse a comma-joined Int list of variable length (no padding) — used for the
// per-buffer diagnostic line/severity store.
fn ints_de_csv(s: Str) -> [Int]
    var out: [Int] = []
    if str.len(s) == 0
        return out
    let n = str.len(s)
    var p = 0
    while p <= n
        let c = util.index_of_byte_from(s, ',', p)
        let endp = if c < 0 then n else c
        let v = str.to_int(str.slice(s, p, endp)) ?? 0
        out = list.append(out, [v])
        p = if c < 0 then n + 1 else c + 1
    out

// Split `s` on byte '\x01' into fields (the per-buffer diagnostic message store).
fn str_split_b1(s: Str) -> [Str]
    var out: [Str] = []
    let n = str.len(s)
    var start = 0
    var i = 0
    while i < n
        if (str.byte_at(s, i) ?? 0) == 1
            out = list.append(out, [str.slice(s, start, i)])
            start = i + 1
        i = i + 1
    out = list.append(out, [str.slice(s, start, n)])
    out

// Serialize a buffer's diagnostics: the flat line/sev ints (comma-joined), a
// NUL separator, then the messages joined by '\x01'.  Per-buffer diagnostics let
// every open document keep its own diagnostics live across switches.
fn diag_ser(li: [Int], msgs: [Str]) -> Str
    ints_ser(li) + str.from_char(0) + str.join(msgs, str.from_char(1))

fn diag_de_li(s: Str) -> [Int]
    let z = util.index_of_byte(s, 0)
    let head = if z < 0 then s else str.slice(s, 0, z)
    ints_de_csv(head)

fn diag_de_msgs(s: Str) -> [Str]
    let z = util.index_of_byte(s, 0)
    if z < 0
        var e: [Str] = []
        return e
    let tail = str.slice(s, z + 1, str.len(s))
    if str.len(tail) == 0
        var e2: [Str] = []
        return e2
    str_split_b1(tail)

// 37 register slots: 0-25 = named a-z, 26-35 = numbered "0-"9 ("0 yank, "1-"9
// delete ring), 36 = "- (small charwise-delete register).
fn regs_empty() -> [Str]
    var x: [Str] = []
    let mut i = 0
    while i < 37
        x = list.append(x, [""])
        i = i + 1
    x

fn reglw_empty() -> [Bool]
    var x: [Bool] = []
    let mut i = 0
    while i < 37
        x = list.append(x, [false])
        i = i + 1
    x

// Index of `p` in a list of buffer paths, or -1.
fn buf_index_of(paths: [Str], p: Str) -> Int
    var i = 0
    while i < list.len(paths)
        if paths[i] == p
            return i
        i = i + 1
    0 - 1

// Load a file from disk as one newline-joined string (a buffer's stored text).
fn file_to_text(path: Str) -> Str [fs]
    str.join(buf_load(path), str.from_char('\n'))

// 26 unset marks (a-z), value -1.
fn marks_empty() -> [Int]
    var x: [Int] = []
    let mut i = 0
    while i < 26
        x = list.append(x, [0 - 1])
        i = i + 1
    x

fn edit_new() -> EditState
    EditState { last: "", cur: "", snaptxt: "", active: false, snaped: snap_empty(), undos: snaps_empty(), redos: snaps_empty(), regs: regs_empty(), reglw: reglw_empty(), rreg: 0, awaitreg: false, marky: marks_empty(), markx: marks_empty(), awaitmark: 0, recording: 0, macrobuf: "", awaitmac: 0, lastmacro: 0, lvy: 0 - 1, lvx: 0 - 1, lvey: 0 - 1, lvex: 0 - 1, lvmode: 0, findc: 0, findt: 0, giy: 0 - 1, gix: 0 - 1 }

// A fresh EditState seeded with a buffer's restored undo/redo history and marks
// (both buffer-local in vim) plus the session-global registers (used on buffer
// switch so each buffer keeps its own `u` / Ctrl-R stacks and `a-z` marks while
// yanks/macros remain shared — registers are global in vim).
fn edit_new_undo(var undos: [Snapshot], var redos: [Snapshot], regs: [Str], reglw: [Bool], marky: [Int], markx: [Int]) -> EditState
    EditState { last: "", cur: "", snaptxt: "", active: false, snaped: snap_empty(), undos: undos, redos: redos, regs: regs, reglw: reglw, rreg: 0, awaitreg: false, marky: marky, markx: markx, awaitmark: 0, recording: 0, macrobuf: "", awaitmac: 0, lastmacro: 0, lvy: 0 - 1, lvx: 0 - 1, lvey: 0 - 1, lvex: 0 - 1, lvmode: 0, findc: 0, findt: 0, giy: 0 - 1, gix: 0 - 1 }

// Push a manual undo snapshot (for buffer-changing Ex commands like :s, which
// run in the driver outside the feed/feed_edit recording path) and clear redo.
fn edit_push_undo(var es: EditState, ed: Editor) -> EditState
    list.push(es.undos, snap_of(ed))    // onto the undo stack in place
    EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: snaps_empty(), regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix }

// First `k` snapshots of `xs` (the stack minus its top).
fn take_snaps(xs: [Snapshot], k: Int) -> [Snapshot]
    var out: [Snapshot] = []
    let mut i = 0
    while i < k
        out = list.append(out, [xs[i]])
        i = i + 1
    out

// Begin recording a command: snapshot the buffer text (for change detection)
// and the full editor (for undo).
fn edit_start(var es: EditState, ed: Editor) -> EditState
    EditState { last: es.last, cur: "", snaptxt: buf_text(ed), active: true, snaped: snap_of(ed), undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix }

// Feed one byte mid/within a tracked command; on completion record the dot
// `last` and push the pre-change snapshot onto the undo stack if it changed.
fn edit_record(ed: Editor, st: InputState, km: Keymap, var es: EditState, b: Int) -> EditStep
    let step = feed_mapped(ed, st, km, b)
    let s2 = step.st
    let cur2 = es.cur + str.from_byte(b)
    let done = s2.mode == 0 and s2.pending == 0 and s2.count == 0
    let push = done and (buf_text(step.ed) != es.snaptxt)
    let newlast    = if push then cur2 else es.last
    let newcur     = if done then "" else cur2
    let newsnaptxt = if done then "" else es.snaptxt
    var newundos   = if push then list.append(es.undos, [es.snaped]) else es.undos
    var newredos   = if push then snaps_empty() else es.redos
    EditStep { ed: step.ed, st: s2, es: EditState { last: newlast, cur: newcur, snaptxt: newsnaptxt, active: not done, snaped: es.snaped, undos: newundos, redos: newredos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix } }

// Untracked byte (pure motion / navigation): feed without touching dot/undo.
fn edit_pass(ed: Editor, st: InputState, km: Keymap, es: EditState, b: Int) -> EditStep
    let step = feed_mapped(ed, st, km, b)
    EditStep { ed: step.ed, st: step.st, es: es }

// Remember the visual selection that was just left (for `gv`).  `st`/`ed` are
// the PRE-command state: anchor (avy,avx) + cursor (ed.cy,ed.cx) + mode.
fn edit_save_visual(var es: EditState, st: InputState, ed: Editor) -> EditState
    EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: st.avy, lvx: st.avx, lvey: ed.cy, lvex: ed.cx, lvmode: st.mode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix }

// `gv` — re-enter the last visual selection (mode + anchor + cursor).
fn edit_regv(ed: Editor, st: InputState, es: EditState) -> EditStep
    let ne = clamp(Editor { lines: ed.lines, cy: es.lvey, cx: es.lvex })
    EditStep { ed: ne, st: InputState { count: 0, pending: 0, mode: es.lvmode, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: es.lvy, avx: es.lvx }, es: es }

// A yank → the "0 register (slot 26).
fn edit_numreg_yank(var es: EditState, text: Str, lw: Bool) -> EditState
    var r = es.regs[:]
    var w = es.reglw[:]
    r = util.set_str_at(r, 26, text)
    w = util.set_bool_at(w, 26, lw)
    EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: r, reglw: w, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix }

// A linewise delete → shift the "1-"9 ring (slots 27-35) and store at "1.
fn edit_numreg_del(var es: EditState, text: Str) -> EditState
    var r = es.regs[:]
    var w = es.reglw[:]
    var i = 35
    while i >= 28
        r = util.set_str_at(r, i, r[i - 1])
        w = util.set_bool_at(w, i, w[i - 1])
        i = i - 1
    r = util.set_str_at(r, 27, text)
    w = util.set_bool_at(w, 27, true)
    EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: r, reglw: w, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix }

// A charwise (sub-line) delete → the small-delete register "- (slot 36).
fn edit_numreg_small(var es: EditState, text: Str) -> EditState
    var r = es.regs[:]
    var w = es.reglw[:]
    r = util.set_str_at(r, 36, text)
    w = util.set_bool_at(w, 36, false)
    EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: r, reglw: w, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix }

// Remember the f/F/t/T that just completed (target `c`, pending `t`) for ; / ,.
fn edit_save_find(var es: EditState, c: Int, t: Int) -> EditState
    EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: c, findt: t, giy: es.giy, gix: es.gix }

// Remember where Insert mode was just left (for `gi`).  `ed` is the PRE-Esc
// editor — the cursor sits where the next character would have gone.
fn edit_save_gi(var es: EditState, ed: Editor) -> EditState
    EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: ed.cy, gix: ed.cx }

// `gi` — jump to the last insert-leave position and re-enter Insert mode.
fn edit_gi(ed: Editor, st: InputState, es: EditState) -> EditStep
    let ne = clamp_insert(Editor { lines: ed.lines, cy: es.giy, cx: es.gix })
    EditStep { ed: ne, st: ist_insert(st), es: es }

// `;` repeats the last find; `,` repeats it reversed.  findt: 8 f, 9 F, 10 t,
// 11 T (f/t go forward; t/T stop one short of the target).
fn edit_repeat_find(ed: Editor, st: InputState, var es: EditState, reverse: Bool) -> EditStep
    let cnt = if st.count > 0 then st.count else 1
    let fwd0 = es.findt == '\b' or es.findt == '\n'
    let till = es.findt == '\n' or es.findt == 11
    let fwd = if reverse then not fwd0 else fwd0
    // ; / , is motion-only; reset any recording a leading count digit started.
    EditStep { ed: move_find(ed, es.findc, fwd, till, cnt), st: ist_done(st), es: EditState { last: es.last, cur: "", snaptxt: "", active: false, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix } }

// `u` — pop the undo stack onto the redo stack and restore the buffer.
fn edit_undo(ed: Editor, st: InputState, var es: EditState) -> EditStep
    let nu = list.len(es.undos)
    let can = nu > 0
    let snap = if can then es.undos[nu - 1] else snap_of(ed)
    var undos2 = if can then take_snaps(es.undos, nu - 1) else es.undos
    var redos2 = if can then list.append(es.redos, [snap_of(ed)]) else es.redos
    let nede = if can then clamp(Editor { lines: snap.lines, cy: snap.cy, cx: snap.cx }) else ed
    EditStep { ed: nede, st: ist_done(st), es: EditState { last: es.last, cur: "", snaptxt: "", active: false, snaped: es.snaped, undos: undos2, redos: redos2, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix } }

// Ctrl-R — pop the redo stack onto the undo stack and restore the buffer.
fn edit_redo(ed: Editor, st: InputState, var es: EditState) -> EditStep
    let nr = list.len(es.redos)
    let can = nr > 0
    let snap = if can then es.redos[nr - 1] else snap_of(ed)
    var redos2 = if can then take_snaps(es.redos, nr - 1) else es.redos
    var undos2 = if can then list.append(es.undos, [snap_of(ed)]) else es.undos
    let nede = if can then clamp(Editor { lines: snap.lines, cy: snap.cy, cx: snap.cx }) else ed
    EditStep { ed: nede, st: ist_done(st), es: EditState { last: es.last, cur: "", snaptxt: "", active: false, snaped: es.snaped, undos: undos2, redos: redos2, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix } }

// `.` — replay the last change `count` times; it is itself an undoable change,
// so snapshot the pre-replay buffer and push it on the undo stack if it changed.
fn edit_dot(ed: Editor, st: InputState, km: Keymap, var es: EditState) -> EditStep
    let reps = if st.count > 0 then st.count else 1
    let presnap = snap_of(ed)
    let pretxt = buf_text(ed)
    var e = ed
    var s = ist_done(st)
    var r = 0
    while r < reps
        let step = replay_seq(e, s, km, es.last)
        e = step.ed
        s = step.st
        r = r + 1
    let push = buf_text(e) != pretxt
    var newundos = if push then list.append(es.undos, [presnap]) else es.undos
    var newredos = if push then snaps_empty() else es.redos
    EditStep { ed: e, st: s, es: EditState { last: es.last, cur: "", snaptxt: "", active: false, snaped: es.snaped, undos: newundos, redos: newredos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix } }

@intent("""Drive one input byte through feed_mapped with dot-repeat and
undo/redo bookkeeping: `u`/Ctrl-R restore from the snapshot stacks; any other
byte runs the edit, and a snapshot is pushed onto the undo stack when the buffer
actually changed.""")
fn feed_edit_inner(ed: Editor, st: InputState, km: Keymap, var es: EditState, b: Int) -> EditStep
    if st.mode == 0 and st.pending == 0 and b == 'u'            // 'u' — undo
        return edit_undo(ed, st, var es)
    if st.mode == 0 and st.pending == 0 and b == '\x12'            // Ctrl-R — redo
        return edit_redo(ed, st, var es)
    if st.mode == 0 and st.pending == 0 and b == '.'            // '.' — repeat
        return edit_dot(ed, st, km, var es)
    if st.pending == 1 and b == 'v' and es.lvmode != 0         // `gv` — reselect last visual
        return edit_regv(ed, st, es)
    if st.pending == 1 and b == 'i' and es.giy >= 0            // `gi` — resume Insert at the last position
        return edit_gi(ed, st, es)
    if st.mode == 0 and st.pending == 0 and (b == ';' or b == ',') and es.findt >= 8   // ; / , — repeat find (count ok)
        return edit_repeat_find(ed, st, var es, b == ',')
    if es.active                                                // mid-command
        return edit_record(ed, st, km, var es, b)
    if st.mode == 0 and st.pending == 0 and st.count == 0 and is_edit_start(b)
        return edit_record(ed, st, km, edit_start(var es, ed), b)
    edit_pass(ed, st, km, es, b)

// ── Named registers: `"a` selects register a for the next op ──────
// The `"<letter>` prefix is handled here in the driver: it loads the named
// register into the unnamed register (so a following p reads it) and marks
// `rreg`; after the command completes, the unnamed register is stored back
// into the named slot (so a preceding y/d writes it).  The named store lives
// in EditState; feed stays pure (it only ever touches the unnamed register).

// Begin a `"` register prefix — await the register letter.
fn edit_await_reg(ed: Editor, st: InputState, var es: EditState) -> EditStep
    EditStep { ed: ed, st: st, es: EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: true, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix } }

// The byte after `"`: a-z selects that register (loaded into the unnamed
// register for reads); anything else cancels.
fn edit_select_reg(ed: Editor, st: InputState, var es: EditState, b: Int) -> EditStep
    if (b >= 'a' and b <= 'z') or (b >= '0' and b <= '9') or (b >= 'A' and b <= 'Z') or b == '-'
        let upper = b >= 'A' and b <= 'Z'                         // A-Z → append to a-z
        let idx = if b == '-' then 36 elif b <= '9' then 26 + (b - '0') elif upper then b - 'A' else b - 'a'
        let rr = if upper then 0 - (idx + 1) else idx + 1          // negative rreg = append mode
        let loaded = InputState { count: st.count, pending: st.pending, mode: st.mode, reg: es.regs[idx], reg_lw: es.reglw[idx], search: st.search, avy: st.avy, avx: st.avx }
        EditStep { ed: ed, st: loaded, es: EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: rr, awaitreg: false, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix } }
    else
        EditStep { ed: ed, st: st, es: EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: false, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix } }

// After a command completes with a register selected, persist the unnamed
// register into the named slot, then clear the selection.
fn edit_persist_reg(step: EditStep) -> EditStep
    if step.es.rreg != 0 and step.st.mode == 0 and step.st.pending == 0 and step.st.count == 0
        let app = step.es.rreg < 0                                  // append (A-Z)
        let idx = (if app then 0 - step.es.rreg else step.es.rreg) - 1
        let old = step.es.regs[idx]
        // Replace always writes (idempotent for read-only ops); append writes
        // only when the unnamed register actually changed (an actual yank/delete,
        // not a read like "Ap).
        let same = step.st.reg == old
        let wrote = if app then (not same) else true
        // Line-wise append joins with a newline (registers hold lines without a
        // trailing \n); skip the separator when the target is still empty.
        let sep = if step.st.reg_lw and str.len(old) > 0 then str.from_char('\n') else ""
        let newval = if app then old + sep + step.st.reg else step.st.reg
        let newlw = step.st.reg_lw     // append keeps the appended chunk's line-wise flag
        let regs2 = if wrote then util.set_str_at(step.es.regs, idx, newval) else step.es.regs
        let lw2 = if wrote then util.set_bool_at(step.es.reglw, idx, newlw) else step.es.reglw
        EditStep { ed: step.ed, st: step.st, es: EditState { last: step.es.last, cur: step.es.cur, snaptxt: step.es.snaptxt, active: step.es.active, snaped: step.es.snaped, undos: step.es.undos[:], redos: step.es.redos[:], regs: regs2, reglw: lw2, rreg: 0, awaitreg: step.es.awaitreg, marky: step.es.marky, markx: step.es.markx, awaitmark: step.es.awaitmark, recording: step.es.recording, macrobuf: step.es.macrobuf, awaitmac: step.es.awaitmac, lastmacro: step.es.lastmacro, lvy: step.es.lvy, lvx: step.es.lvx, lvey: step.es.lvey, lvex: step.es.lvex, lvmode: step.es.lvmode, findc: step.es.findc, findt: step.es.findt, giy: step.es.giy, gix: step.es.gix } }
    else
        step

// ── Marks: m<a-z> set, `<a-z> jump exact, '<a-z> jump line ────────

// Begin a mark prefix (op: 1 set, 2 jump-exact, 3 jump-line).
fn edit_await_mark(ed: Editor, st: InputState, var es: EditState, op: Int) -> EditStep
    EditStep { ed: ed, st: st, es: EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: op, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix } }

// The mark letter after m / ` / ' — set or jump.
fn edit_mark_op(ed: Editor, st: InputState, var es: EditState, b: Int) -> EditStep
    if b >= 'a' and b <= 'z'
        let idx = b - 'a'
        if es.awaitmark == 1                                    // set mark at cursor
            EditStep { ed: ed, st: st, es: EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: util.set_int_at(es.marky, idx, ed.cy), markx: util.set_int_at(es.markx, idx, ed.cx), awaitmark: 0, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix } }
        else                                                    // jump to mark
            let ly = es.marky[idx]
            let nede = if ly < 0 then ed elif es.awaitmark == 2 then clamp(Editor { lines: ed.lines, cy: ly, cx: es.markx[idx] }) else clamp(Editor { lines: ed.lines, cy: ly, cx: first_nonblank(line_at(ed, ly)) })
            EditStep { ed: nede, st: st, es: EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: 0, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix } }
    else
        EditStep { ed: ed, st: st, es: EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: 0, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix } }

fn feed_edit_core(ed: Editor, st: InputState, km: Keymap, var es: EditState, b: Int) -> EditStep
    if es.awaitmark != 0                                        // byte after m / ` / '
        return edit_mark_op(ed, st, var es, b)
    if st.mode == 0 and st.pending == 0 and b == 'm'           // 'm' — set mark
        return edit_await_mark(ed, st, var es, 1)
    if st.mode == 0 and st.pending == 0 and b == '`'           // ` — jump to mark (exact)
        return edit_await_mark(ed, st, var es, 2)
    if st.mode == 0 and st.pending == 0 and b == '\''           // ' — jump to mark (line)
        return edit_await_mark(ed, st, var es, 3)
    if es.awaitreg                                              // byte after `"`
        return edit_select_reg(ed, st, var es, b)
    if st.mode == 0 and st.pending == 0 and b == '"'           // `"` — register prefix
        return edit_await_reg(ed, st, var es)
    edit_persist_reg(feed_edit_inner(ed, st, km, var es, b))

// ── Macros: q<reg> … q record, @<reg> / @@ replay ─────────────
// Recorded keystrokes are stored in the named-register slot (vim shares them),
// so q stop writes `macrobuf` into regs[reg].  Replay re-feeds the bytes
// through feed_edit.  Limitation: `:` / `/` lines inside a macro aren't
// replayed (those are handled by the drivers, not feed).

// Set the await-macro state (1 = after q, 2 = after @).
fn macro_await(var es: EditState, op: Int) -> EditState
    EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: op, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix }

// The register letter after q — begin recording (or cancel on a bad name).
fn macro_start(var es: EditState, b: Int) -> EditState
    let rec = if b >= 'a' and b <= 'z' then b - 'a' + 1 else 0
    EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: rec, macrobuf: "", awaitmac: 0, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix }

// Stop recording — store the recorded keystrokes into the register slot.
fn macro_stop(var es: EditState) -> EditState
    let regs2 = util.set_str_at(es.regs, es.recording - 1, es.macrobuf)
    EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: regs2, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: 0, macrobuf: "", awaitmac: 0, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix }

// Append a keystroke to the in-progress recording.
fn macro_capture(var es: EditState, b: Int) -> EditState
    EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf + str.from_byte(b), awaitmac: 0, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix }

// Clear awaitmac and remember the last replayed register (for @@).
fn macro_done_await(var es: EditState, last: Int) -> EditState
    EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: 0, lastmacro: last, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix }

// The register letter after @ — replay it (`@@` = last) through feed_edit.
fn macro_replay(ed: Editor, st: InputState, km: Keymap, var es: EditState, b: Int) -> EditStep
    let idx = if b == '@' then es.lastmacro - 1 elif b >= 'a' and b <= 'z' then b - 'a' else 0 - 1
    if idx < 0
        return EditStep { ed: ed, st: st, es: macro_done_await(var es, es.lastmacro) }
    let seq = es.regs[idx]
    var e = ed
    var s = st
    var ess = macro_done_await(var es, idx + 1)
    let m = str.len(seq)
    let mut j = 0
    while j < m
        let step = feed_edit(e, s, km, var ess, str.byte_at(seq, j) ?? 0)
        e = step.ed
        s = step.st
        ess = step.es
        j = j + 1
    EditStep { ed: e, st: s, es: ess }

@intent("""The driver-facing edit entry point: wraps feed_edit_core with macro
recording/replay (`q<reg>…q`, `@<reg>`) and remembers the last f/F/t/T target
for `;`/`,`.  Returns an EditStep carrying the new editor, input state, and the
session EditState (registers, marks, undo/redo, dot, macros).""")
fn feed_edit(ed: Editor, st: InputState, km: Keymap, var es: EditState, b: Int) -> EditStep
    if es.awaitmac == 1                                         // byte after q — register
        return EditStep { ed: ed, st: st, es: macro_start(var es, b) }
    if es.awaitmac == 2                                         // byte after @ — replay
        return macro_replay(ed, st, km, var es, b)
    if st.mode == 0 and st.pending == 0 and b == 'q'          // 'q'
        if es.recording != 0
            return EditStep { ed: ed, st: st, es: macro_stop(var es) }
        return EditStep { ed: ed, st: st, es: macro_await(var es, 1) }
    if st.mode == 0 and st.pending == 0 and b == '@'          // '@'
        return EditStep { ed: ed, st: st, es: macro_await(var es, 2) }
    var result = feed_edit_core(ed, st, km, var es, b)
    // A completed f/F/t/T (pending 8-11 + a target character) → remember for ; / ,.
    // The target of a multi-byte character completes on its last byte, and is
    // saved as its code point (see `feed`).
    let fpend = if st.pending >= 256 then st.pending % 256 else st.pending
    let tcomplete = result.st.pending < 256 and ((st.pending < 256 and b < 128) or (st.pending >= 256 and b >= 128 and b < 192))
    var result1 = if fpend >= 8 and fpend <= 11 and b != '\e' and tcomplete
        EditStep { ed: result.ed, st: result.st, es: edit_save_find(var result.es, if st.pending >= 256 then ((st.pending / 256) / 4) * 64 + (b - 128) else b, fpend) }
    else
        result
    // Leaving Visual mode → remember the selection for `gv`.
    var result2 = if (st.mode == 2 or st.mode == 3) and result1.st.mode == 0
        EditStep { ed: result1.ed, st: result1.st, es: edit_save_visual(var result1.es, st, ed) }
    else
        result1
    // A completed yank → "0; a completed linewise delete → the "1-"9 ring.
    // (buf_text is only computed when the unnamed register actually changed.)
    let regchg = str.len(result2.st.reg) > 0 and result2.st.reg != st.reg and result2.st.mode == 0 and result2.st.pending == 0 and result2.st.count == 0
    var result3 = if regchg and buf_text(result2.ed) == buf_text(ed)
        EditStep { ed: result2.ed, st: result2.st, es: edit_numreg_yank(var result2.es, result2.st.reg, result2.st.reg_lw) }
    elif regchg and result2.st.reg_lw
        EditStep { ed: result2.ed, st: result2.st, es: edit_numreg_del(var result2.es, result2.st.reg) }
    elif regchg
        EditStep { ed: result2.ed, st: result2.st, es: edit_numreg_small(var result2.es, result2.st.reg) }
    else
        result2
    // Leaving Insert mode → remember the position for `gi` (ed = pre-Esc cursor).
    var result4 = if st.mode == 1 and result3.st.mode == 0
        EditStep { ed: result3.ed, st: result3.st, es: edit_save_gi(var result3.es, ed) }
    else
        result3
    if es.recording != 0                                       // capture the keystroke
        return EditStep { ed: result4.ed, st: result4.st, es: macro_capture(var result4.es, b) }
    result4

@intent("""`--batch <keys> <file>` entry point: load the file, feed each decoded
key through the same edit pipeline as interactive mode (no TUI, no LSP), and
print the resulting buffer + cursor.  Deterministic — the test harness drives
editor behaviour through this path.

The picker and the pins live here too, driven through the same widget functions
the TUI uses (files_candidates / fuzzy.rank / picker_off / picker_window /
pins_put), because their behaviour is otherwise only observable through a pty
and therefore only assertable against wall-clock timing.  A picker still open
when the keys run out prints its window after the buffer; a pin command prints
the note it would have put on the status line.  The parameter is `fpath`, not
`path`: a parameter named `path` shadows the stdlib module of that name, and
the pin code needs `path.join`.""")
fn run_batch(keys: Str, cfg_path: Str, fpath: Str) [io, fs, time]
    var ed = Editor { lines: buf_load(fpath), cy: 0, cx: 0 }
    var curpath = fpath
    var st = ist_new()
    var es = edit_new()
    // The TOML `[keymaps]`, plus, when `[keymaps] import_nvim = true`, the Alt
    // chords and the Insert-mode maps that type text (`aa` → å) scraped from the
    // Neovim config.  The other imported maps have `:` commands and multi-key
    // sequences for right-hand sides, which the interactive driver runs and this
    // loop does not, so they stay out.
    let km = if keymaps_import_nvim(cfg_path) then keymap_with_chords(load_keymaps(cfg_path), import_nvim_keymaps(default_nvim_dir(), keymap_empty())) else load_keymaps(cfg_path)
    var opts = load_options(cfg_path)    // tabstop/expandtab drive edits, not just render
    let batch_rows = term_rows()         // 24 off-tty — makes paging deterministic
    let pins_root = project_root()
    let pins0 = pins_load(pins_root)
    var pins_p = pins0.p[:]
    var pins_y = pins0.y[:]
    var pins_x = pins0.x[:]
    var pnote = ""                       // what a pin command would show in the status line
    var picker_active = false
    var picker_src = 0                   // 0 :bufs · 1 :files · 2 :pins
    var picker_query = ""
    var picker_sel = 0
    var picker_cands: [Str] = []
    var picker_marks: [Str] = []
    var picker_meta: [Str] = []
    // The repaint decision, run headlessly.  --batch draws nothing, but it feeds
    // its keys with no gaps between them — which is exactly the condition that
    // starves a queue-emptiness redraw loop — so running throttle.should_render
    // over the same key stream reports how many frames the interactive driver
    // would have presented for it.  `frames=` is printed with the picker state.
    let bbudget = frame_budget()
    var bframes = 0
    var blast = now_ms()
    var bmoved = false
    var decoded = decode_escapes(batch_meta_marks(keys))
    // `:help` in --batch: the batch has one buffer and no windows, so the help
    // buffer replaces it (and `q` / `:close` puts it back) instead of splitting.
    var hb_on = false
    var hb_text = ""                      // the help text, to keep the buffer read-only
    var hb_lines: [Str] = []              // the buffer set aside while help is shown
    var hb_path = ""
    var hb_cy = 0
    var hb_cx = 0
    var cmd_mode = false
    var cmd_buf = ""
    var rng_vlo = 0 - 1                   // visual-selection line bounds for `'<,'>`
    var rng_vhi = 0 - 1                   //   (-1 = no active selection)
    var search_mode = false
    var search_buf = ""
    var search_back = false
    var last_subst = ""
    var quit = false
    var n = str.len(decoded)
    var bq = ""                                  // bytes to feed before the next key of `decoded`: a map's RHS, flushed keys
    var bpend = ""                               // Insert-mode keys held as the start of a longer map
    let mut i = 0
    while (i < n or str.len(bq) > 0 or str.len(bpend) > 0) and not quit
        var b = 0
        var from_q = false                       // b came from bq: typed text, not matched again
        var skip = false                         // this step consumed its key without feeding it
        if str.len(bq) > 0
            b = str.byte_at(bq, 0) ?? 0
            bq = str.slice(bq, 1, str.len(bq))
            from_q = true
        elif i >= n                              // no keys left with some held: the wait never ends
            bq = bpend
            bpend = ""
            skip = true
        else
            b = str.byte_at(decoded, i) ?? 0
            let rep: [Int] = if b == 27 and not picker_active then batch_csi_u(decoded, i) else []
            if b == 255 and i + 1 < n                // `\M<key>`: an Alt chord, ESC and the key arriving together
                let cb = str.byte_at(decoded, i + 1) ?? 0
                let mcb = if picker_active then 0 - 1 else map_class(st.mode, cmd_mode or search_mode)
                let mi = meta_idx(km, mcb, cb)
                // A mapped chord becomes its RHS; an unmapped one becomes ESC and the
                // key, as two keys, which is what the interactive loop does with it.
                // Keys held as the start of a map are typed first.
                bq = bpend + (if mi >= 0 then km.rhs[mi] else str.from_byte('\e') + str.from_byte(cb))
                bpend = ""
                i = i + 1
                skip = true
            elif b == 254                            // `\T`: 'timeoutlen' passes with no key
                bq = bpend
                bpend = ""
                skip = true
            elif list.len(rep) == 3
                // A kitty key report: the key it stands for, typed after any held keys.
                let kmods = rep[1]
                let kbytes = kitty_keybytes(rep[0], kmods)
                var typed = kbytes
                if kitty_alt(kmods) and str.len(kbytes) > 0
                    let mcb = map_class(st.mode, cmd_mode or search_mode)
                    let mi = meta_idx_str(km, mcb, kbytes)
                    typed = if mi >= 0 then km.rhs[mi] else str.from_byte('\e') + kbytes
                bq = bpend + typed
                bpend = ""
                i = i + rep[2] - 1
                skip = true
        // Insert-mode maps of two or more keys, held and matched as the interactive
        // loop does it (the timeout is the `\T` mark).
        if not skip and not from_q and st.mode == 1 and not picker_active and not cmd_mode and not search_mode
            let cand = bpend + str.from_byte(b)
            let ei = keymap_seq_idx(km, cand, 2)
            if ei >= 0
                bq = km.rhs[ei]
                bpend = ""
                skip = true
            elif keymap_is_prefix(km, cand, 2)
                bpend = cand
                skip = true
            elif str.len(bpend) > 0
                bq = cand
                bpend = ""
                skip = true
        if skip
            quit = quit                          // consumed by the matcher or a mark; nothing is fed
        elif picker_active                       // modal picker input, as in the TUI
            if b == '\r'                         // Enter — act on the selection
                // Rank only as deep as the selection: the acted-on row is the
                // LAST of that prefix, whatever the window shows.
                let ptop = fuzzy.rank(picker_query, picker_cands, picker_sel + 1)
                if picker_sel < list.len(ptop)
                    let target = picker_meta[ptop[picker_sel]]
                    if target != curpath
                        curpath = target
                        ed = Editor { lines: buf_load(target), cy: 0, cx: 0 }
                    if picker_src == 2           // pins restore the pinned cursor
                        var pjs = 0
                        while pjs < list.len(pins_p)
                            if rel_of(pins_p[pjs]) == target
                                ed = clamp(Editor { lines: ed.lines, cy: pins_y[pjs], cx: pins_x[pjs] })
                            pjs = pjs + 1
                picker_active = false
            elif b == '\e'                       // Esc — dismiss
                picker_active = false
            elif b == '\x0b' or b == '\x10'      // Ctrl-K / Ctrl-P — toward worse ranks
                let pcnt = fuzzy.match_count(picker_query, picker_cands)
                if picker_sel + 1 < pcnt
                    picker_sel = picker_sel + 1
                bmoved = true
            elif b == '\x0a' or b == '\x0e'      // Ctrl-J / Ctrl-N — toward better ranks
                if picker_sel > 0
                    picker_sel = picker_sel - 1
                bmoved = true
            elif b == '\x7f' or b == '\b'        // Backspace — shrink the query
                if str.len(picker_query) > 0
                    picker_query = str.slice(picker_query, 0, str.len(picker_query) - 1)
                    picker_sel = 0
                bmoved = true
            elif b >= ' ' and b < '\x7f'         // type — extend the query, re-rank
                picker_query = picker_query + str.from_byte(b)
                picker_sel = 0
                bmoved = true
        elif cmd_mode
            if b == '\r' or b == '\n'            // Enter — run the command
                if excmd.is_substitute(cmd_buf)
                    es = edit_push_undo(var es, ed)
                    ed = ex_substitute(ed, cmd_buf)
                    last_subst = cmd_buf
                elif excmd.is_global(cmd_buf)
                    es = edit_push_undo(var es, ed)
                    ed = ex_global(ed, cmd_buf)
                elif excmd.is_sort(cmd_buf)
                    es = edit_push_undo(var es, ed)
                    ed = ex_sort(ed, cmd_buf, rng_vlo, rng_vhi)
                elif excmd.move_kind(cmd_buf) != 0
                    es = edit_push_undo(var es, ed)
                    ed = ex_linemove(ed, cmd_buf, excmd.move_kind(cmd_buf) == 2, rng_vlo, rng_vhi)
                elif excmd.is_delete(cmd_buf)
                    es = edit_push_undo(var es, ed)
                    ed = ex_delete(ed, cmd_buf, rng_vlo, rng_vhi)
                elif excmd.shift_amount(cmd_buf) != 0
                    es = edit_push_undo(var es, ed)
                    ed = ex_shift(ed, cmd_buf, rng_vlo, rng_vhi, opts.expandtab, opts.tabstop)
                elif excmd.is_yank(cmd_buf)
                    let rs = excmd.parse_range(cmd_buf, rng_vlo, rng_vhi, ed.cy, list.len(ed.lines))
                    let ylo = if rs.has then rs.lo else ed.cy
                    let yhi = if rs.has then rs.hi else ed.cy
                    let ytext = range_yank_text(ed.lines, ylo, yhi)
                    st = ist_set_reg(st, ytext, true)        // linewise → unnamed register
                    es = edit_numreg_yank(var es, ytext, true)
                    ed = clamp(Editor { lines: ed.lines, cy: yhi, cx: 0 })
                elif excmd.is_retab(cmd_buf)
                    es = edit_push_undo(var es, ed)
                    ed = ex_retab(ed, cmd_buf, rng_vlo, rng_vhi, opts.tabstop)
                elif is_set(cmd_buf)
                    opts = apply_set(opts, cmd_buf)   // tabstop/expandtab affect edits in batch too
                elif excmd.is_goto(cmd_buf)
                    ed = ex_goto(ed, cmd_buf)
                elif exhelp.is_help(cmd_buf)         // :help [topic] — the Ex command cheat sheet
                    hb_text = exhelp.help_text(exhelp.help_topic(cmd_buf), 74)
                    if not hb_on
                        hb_on = true
                        hb_lines = ed.lines[:]
                        hb_path = curpath
                        hb_cy = ed.cy
                        hb_cx = ed.cx
                    curpath = exhelp.help_path()
                    ed = Editor { lines: str.split_lines(hb_text), cy: 0, cx: 0 }
                elif hb_on and excmd.is_winclose(cmd_buf)   // :close / :q in the help window
                    hb_on = false
                    curpath = hb_path
                    ed = clamp(Editor { lines: hb_lines, cy: hb_cy, cx: hb_cx })
                elif excmd.is_files(cmd_buf)         // :files [query] — the file picker
                    picker_active = true
                    picker_src = 1
                    picker_query = excmd.files_query(cmd_buf)
                    picker_sel = 0
                    picker_cands = files_candidates(10000)
                    picker_marks = []
                    picker_meta = []
                    var pfi = 0
                    while pfi < list.len(picker_cands)
                        picker_marks = list.push(picker_marks, "  ")
                        picker_meta = list.push(picker_meta, picker_cands[pfi])
                        pfi = pfi + 1
                elif excmd.is_bufs(cmd_buf)          // :bufs — batch holds one buffer
                    picker_active = true
                    picker_src = 0
                    picker_query = ""
                    picker_sel = 0
                    picker_cands = [curpath]
                    picker_marks = ["% "]
                    picker_meta = [curpath]
                elif excmd.is_pins(cmd_buf)          // :pins — the pin picker
                    picker_active = true
                    picker_src = 2
                    picker_query = ""
                    picker_sel = 0
                    picker_cands = []
                    picker_marks = []
                    picker_meta = []
                    var ppi = 0
                    while ppi < list.len(pins_p)
                        if str.len(pins_p[ppi]) > 0
                            picker_cands = list.push(picker_cands, rel_of(pins_p[ppi]))
                            picker_marks = list.push(picker_marks, str.from_int(ppi + 1) + " ")
                            picker_meta = list.push(picker_meta, rel_of(pins_p[ppi]))
                        ppi = ppi + 1
                elif excmd.is_pinjump(cmd_buf)       // :pinjump N — jump to slot N
                    let jsl = excmd.pin_slot_arg(cmd_buf)
                    if jsl >= 1 and jsl <= list.len(pins_p) and str.len(pins_p[jsl - 1]) > 0
                        let jp = rel_of(pins_p[jsl - 1])
                        if pins_p[jsl - 1] != abs_of(curpath)
                            curpath = jp
                            ed = Editor { lines: buf_load(jp), cy: 0, cx: 0 }
                        ed = clamp(Editor { lines: ed.lines, cy: pins_y[jsl - 1], cx: pins_x[jsl - 1] })
                        pnote = "pin [" + str.from_int(jsl) + "] " + util.basename_of(jp)
                    else
                        pnote = "pin [" + str.from_int(jsl) + "]: empty"
                elif excmd.is_unpin(cmd_buf)         // :unpin [N] — remove a pin
                    let usl = excmd.pin_slot_arg(cmd_buf)
                    let utgt = if usl >= 1 then usl - 1 else pins_slot_of(pins_p, abs_of(curpath))
                    if utgt >= 0 and utgt < list.len(pins_p) and str.len(pins_p[utgt]) > 0
                        pins_p = util.set_str_at(pins_p, utgt, "")
                        pins_save(pins_root, pins_p, pins_y, pins_x)
                        pnote = "unpinned [" + str.from_int(utgt + 1) + "]"
                    else
                        pnote = "unpin: no pin"
                elif excmd.is_pin(cmd_buf)           // :pin [N] — pin the current file
                    let psl = excmd.pin_slot_arg(cmd_buf)
                    let pabs = abs_of(curpath)
                    let phave = pins_slot_of(pins_p, pabs)
                    if psl == 0 and phave >= 0
                        pnote = "already pinned [" + str.from_int(phave + 1) + "]"
                    else
                        let pslot = if psl >= 1 then psl - 1 else pins_free_slot(pins_p)
                        let pnew = pins_put(Pins { p: pins_p, y: pins_y, x: pins_x }, pslot, pabs, ed.cy, ed.cx)
                        pins_p = pnew.p[:]
                        pins_y = pnew.y[:]
                        pins_x = pnew.x[:]
                        pins_save(pins_root, pins_p, pins_y, pins_x)
                        pnote = "pinned [" + str.from_int(pslot + 1) + "] " + util.basename_of(curpath)
                else
                    let r = excmd.exec_ex(cmd_buf)
                    if r.save and curpath == exhelp.help_path()
                        pnote = "E382: cannot write, the help buffer is not a file"
                    elif r.save
                        if not save_buf(curpath, ed.lines)
                            pnote = write_failed_msg(curpath)
                    if r.quit
                        quit = true
                cmd_mode = false
                cmd_buf = ""
            elif b == '\e'                     // Esc — cancel
                cmd_mode = false
                cmd_buf = ""
            elif b == '\x7f' or b == '\b'          // Backspace
                if str.len(cmd_buf) > 0
                    cmd_buf = str.slice(cmd_buf, 0, util.u8_prev(cmd_buf, str.len(cmd_buf)))
            elif (b >= ' ' and b < '\x7f') or (b >= 128 and b < 256)
                cmd_buf = cmd_buf + str.from_byte(b)
        elif search_mode
            if b == '\r' or b == '\n'            // Enter — run the search
                st = ist_set_search(st, search_buf)
                ed = find_next(ed, search_buf, not search_back)
                search_mode = false
                search_buf = ""
            elif b == '\e'                     // Esc — cancel
                search_mode = false
                search_buf = ""
            elif b == '\x7f' or b == '\b'
                if str.len(search_buf) > 0
                    search_buf = str.slice(search_buf, 0, util.u8_prev(search_buf, str.len(search_buf)))
            elif (b >= ' ' and b < '\x7f') or (b >= 128 and b < 256)
                search_buf = search_buf + str.from_byte(b)
        elif hb_on and st.mode == 0 and b == 'q' and scroll_idle(st, es)   // q in the help buffer closes it
            hb_on = false
            curpath = hb_path
            ed = clamp(Editor { lines: hb_lines, cy: hb_cy, cx: hb_cx })
        elif b == 58 and st.mode == 0        // ':' — open the Ex line
            cmd_mode = true
            cmd_buf = ""
            rng_vlo = 0 - 1
            rng_vhi = 0 - 1
        elif b == 58 and (st.mode == 2 or st.mode == 3 or st.mode == 5)   // ':' in Visual — prefill '<,'>
            rng_vlo = if st.avy < ed.cy then st.avy else ed.cy
            rng_vhi = if st.avy > ed.cy then st.avy else ed.cy
            st = ist_done(st)                // leave Visual for the Ex line
            cmd_mode = true
            cmd_buf = "'<,'>"
        elif b == 47 and st.mode == 0        // '/' — search forward
            search_mode = true
            search_buf = ""
            search_back = false
        elif b == 63 and st.mode == 0        // '?' — search backward
            search_mode = true
            search_buf = ""
            search_back = true
        elif scroll_idle(st, es) and key_free(km, b) and scroll_ctrl_kind(b) >= 0   // Ctrl-D/U/F/B paging
            ed = move_rows(ed, scroll_new_cy(ed, batch_rows, scroll_ctrl_kind(b)))
        elif scroll_idle(st, es) and key_free(km, b) and screen_kind(b) >= 0        // H / M / L (top=0 in batch)
            let ty = screen_target(0, batch_rows, list.len(ed.lines), screen_kind(b))
            ed = clamp(Editor { lines: ed.lines, cy: ty, cx: first_nonblank(line_at(ed, ty)) })
        elif scroll_idle(st, es) and key_free(km, b) and b == '&' and str.len(last_subst) > 0   // & — repeat last :s on this line
            es = edit_push_undo(var es, ed)
            ed = ex_substitute(ed, excmd.subst_current_line(last_subst))
        elif b == '\t' and (st.mode == 1 or st.mode == 4) and opts.expandtab
            // expandtab: Tab in Insert/Replace inserts `tabstop` spaces.
            var sp = 0
            while sp < opts.tabstop
                let estep = feed_edit(ed, st, km, var es, ' ')
                ed = estep.ed
                st = estep.st
                es = estep.es
                sp = sp + 1
        else
            let estep = feed_edit(ed, st, km, var es, b)
            ed = estep.ed
            st = estep.st
            es = estep.es
        if hb_on and buf_text(ed) != hb_text   // the help buffer is not modifiable
            ed = clamp(Editor { lines: str.split_lines(hb_text), cy: ed.cy, cx: ed.cx })
            st = ist_done(st)
            pnote = "E21: read-only"
        // Ask the throttle the same question the interactive drain asks: with
        // more keys still queued and the picker moved, has the budget run out?
        if picker_active and throttle.should_render(now_ms(), blast, bbudget, i + 1 < n, bmoved)
            bframes = bframes + 1
            blast = now_ms()
            bmoved = false
        if not from_q
            i = i + 1
    let mut li = 0
    let nl = list.len(ed.lines)
    while li < nl
        println(ed.lines[li])
        li = li + 1
    println("cursor=" + str.from_int(ed.cy) + ":" + str.from_int(ed.cx))
    // Everything below is emitted only by a run that used one of these
    // surfaces, so the buffer + `cursor=` dump keeps its exact old shape for
    // every other run.  Rows are listed best-rank-first (the overlay draws the
    // same window bottom-up); `>` marks the selection, which is in the window
    // by construction.
    if picker_active
        let bmaxh = picker_maxh(batch_rows)
        let bmatch = fuzzy.match_count(picker_query, picker_cands)
        var bsel = picker_sel
        if bsel >= bmatch
            bsel = if bmatch > 0 then bmatch - 1 else 0
        let boff = picker_off(bsel, bmaxh)
        let bwin = picker_window(fuzzy.rank(picker_query, picker_cands, boff + bmaxh), boff, bmaxh)
        let btitle = if picker_src == 0 then "Buffers" elif picker_src == 1 then "Find Files" else "Pins"
        println("picker=" + btitle + " sel=" + str.from_int(bsel) + " off=" + str.from_int(boff) + " n=" + str.from_int(bmatch) + " maxh=" + str.from_int(bmaxh))
        var bri = 0
        while bri < list.len(bwin)
            println((if bri + boff == bsel then "> " else "  ") + picker_marks[bwin[bri]] + picker_cands[bwin[bri]])
            bri = bri + 1
        println("frames=" + str.from_int(bframes))
    if str.len(pnote) > 0
        println("note=" + pnote)

// ── Interactive TUI ─────────────────────────────────────────────

fn emit_byte(b: Int) [io]
    let _ = novo_pty_stdout_write_byte_h(b)

// Write a string to stdout byte-by-byte (raw mode — no libc buffering
// surprises with control sequences).
fn emit(s: Str) [io]
    let n = str.len(s)
    let mut i = 0
    while i < n
        emit_byte(str.byte_at(s, i) ?? 0)
        i = i + 1

// ESC [ — start a CSI sequence.  ESC is spelled as byte 27 rather than
// a string escape (Novo source convention; see novomux/render.nv).
fn csi() [io]
    emit_byte('\e')
    emit_byte(91)         // '['

fn cup(row: Int, col: Int) [io]   // 1-based cursor position
    csi()
    emit(str.from_int(row) + ";" + str.from_int(col) + "H")

fn sgr(code: Str) [io]            // ESC [ <code> m
    csi()
    emit(code + "m")

fn el() [io]                      // ESC [ K — erase from cursor to end of line
    csi()
    emit("K")

// End-of-row clear for one window's row.  A window flush against the terminal's
// right edge can erase to end-of-line (`el`) cheaply; a window with a neighbour
// to its right (a vsplit's left pane) must NOT — `el` would wipe the neighbour —
// so it pads with `pad` spaces to its own right edge instead.  `clip` is true
// exactly when the window's right edge is left of the terminal's.
fn eol(clip: Bool, pad: Int) [io]
    if clip
        if pad > 0
            emit(disp.nspaces(pad))
    else
        el()

// DECSCUSR — set the cursor shape to match the mode: a steady block for
// Normal/Visual, a steady bar (I-beam) for Insert, a steady underline for
// Replace.  `ESC [ <n> SP q`; n=2 block, n=6 bar, n=4 underline.
fn cursor_shape(mode: Int) [io]
    csi()
    if mode == 1
        emit("6 q")          // insert → bar
    elif mode == 4
        emit("4 q")          // replace → underline
    else
        emit("2 q")          // normal / visual → block

// Tab/column geometry (is_utf8_cont / expand_tabs / vis_col / hscroll_to) moved
// to disp.nv (pure display helpers).

// Clear the whole screen (ESC [ 2J).  Only used once at startup and on a
// resize — NOT per frame: a per-frame clear blanks the screen between the
// erase and the repaint, which the eye sees as flicker on every keystroke.
fn clear_screen() [io]
    csi()
    emit("2J")

// Open a frame.  Every byte of a redraw — buffer, command line, list overlay,
// picker — must sit between frame_begin and frame_end, because a redraw is a
// STACK of layers and the terminal will happily present the lower ones on their
// own: each layer is written as it is computed, so an overlay drawn after the
// buffer arrives one presentation late and the buffer shows through it.  DEC
// private mode 2026 (synchronized output) makes the terminal hold everything
// until the frame closes and then swap it in as one image; the cursor is hidden
// for the whole frame so it cannot be seen parked in a lower layer either.
// Terminals without mode 2026 ignore both sequences and lose only the atomicity.
fn frame_begin() [io]
    csi()
    emit("?2026h")
    csi()
    emit("?25l")

// Close the frame: restore the cursor, then let the terminal present.
fn frame_end() [io]
    csi()
    emit("?25h")
    csi()
    emit("?2026l")

// Milliseconds off the monotonic clock.  The frame budget is a duration, and a
// duration may only be measured against a clock that cannot step — see the
// stdlib `time` module on why `Instant` differences are not durations.
fn now_ms() -> Int [time]
    time.ticks_us() / 1000

// The repaint budget in force, in milliseconds.  `NOVIM_FRAME_BUDGET_MS`
// overrides throttle.frame_budget_ms so a driver can pin the cadence instead of
// racing the clock: 0 paints on every pending move, a very large value never
// interrupts a drain.  A value that is not an integer falls back to the default.
fn frame_budget() -> Int [io]
    let e = process.env("NOVIM_FRAME_BUDGET_MS") ?? ""
    if str.len(e) == 0
        return throttle.frame_budget_ms()
    str.to_int(e) ?? throttle.frame_budget_ms()

// Enter the editor's terminal mode: the alternate screen buffer (so the
// editor has no scrollback for the mouse wheel to bleed into, and the
// shell's screen is restored on exit) + SGR mouse reporting (so the scroll
// wheel is delivered to novim as `ESC[<64;…M` / `ESC[<65;…M` rather than
// scrolling the terminal).
// OSC 12 sets the terminal's cursor colour; OSC 112 puts it back.  The
// palette names the cursor block as amber's own (rule 1: amber is where
// something is acting, and in an editor the cursor IS the actor).  A
// terminal that does not implement OSC 12 ignores the sequence, so this
// degrades to whatever cursor colour the user already had.
fn cursor_color_set() [io]
    emit_byte(27)
    emit("]12;#fbbf24")
    emit_byte(7)

fn cursor_color_reset() [io]
    emit_byte(27)
    emit("]112")
    emit_byte(7)

fn term_enter(want_color: Bool) [io]
    csi()
    emit("?1049h")        // alternate screen buffer
    csi()
    emit("?1000h")        // mouse button tracking (covers the wheel)
    csi()
    emit("?1006h")        // SGR extended mouse coordinates
    // The kitty keyboard protocol: push flag 1 (Alt and Ctrl chords and Escape
    // come as `CSI code ; mods u`), then ask what is in force.  A terminal that
    // does not know it drops both and sends no answer; the loop then keeps
    // reading the ESC form of a chord.
    csi()
    emit(">1u")
    csi()
    emit("?u")
    if want_color
        cursor_color_set()

// Restore the terminal: disable mouse reporting and leave the alternate
// screen (bringing back whatever the shell was showing before novim ran).
fn term_leave(want_color: Bool) [io]
    if want_color
        cursor_color_reset()
    csi()
    emit("<u")            // give back the keyboard-protocol flags pushed in term_enter
    csi()
    emit("?1000l")
    csi()
    emit("?1006l")
    csi()
    emit("?1049l")

// Flicker-free full repaint.  Instead of clearing the screen (which blanks
// then repaints — visible flicker on every cursor move), we hide the cursor,
// overwrite every row in place, and erase each row's tail with ESC [ K so no
// stale glyphs from a longer previous line survive.  Draws up to (rows-1)
// buffer lines (a `~` past end-of-buffer), a reverse-video status line on the
// last row, then places the hardware cursor at the editor cursor.
// Emit visual columns [left, left+width) of an (already tab-expanded) line,
// reverse-videoing the selected visual-column span [vlo, vhi) (vlo>=vhi → no
// highlight, e.g. outside visual mode).
fn emit_line_hl(expanded: Str, left: Int, width: Int, vlo: Int, vhi: Int) [io]
    let elen = str.len(expanded)
    let endc = if left + width < elen then left + width else elen
    var c = left
    var insel = false
    while c < endc
        let want = c >= vlo and c < vhi
        if want and not insel
            sgr("7")
            insel = true
        if not want and insel
            sgr("0")
            insel = false
        emit_byte(str.byte_at(expanded, c) ?? ' ')
        c = c + 1
    if insel
        sgr("0")

// Is visual column `c` inside any [start,end) range of the flat list `sr`?
fn col_in_ranges(sr: [Int], c: Int) -> Bool
    var k = 0
    let m = list.len(sr)
    while k + 1 < m
        if c >= sr[k] and c < sr[k + 1]
            return true
        k = k + 2
    false

// Convert a regex match's byte ranges on `raw` to visual-column ranges.
fn search_vis_ranges(atoms: [nvregex.ReAtom], raw: Str, ts: Int) -> [Int]
    let br = nvregex.re_match_ranges(atoms, raw)
    var out: [Int] = []
    var k = 0
    let m = list.len(br)
    while k + 1 < m
        out = list.append(out, [disp.vis_col(raw, br[k], ts)])
        out = list.append(out, [disp.vis_col(raw, br[k + 1], ts)])
        k = k + 2
    out

// The Novo tokenizer + per-column syntax colours (nv_ident_start/char/keyword,
// syntax_colors), the tree-sitter capture→colour mapping (ts_color_for_kind,
// ts_line_syncols), and byte_offset_of_line all moved to disp.nv (pure display
// helpers).

// Paint a line: syntax colours (`syncols`, per-column fg index) as the base,
// search matches (`sr`/`scol`) over them, and the [vlo,vhi) highlight on top.
// `hlcol` is that top slot's SGR — the caller resolved it from the theme as
// the Visual-selection colour or the yank-flash colour, the two never
// coexisting.  Both `scol` and `hlcol` are SGR parameter strings, not colour
// indices, because a slot may be a fg/bg pair or plain reverse video.
fn emit_line_styled(expanded: Str, left: Int, width: Int, vlo: Int, vhi: Int, sr: [Int], scol: Str, syncols: [Int], hlcol: Str) [io]
    let elen = str.len(expanded)
    let endc = if left + width < elen then left + width else elen
    let sn = list.len(syncols)
    var c = left
    var cur = 0                      // 0 none, 1 selection/flash, 2 search, 1000+idx syntax
    while c < endc
        let want = if c >= vlo and c < vhi
            1
        elif col_in_ranges(sr, c)
            2
        elif c < sn and syncols[c] > 0
            1000 + syncols[c]
        else
            0
        if want != cur
            sgr("0")
            if want == 1
                sgr(hlcol)
            elif want == 2
                sgr(scol)
            elif want >= 1000
                sgr(colorscheme.fg_params(want - 1000))
            cur = want
        emit_byte(str.byte_at(expanded, c) ?? ' ')
        c = c + 1
    if cur != 0
        sgr("0")

// Highlight Novo source (`.nv`).
fn ends_with_nv(p: Str) -> Bool
    let n = str.len(p)
    n >= 3 and str.slice(p, n - 3, n) == ".nv"

// ── Yank flash (vim's `on_yank` highlight) ───────────────────────────────────
// A transient highlight over the just-yanked region, shown for ~150ms after a
// yank.  Reuses the Visual selection's reverse-video render slot (yank flash and
// Visual mode never coexist).  `lw` = linewise (highlight whole lines).
struct Flash
    active: Bool
    sy:     Int
    sx:     Int
    ey:     Int
    ex:     Int
    lw:     Bool

fn flash_none() -> Flash
    Flash { active: false, sy: 0, sx: 0, ey: 0, ex: 0, lw: false }

// A linewise flash spanning whole lines [lo..hi] (for `:y` / `:yank`).
fn flash_lines(lo: Int, hi: Int) -> Flash
    Flash { active: true, sy: lo, sx: 0, ey: hi, ex: 0, lw: true }

// Linewise register text for lines [lo..hi] — joined with '\n' (separator, no
// trailing newline), matching `join_lines` so `p`/`P` treat it linewise.
fn range_yank_text(lines: [Str], lo: Int, hi: Int) -> Str
    var acc = ""
    var i = lo
    while i <= hi
        if i > lo
            acc = acc + str.from_char('\n')
        acc = acc + lines[i]
        i = i + 1
    acc

@intent("""Build the flash region for a just-completed yank.  The post-yank
cursor (cy, cx) is the top-left of the yanked text (vim leaves it there); the
register text + linewise flag give the extent.""")
fn flash_from_yank(cy: Int, cx: Int, reg: Str, lw: Bool) -> Flash
    if lw
        var nlf = 0                          // count the register's newlines
        var i = 0
        let n = str.len(reg)
        while i < n
            if (str.byte_at(reg, i) ?? 0) == '\n'
                nlf = nlf + 1
            i = i + 1
        // linewise registers are newline-SEPARATED (`join_lines`: N lines, N-1
        // '\n'), but some paths add a trailing '\n' — count both shapes.
        let ends_nl = n > 0 and (str.byte_at(reg, n - 1) ?? 0) == '\n'
        let cnt = if ends_nl then nlf else nlf + 1
        Flash { active: true, sy: cy, sx: 0, ey: cy + cnt - 1, ex: 0, lw: true }
    else
        let segs = str.split(reg, str.from_char('\n'))
        let nseg = list.len(segs)
        if nseg <= 1
            Flash { active: true, sy: cy, sx: cx, ey: cy, ex: cx + str.len(reg) - 1, lw: false }
        else
            Flash { active: true, sy: cy, sx: cx, ey: cy + nseg - 1, ex: str.len(segs[nseg - 1]) - 1, lw: false }

@intent("""Draw ONE window's frame into its rect: the text viewport (scrolled
to `top`/`left`, optional line-number gutter, tab expansion, Novo syntax
highlighting, search-match and visual-selection highlighting, per-line
diagnostic colouring) plus that window's status line.  All positioning is
offset by the window origin (rx, ry) and bounded to the window size (cols,
rows); for a single full-screen window (rx=ry=0) these reduce to absolute
coordinates.  Does NOT touch cursor visibility or place the hardware cursor —
the orchestrator (`render` / `render_all`) hides the cursor once, draws every
window, then places it in the active window.""")
fn draw_window(ed: Editor, win: wlayout.Rect, path: Str, top: Int, left: Int, mode: Int, avy: Int, avx: Int, search: Str, cs: colorscheme.Colorscheme, opts: Options, diag_li: [Int], diag_msgs: [Str], info: Str, modified: Bool, clip: Bool, active: Bool, ts_spans: [Int], flash: Flash) [io]
    let rows = win.h
    let cols = win.w
    let rx = win.x
    let ry = win.y
    let body = rows - 1
    let nl = list.len(ed.lines)
    let dohl = opts.hlsearch and str.len(search) > 0     // search highlighting
    let satoms = if dohl then nvregex.re_compile(search) else []
    let dosyn = opts.syntax and ends_with_nv(path)        // Novo syntax highlighting
    let synkw = util.cs_or(cs.kw_fg, 170)
    let synstr = util.cs_or(cs.str_fg, 150)
    let syncmt = util.cs_or(cs.cmt_fg, 245)
    let synnum = util.cs_or(cs.num_fg, 215)
    // Chrome slots, resolved once per window rather than per painted cell.
    let selcol = colorscheme.sel_sgr(cs)          // Visual selection
    let searchcol = colorscheme.search_sgr(cs)    // `hlsearch` match
    let flashcol = colorscheme.flash_sgr(cs)      // yank flash
    let gerr = cs.hl.err_fg                       // gutter: diagnostic severity 1
    let gwarn = cs.hl.warn_fg                     // gutter: severity >= 2
    let gcur = cs.hl.curline_fg                   // gutter: the cursor line
    let numbered = opts.number or opts.relativenumber
    // Gutter width tracks the largest line number (min 3 digits) so the text
    // column stays put when the cursor crosses a digit boundary on a 1000+
    // line file — numbers are right-aligned (least-significant digit fixed).
    let numw = if disp.num_digits(nl) > 3 then disp.num_digits(nl) else 3
    let gutter = if numbered then numw + 1 else 0
    let width = if cols - gutter > 0 then cols - gutter else 1   // text area width
    // Normalised visual selection bounds (start <= end), used for highlighting.
    let a_first = avy < ed.cy or (avy == ed.cy and avx <= ed.cx)
    let ssy = if a_first then avy else ed.cy
    let ssx = if a_first then avx else ed.cx
    let sey = if a_first then ed.cy else avy
    let sex = if a_first then ed.cx else avx
    let vis = mode == 2 or mode == 3 or mode == 5
    // Blockwise (mode 5) selects a column rectangle: the same character-column
    // band on every selected row, so the highlight bounds come from min/max of
    // the two corners' character columns rather than the per-line charwise
    // start/end.  Each row turns the band into its own bytes (util.u8_fwd).
    let bcols = vblock_cols(ed, avy, avx)
    let bxlo = bcols.lo
    let bxhi = bcols.hi
    // `r` = screen row, `li` = buffer line.  With `wrap` a long line occupies
    // several screen rows, so the two are tracked separately.
    var r = 0
    var li = top
    let dots = list.len(ts_spans) > 0            // tree-sitter spans available for this buffer
    var line_byte = disp.byte_offset_of_line(ed.lines, top)   // byte offset of the first visible line
    while r < body
        if li < nl
            let raw = ed.lines[li]
            let expanded = disp.expand_tabs(raw, opts.tabstop)
            let vlen = str.len(expanded)
            var vlo = 0
            var vhi = 0
            if vis and li >= ssy and li <= sey
                if mode == 3
                    vlo = 0
                    vhi = vlen
                elif mode == 5
                    vlo = disp.vis_col(raw, util.u8_fwd(raw, 0, bxlo), opts.tabstop)
                    vhi = disp.vis_col(raw, util.u8_fwd(raw, 0, bxhi + 1), opts.tabstop)
                else
                    let blo = if li == ssy then ssx else 0
                    let bhi = if li == sey then sex + 1 else str.len(raw)
                    vlo = disp.vis_col(raw, blo, opts.tabstop)
                    vhi = disp.vis_col(raw, bhi, opts.tabstop)
            // Yank flash: same reverse-video slot as the selection (the two never
            // coexist — a flash only shows in Normal mode, just after a yank).
            if (not vis) and flash.active and li >= flash.sy and li <= flash.ey
                if flash.lw
                    vlo = 0
                    vhi = vlen
                else
                    let fblo = if li == flash.sy then flash.sx else 0
                    let fbhi = if li == flash.ey then flash.ex + 1 else str.len(raw)
                    vlo = disp.vis_col(raw, fblo, opts.tabstop)
                    vhi = disp.vis_col(raw, fbhi, opts.tabstop)
            let srng = if dohl then search_vis_ranges(satoms, raw, opts.tabstop) else []
            let syncols = if dots then disp.ts_line_syncols(ts_spans, line_byte, raw, opts.tabstop, cs) elif dosyn then disp.syntax_colors(expanded, synkw, synstr, syncmt, synnum, cs.depth) else []
            let segs = if opts.wrap and vlen > width then (vlen + width - 1) / width else 1
            var seg = 0
            while seg < segs and r < body
                cup(ry + r + 1, rx + 1)
                if numbered
                    if seg == 0
                        // relativenumber → distance from the cursor line; with
                        // `number` too the cursor line shows its absolute number.
                        let gnum = if opts.relativenumber and li != ed.cy
                            if li > ed.cy then li - ed.cy else ed.cy - li
                        elif opts.relativenumber and (not opts.number)
                            0
                        else
                            li + 1
                        // A line with a diagnostic colours its number red (error)
                        // or yellow (warning) — a zero-width gutter sign.
                        let dsev = diag_sev_for_line(diag_li, li)
                        let iscur = li == ed.cy        // the active line gets a bold number
                        // In hybrid number+relativenumber the active line shows
                        // its absolute number flush-LEFT (neovim style); every
                        // other line stays right-aligned.
                        let numtxt = if iscur and opts.relativenumber and opts.number
                            disp.pad_num_l(gnum, numw)
                        else
                            disp.pad_num(gnum, numw)
                        // Diagnostic severity outranks the cursor line, which
                        // outranks nothing.  Bold marks the cursor line
                        // whatever colours it — an attribute, so it survives
                        // a theme that sets no colours at all (--no-color).
                        let gcol = if dsev == 1 then gerr elif dsev >= 2 then gwarn elif iscur then gcur else 0 - 1
                        var gpar = if iscur then "1" else ""
                        if gcol >= 0
                            gpar = gpar + (if str.len(gpar) > 0 then ";" else "") + colorscheme.fg_params(gcol)
                        if str.len(gpar) > 0
                            sgr(gpar)
                            emit(numtxt)
                            sgr("0")
                            emit(" ")
                        else
                            emit(numtxt + " ")
                    else
                        emit(disp.nspaces(numw + 1))   // blank gutter on continuation rows
                let segleft = if opts.wrap then seg * width else left
                // Selection and yank flash share one render slot (they never
                // coexist), so the caller picks which colour that slot carries.
                let hlcol = if (not vis) and flash.active then flashcol else selcol
                emit_line_styled(expanded, segleft, width, vlo, vhi, srng, searchcol, syncols, hlcol)
                // chars emitted by emit_line_styled = clamp(vlen - segleft, 0, width)
                let shown = if vlen - segleft < 0 then 0 elif vlen - segleft > width then width else vlen - segleft
                eol(clip, width - shown)
                r = r + 1
                seg = seg + 1
            line_byte = line_byte + str.len(ed.lines[li]) + 1   // advance past this line + its \n
            li = li + 1
        else
            cup(ry + r + 1, rx + 1)
            if cs.tilde_fg >= 0
                sgr(colorscheme.fg_params(cs.tilde_fg))
                emit("~")
                sgr("0")
            else
                emit("~")
            eol(clip, cols - 1)          // "~" took 1 column; fill the rest
            r = r + 1
            li = li + 1
    cup(ry + rows, rx + 1)
    // The focused window keeps the full status styling (reverse / colourscheme
    // colours); inactive panes draw a plain status bar so the focus is obvious.
    let barsgr = if active then colorscheme.status_sgr(cs) else "0"
    sgr(barsgr)
    let modestr = if mode == 1 then "-- INSERT -- " elif mode == 2 then "-- VISUAL -- " elif mode == 3 then "-- VISUAL LINE -- " elif mode == 4 then "-- REPLACE -- " elif mode == 5 then "-- VISUAL BLOCK -- " else "-- NORMAL -- "
    // Diagnostics summary (E:n W:m) plus, when the cursor sits on a diagnostic
    // line, that diagnostic's message — the low-effort surface before any popup.
    let ndiag = list.len(diag_li) / 2
    let dsum = if ndiag > 0 then "  E:" + str.from_int(diag_count(diag_li, 1)) + " W:" + str.from_int(diag_count(diag_li, 2)) else ""
    // Base status (path/pos/mode/count) is emitted in full — only the on-cursor
    // diagnostic message is bounded to the remaining width so it can't wrap.
    let modflag = if modified then " [+]" else ""
    // vim's label for a buffer with no file name; without it the status
    // line just has a gap where the name should be.
    let shown_path = if str.len(path) == 0 then "[No Name]" else path
    var statusln = " " + shown_path + modflag + "  " + str.from_int(ed.cy + 1) + ":" + str.from_int(ed.cx + 1) + "  " + modestr + dsum
    // An explicit `info` line (a gd/K result) wins over the passive on-cursor
    // diagnostic message; either is bounded to the remaining width.
    let cmsg = diag_msg_for_line(diag_li, diag_msgs, ed.cy)
    let showmsg = if str.len(info) > 0 then info else cmsg
    let room = cols - 1 - str.len(statusln)
    if str.len(showmsg) > 0 and room > 6
        let mm = if str.len(showmsg) > room - 2 then str.slice(showmsg, 0, room - 2) else showmsg
        statusln = statusln + "  " + mm
    // Amber marks the mode that is putting keystrokes INTO the buffer —
    // the palette's rule 1 (amber is where something acts) read for an
    // editor, where the actor is whoever is typing.  Spent here and on the
    // cursor, and nowhere else: NORMAL and the VISUAL modes are selection
    // and navigation, so they keep the bar's own teal.
    //
    // Only the focused window gets it.  An inactive split draws a plain bar
    // precisely so it does not claim to be where the keys are going.
    let acting = active and (mode == 1 or mode == 4)
    if acting and colorscheme.status_sgr(cs) != "7"
        let cut = util.index_of_str(statusln, modestr)
        if cut >= 0
            emit(str.slice(statusln, 0, cut))
            sgr(colorscheme.fg_params(colorscheme.pal_amber(cs.depth)))
            emit(modestr)
            sgr(barsgr)
            emit(str.slice(statusln, cut + str.len(modestr), str.len(statusln)))
        else
            emit(statusln)
    else
        emit(statusln)
    eol(clip, cols - str.len(statusln))   // fill the rest of the status bar with the status bg
    sgr("0")

@intent("""Place the hardware cursor at the active window's text cursor,
offset by the window origin and the (recomputed) gutter width, wrap-aware.
Split out of draw_window so a multi-window frame draws every window first,
then homes the cursor in the focused one.""")
fn place_cursor(ed: Editor, win: wlayout.Rect, top: Int, left: Int, opts: Options) [io]
    let rx = win.x
    let ry = win.y
    let cols = win.w
    let nl = list.len(ed.lines)
    let numbered = opts.number or opts.relativenumber
    let numw = if disp.num_digits(nl) > 3 then disp.num_digits(nl) else 3
    let gutter = if numbered then numw + 1 else 0
    let width = if cols - gutter > 0 then cols - gutter else 1
    let curline = if ed.cy < nl then ed.lines[ed.cy] else ""
    let cviscol = disp.vis_col(curline, ed.cx, opts.tabstop)
    if opts.wrap
        // screen row = rows used by lines [top, cy) + the cursor's own segment
        var crow = 0
        var ci = top
        while ci < ed.cy
            let cvl = str.len(disp.expand_tabs(ed.lines[ci], opts.tabstop))
            crow = crow + (if cvl > width then (cvl + width - 1) / width else 1)
            ci = ci + 1
        cup(ry + crow + cviscol / width + 1, rx + (cviscol % width) + gutter + 1)
    else
        cup(ry + ed.cy - top + 1, rx + (cviscol - left) + gutter + 1)

@intent("""Single-window frame: hide the cursor, draw the one window, place the
cursor, restore it.  Byte-identical to the pre-split render — the interactive
driver calls this whenever there is exactly one window.""")
fn render(ed: Editor, win: wlayout.Rect, path: Str, top: Int, left: Int, mode: Int, avy: Int, avx: Int, search: Str, cs: colorscheme.Colorscheme, opts: Options, diag_li: [Int], diag_msgs: [Str], info: Str, modified: Bool, ts_spans: [Int], flash: Flash) [io]
    draw_window(ed, win, path, top, left, mode, avy, avx, search, cs, opts, diag_li, diag_msgs, info, modified, false, true, ts_spans, flash)
    place_cursor(ed, win, top, left, opts)
    cursor_shape(mode)   // block in normal/visual, bar in insert, underline in replace

// Split joined buffer text into lines, guaranteeing at least one (empty) line
// so an empty buffer still renders a cursor row.
fn lines_of(text: Str) -> [Str]
    let bl = str.split_lines(text)
    if list.len(bl) == 0 then [""] else bl

@intent("""Multi-window frame: draw every window in the layout into its computed
rect, then home the cursor in the active window.  Each
window draws its OWN buffer (win_buf): the active window and any pane showing
the same buffer draw the live `ed.lines`; a pane on a different buffer draws
that buffer's stored text (bufs_text), with its own path in the status line.
The active window draws from the live ed cursor / top / left and the real mode
(selection, INSERT, gd/K info); every other pane draws from its saved win_*
cursor/viewport in plain NORMAL mode.  Diagnostics + the modified flag follow
the live active buffer only.""")
fn render_all(ed: Editor, lay: wlayout.Layout, awin: Int, screen: wlayout.Rect, win_cy: [Int], win_cx: [Int], win_top: [Int], win_left: [Int], win_buf: [Int], win_ww: [Int], win_hw: [Int], cur_buf: Int, bufs_text: [Str], bufs_path: [Str], path: Str, top: Int, left: Int, mode: Int, avy: Int, avx: Int, search: Str, cs: colorscheme.Colorscheme, opts: Options, diag_li: [Int], diag_msgs: [Str], info: Str, modified: Bool, ts_spans: [Int], flash: Flash) [io]
    let rects = wlayout.layout_rects(lay, screen, win_ww, win_hw, [])
    var i = 0
    while i < list.len(rects)
        let wid = rects[i]
        let wr = wlayout.rect(rects[i + 1], rects[i + 2], rects[i + 3], rects[i + 4])
        let isact = wid == awin
        let bi = win_buf[wid]
        let same = bi == cur_buf            // shows the live (active) buffer
        let wcy = if isact then ed.cy else win_cy[wid]
        let wcx = if isact then ed.cx else win_cx[wid]
        let wtop = if isact then top else win_top[wid]
        let wleft = if isact then left else win_left[wid]
        let wmode = if isact then mode else 0
        let wavy = if isact then avy else wcy
        let wavx = if isact then avx else wcx
        let winfo = if isact then info else ""
        let wpath = if same then path else bufs_path[bi]
        let wlines = if same then ed.lines else lines_of(bufs_text[bi])
        let wdiag_li = if same then diag_li else []
        let wdiag_msgs = if same then diag_msgs else []
        let wmod = if same then modified else false
        let view = Editor { lines: wlines, cy: wcy, cx: wcx }
        // A window whose right edge is left of the screen edge (a vsplit's left
        // pane) must bounded-fill its rows, not erase-to-EOL into its neighbour.
        let clip = wr.x + wr.w < screen.w
        let wts = if same then ts_spans else []   // ts spans only for the live (active) buffer
        let wflash = if isact then flash else flash_none()   // flash only on the active window
        draw_window(view, wr, wpath, wtop, wleft, wmode, wavy, wavx, search, cs, opts, wdiag_li, wdiag_msgs, winfo, wmod, clip, isact, wts, wflash)
        i = i + 5
    place_cursor(ed, wlayout.window_rect(lay, awin, screen, win_ww, win_hw), top, left, opts)
    cursor_shape(mode)

@intent("""Paint one frame, dispatching on window count: a single window keeps
the proven byte-identical render path; two or more go through render_all.  (Not
named `frame` — that is a reserved word in Novo.)

This is the BOTTOM layer only.  Callers open the frame (frame_begin) before it
and close it (frame_end) after every overlay they intend to stack on top, so the
terminal presents buffer and overlay as one image.""")
fn paint_frame(ed: Editor, lay: wlayout.Layout, awin: Int, cols: Int, rows: Int, win_cy: [Int], win_cx: [Int], win_top: [Int], win_left: [Int], win_buf: [Int], win_ww: [Int], win_hw: [Int], cur_buf: Int, bufs_text: [Str], bufs_path: [Str], path: Str, top: Int, left: Int, st: InputState, cs: colorscheme.Colorscheme, opts: Options, diag_li: [Int], diag_msgs: [Str], info: Str, modified: Bool, ts_spans: [Int], flash: Flash) [io]
    let screen = wlayout.rect(0, 0, cols, rows)
    if wlayout.layout_count(lay) == 1
        render(ed, wlayout.window_rect(lay, awin, screen, win_ww, win_hw), path, top, left, st.mode, st.avy, st.avx, st.search, cs, opts, diag_li, diag_msgs, info, modified, ts_spans, flash)
    else
        render_all(ed, lay, awin, screen, win_cy, win_cx, win_top, win_left, win_buf, win_ww, win_hw, cur_buf, bufs_text, bufs_path, path, top, left, st.mode, st.avy, st.avx, st.search, cs, opts, diag_li, diag_msgs, info, modified, ts_spans, flash)

fn term_rows() -> Int [io]
    let packed = novo_pty_get_winsize_h()
    let r = int.shr_logical(packed, 16)
    if r > 0 then r else 24

fn term_cols() -> Int [io]
    let packed = novo_pty_get_winsize_h()
    let c = packed & 65535
    if c > 0 then c else 80

// Drain the rest of a CSI/SS3 escape sequence (after the leading `ESC [` or
// `ESC O`) and return `param * 256 + finalByte`, or a negative value if the
// stream ended mid-sequence.  `param` is the leading decimal number (0 if none)
// — needed because the tilde-final keys share one final byte and differ only by
// it: `ESC[3~` Delete, `ESC[5~` PageUp, `ESC[6~` PageDown.  Remaining parameter
// / intermediate bytes (e.g. the `;5` of a `ESC[1;5A` Ctrl-arrow) are skipped.
// Recognising these stops their letters being fed in as editor commands —
// e.g. a focus-in `ESC[I` would otherwise read as `I` (insert mode).
fn csi_seq() -> Int [io]
    csi_finish(novo_pty_stdin_read_byte_h())

// Finish a CSI sequence given its already-read first byte (used when the
// dispatcher peeked one byte to detect an SGR mouse `<`).  Returns
// param*256 + finalByte, or the (negative) read error.
fn csi_finish(first: Int) -> Int [io]
    let r = csi_read(first)
    if r[0] < 0 then r[0] else r[1] * 256 + r[0]

// Read the rest of a CSI sequence given its already-read first byte, and return
// `[final, p1, p2, marker]`: the final byte (negative when the stream ended
// mid-sequence), the first two decimal parameters (0 when absent; anything after
// a `:` inside a parameter is skipped), and the private-parameter prefix byte
// (`<` `=` `>` `?`) or 0.  The kitty keyboard protocol's `CSI code ; mods u` and
// its query reply `CSI ? flags u` are read through this.
fn csi_read(first: Int) -> [Int] [io]
    var b = first
    var marker = 0
    if b == '<' or b == '=' or b == '>' or b == '?'   // private-parameter prefix
        marker = b
        b = novo_pty_stdin_read_byte_h()
    var p1 = 0
    var p2 = 0
    var cur = 0
    var idx = 0                                 // which parameter `cur` belongs to
    var sub = false                             // inside a `:` sub-parameter, skipped
    while b >= ' ' and b <= '?'                 // parameters / intermediates
        if b >= '0' and b <= '9'
            if not sub
                cur = cur * 10 + (b - '0')
        elif b == ';'
            if idx == 0
                p1 = cur
            idx = idx + 1
            cur = 0
            sub = false
        elif b == ':'
            sub = true
        b = novo_pty_stdin_read_byte_h()
    if idx == 0
        p1 = cur
    elif idx == 1
        p2 = cur
    [b, p1, p2, marker]

// Parse an SGR mouse report after the `ESC[<` prefix is consumed.  Returns
// [button, col, row, final] (col/row 1-based; final 'M' press / 'm' release).
fn mouse_seq() -> [Int] [io]
    var btn = 0
    var b = novo_pty_stdin_read_byte_h()
    while b >= '0' and b <= '9'
        btn = btn * 10 + (b - '0')
        b = novo_pty_stdin_read_byte_h()
    var col = 0
    b = novo_pty_stdin_read_byte_h()
    while b >= '0' and b <= '9'
        col = col * 10 + (b - '0')
        b = novo_pty_stdin_read_byte_h()
    var row = 0
    b = novo_pty_stdin_read_byte_h()
    while b >= '0' and b <= '9'
        row = row * 10 + (b - '0')
        b = novo_pty_stdin_read_byte_h()
    [btn, col, row, b]

// Inverse of vis_col: the raw byte index at (or just past) visual column
// `vcol` in a line, accounting for tab expansion.  Used to map a mouse click's
// screen column back to a buffer column.
fn vis_to_byte(raw: Str, vcol: Int, ts: Int) -> Int
    var b = 0
    var v = 0
    let n = str.len(raw)
    while b < n and v < vcol
        let ch = str.byte_at(raw, b) ?? 0
        if ch == '\t'
            v = v + (ts - (v % ts))
        else
            v = v + 1
        b = b + 1
    b

// Apply an arrow / Home / End key (decoded from a CSI/SS3 final byte) as a
// cursor move; any other final byte is ignored (returns `ed` unchanged), so
// focus events and report replies are harmless no-ops.  `allow_eol` lets the
// cursor sit one past the last char (insert/replace mode); otherwise it clamps
// to the last char like normal-mode motions.
fn arrow_move(ed: Editor, fin: Int, allow_eol: Bool) -> Editor
    let nl = list.len(ed.lines)
    if fin == 'D'                                  // ← left
        Editor { lines: ed.lines, cy: ed.cy, cx: util.u8_prev(line_at(ed, ed.cy), ed.cx) }
    elif fin == 'C'                                // → right
        let line = line_at(ed, ed.cy)
        let cap = if allow_eol then str.len(line) else util.u8_last(line)
        Editor { lines: ed.lines, cy: ed.cy, cx: if ed.cx < cap then util.u8_next(line, ed.cx) else cap }
    elif fin == 'A'                                // ↑ up
        let ny = if ed.cy > 0 then ed.cy - 1 else 0
        let line = line_at(ed, ny)
        let cap = if allow_eol then str.len(line) else util.u8_last(line)
        let nx = util.u8_same_col(line_at(ed, ed.cy), ed.cx, line)
        Editor { lines: ed.lines, cy: ny, cx: if nx < cap then nx else cap }
    elif fin == 'B'                                // ↓ down
        let ny = if ed.cy + 1 < nl then ed.cy + 1 else nl - 1
        let line = line_at(ed, ny)
        let cap = if allow_eol then str.len(line) else util.u8_last(line)
        let nx = util.u8_same_col(line_at(ed, ed.cy), ed.cx, line)
        Editor { lines: ed.lines, cy: ny, cx: if nx < cap then nx else cap }
    elif fin == 'H'                                // Home
        Editor { lines: ed.lines, cy: ed.cy, cx: 0 }
    elif fin == 'F'                                // End
        let line = line_at(ed, ed.cy)
        Editor { lines: ed.lines, cy: ed.cy, cx: if allow_eol then str.len(line) else util.u8_last(line) }
    else
        ed

// Recompute the horizontal offset for the current cursor: the text area is
// `cols` minus the line-number gutter, and the cursor's visual column must
// stay inside it.  Pure wrapper around hscroll_to used at each repaint site.
fn hscroll_for(left: Int, ed: Editor, opts: Options, cols: Int) -> Int
    if opts.wrap                                  // wrapped lines never scroll horizontally
        return 0
    let nl = list.len(ed.lines)
    let numw = if disp.num_digits(nl) > 3 then disp.num_digits(nl) else 3
    let gutter = if opts.number or opts.relativenumber then numw + 1 else 0
    disp.hscroll_to(left, disp.vis_col(line_at(ed, ed.cy), ed.cx, opts.tabstop), cols - gutter)

// Adjust the viewport top so the cursor line is visible in `body` rows.
fn scroll_to(top: Int, cy: Int, body: Int) -> Int
    var t = top
    if cy < t
        t = cy
    if cy >= t + body
        t = cy - body + 1
    if t < 0
        t = 0
    t

// ── Viewport scrolling: Ctrl-D/U/F/B + zz/zt/zb ───────────────────
// These are driver-level (they touch the `top` viewport, which `feed` does not
// know about).  `kind`: 0 Ctrl-D (½ down), 1 Ctrl-U (½ up), 2 Ctrl-F (page
// down), 3 Ctrl-B (page up), 4 zz (centre), 5 zt (cursor→top), 6 zb (→bottom).

// Only treat a scroll key as a scroll when input is idle — otherwise `z` would
// steal the register/mark name from `qz` / `"z` / `mz`, and Ctrl-D a find target.
fn scroll_idle(st: InputState, es: EditState) -> Bool
    st.mode == 0 and st.pending == 0 and st.count == 0 and es.awaitmac == 0 and (not es.awaitreg) and es.awaitmark == 0

// Like scroll_idle but COUNT-tolerant — for the `g` prefix buffer, so `3gg` /
// `3gcc` can carry their count to the second key.
fn g_idle(st: InputState, es: EditState) -> Bool
    st.mode == 0 and st.pending == 0 and es.awaitmac == 0 and (not es.awaitreg) and es.awaitmark == 0

// New cursor line after a paging command (zz/zt/zb leave the cursor put).
fn scroll_new_cy(ed: Editor, rows: Int, kind: Int) -> Int
    let body = rows - 1
    let half = if body / 2 > 0 then body / 2 else 1
    let page = if body - 2 > 0 then body - 2 else 1
    let nl = list.len(ed.lines)
    var ncy = ed.cy
    if kind == 0
        ncy = ed.cy + half
    elif kind == 1
        ncy = ed.cy - half
    elif kind == 2
        ncy = ed.cy + page
    elif kind == 3
        ncy = ed.cy - page
    if ncy < 0
        ncy = 0
    if ncy > nl - 1
        ncy = nl - 1
    ncy

// New viewport top after a scroll command.
fn scroll_new_top(cy: Int, top: Int, rows: Int, kind: Int) -> Int
    let body = rows - 1
    let half = if body / 2 > 0 then body / 2 else 1
    let page = if body - 2 > 0 then body - 2 else 1
    var t = top
    if kind == 0
        t = top + half
    elif kind == 1
        t = top - half
    elif kind == 2
        t = top + page
    elif kind == 3
        t = top - page
    elif kind == 4                       // zz — centre the cursor
        t = cy - body / 2
    elif kind == 5                       // zt — cursor to the top
        t = cy
    elif kind == 6                       // zb — cursor to the bottom
        t = cy - body + 1
    if t < 0
        t = 0
    t

// Decode a z-prefix second byte into a kind (4/5/6), or -1 if not z/t/b.
fn scroll_z_kind(b: Int) -> Int
    if b == 'z' then 4 elif b == 't' then 5 elif b == 'b' then 6 else 0 - 1

// Decode a Ctrl paging byte into a kind (0..3), or -1 if not a paging key.
fn scroll_ctrl_kind(b: Int) -> Int
    if b == '\x04' then 0 elif b == '\x15' then 1 elif b == '\x06' then 2 elif b == '\x02' then 3 else 0 - 1

// Target buffer line for the screen motions H / M / L (kind 0/1/2) given the
// current viewport [top, top+body) clamped to the buffer.
fn screen_target(top: Int, rows: Int, nl: Int, kind: Int) -> Int
    let body = rows - 1
    let last_vis = if top + body - 1 < nl - 1 then top + body - 1 else nl - 1
    var t = top
    if kind == 1
        t = top + (last_vis - top) / 2       // M — middle of the visible lines
    elif kind == 2
        t = last_vis                         // L — bottom visible line
    if t < 0
        t = 0
    if t > nl - 1
        t = nl - 1
    t

// Decode H / M / L into a kind (0/1/2), or -1.
fn screen_kind(b: Int) -> Int
    if b == 'H' then 0 elif b == 'M' then 1 elif b == 'L' then 2 else 0 - 1

// A scroll / screen key is only handled by the driver when the user hasn't
// remapped it — otherwise the keymap (applied inside feed) must win.
fn key_free(km: Keymap, b: Int) -> Bool
    str.len(keymap_lookup(km, b)) == 0

@intent("""The interactive editor driver: set raw mode, load config + the first
file (plus any `extra` newline-joined files as additional buffers), then loop —
poll stdin and the language server, fold input bytes through `feed_edit`, run
the deferred buffer/window switches, debounce `didChange`, route diagnostics by
URI, and repaint.  Owns ALL session state the pure `feed` must not: the buffer
list and per-buffer view/undo/marks/diagnostics, registers, the jumplist, the
LSP connection, and the screen.  `path` is the first file; `extra` carries the
rest (a Str, not [Str] — a [Str] param here reproducibly corrupted the
buffer-switch codegen; see the bug filed in features/orbits/novim).""")
fn run_interactive(cfg_path: Str, path: Str, extra: Str, want_color: Bool) [io, fs, time, ffi]
    let _ = novo_pty_set_raw_mode_h()
    term_enter(want_color)                // alternate screen + mouse wheel capture + cursor colour
    var curpath = path                   // the open file; `:e` switches it
    var ed = Editor { lines: buf_load(path), cy: 0, cx: 0 }
    var disk_text = buf_text(ed)         // last-saved/loaded text, for the :e dirty guard
    var st = ist_new()
    var es = edit_new()
    // Keymaps: the TOML `[keymaps]`, plus (when `[keymaps] import_nvim = true`)
    // the Normal-mode maps scraped from the user's Neovim config.
    let km = if keymaps_import_nvim(cfg_path) then import_nvim_keymaps(default_nvim_dir(), load_keymaps(cfg_path)) else load_keymaps(cfg_path)
    let km_active = list.len(km.lhs) > 0          // any maps → run the prefix matcher
    let ttm = load_ttimeoutlen(cfg_path)          // ms to wait after ESC for the key of an Alt chord
    let tmo = load_timeoutlen(cfg_path, default_nvim_dir())   // ms a held map prefix waits for its next key
    var map_pending = ""                          // buffered multi-key LHS prefix
    var map_at = 0                                // now_ms() when the last key joined map_pending
    var map_replay = ""                           // RHS / flushed bytes to re-feed through the driver
    // var: `:colorscheme <name>` switches it live — and still does under
    // --no-color, because typing the command IS asking for those colours.
    // Colour depth, detected once here and carried in `cs.depth` from then
    // on — COLORTERM/TERM are read at startup and never again.
    let cdepth = colorscheme.detect_depth()
    var cs = if want_color then colorscheme.load_colorscheme(cfg_path, cdepth) else colorscheme.colorscheme_plain(cdepth)
    let opts_cfg = load_options(cfg_path)
    var opts = if want_color then opts_cfg else options_no_syntax(opts_cfg)
    var rows = term_rows()
    var cols = term_cols()
    var top = 0
    var left = 0
    var cmd_mode = false
    var cmd_buf = ""
    var cmd_cx = 0                       // insertion point within cmd_buf (0..len)
    var cmd_hist = history_load(0)       // executed `:` commands, oldest first (persisted)
    var hist_idx = 0                     // history cursor while in cmd mode (len = empty new line)
    var rng_vlo = 0 - 1                   // visual-selection line bounds for `'<,'>`
    var rng_vhi = 0 - 1                   //   (-1 = no active selection)
    var search_mode = false
    var search_buf = ""
    var search_cx = 0                    // insertion point within search_buf (0..len)
    var search_back = false
    var search_hist = history_load(1)    // executed `/`?` patterns, oldest first (persisted)
    var shist_idx = 0                    // history cursor while in search mode
    var hl_off = false                   // `:noh` — suppress search highlight until the next search
    var zpend = false                    // awaiting the 2nd byte of a `z` scroll command
    var esc_pushback = 0 - 99            // one-byte pushback: the key after a lone ESC
    var kitty_on = false                 // the terminal answered `CSI ? u` with flag 1: chords come as `CSI … u`
    var last_subst = ""                  // last :s command, for `&`
    // ── LSP (novols) live state.  All async I/O lives here in the
    // driver, never in the pure `feed` path.  `lsp_pid < 0` means no server.
    var lsp_pid = 0 - 1
    var lsp_in = 0
    var lsp_out = 0
    var lsp_ver = 1
    var lsp_uri = "file://" + path
    var lsp_lasttext = ""
    // Multi-language: one server per session, chosen from the active file's
    // type.  `lsp_lang` is the running server's LSP languageId ("novo", "rust",
    // …; "" = no server); a buffer gets LSP only when its language matches.
    // `.nv` resolves to novols/"novo" with a null root — byte-for-byte unchanged from the novols-only path.
    let lsp_cfg = file_to_text(cfg_path)
    var lsp_lang = ""
    // ── Tree-sitter highlighting (optional; falls back to the native tokenizer)
    // `ts_spans_cache` holds the ACTIVE buffer's capture spans, recomputed when
    // its text changes; an empty cache (grammar missing / unknown filetype /
    // parse failed) means the renderer uses syntax_colors instead.
    //
    // Grammar + queries resolve PER FILETYPE from a search path — ~/.novo/lib
    // first (where orbit/novo-treesitter/bin/install-lib.sh puts the Novo
    // grammar), then any nvim-treesitter parser dirs — so markdown / C / TOML /
    // Python / LLVM-IR buffers highlight with their own grammar instead of
    // everything being parsed as Novo.  `ts_lang` is "" for a filetype we have
    // no grammar for.  See ts.nv for the tables and the config overrides.
    var ts_lang = tslang.ts_lang_of(path)
    var ts_grammar = tslang.ts_grammar_path(lsp_cfg, ts_lang)
    var ts_symbol = tslang.ts_symbol_of(ts_lang)
    var ts_queries = file_to_text(tslang.ts_queries_path(lsp_cfg, ts_lang))
    var ts_spans_cache: [Int] = []
    var ts_lasttext = "\x00"             // sentinel ≠ any buffer → first frame parses
    // Opt-in (config `[options] treesitter = true` or `:set treesitter`); when
    // off, ts_spans_cache stays empty and the renderer uses the native tokenizer.
    var ts_enabled = want_color and util.index_of_str(file_to_text(cfg_path), "treesitter = true") >= 0
    // `[options] clipboard = "unnamedplus"` (or "unnamed") → sync the unnamed
    // register with the OS clipboard, like Neovim's unnamedplus.
    let clip_on = clipboard_enabled(cfg_path)
    var diag_li: [Int] = []
    var diag_msgs: [Str] = []
    var lsp_reqid = 1                    // monotonic id for gd/K requests (init used 1)
    var lsp_info = ""                    // transient status message (gd/K result)
    var gpend = false                    // awaiting the 2nd byte of a `g` command (gd / gc / gg…)
    var cpend = false                    // `gc` — awaiting the comment-toggle target (c / motion)
    var cpend_obj = false                // `gca`/`gci` — awaiting the text-object char (p)
    var cpend_around = false             // the awaited object is `a` (around) vs `i` (inner)
    var vgc_pend = false                 // Visual `g` — awaiting `c` (comment the selection)
    // ── Window splits ───────────────────────────────────────────────────────
    // `lay` is the window-layout tree (`:split` / `:vsplit`, nested); `awin` is
    // the focused window id (also an index into the win_* arrays).  Each window
    // shows a buffer (win_buf) with its own cursor/viewport; the active window's
    // live state is ed.cy/ed.cx/top/left, while win_* holds the OTHER windows'
    // saved state, synced on every focus change / split.
    var lay = wlayout.LWin(0)
    var awin = 0
    var win_cy: [Int] = [0]
    var win_cx: [Int] = [0]
    var win_top: [Int] = [0]
    var win_left: [Int] = [0]
    var win_buf: [Int] = [0]             // which buffer index each window displays
    // Per-window size weights (width / height); a split divides its space in
    // proportion to the child weights.  Default 100 = equal; Ctrl-W >/< adjust
    // width, Ctrl-W +/- adjust height, Ctrl-W = resets all to 100.
    var win_ww: [Int] = [100]
    var win_hw: [Int] = [100]
    var wpend = false                    // awaiting the 2nd byte of a Ctrl-W command
    var comp_active = false              // Ctrl-N/P completion cycle in progress
    var insert_oneshot = false           // `<C-o>` — run one Normal command, then back to Insert
    var comp_cands: [Str] = []           // filtered candidate labels
    var comp_idx = 0                     // current candidate
    var comp_start = 0                   // column where the completed prefix begins
    // Blockwise-visual insert (`<C-v>…I/A/c`): the column band + row range are
    // captured when the insert starts; on Esc the first row's inserted text is
    // replayed onto every other selected row (block_replicate).
    var binsert_active = false
    var binsert_ylo = 0
    var binsert_yhi = 0
    var binsert_col = 0
    var binsert_append = false
    var binsert_flen0 = 0                // first row's length in bytes when insert began (post delete/pad)
    var binsert_nch0 = 0                 // the same length in characters
    // Jumplist (browser-style back/forward) for Ctrl-O / Ctrl-I.  Each stack
    // holds "y|x|path" entries (file-aware, so a jump across files round-trips);
    // a jump pushes the origin onto `jback` and clears `jfwd`.
    var jback: [Str] = []
    var jfwd: [Str] = []
    // ── Buffer list (multiple files open at once) ───────────────────────────
    // Each buffer's working copy lives in the active `ed`/`top`/`left`/`curpath`/
    // `disk_text`; on switch it's saved back into these parallel stores and the
    // target restored.  Content is stored joined (`bufs_text`) to avoid nesting
    // `[[Str]]`.  `cur_buf` indexes the active buffer.
    var bufs_text: [Str] = [buf_text(ed)]
    var bufs_path: [Str] = [path]
    var bufs_cy: [Int] = [0]
    var bufs_cx: [Int] = [0]
    var bufs_top: [Int] = [0]
    var bufs_left: [Int] = [0]
    var bufs_disk: [Str] = [disk_text]
    var bufs_undo: [Str] = [""]      // per-buffer serialized undo stack
    var bufs_redo: [Str] = [""]      // per-buffer serialized redo stack
    var bufs_marky: [Str] = [""]     // per-buffer marks a-z: serialized lines
    var bufs_markx: [Str] = [""]     // per-buffer marks a-z: serialized columns
    var bufs_diag: [Str] = [""]      // per-buffer serialized diagnostics (multi-doc LSP)
    var bufs_lspopen: [Bool] = [false]  // whether each buffer's doc is open in novols
    var cur_buf = 0
    var alt_buf = 0 - 1              // alternate buffer (last visited) for Ctrl-^ / :b#
    var arglist: [Str] = [path]     // the CLI argument list (:args / :next / :prev)
    var arg_idx = 0                 // current position in the argument list
    // Extra command-line files (`novim a b c`) become additional buffers.  They
    // arrive newline-joined in `extra` (a Str — passing a `[Str]` parameter to
    // this function reproducibly corrupted the buffer-switch codegen).
    let extra_files = str.split_lines(extra)
    var efi = 0
    while efi < list.len(extra_files)
        let ef = extra_files[efi]
        if str.len(ef) > 0
            let eft = file_to_text(ef)
            bufs_text = list.push(bufs_text, eft)
            bufs_path = list.push(bufs_path, ef)
            bufs_cy = list.push(bufs_cy, 0)
            bufs_cx = list.push(bufs_cx, 0)
            bufs_top = list.push(bufs_top, 0)
            bufs_left = list.push(bufs_left, 0)
            bufs_disk = list.push(bufs_disk, eft)
            bufs_undo = list.push(bufs_undo, "")
            bufs_redo = list.push(bufs_redo, "")
            bufs_marky = list.push(bufs_marky, "")
            bufs_markx = list.push(bufs_markx, "")
            bufs_diag = list.push(bufs_diag, "")
            bufs_lspopen = list.push(bufs_lspopen, false)
            arglist = list.push(arglist, ef)
        efi = efi + 1
    // Deferred buffer switch: `:e`/`:bn`/`:bp`/cross-file gd / cross-file
    // Ctrl-O all set `want_path` (+ target cursor, or `want_y < 0` to restore the
    // buffer's saved cursor); one block after the input drain finds-or-creates
    // the buffer, saves the current one, and activates it (LSP didClose/didOpen).
    var want_path = ""
    var want_y = 0
    var want_x = 0
    var want_close = ""
    // Deferred window command (set by `:split` / `:vsplit` / `Ctrl-W s/v/c/q`,
    // run after the input drain): 0 none · 1 hsplit · 3 close · 4 vsplit.
    var pending_wcmd = 0
    // Deferred focus change to this window id (Ctrl-W w / h / j / k / l); -1 none.
    var pending_focus = 0 - 1
    var buflist = false                  // `:ls` — show the buffer-list overlay until the next key
    var help_fill = ""                   // text of the `[help]` buffer while it is being created
    // ── Picker overlay (picker-and-pins): modal prompt + fuzzy-ranked list ──
    var picker_active = false
    var picker_src = 0                   // 0 = :bufs; no other source is wired
    var picker_query = ""
    var picker_sel = 0                   // selection index into the ranked view
    var picker_cands: [Str] = []         // scored + displayed rows
    var picker_marks: [Str] = []         // per-row display prefix ("% " current, "# " alternate)
    var picker_meta: [Str] = []          // per-row action payload (bufs: the buffer path)
    // The WHOLE ranking of picker_cands for picker_query, best first, memoised.
    // Ranking is O(candidates) and moving the selection does not change it, so
    // recomputing it per repaint made the cost of one keystroke scale with the
    // size of the list — at ten thousand candidates a frame cost ~200 ms, which
    // is what turned a held arrow key into a slideshow.  It is invalidated by
    // the two things that DO change it: the query, and the candidate list
    // (`:grep` grows its list under an open picker).  `picker_rank` doubles as
    // the match count — fuzzy.rank excludes non-matches, so its length is
    // exactly what fuzzy.match_count would return.
    var picker_rank: [Int] = []
    var picker_rank_ok = false
    // The picker moved since the last frame reached the terminal — the "is
    // there anything to show" input of the repaint decision.
    var picker_moved = false
    // ── :grep live source: an rg --vimgrep child streams into the picker ──
    var grep_pid = 0 - 1                 // running rg (-1 = none)
    var grep_fd = 0 - 1
    var grep_buf = ""                    // partial-line accumulator
    var grep_total = 0                   // rows received (honest counter)
    var grep_pending = false             // query changed — respawn after the debounce
    var grep_debounce = 0                // poll ticks until the respawn fires
    // ── Pins (harpoon slots): per-project, persisted, loaded at start ──
    let pins_root = project_root()
    let pins_at_start = pins_load(pins_root)
    var pins_p = pins_at_start.p[:]         // slot i → pinned path, absolute ("" = free)
    var pins_y = pins_at_start.y[:]
    var pins_x = pins_at_start.x[:]
    var modified = false                 // active buffer differs from disk → status `[+]`
    var lsp_dirty = false                // buffer changed since the last didChange
    var lsp_idle = 0                      // consecutive idle poll cycles (debounce)
    var yflash = flash_none()            // yank-highlight overlay (vim's on_yank)
    var yflash_ticks = 0                 // poll cycles left before the flash clears
    var lsp_phase = 0                    // 0 none · 1 init sent (awaiting result) · 2 ready
    if str.len(lsp.lsp_lang_of(path)) > 0
        lsp_lang = lsp.lsp_lang_of(path)
        lsp_pid = lsp.lsp_spawn_cmd(lsp.lsp_cmd_for(path, lsp_cfg))
        if lsp_pid >= 0
            lsp_in = proc.stdin_fd(lsp_pid)
            lsp_out = proc.stdout_fd(lsp_pid)
            // Fire `initialize` and move on — the handshake completes
            // asynchronously in the loop so a big file appears instantly
            // instead of blocking on the server's (slow) initialize result.
            lsp.lsp_send(lsp_in, lsp.lsp_init_req(lsp_uri, lsp.lsp_root_uri_for(path)))
            lsp_phase = 1
    clear_screen()       // one-time clear of whatever was on screen before
    left = hscroll_for(left, ed, opts, cols)
    if ts_enabled and str.len(ts_grammar) > 0 and buf_text(ed) != ts_lasttext
        ts_lasttext = buf_text(ed)
        ts_spans_cache = ts.ts_spans(ts_grammar, ts_symbol, ts_queries, ts_lasttext)
    history_init()                       // ensure the history dir + compact the file
    let fbudget = frame_budget()         // how long a moving selection may go unpainted
    frame_begin()
    paint_frame(ed, lay, awin, cols, rows, win_cy, win_cx, win_top, win_left, win_buf, win_ww, win_hw, cur_buf, bufs_text, bufs_path, curpath, top, left, st, cs, opts, diag_li, diag_msgs, lsp_info, modified, ts_spans_cache, yflash)
    frame_end()
    // Stamped when a frame has REACHED the terminal, so the budget measures the
    // gap between presented frames.  Stamping before the paint would charge the
    // paint's own cost to the next budget and make a slow frame demand another
    // one the instant it finished.
    var last_render = now_ms()
    var running = true
    while running
        // Short stdin poll keeps the editor responsive while leaving slack to
        // drain novols' stdout each iteration (combined two-fd poll).
        // While keys are held as the start of a longer map, the poll ends when
        // 'timeoutlen' runs out (at most one 50 ms tick late otherwise).
        var pwait = 50
        if str.len(map_pending) > 0
            let left_ms = tmo - (now_ms() - map_at)
            pwait = if left_ms < 1 then 1 elif left_ms < 50 then left_ms else 50
        var m = novo_pty_poll_h(0, pwait)    // poll host stdin (fd 0)
        // 'timeoutlen' ran out with no further key: the held keys are typed text.
        // They are replayed raw, so the matcher does not see them again.
        if m % 2 == 0 and str.len(map_pending) > 0 and now_ms() - map_at >= tmo
            map_replay = map_pending
            map_pending = ""
            m = 1
        var changed = false
        // Yank flash (vim's on_yank): hold the highlight for ~3 poll cycles
        // (~150ms), then clear it and repaint.
        if yflash.active
            if yflash_ticks <= 0
                yflash = flash_none()
                changed = true
            else
                yflash_ticks = yflash_ticks - 1
        // ── :grep pump: debounced rg respawn + non-blocking row streaming ──
        if picker_active and picker_src == 3
            if grep_pending
                if grep_debounce > 0
                    grep_debounce = grep_debounce - 1
                else
                    grep_pending = false
                    grep_child_kill(grep_pid)        // a newer prompt kills the older rg
                    grep_pid = 0 - 1
                    grep_buf = ""
                    grep_total = 0
                    picker_cands = []
                    picker_marks = []
                    picker_meta = []
                    picker_sel = 0
                    picker_rank_ok = false
                    changed = true
                    picker_moved = true
                    if str.len(picker_query) > 0
                        // explicit "." path: with a piped stdin and NO path,
                        // rg searches stdin and produces nothing for the tree.
                        match proc.spawn(["rg", "--vimgrep", "--", picker_query, "."])
                            None =>
                                picker_active = false
                                lsp_info = "grep: needs ripgrep (rg) on PATH"
                            Some(gp) =>
                                grep_pid = gp
                                grep_fd = proc.stdout_fd(gp)
            if grep_pid >= 0
                // Drain what rg has produced without blocking keystrokes:
                // poll-0 reads, bounded per tick so the UI stays responsive.
                var gbudget = 8192
                var gmore = true
                while gmore and gbudget > 0
                    if proc.poll(grep_fd, 0) == 1
                        let gb = proc.read_byte(grep_fd)
                        if gb < 0                    // EOF — rg finished
                            grep_child_kill(grep_pid)
                            grep_pid = 0 - 1
                            gmore = false
                            changed = true
                        elif gb == '\n'
                            if str.len(grep_buf) > 0
                                // strip rg's "./" path prefix (from the explicit
                                // "." search root) so rows read + compare clean
                                let grow2 = if str.len(grep_buf) > 2 and str.slice(grep_buf, 0, 2) == "./" then str.slice(grep_buf, 2, str.len(grep_buf)) else grep_buf
                                grep_total = grep_total + 1
                                if list.len(picker_cands) < 2000
                                    picker_cands = list.push(picker_cands, grow2)
                                    picker_marks = list.push(picker_marks, "")
                                    picker_meta = list.push(picker_meta, grow2)
                                    picker_rank_ok = false     // the list grew — re-rank
                            grep_buf = ""
                            changed = true
                        else
                            grep_buf = grep_buf + str.from_byte(gb)
                        gbudget = gbudget - 1
                    else
                        gmore = false
        if m % 2 == 1
            lsp_info = ""                 // a transient gd/K message lasts until the next key
            buflist = false               // the :ls overlay is dismissed by the next key
            var done = false
            while not done
                var b = 0
                var from_replay = false
                if str.len(map_replay) > 0            // remapped RHS / flushed bytes, re-fed raw
                    b = str.byte_at(map_replay, 0) ?? 0
                    map_replay = str.slice(map_replay, 1, str.len(map_replay))
                    from_replay = true
                elif esc_pushback != 0 - 99           // a key stashed after a lone ESC
                    b = esc_pushback
                    esc_pushback = 0 - 99
                else
                    b = novo_pty_stdin_read_byte_h()
                // Rank once, ahead of the dispatch, so every handler below reads
                // the same memo: both the arrow keys (resolved inside the escape
                // branch) and the modal picker branch need the ranking, and
                // neither may pay for it per keystroke.
                if picker_active and not picker_rank_ok
                    picker_rank = fuzzy.rank(picker_query, picker_cands, list.len(picker_cands))
                    picker_rank_ok = true
                // Resolve terminal escape sequences (CSI `ESC [`, SS3 `ESC O`)
                // before dispatch so their final letters aren't read as editor
                // commands.  Arrow / Home / End move the cursor; everything else
                // (focus events, device-attribute / cursor-position replies) is
                // ignored.  A lone ESC, or ESC + another key, is delivered as ESC.
                // Replayed bytes are literal — a remapped `<Esc>` is one ESC byte,
                // not the start of a CSI to read more (its rest is in map_replay).
                var esc_skip = false
                // An ESC ends the wait of held map keys: they are typed first, then
                // the ESC is read again (as a pushback) with nothing held.
                let esc_hold = b == '\e' and not from_replay and str.len(map_pending) > 0
                if esc_hold
                    map_replay = map_pending
                    map_pending = ""
                    esc_pushback = b
                    esc_skip = true
                if b == '\e' and not from_replay and not esc_hold
                    var nx = novo_pty_stdin_read_byte_h()
                    // An Alt chord is ESC and a key sent together.  Where a map
                    // for one exists (`meta_live`), a key that is not there yet
                    // is waited for up to `ttm` ms, since the two bytes may reach
                    // us in separate reads; where none exists the ESC goes on at
                    // once, as before.
                    let mcl = map_class(st.mode, cmd_mode or search_mode)
                    let chord_ok = km_active and mcl >= 0 and not picker_active and not zpend and not wpend and not gpend and not cpend and not cpend_obj and not vgc_pend and not comp_active
                    let meta_live = chord_ok and has_meta_map(km, mcl)
                    // With the keyboard protocol on, an Alt chord is never ESC and
                    // a key, so a lone ESC is an Escape key already and nothing
                    // is waited for.
                    if nx == 0 - 2 and meta_live and ttm > 0 and not kitty_on
                        if novo_pty_poll_h(0, ttm) % 2 == 1
                            nx = novo_pty_stdin_read_byte_h()
                    // `ESC O` opens a function-key sequence (`ESC O P` is F1) and
                    // is also Alt-Shift-o.  With a map for it, the byte after is
                    // looked at, with the same wait: nothing, or anything that
                    // does not continue a function-key sequence, makes it the
                    // chord, and that byte is delivered after the chord's RHS.
                    var o_chord = false
                    var o_next = 0 - 2
                    if nx == 'O' and meta_live and meta_idx(km, mcl, 'O') >= 0
                        o_next = novo_pty_stdin_read_byte_h()
                        if o_next == 0 - 2 and ttm > 0 and not kitty_on
                            if novo_pty_poll_h(0, ttm) % 2 == 1
                                o_next = novo_pty_stdin_read_byte_h()
                        if o_next == 0 - 2 or not ss3_continues(o_next)
                            o_chord = true
                    if o_chord
                        map_replay = km.rhs[meta_idx(km, mcl, 'O')]
                        esc_skip = true
                        if o_next >= 0
                            esc_pushback = o_next
                    elif nx == '[' or nx == 'O'
                        // Peek one byte after a CSI `[` to detect an SGR mouse
                        // report (`ESC[<button;col;rowM`); SS3 `O` never is.
                        var c1 = 0 - 1
                        var is_mouse = false
                        if nx == '['
                            c1 = novo_pty_stdin_read_byte_h()
                            is_mouse = c1 == '<'
                        if is_mouse
                            let mev = mouse_seq()              // [button, col, row, final]
                            if list.len(mev) == 4 and not cmd_mode and not search_mode
                                let btn = mev[0]
                                let mfin = mev[3]
                                if btn == 64 or btn == 65         // wheel up / down — scroll the viewport
                                    let body = rows - 1
                                    let nl = list.len(ed.lines)
                                    var t = 0
                                    while t < 3
                                        if btn == 65
                                            top = if top + 1 < nl then top + 1 else top
                                        else
                                            top = if top - 1 > 0 then top - 1 else 0
                                        t = t + 1
                                    var ncy = ed.cy
                                    if ncy < top
                                        ncy = top
                                    if ncy > top + body - 1
                                        ncy = top + body - 1
                                    ed = move_rows(ed, ncy)
                                elif mfin == 'M' and btn == 0     // left-click press — position the caret
                                    let scr = wlayout.rect(0, 0, cols, rows)
                                    let px = mev[1] - 1
                                    let py = mev[2] - 1
                                    let wid = wlayout.window_at(lay, scr, win_ww, win_hw, px, py)
                                    if wid >= 0 and wid != awin
                                        pending_focus = wid       // clicked a different pane → focus it
                                    elif wid == awin
                                        let wr = wlayout.window_rect(lay, awin, scr, win_ww, win_hw)
                                        let r0 = py - wr.y
                                        if r0 >= 0 and r0 < wr.h - 1   // a text row (not the status line)
                                            let nl = list.len(ed.lines)
                                            let ncy = if top + r0 < nl then top + r0 else (if nl > 0 then nl - 1 else 0)
                                            let numbered = opts.number or opts.relativenumber
                                            let numw = if disp.num_digits(nl) > 3 then disp.num_digits(nl) else 3
                                            let gutter = if numbered then numw + 1 else 0
                                            let vcol = (px - wr.x) - gutter + left
                                            let ncx = vis_to_byte(line_at(ed, ncy), if vcol > 0 then vcol else 0, opts.tabstop)
                                            ed = clamp(Editor { lines: ed.lines, cy: ncy, cx: ncx })
                            esc_skip = true
                        else
                            let cr = if nx == '[' then csi_read(c1) elif o_next >= 0 then csi_read(o_next) else csi_read(novo_pty_stdin_read_byte_h())
                            // `CSI … u` is a key report or the answer to the protocol
                            // query, not a cursor or function key (handled at the end).
                            let ufin = nx == '[' and cr[0] == 'u'
                            let packed = if cr[0] < 0 then cr[0] elif ufin then 0 - 1 else cr[1] * 256 + cr[0]
                            // Picker: Up/Down move the selection (visual
                            // directions — bottom-up list, so Up = rank+1).
                            if packed >= 0 and picker_active
                                let kfin = packed % 256
                                if kfin == 'A'
                                    let kcnt = list.len(picker_rank)
                                    if picker_sel + 1 < kcnt
                                        picker_sel = picker_sel + 1
                                    changed = true
                                    picker_moved = true
                                elif kfin == 'B'
                                    if picker_sel > 0
                                        picker_sel = picker_sel - 1
                                    changed = true
                                    picker_moved = true
                            if packed >= 0 and not cmd_mode and not search_mode and not picker_active
                                let fin = packed % 256
                                let prm = packed / 256
                                let ins = st.mode == 1 or st.mode == 4
                                if fin == '~' and prm == 5         // PageUp (~ Ctrl-B)
                                    ed = move_rows(ed, scroll_new_cy(ed, rows, 3))
                                    top = scroll_new_top(ed.cy, top, rows, 3)
                                elif fin == '~' and prm == 6       // PageDown (~ Ctrl-F)
                                    ed = move_rows(ed, scroll_new_cy(ed, rows, 2))
                                    top = scroll_new_top(ed.cy, top, rows, 2)
                                elif fin == '~' and prm == 3       // Delete — forward-delete the char at the cursor
                                    if ins
                                        let ln = line_at(ed, ed.cy)
                                        if ed.cx < str.len(ln)
                                            es = edit_push_undo(var es, ed)
                                            let newln = str.slice(ln, 0, ed.cx) + str.slice(ln, util.u8_next(ln, ed.cx), str.len(ln))
                                            ed = Editor { lines: set_line(ed.lines, ed.cy, newln), cy: ed.cy, cx: ed.cx }
                                    else
                                        let dstep = feed_edit(ed, st, km, var es, 'x')   // normal/visual: like `x`
                                        ed = dstep.ed
                                        st = dstep.st
                                        es = dstep.es
                                elif fin == '~' and (prm == 1 or prm == 7)   // Home
                                    ed = arrow_move(ed, 'H', ins)
                                elif fin == '~' and (prm == 4 or prm == '\b')   // End
                                    ed = arrow_move(ed, 'F', ins)
                                elif fin != '~'                    // arrows / Home(H) / End(F)
                                    ed = arrow_move(ed, fin, ins)
                            // Ex line: Up/Down walk history, Left/Right/Home/End
                            // move the insertion point, Delete removes at it.
                            if packed >= 0 and cmd_mode
                                let cfin = packed % 256
                                let cprm = packed / 256
                                if cfin == 'A' and hist_idx > 0           // ↑ older
                                    hist_idx = hist_idx - 1
                                    cmd_buf = cmd_hist[hist_idx]
                                    cmd_cx = str.len(cmd_buf)
                                    changed = true
                                elif cfin == 'B'                          // ↓ newer
                                    if hist_idx < list.len(cmd_hist) - 1
                                        hist_idx = hist_idx + 1
                                        cmd_buf = cmd_hist[hist_idx]
                                        cmd_cx = str.len(cmd_buf)
                                        changed = true
                                    elif hist_idx < list.len(cmd_hist)
                                        hist_idx = list.len(cmd_hist)     // back to the empty new line
                                        cmd_buf = ""
                                        cmd_cx = 0
                                        changed = true
                                elif cfin == 'D'                          // ← left
                                    if cmd_cx > 0
                                        cmd_cx = util.u8_prev(cmd_buf, cmd_cx)
                                        changed = true
                                elif cfin == 'C'                          // → right
                                    if cmd_cx < str.len(cmd_buf)
                                        cmd_cx = util.u8_next(cmd_buf, cmd_cx)
                                        changed = true
                                elif cfin == 'H' or (cfin == '~' and (cprm == 1 or cprm == 7))   // Home
                                    cmd_cx = 0
                                    changed = true
                                elif cfin == 'F' or (cfin == '~' and cprm == 4)                  // End
                                    cmd_cx = str.len(cmd_buf)
                                    changed = true
                                elif cfin == '~' and cprm == 3            // Delete — remove at the cursor
                                    if cmd_cx < str.len(cmd_buf)
                                        cmd_buf = str.slice(cmd_buf, 0, cmd_cx) + str.slice(cmd_buf, util.u8_next(cmd_buf, cmd_cx), str.len(cmd_buf))
                                        changed = true
                            // Search line: Up/Down history, Left/Right/Home/End
                            // move the insertion point, Delete removes at it.
                            if packed >= 0 and search_mode
                                let sfin = packed % 256
                                let sprm = packed / 256
                                if sfin == 'A' and shist_idx > 0          // ↑ older
                                    shist_idx = shist_idx - 1
                                    search_buf = search_hist[shist_idx]
                                    search_cx = str.len(search_buf)
                                    changed = true
                                elif sfin == 'B'                          // ↓ newer
                                    if shist_idx < list.len(search_hist) - 1
                                        shist_idx = shist_idx + 1
                                        search_buf = search_hist[shist_idx]
                                        search_cx = str.len(search_buf)
                                        changed = true
                                    elif shist_idx < list.len(search_hist)
                                        shist_idx = list.len(search_hist)
                                        search_buf = ""
                                        search_cx = 0
                                        changed = true
                                elif sfin == 'D'                          // ← left
                                    if search_cx > 0
                                        search_cx = util.u8_prev(search_buf, search_cx)
                                        changed = true
                                elif sfin == 'C'                          // → right
                                    if search_cx < str.len(search_buf)
                                        search_cx = util.u8_next(search_buf, search_cx)
                                        changed = true
                                elif sfin == 'H' or (sfin == '~' and (sprm == 1 or sprm == 7))   // Home
                                    search_cx = 0
                                    changed = true
                                elif sfin == 'F' or (sfin == '~' and sprm == 4)                  // End
                                    search_cx = str.len(search_buf)
                                    changed = true
                                elif sfin == '~' and sprm == 3            // Delete — remove at the cursor
                                    if search_cx < str.len(search_buf)
                                        search_buf = str.slice(search_buf, 0, search_cx) + str.slice(search_buf, util.u8_next(search_buf, search_cx), str.len(search_buf))
                                        changed = true
                            esc_skip = true
                            if ufin and cr[3] == '?'
                                // The answer to `CSI ? u`: the flags in force.  Flag 1
                                // on means the terminal reports chords as `CSI … u`.
                                kitty_on = cr[1] % 2 == 1
                            elif ufin and cr[3] == 0
                                // A key report.  Its key becomes the bytes it stands
                                // for and goes through the matcher and the editor as
                                // if typed; an Alt chord with a map runs the map.
                                let kmods = if cr[2] > 0 then cr[2] else 1
                                let kbytes = kitty_keybytes(cr[1], kmods)
                                if str.len(kbytes) > 0
                                    if kitty_alt(kmods)
                                        let kmi = if chord_ok then meta_idx_str(km, mcl, kbytes) else 0 - 1
                                        if kmi >= 0
                                            map_replay = km.rhs[kmi]
                                        else
                                            b = '\e'                // no map: Escape, then the key
                                            map_replay = kbytes
                                            esc_skip = false
                                    else
                                        b = str.byte_at(kbytes, 0) ?? 0
                                        map_replay = str.slice(kbytes, 1, str.len(kbytes))
                                        esc_skip = false
                    elif nx >= 0
                        let mi = if meta_live then meta_idx(km, mcl, nx) else 0 - 1
                        if mi >= 0
                            map_replay = km.rhs[mi]       // the chord's RHS, re-fed as typed bytes
                            esc_skip = true
                        else
                            esc_pushback = nx
                // Multi-key keymap matcher: a fresh Normal-mode key (not a replay,
                // not an escape sequence) extends the pending LHS prefix.  Exact
                // match → queue the RHS for replay; still-a-prefix → buffer and
                // wait for the next key; dead end → flush the buffered keys + this
                // one literally.  Single-byte maps are handled in feed (feed_mapped),
                // so this only fires for multi-byte LHS (`<leader>w`, `vv`, `;p`).
                // Mode class for the matcher: 0 = Normal, 1 = Visual (char/line/
                // block), 2 = Insert; Replace (4) doesn't run it.
                let mclass = if st.mode == 0 then 0 elif st.mode == 2 or st.mode == 3 or st.mode == 5 then 1 elif st.mode == 1 then 2 else 0 - 1
                var map_eat = false
                if km_active and mclass >= 0 and not from_replay and not esc_skip and b >= 0 and not cmd_mode and not search_mode and not picker_active and not zpend and not wpend and not gpend and not cpend and not cpend_obj and not vgc_pend and not comp_active and esc_pushback == 0 - 99
                    let cand = map_pending + str.from_byte(b)
                    let ei = keymap_seq_idx(km, cand, mclass)
                    // A key report that stands for more than one byte left the rest in
                    // map_replay; what the matcher queues goes in front of it.
                    if ei >= 0
                        map_replay = km.rhs[ei] + map_replay
                        map_pending = ""
                        map_eat = true
                    elif keymap_is_prefix(km, cand, mclass)
                        map_pending = cand
                        map_at = now_ms()
                        map_eat = true
                    elif str.len(map_pending) > 0     // buffered prefix hit a dead end → flush it + b
                        map_replay = cand + map_replay
                        map_pending = ""
                        map_eat = true
                if map_eat
                    done = done                      // consumed by the matcher; loop for replay / next key
                elif esc_skip
                    done = done                      // sequence consumed — no editor action
                elif b == -2
                    done = true
                elif b == -1
                    done = true
                    running = false
                elif picker_active                       // modal picker input
                    if b == '\r'                         // Enter ('\r' only — Ctrl-J is 0x0a)
                        // The selection is a rank over the WHOLE match set, so
                        // the acted-on row is that rank, not the window's copy.
                        if picker_sel < list.len(picker_rank)
                            let ridx = picker_rank[picker_sel]
                            if picker_src == 3               // :grep — jump to file:line:col
                                let grow = picker_meta[ridx]
                                let g1 = util.index_of_byte(grow, ':')
                                let g2 = if g1 >= 0 then util.index_of_byte_from(grow, ':', g1 + 1) else 0 - 1
                                let g3 = if g2 >= 0 then util.index_of_byte_from(grow, ':', g2 + 1) else 0 - 1
                                if g1 > 0 and g2 > g1 and g3 > g2
                                    let gfile = str.slice(grow, 0, g1)
                                    let gline = (str.to_int(str.slice(grow, g1 + 1, g2)) ?? 1) - 1
                                    let gcol = (str.to_int(str.slice(grow, g2 + 1, g3)) ?? 1) - 1
                                    jback = list.push(jback, jentry(curpath, ed.cy, ed.cx))
                                    jfwd = []
                                    if gfile == curpath
                                        ed = clamp(Editor { lines: ed.lines, cy: gline, cx: gcol })
                                    else
                                        want_path = gfile
                                        want_y = gline
                                        want_x = gcol
                            elif picker_meta[ridx] != curpath   // :bufs switch / :files open / :pins jump
                                want_path = picker_meta[ridx]   // want_path opens unseen files too
                                want_y = 0 - 1
                                want_x = 0
                                if picker_src == 2              // pins restore the pinned cursor
                                    var pjs = 0
                                    while pjs < list.len(pins_p)
                                        if rel_of(pins_p[pjs]) == picker_meta[ridx]
                                            want_y = pins_y[pjs]
                                            want_x = pins_x[pjs]
                                        pjs = pjs + 1
                        grep_child_kill(grep_pid)
                        grep_pid = 0 - 1
                        grep_pending = false
                        picker_active = false
                        changed = true
                    elif b == '\e'                       // Esc — dismiss
                        grep_child_kill(grep_pid)
                        grep_pid = 0 - 1
                        grep_pending = false
                        picker_active = false
                        changed = true
                    elif b == '\x0b' or b == '\x10'      // Ctrl-K / Ctrl-P — visually UP
                        // Bottom-up list: rank 0 (best) is the bottom row, so
                        // moving up on screen means a HIGHER rank index.  The
                        // bound is every match, not the windowful on screen —
                        // the window follows the selection, not the reverse.
                        let pcnt = list.len(picker_rank)
                        if picker_sel + 1 < pcnt
                            picker_sel = picker_sel + 1
                        changed = true
                        picker_moved = true
                    elif b == '\x0a' or b == '\x0e'      // Ctrl-J / Ctrl-N — visually DOWN
                        if picker_sel > 0
                            picker_sel = picker_sel - 1
                        changed = true
                        picker_moved = true
                    elif b == '\x7f' or b == '\b'        // Backspace — shrink the query
                        if str.len(picker_query) > 0
                            picker_query = str.slice(picker_query, 0, str.len(picker_query) - 1)
                            picker_sel = 0
                            picker_rank_ok = false
                            if picker_src == 3           // :grep re-runs rg for the new prompt
                                grep_pending = true
                                grep_debounce = 2        // ~100ms at the 50ms poll cadence
                        changed = true
                        picker_moved = true
                    elif b >= ' ' and b < '\x7f'         // type — extend the query, re-rank
                        picker_query = picker_query + str.from_byte(b)
                        picker_sel = 0
                        picker_rank_ok = false
                        if picker_src == 3
                            grep_pending = true
                            grep_debounce = 2
                        changed = true
                        picker_moved = true
                elif cmd_mode
                    if b == '\r' or b == '\n'            // Enter — run command
                        if excmd.is_substitute(cmd_buf)
                            es = edit_push_undo(var es, ed)
                            ed = ex_substitute(ed, cmd_buf)
                            last_subst = cmd_buf
                        elif excmd.is_global(cmd_buf)
                            es = edit_push_undo(var es, ed)
                            ed = ex_global(ed, cmd_buf)
                        elif excmd.is_sort(cmd_buf)
                            es = edit_push_undo(var es, ed)
                            ed = ex_sort(ed, cmd_buf, rng_vlo, rng_vhi)
                        elif excmd.move_kind(cmd_buf) != 0
                            es = edit_push_undo(var es, ed)
                            ed = ex_linemove(ed, cmd_buf, excmd.move_kind(cmd_buf) == 2, rng_vlo, rng_vhi)
                        elif excmd.is_delete(cmd_buf)
                            es = edit_push_undo(var es, ed)
                            ed = ex_delete(ed, cmd_buf, rng_vlo, rng_vhi)
                        elif excmd.shift_amount(cmd_buf) != 0
                            es = edit_push_undo(var es, ed)
                            ed = ex_shift(ed, cmd_buf, rng_vlo, rng_vhi, opts.expandtab, opts.tabstop)
                        elif excmd.is_retab(cmd_buf)
                            es = edit_push_undo(var es, ed)
                            ed = ex_retab(ed, cmd_buf, rng_vlo, rng_vhi, opts.tabstop)
                        elif excmd.is_yank(cmd_buf)
                            let rs = excmd.parse_range(cmd_buf, rng_vlo, rng_vhi, ed.cy, list.len(ed.lines))
                            let ylo = if rs.has then rs.lo else ed.cy
                            let yhi = if rs.has then rs.hi else ed.cy
                            let ytext = range_yank_text(ed.lines, ylo, yhi)
                            st = ist_set_reg(st, ytext, true)        // linewise → unnamed register
                            es = edit_numreg_yank(var es, ytext, true)
                            ed = clamp(Editor { lines: ed.lines, cy: yhi, cx: 0 })
                            yflash = flash_lines(ylo, yhi)           // flash the yanked range
                            yflash_ticks = 3
                        elif excmd.is_goto(cmd_buf)
                            jback = list.push(jback, jentry(curpath, ed.cy, ed.cx))
                            jfwd = []
                            ed = ex_goto(ed, cmd_buf)
                        elif is_set(cmd_buf) and is_ts_set(cmd_buf)   // :set treesitter / nots / ts! — driver toggle
                            ts_enabled = ts_set_value(cmd_buf, ts_enabled)
                            ts_lasttext = "\x00"          // force a re-parse (or clears on next frame)
                            if not ts_enabled
                                ts_spans_cache = []
                            lsp_info = if ts_enabled then "treesitter on" else "treesitter off"
                        elif is_set(cmd_buf)
                            opts = apply_set(opts, cmd_buf)
                            left = hscroll_for(left, ed, opts, cols)
                        elif exhelp.is_help(cmd_buf)             // :help [topic] — the Ex command cheat sheet in a read-only split
                            let htext = exhelp.help_text(exhelp.help_topic(cmd_buf), cols - 6)
                            let hix = buf_index_of(bufs_path, exhelp.help_path())
                            var hwin = 0 - 1                       // a window already showing it
                            if hix >= 0
                                let hids = wlayout.layout_winids(lay, [])
                                var hwi = 0
                                while hwi < list.len(hids)
                                    if win_buf[hids[hwi]] == hix
                                        hwin = hids[hwi]
                                    hwi = hwi + 1
                            if hwin < 0
                                help_fill = htext                  // no help window: split, then show the buffer
                                if hix >= 0
                                    bufs_text = util.set_str_at(bufs_text, hix, htext)
                                    bufs_disk = util.set_str_at(bufs_disk, hix, htext)
                                    bufs_cy = util.set_int_at(bufs_cy, hix, 0)
                                    bufs_cx = util.set_int_at(bufs_cx, hix, 0)
                                    bufs_top = util.set_int_at(bufs_top, hix, 0)
                                pending_wcmd = 1
                                want_path = exhelp.help_path()
                                want_y = 0 - 1
                            else                                   // reuse it: new content, cursor home, focus
                                bufs_text = util.set_str_at(bufs_text, hix, htext)
                                bufs_disk = util.set_str_at(bufs_disk, hix, htext)
                                bufs_cy = util.set_int_at(bufs_cy, hix, 0)
                                bufs_cx = util.set_int_at(bufs_cx, hix, 0)
                                bufs_top = util.set_int_at(bufs_top, hix, 0)
                                win_cy = util.set_int_at(win_cy, hwin, 0)
                                win_cx = util.set_int_at(win_cx, hwin, 0)
                                win_top = util.set_int_at(win_top, hwin, 0)
                                win_left = util.set_int_at(win_left, hwin, 0)
                                if hix == cur_buf
                                    ed = Editor { lines: str.split_lines(htext), cy: 0, cx: 0 }
                                    disk_text = htext
                                    top = 0
                                    left = 0
                                else
                                    pending_focus = hwin
                        elif excmd.is_noh(cmd_buf)
                            hl_off = true                 // hide the highlight; keep the pattern for n/N
                        elif excmd.is_fmt(cmd_buf)
                            if lsp_phase == 2
                                lsp_reqid = lsp_reqid + 1
                                lsp.lsp_send(lsp_in, lsp.lsp_formatting_req(lsp_reqid, lsp_uri, opts.tabstop))
                                let fresp = lsp.lsp_pump(lsp_out, lsp_reqid, 40)
                                if str.len(fresp) == 0
                                    lsp_info = "format: no response"
                                else
                                    let nt = lsp.lsp_fmt_newtext(fresp)
                                    if str.len(nt) == 0
                                        lsp_info = "format: no changes"
                                    else
                                        es = edit_push_undo(var es, ed)
                                        let nls = str.split_lines(nt)
                                        ed = clamp(Editor { lines: if list.len(nls) == 0 then [""] else nls, cy: ed.cy, cx: ed.cx })
                                        // refresh diagnostics for the reformatted buffer
                                        lsp_lasttext = buf_text(ed)
                                        lsp_ver = lsp_ver + 1
                                        lsp.lsp_send(lsp_in, lsp.lsp_didchange(lsp_uri, lsp_ver, lsp_lasttext))
                                        lsp_info = "formatted"
                            else
                                lsp_info = "format: LSP not ready"
                        elif excmd.is_sym(cmd_buf)
                            if lsp_phase == 2
                                let q = excmd.sym_query(cmd_buf)
                                lsp_reqid = lsp_reqid + 1
                                lsp.lsp_send(lsp_in, lsp.lsp_documentsymbol_req(lsp_reqid, lsp_uri))
                                let sresp = lsp.lsp_pump(lsp_out, lsp_reqid, 40)
                                if str.len(sresp) == 0
                                    lsp_info = "sym: no response"
                                else
                                    let snames = lsp.lsp_sym_names(sresp)
                                    let spos = lsp.lsp_sym_pos(sresp)
                                    var found = 0 - 1
                                    var si = 0
                                    while si < list.len(snames) and found < 0
                                        if str.len(q) == 0 or util.index_of_str(snames[si], q) >= 0
                                            found = si
                                        si = si + 1
                                    if found >= 0 and found * 2 + 1 < list.len(spos)
                                        jback = list.push(jback, jentry(curpath, ed.cy, ed.cx))
                                        jfwd = []
                                        ed = clamp(Editor { lines: ed.lines, cy: spos[found * 2], cx: spos[found * 2 + 1] })
                                        lsp_info = "sym: " + snames[found]
                                    else
                                        lsp_info = "sym: no match"
                            else
                                lsp_info = "sym: LSP not ready"
                        elif excmd.is_rename(cmd_buf)
                            if lsp_phase != 2
                                lsp_info = "rename: LSP not ready"
                            else
                                let nn = excmd.rename_query(cmd_buf)
                                if str.len(nn) == 0
                                    lsp_info = "rename: usage :rename <newname>"
                                else
                                    lsp_reqid = lsp_reqid + 1
                                    lsp.lsp_send(lsp_in, lsp.lsp_rename_req(lsp_reqid, lsp_uri, ed.cy, ed.cx, nn))
                                    let rresp = lsp.lsp_pump(lsp_out, lsp_reqid, 40)
                                    if str.len(rresp) == 0
                                        lsp_info = "rename: no response"
                                    else
                                        let nts = lsp.lsp_rename_newtexts(rresp)
                                        if list.len(nts) == 0
                                            lsp_info = "rename: no occurrences"
                                        else
                                            let trips = lsp.lsp_rename_triples(rresp)
                                            es = edit_push_undo(var es, ed)
                                            ed = clamp(apply_rename(ed, trips, nts))
                                            lsp_lasttext = buf_text(ed)
                                            lsp_ver = lsp_ver + 1
                                            lsp.lsp_send(lsp_in, lsp.lsp_didchange(lsp_uri, lsp_ver, lsp_lasttext))
                                            lsp_info = "renamed " + str.from_int(list.len(nts)) + " sites"
                        elif excmd.is_reload(cmd_buf)            // bare :e / :e! — reload from disk
                            let bang = util.index_of_byte(cmd_buf, '!') >= 0
                            if (not bang) and buf_text(ed) != disk_text
                                lsp_info = "unsaved changes (:e! to override)"
                            else
                                let fresh = file_to_text(curpath)
                                es = edit_push_undo(var es, ed)
                                let fl = str.split_lines(fresh)
                                ed = clamp(Editor { lines: if list.len(fl) == 0 then [""] else fl, cy: ed.cy, cx: ed.cx })
                                disk_text = buf_text(ed)
                                if lsp_phase == 2
                                    lsp_lasttext = buf_text(ed)
                                    lsp_ver = lsp_ver + 1
                                    lsp.lsp_send(lsp_in, lsp.lsp_didchange(lsp_uri, lsp_ver, lsp_lasttext))
                                lsp_info = "reloaded " + util.basename_of(curpath)
                        elif excmd.is_edit_cmd(cmd_buf)
                            let tgt = excmd.edit_cmd_path(cmd_buf)
                            if str.len(tgt) == 0
                                lsp_info = "edit: usage :e <file>"
                            else                          // open/switch the buffer (edits are preserved in memory)
                                jback = list.push(jback, jentry(curpath, ed.cy, ed.cx))
                                jfwd = []
                                want_path = tgt
                                want_y = 0 - 1            // restore the buffer's saved cursor
                                want_x = 0
                                lsp_info = str.from_char('"') + tgt + str.from_char('"')
                        elif excmd.is_bufdo(cmd_buf)            // :bufdo <subcmd> — substitute across all buffers
                            let sub = excmd.cmd_arg(cmd_buf)
                            if not excmd.is_substitute(sub)
                                lsp_info = "bufdo: only :s/:%s supported"
                            else
                                es = edit_push_undo(var es, ed)   // active buffer
                                ed = ex_substitute(ed, sub)
                                var bi = 0                     // stored buffers
                                while bi < list.len(bufs_text)
                                    if bi != cur_buf and bufs_path[bi] != exhelp.help_path()
                                        let pre = bufs_text[bi]
                                        let nt = sub_text(pre, sub)
                                        if nt != pre
                                            bufs_undo = util.set_str_at(bufs_undo, bi, undo_push_text(bufs_undo[bi], pre))
                                            bufs_redo = util.set_str_at(bufs_redo, bi, "")
                                            bufs_text = util.set_str_at(bufs_text, bi, nt)
                                    bi = bi + 1
                                if lsp_phase == 2
                                    lsp_lasttext = buf_text(ed)
                                    lsp_ver = lsp_ver + 1
                                    lsp.lsp_send(lsp_in, lsp.lsp_didchange(lsp_uri, lsp_ver, lsp_lasttext))
                                lsp_info = "bufdo: " + str.from_int(list.len(bufs_text)) + " buffers"
                        elif excmd.is_badd(cmd_buf)            // :badd <file> — add buffer without switching
                            let tgt = excmd.cmd_arg(cmd_buf)
                            if str.len(tgt) == 0
                                lsp_info = "badd: usage :badd <file>"
                            elif buf_index_of(bufs_path, tgt) >= 0
                                lsp_info = "already open: " + util.basename_of(tgt)
                            else
                                bufs_text = list.push(bufs_text, file_to_text(tgt))
                                bufs_path = list.push(bufs_path, tgt)
                                bufs_cy = list.push(bufs_cy, 0)
                                bufs_cx = list.push(bufs_cx, 0)
                                bufs_top = list.push(bufs_top, 0)
                                bufs_left = list.push(bufs_left, 0)
                                bufs_disk = list.push(bufs_disk, file_to_text(tgt))
                                bufs_undo = list.push(bufs_undo, "")
                                bufs_redo = list.push(bufs_redo, "")
                                bufs_marky = list.push(bufs_marky, "")
                                bufs_markx = list.push(bufs_markx, "")
                                bufs_diag = list.push(bufs_diag, "")
                                bufs_lspopen = list.push(bufs_lspopen, false)
                                if lsp.lsp_lang_of(tgt) == lsp_lang and lsp_lang != "" and lsp_phase == 2   // open the doc so its diagnostics go live
                                    lsp.lsp_send(lsp_in, lsp.lsp_didopen("file://" + tgt, lsp_lang, file_to_text(tgt)))
                                    bufs_lspopen = util.set_bool_at(bufs_lspopen, list.len(bufs_path) - 1, true)
                                lsp_info = "added " + util.basename_of(tgt) + "; " + str.from_int(list.len(bufs_path)) + " buffers"
                        elif excmd.argcmd_kind(cmd_buf) > 0    // :args / :next / :prev / :first / :last / :wn / :wN
                            let ak = excmd.argcmd_kind(cmd_buf)
                            let na = list.len(arglist)
                            if ak == 1                    // :args — show the list
                                lsp_info = excmd.arglist_str(arglist, arg_idx)
                            else
                                let tgt = if ak == 2 or ak == 6 then arg_idx + 1 elif ak == 3 or ak == 7 then arg_idx - 1 elif ak == 4 then 0 else na - 1
                                if tgt < 0 or tgt >= na
                                    lsp_info = if tgt < 0 then "at first arg" else "at last arg"
                                else
                                    // :wn / :wN write the current buffer
                                    // BEFORE leaving it, so a write that
                                    // fails has to stop the navigation —
                                    // otherwise the edits are gone with
                                    // the buffer and the only trace is a
                                    // status line nobody read.
                                    var wn_ok = true
                                    if ak == 6 or ak == 7
                                        // Skip the write for an unnamed
                                        // buffer rather than creating "".
                                        if curpath != ""
                                            wn_ok = save_buf(curpath, ed.lines)
                                            if wn_ok
                                                disk_text = buf_text(ed)
                                    if not wn_ok
                                        lsp_info = write_failed_msg(curpath)
                                    else
                                        arg_idx = tgt
                                        jback = list.push(jback, jentry(curpath, ed.cy, ed.cx))
                                        jfwd = []
                                        want_path = arglist[tgt]
                                        want_y = 0 - 1
                                        want_x = 0
                        elif excmd.is_bufs(cmd_buf)          // :bufs — the interactive buffer picker
                            picker_active = true
                            picker_src = 0
                            picker_query = ""
                            picker_sel = 0
                            picker_rank_ok = false
                            picker_cands = []
                            picker_marks = []
                            picker_meta = []
                            var pbi = 0
                            while pbi < list.len(bufs_path)
                                if bufs_path[pbi] != exhelp.help_path()      // unlisted
                                    picker_cands = list.push(picker_cands, bufs_path[pbi])
                                    picker_marks = list.push(picker_marks, if pbi == cur_buf then "% " elif pbi == alt_buf then "# " else "  ")
                                    picker_meta = list.push(picker_meta, bufs_path[pbi])
                                pbi = pbi + 1
                        elif excmd.is_files(cmd_buf)         // :files [query] — the file picker
                            picker_active = true
                            picker_src = 1
                            picker_query = excmd.files_query(cmd_buf)
                            picker_sel = 0
                            picker_rank_ok = false
                            picker_cands = files_candidates(10000)
                            picker_marks = []
                            picker_meta = []
                            var pfi = 0
                            while pfi < list.len(picker_cands)
                                picker_marks = list.push(picker_marks, "  ")
                                picker_meta = list.push(picker_meta, picker_cands[pfi])
                                pfi = pfi + 1
                        elif excmd.is_grep(cmd_buf)          // :grep [query] — live grep
                            // Probe for rg first: spawn() fork+execs, so a missing
                            // binary still yields Some(dead child) — an empty
                            // `rg --version` is the reliable absence signal.
                            let rgprobe = match proc.spawn(["rg", "--version"])
                                None => []
                                Some(vp) => proc_drain_lines(vp)
                            if list.len(rgprobe) == 0
                                lsp_info = "grep: needs ripgrep (rg) on PATH"
                            else
                                picker_active = true
                                picker_src = 3
                                picker_query = excmd.files_query(cmd_buf)
                                picker_sel = 0
                                picker_rank_ok = false
                                picker_cands = []
                                picker_marks = []
                                picker_meta = []
                                grep_child_kill(grep_pid)
                                grep_pid = 0 - 1
                                grep_buf = ""
                                grep_total = 0
                                grep_pending = true
                                grep_debounce = 0        // first spawn fires immediately
                        elif excmd.is_pins(cmd_buf)          // :pins — the pin picker
                            picker_active = true
                            picker_src = 2
                            picker_query = ""
                            picker_sel = 0
                            picker_rank_ok = false
                            picker_cands = []
                            picker_marks = []
                            picker_meta = []
                            var ppi = 0
                            while ppi < list.len(pins_p)
                                if str.len(pins_p[ppi]) > 0
                                    picker_cands = list.push(picker_cands, rel_of(pins_p[ppi]))
                                    picker_marks = list.push(picker_marks, str.from_int(ppi + 1) + " ")
                                    picker_meta = list.push(picker_meta, rel_of(pins_p[ppi]))
                                ppi = ppi + 1
                        elif excmd.is_pinjump(cmd_buf)       // :pinjump N — jump to slot N
                            let jsl = excmd.pin_slot_arg(cmd_buf)
                            if jsl >= 1 and jsl <= list.len(pins_p) and str.len(pins_p[jsl - 1]) > 0
                                if pins_p[jsl - 1] != abs_of(curpath)
                                    want_path = rel_of(pins_p[jsl - 1])
                                    want_y = pins_y[jsl - 1]
                                    want_x = pins_x[jsl - 1]
                                lsp_info = "pin [" + str.from_int(jsl) + "] " + util.basename_of(pins_p[jsl - 1])
                            else
                                lsp_info = "pin [" + str.from_int(jsl) + "]: empty"
                        elif excmd.is_unpin(cmd_buf)         // :unpin [N] — remove a pin
                            let usl = excmd.pin_slot_arg(cmd_buf)
                            let utgt = if usl >= 1 then usl - 1 else pins_slot_of(pins_p, abs_of(curpath))
                            if utgt >= 0 and utgt < list.len(pins_p) and str.len(pins_p[utgt]) > 0
                                pins_p = util.set_str_at(pins_p, utgt, "")
                                pins_save(pins_root, pins_p, pins_y, pins_x)
                                lsp_info = "unpinned [" + str.from_int(utgt + 1) + "]"
                            else
                                lsp_info = "unpin: no pin"
                        elif excmd.is_pin(cmd_buf)           // :pin [N] — pin the current file
                            let psl = excmd.pin_slot_arg(cmd_buf)
                            let pabs = abs_of(curpath)
                            let phave = pins_slot_of(pins_p, pabs)
                            if psl == 0 and phave >= 0
                                lsp_info = "already pinned [" + str.from_int(phave + 1) + "]"
                            else
                                let pslot = if psl >= 1 then psl - 1 else pins_free_slot(pins_p)
                                let pnew = pins_put(Pins { p: pins_p, y: pins_y, x: pins_x }, pslot, pabs, ed.cy, ed.cx)
                                pins_p = pnew.p[:]
                                pins_y = pnew.y[:]
                                pins_x = pnew.x[:]
                                pins_save(pins_root, pins_p, pins_y, pins_x)
                                lsp_info = "pinned [" + str.from_int(pslot + 1) + "] " + util.basename_of(curpath)
                        elif excmd.is_bufcmd(cmd_buf)
                            let nb = list.len(bufs_path)
                            let bk = excmd.bufcmd_kind(cmd_buf)
                            if bk == 0                    // :ls — show the buffer list overlay
                                buflist = true
                            elif bk == 3                  // :bd — close current
                                if nb <= 1
                                    lsp_info = "cannot close the last buffer"
                                else
                                    let surv = if cur_buf > 0 then cur_buf - 1 else 1
                                    want_close = curpath
                                    want_path = bufs_path[surv]
                                    want_y = 0 - 1
                                    want_x = 0
                            else                          // navigation: bn/bp/bfirst/blast
                                var tgt2 = if bk == 1 then (cur_buf + 1) % nb elif bk == 2 then (cur_buf + nb - 1) % nb elif bk == 4 then 0 else nb - 1
                                if bufs_path[tgt2] == exhelp.help_path()      // unlisted: step past it
                                    tgt2 = if bk == 2 or bk == 5 then (tgt2 + nb - 1) % nb else (tgt2 + 1) % nb
                                jback = list.push(jback, jentry(curpath, ed.cy, ed.cx))
                                jfwd = []
                                want_path = bufs_path[tgt2]
                                want_y = 0 - 1
                                want_x = 0
                        elif excmd.is_bgoto(cmd_buf)             // :b <n> / :b <name> / :b#
                            let barg = excmd.bgoto_arg(cmd_buf)
                            let bn2 = excmd.bgoto_target(cmd_buf)
                            // `#` = alternate buffer; a number switches by index;
                            // otherwise match a filename
                            let bidx = if barg == "#" then alt_buf elif bn2 >= 1 and bn2 <= list.len(bufs_path) then bn2 - 1 else excmd.buf_find_by_name(bufs_path, barg)
                            if bidx >= 0
                                jback = list.push(jback, jentry(curpath, ed.cy, ed.cx))
                                jfwd = []
                                want_path = bufs_path[bidx]
                                want_y = 0 - 1
                                want_x = 0
                            else
                                lsp_info = "no buffer matching " + barg
                        elif excmd.writeall_kind(cmd_buf) > 0   // :wa / :wqa / :xa / :qa
                            let wk = excmd.writeall_kind(cmd_buf)
                            var wa_failed = false
                            if wk == 1 or wk == 2
                                let w = write_all_bufs(bufs_path, bufs_text, bufs_disk, cur_buf, ed, disk_text)
                                if w.failed > 0
                                    // Marking the buffers saved after a
                                    // failed write is how `:wqa` used to
                                    // quit over the top of unwritten edits:
                                    // the count it reported was of ATTEMPTS.
                                    wa_failed = true
                                    lsp_info = write_failed_msg(w.first_fail)
                                          + " (" + str.from_int(w.failed) + " of "
                                          + str.from_int(w.wrote + w.failed) + " buffer(s))"
                                else
                                    disk_text = buf_text(ed)
                                    bufs_disk = mark_all_saved(bufs_text, bufs_disk)
                                    lsp_info = "wrote " + str.from_int(w.wrote) + " buffer(s)"
                            let blocked = wa_failed
                                       or (wk == 3 and buffers_modified(bufs_text, bufs_disk, cur_buf, buf_text(ed), disk_text))
                            if blocked
                                lsp_info = "unsaved buffers (:qa! to override)"
                            elif wk == 2 or wk == 3 or wk == 4
                                running = false
                                done = true
                        elif excmd.is_split(cmd_buf)            // :split / :sp — stacked window split
                            pending_wcmd = 1
                        elif excmd.is_vsplit(cmd_buf)           // :vsplit / :vs — side-by-side split
                            pending_wcmd = 4
                        elif excmd.is_winclose(cmd_buf) and wlayout.layout_count(lay) > 1   // :close / :q with splits → close window
                            pending_wcmd = 3
                        elif excmd.is_only(cmd_buf)            // :only — keep just the active window
                            pending_wcmd = 5
                        elif excmd.is_colorscheme(cmd_buf)     // :colorscheme <name> — live theme switch
                            cs = colorscheme.colorscheme_named(excmd.colorscheme_arg(cmd_buf), cdepth)
                            lsp_info = "colorscheme " + excmd.colorscheme_arg(cmd_buf)
                        else
                            let r = excmd.exec_ex(cmd_buf)
                            if r.save
                                // An unnamed buffer (novim with no file
                                // argument) has nowhere to go: writing
                                // would create a file literally named "".
                                if curpath == ""
                                    lsp_info = "E32: no file name"
                                elif curpath == exhelp.help_path()
                                    lsp_info = "E382: cannot write, the help buffer is not a file"
                                else
                                    if save_buf(curpath, ed.lines)
                                        disk_text = buf_text(ed)
                                        lsp_info = wrote_msg(curpath, ed.lines)
                                    else
                                        // disk_text is NOT advanced, so the
                                        // buffer stays modified and the `:wq`
                                        // guard below sees it.
                                        lsp_info = write_failed_msg(curpath)
                            if r.quit
                                // `:wq` used to quit on the strength of having
                                // ATTEMPTED the write — `not r.save` skipped
                                // the modified check entirely.  A failed `:w`
                                // leaves the buffer modified, so the same
                                // check now answers for both.
                                if util.index_of_byte(cmd_buf, '!') < 0 and buffers_modified(bufs_text, bufs_disk, cur_buf, buf_text(ed), disk_text)
                                    lsp_info = if r.save
                                        write_failed_msg(curpath) + " — not quitting (:q! to override)"
                                    else
                                        "unsaved buffers (:q! to override)"
                                else
                                    running = false
                                    done = true
                        // Record the command in history (skip empties + a repeat
                        // of the most recent entry); persist it to disk.
                        if str.len(cmd_buf) > 0 and (list.len(cmd_hist) == 0 or cmd_hist[list.len(cmd_hist) - 1] != cmd_buf)
                            cmd_hist = list.push(cmd_hist, cmd_buf)
                            history_append(":", cmd_buf)
                        cmd_mode = false
                        cmd_buf = ""
                    elif b == '\e'                     // Esc — cancel
                        cmd_mode = false
                        cmd_buf = ""
                    elif b == '\x7f' or b == '\b'      // Backspace — delete the character before the cursor
                        if cmd_cx > 0
                            let cfrom = util.u8_prev(cmd_buf, cmd_cx)
                            cmd_buf = str.slice(cmd_buf, 0, cfrom) + str.slice(cmd_buf, cmd_cx, str.len(cmd_buf))
                            cmd_cx = cfrom
                    elif (b >= ' ' and b < '\x7f') or (b >= 128 and b < 256)   // insert the typed byte at the cursor
                        cmd_buf = str.slice(cmd_buf, 0, cmd_cx) + str.from_byte(b) + str.slice(cmd_buf, cmd_cx, str.len(cmd_buf))
                        cmd_cx = cmd_cx + 1
                elif search_mode
                    if b == '\r' or b == '\n'
                        st = ist_set_search(st, search_buf)
                        hl_off = false                   // a new search re-lights the highlight
                        jback = list.push(jback, jentry(curpath, ed.cy, ed.cx))
                        jfwd = []
                        ed = find_next(ed, search_buf, not search_back)
                        if str.len(search_buf) > 0 and (list.len(search_hist) == 0 or search_hist[list.len(search_hist) - 1] != search_buf)
                            search_hist = list.push(search_hist, search_buf)
                            history_append("/", search_buf)
                        search_mode = false
                        search_buf = ""
                    elif b == '\e'
                        search_mode = false
                        search_buf = ""
                    elif b == '\x7f' or b == '\b'      // Backspace — delete the character before the cursor
                        if search_cx > 0
                            let sfrom = util.u8_prev(search_buf, search_cx)
                            search_buf = str.slice(search_buf, 0, sfrom) + str.slice(search_buf, search_cx, str.len(search_buf))
                            search_cx = sfrom
                    elif (b >= ' ' and b < '\x7f') or (b >= 128 and b < 256)   // insert the typed byte at the cursor
                        search_buf = str.slice(search_buf, 0, search_cx) + str.from_byte(b) + str.slice(search_buf, search_cx, str.len(search_buf))
                        search_cx = search_cx + 1
                elif zpend                            // 2nd byte of a `z` command
                    zpend = false
                    let zk = scroll_z_kind(b)
                    if zk >= 0
                        top = scroll_new_top(ed.cy, top, rows, zk)
                elif wpend                            // 2nd byte of a Ctrl-W window command
                    wpend = false
                    if b == 's' or b == 'S' or b == 19   // Ctrl-W s / S / Ctrl-S — horizontal split
                        pending_wcmd = 1
                    elif b == 'v' or b == 'V' or b == 22 // Ctrl-W v / V / Ctrl-V — vertical split
                        pending_wcmd = 4
                    elif b == 'w' or b == 23             // Ctrl-W w / Ctrl-W Ctrl-W — cycle focus
                        pending_focus = wlayout.win_cycle_next(lay, awin)
                    elif b == 'h'                        // Ctrl-W h — focus window to the left
                        pending_focus = wlayout.window_in_dir(lay, awin, wlayout.rect(0, 0, cols, rows), 0, win_ww, win_hw)
                    elif b == 'j'                        // Ctrl-W j — focus window below
                        pending_focus = wlayout.window_in_dir(lay, awin, wlayout.rect(0, 0, cols, rows), 1, win_ww, win_hw)
                    elif b == 'k'                        // Ctrl-W k — focus window above
                        pending_focus = wlayout.window_in_dir(lay, awin, wlayout.rect(0, 0, cols, rows), 2, win_ww, win_hw)
                    elif b == 'l'                        // Ctrl-W l — focus window to the right
                        pending_focus = wlayout.window_in_dir(lay, awin, wlayout.rect(0, 0, cols, rows), 3, win_ww, win_hw)
                    elif b == 'c' or b == 'q' or b == 17 // Ctrl-W c / q / Ctrl-Q — close active window
                        pending_wcmd = 3
                    elif b == 'o' or b == 15             // Ctrl-W o / Ctrl-O — close all but the active window
                        pending_wcmd = 5
                    elif b == '+'                        // Ctrl-W + — grow the active window's height
                        win_hw = util.set_int_at(win_hw, awin, win_hw[awin] + 20)
                    elif b == '-'                        // Ctrl-W - — shrink height
                        win_hw = util.set_int_at(win_hw, awin, if win_hw[awin] > 40 then win_hw[awin] - 20 else 20)
                    elif b == '>'                        // Ctrl-W > — grow width
                        win_ww = util.set_int_at(win_ww, awin, win_ww[awin] + 20)
                    elif b == '<'                        // Ctrl-W < — shrink width
                        win_ww = util.set_int_at(win_ww, awin, if win_ww[awin] > 40 then win_ww[awin] - 20 else 20)
                    elif b == '='                        // Ctrl-W = — equalize all windows
                        var rwi = 0
                        while rwi < list.len(win_ww)
                            win_ww = util.set_int_at(win_ww, rwi, 100)
                            win_hw = util.set_int_at(win_hw, rwi, 100)
                            rwi = rwi + 1
                elif gpend                            // 2nd byte of a `g` (gd intercept)
                    gpend = false
                    if b == 'd' and lsp_phase == 2      // `gd` — go to definition
                        lsp_reqid = lsp_reqid + 1
                        lsp.lsp_send(lsp_in, lsp.lsp_pos_req(lsp_reqid, "textDocument/definition", lsp_uri, ed.cy, ed.cx))
                        let resp = lsp.lsp_pump(lsp_out, lsp_reqid, 20)
                        if str.len(resp) == 0
                            lsp_info = "definition: no response"
                        else
                            let dpos = lsp.lsp_def_pos(resp)
                            if list.len(dpos) >= 2
                                let duri = lsp.lsp_def_uri(resp)
                                if duri == lsp_uri or duri == ""
                                    jback = list.push(jback, jentry(curpath, ed.cy, ed.cx))
                                    jfwd = []
                                    ed = clamp(Editor { lines: ed.lines, cy: dpos[0], cx: dpos[1] })
                                    lsp_info = "definition"
                                else                               // cross-file: record + switch buffer
                                    jback = list.push(jback, jentry(curpath, ed.cy, ed.cx))
                                    jfwd = []
                                    want_path = uri_to_path(duri)
                                    want_y = dpos[0]
                                    want_x = dpos[1]
                                    lsp_info = "definition"
                            else
                                lsp_info = "no definition found"
                    elif b == 'c'                     // `gc` — comment toggle; await the target
                        cpend = true
                    else                              // not `gd`/`gc` — replay g + this byte
                        let jy = ed.cy
                        let jx = ed.cx
                        let g1 = feed_edit(ed, st, km, var es, 'g')
                        ed = g1.ed
                        st = g1.st
                        es = g1.es
                        let g2 = feed_edit(ed, st, km, var es, b)
                        ed = g2.ed
                        st = g2.st
                        es = g2.es
                        if b == 'g' and ed.cy != jy   // gg moved — record the jump
                            jback = list.push(jback, jentry(curpath, jy, jx))
                            jfwd = []
                elif cpend                            // `gc` target: gcc / gcj / gck / gcG / gc} / gca p…
                    cpend = false
                    if b == 'a' or b == 'i'           // gca{obj} / gci{obj} — await the object char
                        cpend_obj = true
                        cpend_around = b == 'a'
                    else
                        let pfx = comment_prefix(curpath)
                        let last = list.len(ed.lines) - 1
                        let cnt = if st.count > 0 then st.count else 1   // `3gcc` = 3 lines
                        var clo = 0 - 1
                        var chi = 0 - 1
                        if b == 'c'                   // gcc / Ngcc — N lines from the cursor
                            clo = ed.cy
                            chi = if ed.cy + cnt - 1 <= last then ed.cy + cnt - 1 else last
                        elif b == 'j'                 // gcj / Ngcj — current + N down
                            clo = ed.cy
                            chi = if ed.cy + cnt <= last then ed.cy + cnt else last
                        elif b == 'k'                 // gck / Ngck — current + N up
                            clo = if ed.cy - cnt >= 0 then ed.cy - cnt else 0
                            chi = ed.cy
                        elif b == 'G'                 // gcG — to end of buffer
                            clo = ed.cy
                            chi = last
                        elif b == '}'                 // gc} / Ngc} — to the Nth paragraph break ahead
                            clo = ed.cy
                            chi = para_fwd(ed, cnt)
                        elif b == '{'                 // gc{ / Ngc{ — back N paragraph breaks
                            clo = para_bwd(ed, cnt)
                            chi = ed.cy
                        if clo >= 0
                            es = edit_push_undo(var es, ed)
                            ed = clamp(Editor { lines: comment_toggle(ed.lines[:], clo, chi, pfx), cy: ed.cy, cx: ed.cx })
                        st = ist_done(st)             // consume the count either way
                elif cpend_obj                        // gc + a/i, awaiting the object char (p)
                    cpend_obj = false
                    if b == 'p'                       // gcap / gcip — the current paragraph
                        let to = textobj_paragraph(ed, cpend_around)
                        if to.ok
                            es = edit_push_undo(var es, ed)
                            ed = clamp(Editor { lines: comment_toggle(ed.lines[:], to.vr.sy, to.vr.ey, comment_prefix(curpath)), cy: ed.cy, cx: ed.cx })
                    st = ist_done(st)                 // consume any count
                elif vgc_pend                         // Visual `g` 2nd byte (gc on the selection)
                    vgc_pend = false
                    if b == 'c'                       // gc — toggle-comment the selected lines, leave Visual
                        let vlo = if st.avy < ed.cy then st.avy else ed.cy
                        let vhi = if st.avy < ed.cy then ed.cy else st.avy
                        es = edit_push_undo(var es, ed)
                        ed = clamp(Editor { lines: comment_toggle(ed.lines[:], vlo, vhi, comment_prefix(curpath)), cy: vlo, cx: 0 })
                        st = ist_done(st)
                    else                              // not gc — replay g + this byte through Visual
                        let v1 = feed_edit(ed, st, km, var es, 'g')
                        ed = v1.ed
                        st = v1.st
                        es = v1.es
                        let v2 = feed_edit(ed, st, km, var es, b)
                        ed = v2.ed
                        st = v2.st
                        es = v2.es
                elif (st.mode == 2 or st.mode == 3 or st.mode == 5) and b == 'g' and key_free(km, 'g')   // Visual `g` — await c (gc)
                    vgc_pend = true
                elif scroll_idle(st, es) and st.mode == 0 and b == 'q' and curpath == exhelp.help_path() and wlayout.layout_count(lay) > 1   // q in the help window closes it
                    pending_wcmd = 3
                elif scroll_idle(st, es) and key_free(km, 23) and b == 23   // Ctrl-W — window command prefix
                    wpend = true
                elif g_idle(st, es) and key_free(km, 'g') and b == 'g'   // 'g' — await 2nd byte (gd / gc / gg / gu / gv / gi…), count-carrying
                    gpend = true
                elif lsp_phase == 2 and scroll_idle(st, es) and key_free(km, 'K') and b == 'K'   // K — hover
                    lsp_reqid = lsp_reqid + 1
                    lsp.lsp_send(lsp_in, lsp.lsp_pos_req(lsp_reqid, "textDocument/hover", lsp_uri, ed.cy, ed.cx))
                    let hresp = lsp.lsp_pump(lsp_out, lsp_reqid, 20)
                    if str.len(hresp) == 0
                        lsp_info = "hover: no response"
                    else
                        let htext = lsp.hover_oneline(lsp.lsp_hover_text(hresp))
                        lsp_info = if str.len(htext) > 0 then htext else "no hover info"
                elif scroll_idle(st, es) and key_free(km, b) and b == 'z'   // 'z' — await z/t/b
                    zpend = true
                elif scroll_idle(st, es) and key_free(km, b) and scroll_ctrl_kind(b) >= 0   // Ctrl-D/U/F/B
                    let k = scroll_ctrl_kind(b)
                    ed = move_rows(ed, scroll_new_cy(ed, rows, k))
                    top = scroll_new_top(ed.cy, top, rows, k)
                elif scroll_idle(st, es) and key_free(km, b) and screen_kind(b) >= 0        // H / M / L
                    let ty = screen_target(top, rows, list.len(ed.lines), screen_kind(b))
                    ed = clamp(Editor { lines: ed.lines, cy: ty, cx: first_nonblank(line_at(ed, ty)) })
                elif scroll_idle(st, es) and key_free(km, b) and b == '&' and str.len(last_subst) > 0   // & — repeat last :s
                    es = edit_push_undo(var es, ed)
                    ed = ex_substitute(ed, excmd.subst_current_line(last_subst))
                elif scroll_idle(st, es) and key_free(km, b) and (b == '\x05' or b == '\x19')   // Ctrl-E / Ctrl-Y — scroll one line
                    let body = rows - 1
                    let nl = list.len(ed.lines)
                    if b == '\x05'                     // Ctrl-E — view down
                        top = if top + 1 < nl then top + 1 else top
                    else                             // Ctrl-Y — view up
                        top = if top - 1 > 0 then top - 1 else 0
                    var ncy = ed.cy                  // keep the cursor on screen
                    if ncy < top
                        ncy = top
                    if ncy > top + body - 1
                        ncy = top + body - 1
                    ed = move_rows(ed, ncy)
                elif scroll_idle(st, es) and key_free(km, b) and b == '\x0f' and list.len(jback) >= 1   // Ctrl-O — jump back
                    let e = jback[list.len(jback) - 1]
                    let tf = jentry_path(e)
                    if tf == curpath                       // in-buffer jump
                        jfwd = list.push(jfwd, jentry(curpath, ed.cy, ed.cx))
                        jback = drop_last_str(jback)
                        ed = clamp(Editor { lines: ed.lines, cy: jentry_y(e), cx: jentry_x(e) })
                    else                                   // cross-file — switch buffer
                        jfwd = list.push(jfwd, jentry(curpath, ed.cy, ed.cx))
                        jback = drop_last_str(jback)
                        want_path = tf
                        want_y = jentry_y(e)
                        want_x = jentry_x(e)
                elif scroll_idle(st, es) and key_free(km, b) and b == '\t' and list.len(jfwd) >= 1   // Ctrl-I / Tab — jump forward
                    let e = jfwd[list.len(jfwd) - 1]
                    let tf = jentry_path(e)
                    if tf == curpath
                        jback = list.push(jback, jentry(curpath, ed.cy, ed.cx))
                        jfwd = drop_last_str(jfwd)
                        ed = clamp(Editor { lines: ed.lines, cy: jentry_y(e), cx: jentry_x(e) })
                    else
                        jback = list.push(jback, jentry(curpath, ed.cy, ed.cx))
                        jfwd = drop_last_str(jfwd)
                        want_path = tf
                        want_y = jentry_y(e)
                        want_x = jentry_x(e)
                elif scroll_idle(st, es) and key_free(km, b) and b == '\x1e' and alt_buf >= 0 and alt_buf < list.len(bufs_path) and alt_buf != cur_buf   // Ctrl-^ — alternate buffer
                    jback = list.push(jback, jentry(curpath, ed.cy, ed.cx))
                    jfwd = []
                    want_path = bufs_path[alt_buf]
                    want_y = 0 - 1
                    want_x = 0
                elif b == 58 and st.mode == 0        // ':' — open the Ex line
                    cmd_mode = true
                    cmd_buf = ""
                    cmd_cx = 0
                    hist_idx = list.len(cmd_hist)
                    rng_vlo = 0 - 1
                    rng_vhi = 0 - 1
                elif b == 58 and (st.mode == 2 or st.mode == 3 or st.mode == 5)   // ':' in Visual — prefill '<,'>
                    rng_vlo = if st.avy < ed.cy then st.avy else ed.cy
                    rng_vhi = if st.avy > ed.cy then st.avy else ed.cy
                    st = ist_done(st)                // leave Visual for the Ex line
                    cmd_mode = true
                    cmd_buf = "'<,'>"
                    cmd_cx = str.len(cmd_buf)        // cursor after the prefilled range
                    hist_idx = list.len(cmd_hist)
                elif b == 47 and st.mode == 0        // '/' — search forward
                    search_mode = true
                    search_buf = ""
                    search_cx = 0
                    search_back = false
                    shist_idx = list.len(search_hist)
                elif b == 63 and st.mode == 0        // '?' — search backward
                    search_mode = true
                    search_buf = ""
                    search_cx = 0
                    search_back = true
                    shist_idx = list.len(search_hist)
                elif st.mode == 1 and lsp_phase == 2 and (b == '\x0e' or b == '\x10')   // Ctrl-N/P — completion
                    if not comp_active
                        let curline = line_at(ed, ed.cy)
                        comp_start = ident_start_before(curline, ed.cx)
                        let prefix = str.slice(curline, comp_start, ed.cx)
                        lsp_reqid = lsp_reqid + 1
                        lsp.lsp_send(lsp_in, lsp.lsp_completion_req(lsp_reqid, lsp_uri, ed.cy, ed.cx))
                        let cresp = lsp.lsp_pump(lsp_out, lsp_reqid, 40)
                        var cands: [Str] = []
                        let labels = lsp.lsp_comp_labels(cresp)
                        var ci = 0
                        while ci < list.len(labels)
                            if starts_with(labels[ci], prefix)
                                cands = list.push(cands, labels[ci])
                            ci = ci + 1
                        if list.len(cands) == 0
                            lsp_info = "no completions"
                        else
                            comp_cands = cands
                            comp_idx = if b == '\x10' then list.len(cands) - 1 else 0
                            ed = comp_apply(ed, comp_start, ed.cx, comp_cands[comp_idx])
                            lsp_info = "match " + str.from_int(comp_idx + 1) + "/" + str.from_int(list.len(comp_cands)) + ": " + comp_cands[comp_idx]
                            comp_active = true
                    else
                        let n = list.len(comp_cands)
                        if n > 0
                            if b == '\x0e'
                                comp_idx = (comp_idx + 1) % n
                            else
                                comp_idx = (comp_idx + n - 1) % n
                            ed = comp_apply(ed, comp_start, ed.cx, comp_cands[comp_idx])
                            lsp_info = "match " + str.from_int(comp_idx + 1) + "/" + str.from_int(n) + ": " + comp_cands[comp_idx]
                elif st.mode == 1 and b == '\x0f'    // Ctrl-O — run one Normal command, then back to Insert
                    insert_oneshot = true
                    st = ist_done(st)                // drop to idle Normal for the next command
                elif b == '\t' and (st.mode == 1 or st.mode == 4) and opts.expandtab
                    // expandtab: Tab in Insert/Replace becomes `tabstop` spaces —
                    // queued through the replay path so each space runs the full
                    // per-key machinery (block-insert tracking, undo, …).
                    map_replay = disp.nspaces(opts.tabstop) + map_replay
                else
                    if comp_active                   // any other key commits the candidate
                        comp_active = false
                    let jy = ed.cy                    // record G/gg/n/N/{/}/%/*/# jumps
                    let jx = ed.cx
                    let wasjump = is_jump_key(st, b)
                    // Clipboard sync (unnamedplus): seed the unnamed register from
                    // the OS clipboard before a plain paste (`p`/`P`, no named
                    // register selected), so it reflects what another app yanked.
                    if clip_on and (b == 'p' or b == 'P') and es.rreg == 0 and not es.awaitreg
                        let cb = clip_paste()
                        if str.len(cb) > 0
                            st = ist_set_reg(st, cb, clip_ends_nl(cb))
                    // A search-repeat re-lights the highlight cleared by `:noh`.
                    if hl_off and st.mode == 0 and (b == 'n' or b == 'N' or b == '*' or b == '#')
                        hl_off = false
                    let pre_reg = st.reg
                    // Block-insert start: capture the column band + row range from
                    // the still-live blockwise selection before feed enters Insert.
                    let pre_mode = st.mode
                    if st.mode == 5 and (b == 'I' or b == 'A' or b == 'c')
                        binsert_ylo = if st.avy < ed.cy then st.avy else ed.cy
                        binsert_yhi = if st.avy < ed.cy then ed.cy else st.avy
                        let bcols = vblock_cols(ed, st.avy, st.avx)
                        binsert_col = if b == 'A' then bcols.hi + 1 else bcols.lo
                        binsert_append = b == 'A'
                        binsert_active = true
                    let pre_y0 = es.regs[26]              // "0 register — changes only on a yank
                    let estep = feed_edit(ed, st, km, var es, b)
                    ed = estep.ed
                    st = estep.st
                    es = estep.es
                    // Yank flash: the "0 (yank) register updated and we are back in
                    // Normal — a yank just completed (a delete writes "1, not "0).
                    // The post-yank cursor is the yank's top-left.
                    if st.mode == 0 and es.regs[26] != pre_y0
                        yflash = flash_from_yank(ed.cy, ed.cx, es.regs[26], es.reglw[26])
                        yflash_ticks = 3
                        changed = true
                    // `<C-o>` one-shot: once the borrowed Normal command finishes
                    // (back to idle Normal), step back into Insert.  If the command
                    // entered Insert/Visual itself (a/i/o/v), just clear the flag.
                    if insert_oneshot
                        if st.mode == 0 and st.pending == 0 and st.count == 0 and not es.awaitreg and es.awaitmark == 0 and es.awaitmac == 0
                            st = ist_insert(st)
                            insert_oneshot = false
                        elif st.mode != 0
                            insert_oneshot = false
                    // Insert just began (mode 5 → 1): record the first row's
                    // length now (after any `c` delete / `A` pad) so the inserted
                    // span can be diffed precisely on Esc.
                    if binsert_active and pre_mode == 5 and st.mode == 1
                        binsert_flen0 = if binsert_ylo < list.len(ed.lines) then str.len(ed.lines[binsert_ylo]) else 0
                        binsert_nch0 = if binsert_ylo < list.len(ed.lines) then util.u8_count(ed.lines[binsert_ylo], 0, binsert_flen0) else 0
                    // Block-insert end (Esc left Insert): replay the first row's
                    // inserted text onto the rest of the column.  Skip if the
                    // insert spilled onto another line (e.g. Enter) — like vim.
                    if binsert_active and pre_mode == 1 and st.mode == 0
                        if ed.cy == binsert_ylo
                            ed = block_replicate(ed, binsert_ylo, binsert_yhi, binsert_col, binsert_flen0, binsert_nch0, binsert_append)
                        binsert_active = false
                    // Clipboard sync: a yank/delete changed the unnamed register →
                    // push it to the OS clipboard so another app can paste it.
                    if clip_on and str.len(st.reg) > 0 and st.reg != pre_reg
                        clip_copy(st.reg, st.reg_lw)
                    if wasjump and ed.cy != jy
                        jback = list.push(jback, jentry(curpath, jy, jx))
                        jfwd = []
                // Bound the coalescing by TIME.  This drain otherwise ends only
                // when stdin runs dry, which under key auto-repeat can be "when
                // the user lets go" — the terminal refills the queue as fast as
                // the loop empties it.  Leaving the drain early hands control to
                // the repaint below and the next poll returns immediately with
                // the still-queued input, so nothing is lost, only presented.
                //
                // Only stdin counts as pending: a buffered remap RHS or an ESC
                // pushback lives in this loop's own state, and the outer poll
                // will not wake for it, so leaving with either armed would
                // strand those bytes until the next real keystroke.
                if not done and str.len(map_replay) == 0 and esc_pushback == 0 - 99
                    if throttle.should_render(now_ms(), last_render, fbudget, novo_pty_poll_h(0, 0) % 2 == 1, picker_moved)
                        done = true
            changed = true
        // ── Deferred window + buffer commands ───────────────────────────────
        // Order matters: window split/close/focus run FIRST and may set
        // `want_path` (when a focus/close move lands on a window showing a
        // different buffer); the buffer-switch block runs AFTER so the switch
        // completes in the same iteration, before the next keystroke is read.
        // A window owns its view (win_cy/cx/top/left) and which buffer it shows
        // (win_buf); a buffer owns its content + history (bufs_*).
        if pending_wcmd == 1 or pending_wcmd == 4   // :split/Ctrl-W s (stacked) · :vsplit/Ctrl-W v (side-by-side)
            let vertical = pending_wcmd == 4
            win_cy = util.set_int_at(win_cy, awin, ed.cy)
            win_cx = util.set_int_at(win_cx, awin, ed.cx)
            win_top = util.set_int_at(win_top, awin, top)
            win_left = util.set_int_at(win_left, awin, left)
            let newid = list.len(win_cy)
            win_cy = list.push(win_cy, ed.cy)
            win_cx = list.push(win_cx, ed.cx)
            win_top = list.push(win_top, top)
            win_left = list.push(win_left, left)
            win_buf = list.push(win_buf, cur_buf)   // new window shows the current buffer
            win_ww = list.push(win_ww, 100)
            win_hw = list.push(win_hw, 100)
            lay = wlayout.layout_split(lay, awin, newid, vertical)
            awin = newid                                   // focus the new window
            lsp_info = (if vertical then "vsplit (" else "split (") + str.from_int(wlayout.layout_count(lay)) + " windows)"
            changed = true
        elif pending_wcmd == 3                // Ctrl-W c / Ctrl-W q / :close / :q — close active window
            if wlayout.layout_count(lay) > 1
                if curpath == exhelp.help_path()     // the help buffer goes with its window
                    want_close = curpath
                let rem = wlayout.layout_remove(lay, awin)
                if list.len(rem) > 0
                    lay = rem[0]
                    let ids = wlayout.layout_winids(lay, [])
                    let surv = ids[0]            // first surviving window takes focus
                    awin = surv
                    if win_buf[surv] == cur_buf
                        ed = clamp(Editor { lines: ed.lines, cy: win_cy[surv], cx: win_cx[surv] })
                        top = win_top[surv]
                        left = win_left[surv]
                    else                         // survivor shows another buffer → route via want_path
                        let tb = win_buf[surv]
                        bufs_top = util.set_int_at(bufs_top, tb, win_top[surv])
                        bufs_left = util.set_int_at(bufs_left, tb, win_left[surv])
                        want_path = bufs_path[tb]
                        want_y = win_cy[surv]
                        want_x = win_cx[surv]
                    lsp_info = "closed (" + str.from_int(wlayout.layout_count(lay)) + " windows)"
                    changed = true
        elif pending_wcmd == 5                // Ctrl-W o / :only — keep just the active window
            if wlayout.layout_count(lay) > 1
                lay = wlayout.LWin(awin)              // active window keeps its live ed/top/left
                lsp_info = "only"
                changed = true
        pending_wcmd = 0
        // Deferred focus change (Ctrl-W w / h / j / k / l): save the active
        // window's view, then activate the target — directly when it shows the
        // same buffer, else by routing a buffer switch through `want_path` below.
        if pending_focus >= 0 and pending_focus != awin
            let tgt = pending_focus
            win_cy = util.set_int_at(win_cy, awin, ed.cy)
            win_cx = util.set_int_at(win_cx, awin, ed.cx)
            win_top = util.set_int_at(win_top, awin, top)
            win_left = util.set_int_at(win_left, awin, left)
            if win_buf[tgt] == cur_buf
                awin = tgt
                ed = clamp(Editor { lines: ed.lines, cy: win_cy[tgt], cx: win_cx[tgt] })
                top = win_top[tgt]
                left = win_left[tgt]
            else
                let tb = win_buf[tgt]
                bufs_top = util.set_int_at(bufs_top, tb, win_top[tgt])
                bufs_left = util.set_int_at(bufs_left, tb, win_left[tgt])
                want_path = bufs_path[tb]
                want_y = win_cy[tgt]
                want_x = win_cx[tgt]
                awin = tgt
            changed = true
        pending_focus = 0 - 1
        // Deferred buffer switch — find-or-create the buffer for `want_path`,
        // save the current buffer's working copy, and activate the target
        // (restoring its content/cursor and retargeting the language server).
        if str.len(want_path) > 0
            var idx = buf_index_of(bufs_path, want_path)
            let creating = idx < 0
            if creating                        // open a new buffer from disk
                bufs_text = list.push(bufs_text, if want_path == exhelp.help_path() then help_fill else file_to_text(want_path))
                bufs_path = list.push(bufs_path, want_path)
                bufs_cy = list.push(bufs_cy, 0)
                bufs_cx = list.push(bufs_cx, 0)
                bufs_top = list.push(bufs_top, 0)
                bufs_left = list.push(bufs_left, 0)
                bufs_disk = list.push(bufs_disk, "")
                bufs_undo = list.push(bufs_undo, "")
                bufs_redo = list.push(bufs_redo, "")
                bufs_marky = list.push(bufs_marky, "")
                bufs_markx = list.push(bufs_markx, "")
                bufs_diag = list.push(bufs_diag, "")
                bufs_lspopen = list.push(bufs_lspopen, false)
                idx = list.len(bufs_path) - 1
            if idx != cur_buf
                // save the buffer we're leaving (incl. its undo/redo history)
                bufs_text = util.set_str_at(bufs_text, cur_buf, buf_text(ed))
                bufs_cy = util.set_int_at(bufs_cy, cur_buf, ed.cy)
                bufs_cx = util.set_int_at(bufs_cx, cur_buf, ed.cx)
                bufs_top = util.set_int_at(bufs_top, cur_buf, top)
                bufs_left = util.set_int_at(bufs_left, cur_buf, left)
                bufs_disk = util.set_str_at(bufs_disk, cur_buf, disk_text)
                bufs_undo = util.set_str_at(bufs_undo, cur_buf, snaps_ser(es.undos))
                bufs_redo = util.set_str_at(bufs_redo, cur_buf, snaps_ser(es.redos))
                bufs_marky = util.set_str_at(bufs_marky, cur_buf, ints_ser(es.marky))
                bufs_markx = util.set_str_at(bufs_markx, cur_buf, ints_ser(es.markx))
                bufs_diag = util.set_str_at(bufs_diag, cur_buf, diag_ser(diag_li, diag_msgs))
                // documents stay open in novols (multi-doc) — no didClose on switch
                alt_buf = cur_buf             // the buffer we leave becomes the alternate
                cur_buf = idx
                let nls = str.split_lines(bufs_text[idx])
                let ny = if want_y >= 0 then want_y else bufs_cy[idx]
                let nx = if want_y >= 0 then want_x else bufs_cx[idx]
                ed = clamp(Editor { lines: if list.len(nls) == 0 then [""] else nls, cy: ny, cx: nx })
                curpath = want_path
                top = bufs_top[idx]
                left = bufs_left[idx]
                disk_text = if creating then buf_text(ed) else bufs_disk[idx]
                // restore the target buffer's own undo/redo history + marks;
                // carry the registers forward (global) but reset dot/macros
                let usaved = bufs_undo[idx]
                let rsaved = bufs_redo[idx]
                let mysaved = bufs_marky[idx]
                let mxsaved = bufs_markx[idx]
                let gregs = es.regs
                let greglw = es.reglw
                es = edit_new_undo(snaps_de(usaved), snaps_de(rsaved), gregs, greglw, marks_de(mysaved), marks_de(mxsaved))
                let dsaved = bufs_diag[idx]   // restore the target's live diagnostics
                diag_li = diag_de_li(dsaved)
                diag_msgs = diag_de_msgs(dsaved)
                lsp_uri = "file://" + curpath
                lsp_lasttext = buf_text(ed)   // debounced didChange now diffs against THIS buffer
                // Re-resolve the grammar for the incoming buffer's filetype —
                // switching from foo.nv to bar.py must switch grammars too, or
                // the new buffer would be parsed with the old language (or, for
                // an unknown type, keep stale spans from the previous one).
                ts_lang = tslang.ts_lang_of(curpath)
                ts_grammar = tslang.ts_grammar_path(lsp_cfg, ts_lang)
                ts_symbol = tslang.ts_symbol_of(ts_lang)
                ts_queries = file_to_text(tslang.ts_queries_path(lsp_cfg, ts_lang))
                ts_spans_cache = []
                ts_lasttext = "\x00"          // force a re-parse under the new grammar
                let already = bufs_lspopen[idx]
                if str.len(lsp.lsp_lang_of(curpath)) > 0
                    if lsp_pid < 0             // no server yet — spawn for this file's language (opens all matching docs at handshake)
                        lsp_lang = lsp.lsp_lang_of(curpath)
                        lsp_pid = lsp.lsp_spawn_cmd(lsp.lsp_cmd_for(curpath, lsp_cfg))
                        if lsp_pid >= 0
                            lsp_in = proc.stdin_fd(lsp_pid)
                            lsp_out = proc.stdout_fd(lsp_pid)
                            lsp.lsp_send(lsp_in, lsp.lsp_init_req(lsp_uri, lsp.lsp_root_uri_for(curpath)))
                            lsp_phase = 1
                    elif lsp_phase == 2 and not already and lsp.lsp_lang_of(curpath) == lsp_lang   // first visit since server ready — open it
                        lsp_ver = lsp_ver + 1
                        lsp.lsp_send(lsp_in, lsp.lsp_didopen(lsp_uri, lsp_lang, lsp_lasttext))
                        bufs_lspopen = util.set_bool_at(bufs_lspopen, idx, true)
            elif want_y >= 0                   // same buffer — just move the cursor
                ed = clamp(Editor { lines: ed.lines, cy: want_y, cx: want_x })
            win_buf = util.set_int_at(win_buf, awin, cur_buf)   // active window now shows cur_buf
            want_path = ""
            changed = true
        if str.len(want_close) > 0
            let ci = buf_index_of(bufs_path, want_close)
            if ci >= 0 and list.len(bufs_path) > 1
                bufs_text = util.remove_at_str(bufs_text, ci)
                bufs_path = util.remove_at_str(bufs_path, ci)
                bufs_cy = util.remove_at_int(bufs_cy, ci)
                bufs_cx = util.remove_at_int(bufs_cx, ci)
                bufs_top = util.remove_at_int(bufs_top, ci)
                bufs_left = util.remove_at_int(bufs_left, ci)
                bufs_disk = util.remove_at_str(bufs_disk, ci)
                bufs_undo = util.remove_at_str(bufs_undo, ci)
                bufs_redo = util.remove_at_str(bufs_redo, ci)
                bufs_marky = util.remove_at_str(bufs_marky, ci)
                bufs_markx = util.remove_at_str(bufs_markx, ci)
                if bufs_lspopen[ci] and lsp_phase == 2   // only matching-language buffers were ever opened
                    lsp.lsp_send(lsp_in, lsp.lsp_didclose("file://" + want_close))
                bufs_diag = util.remove_at_str(bufs_diag, ci)
                bufs_lspopen = util.remove_at_bool(bufs_lspopen, ci)
                if ci < cur_buf
                    cur_buf = cur_buf - 1
                if ci == alt_buf            // alternate closed — invalidate
                    alt_buf = 0 - 1
                elif ci < alt_buf
                    alt_buf = alt_buf - 1
                // shift win_buf past the removed buffer; a window that showed it
                // falls back to the now-active buffer so no window dangles
                var wbi = 0
                while wbi < list.len(win_buf)
                    if win_buf[wbi] == ci
                        win_buf = util.set_int_at(win_buf, wbi, cur_buf)
                    elif win_buf[wbi] > ci
                        win_buf = util.set_int_at(win_buf, wbi, win_buf[wbi] - 1)
                    wbi = wbi + 1
                lsp_info = "closed; " + str.from_int(list.len(bufs_path)) + " left"
            want_close = ""
            changed = true
        // Live document sync, TIME-debounced: mark the buffer dirty on any
        // input, and only send `didChange` after typing pauses (~150 ms of idle
        // poll cycles).  This coalesces a burst of insert-mode keystrokes into a
        // single full-document sync instead of rebuilding + re-sending the whole
        // buffer (a byte-at-a-time pipe write) on every keypress.
        if m % 2 == 1
            lsp_dirty = true
            lsp_idle = 0
        else
            lsp_idle = lsp_idle + 1
        if lsp_phase == 2 and lsp_dirty and lsp_idle >= 3
            let cur = buf_text(ed)
            if cur != lsp_lasttext
                lsp_lasttext = cur
                lsp_ver = lsp_ver + 1
                lsp.lsp_send(lsp_in, lsp.lsp_didchange(lsp_uri, lsp_ver, cur))
            lsp_dirty = false
        // Drain whatever novols has sent (non-blocking).  The init result
        // (id 1) completes the handshake asynchronously — initialized +
        // didOpen (with the buffer's current text, edits-during-init included);
        // publishDiagnostics notifications rebuild the diagnostics store.
        if lsp_pid >= 0
            var more = true
            while more
                let msg = lsp.lsp_poll_message(lsp_out, 0)
                if str.len(msg) == 0
                    more = false
                elif lsp_phase == 1 and lsp.lsp_msg_id(msg) == 1
                    lsp.lsp_send(lsp_in, lsp.lsp_initialized())
                    lsp_phase = 2
                    var oi = 0                  // open every buffer of the server's language (multi-doc)
                    while oi < list.len(bufs_path)
                        let opath = bufs_path[oi]
                        if lsp.lsp_lang_of(opath) == lsp_lang
                            let otext = if oi == cur_buf then buf_text(ed) else bufs_text[oi]
                            lsp.lsp_send(lsp_in, lsp.lsp_didopen("file://" + opath, lsp_lang, otext))
                            bufs_lspopen = util.set_bool_at(bufs_lspopen, oi, true)
                        oi = oi + 1
                    lsp_lasttext = buf_text(ed)
                elif lsp.lsp_is_diag(msg)
                    // route diagnostics to the buffer they belong to (by URI);
                    // only the active buffer's update the live display.
                    let dpath = uri_to_path(lsp.lsp_diag_uri(msg))
                    let dbi = buf_index_of(bufs_path, dpath)
                    if dbi >= 0
                        var dli = lsp.lsp_collect_diag_ints(msg)
                        var dmsgs = lsp.lsp_collect_diag_msgs(msg)
                        bufs_diag = util.set_str_at(bufs_diag, dbi, diag_ser(dli, dmsgs))
                        if dbi == cur_buf
                            diag_li = dli
                            diag_msgs = dmsgs
                            changed = true
        if curpath == exhelp.help_path() and buf_text(ed) != disk_text   // the help buffer is not modifiable
            let hro = str.split_lines(disk_text)
            ed = clamp(Editor { lines: if list.len(hro) == 0 then [""] else hro, cy: ed.cy, cx: ed.cx })
            st = ist_done(st)
            lsp_info = "E21: read-only"
            changed = true
        if changed
            top = scroll_to(top, ed.cy, rows - 1)
            left = hscroll_for(left, ed, opts, cols)
            let curtxt = buf_text(ed)
            modified = curtxt != disk_text
            // re-parse the active buffer for tree-sitter highlighting when its
            // text (or the focused buffer) changed; empty cache → native tokenizer
            if ts_enabled and str.len(ts_grammar) > 0 and curtxt != ts_lasttext
                ts_lasttext = curtxt
                ts_spans_cache = ts.ts_spans(ts_grammar, ts_symbol, ts_queries, curtxt)
            // `:noh` renders with the highlight suppressed (search pattern kept).
            let rst = if hl_off then ist_blank_search(st) else st
            // One frame, every layer: the buffer underneath, then whichever of
            // the command line / buffer list / picker is up.  Nothing between
            // frame_begin and frame_end may reach the terminal on its own.
            frame_begin()
            paint_frame(ed, lay, awin, cols, rows, win_cy, win_cx, win_top, win_left, win_buf, win_ww, win_hw, cur_buf, bufs_text, bufs_path, curpath, top, left, rst, cs, opts, diag_li, diag_msgs, lsp_info, modified, ts_spans_cache, yflash)
            if cmd_mode
                cup(rows, 1)
                csi()
                emit("K")
                emit(":" + cmd_buf)
                cup(rows, 2 + disp.vis_col(cmd_buf, cmd_cx, 8))   // park the cursor at the insertion point (a column per character, not per byte)
            if search_mode
                cup(rows, 1)
                csi()
                emit("K")
                emit("/" + search_buf)
                cup(rows, 2 + disp.vis_col(search_buf, search_cx, 8))   // park the cursor at the insertion point (a column per character, not per byte)
            if buflist
                draw_buflist(bufs_path, cur_buf, rows)
            if picker_active
                if not picker_rank_ok
                    picker_rank = fuzzy.rank(picker_query, picker_cands, list.len(picker_cands))
                    picker_rank_ok = true
                let dmaxh = picker_maxh(rows)
                let dmatch = list.len(picker_rank)
                if picker_sel >= dmatch
                    picker_sel = if dmatch > 0 then dmatch - 1 else 0
                let doff = picker_off(picker_sel, dmaxh)
                let dtop = picker_window(picker_rank, doff, dmaxh)
                let dtitle = if picker_src == 0 then "Buffers" elif picker_src == 1 then "Find Files" elif picker_src == 2 then "Pins" else "Live Grep"
                // :grep counter = rows received from rg (honest when the stored
                // list is capped); other sources count fuzzy matches.
                let dnm = if picker_src == 3 then grep_total else dmatch
                let dtot = if picker_src == 3 then grep_total else list.len(picker_cands)
                draw_picker(picker_cands, picker_marks, dtop, picker_sel - doff, picker_query, dnm, dtot, dtitle, rows, cols, cs)
            frame_end()
            last_render = now_ms()
            picker_moved = false
        if novo_pty_winsize_changed_h() == 1
            rows = term_rows()
            cols = term_cols()
            top = scroll_to(top, ed.cy, rows - 1)
            left = hscroll_for(left, ed, opts, cols)
            frame_begin()
            clear_screen()   // dimensions changed — clear stale content once
            paint_frame(ed, lay, awin, cols, rows, win_cy, win_cx, win_top, win_left, win_buf, win_ww, win_hw, cur_buf, bufs_text, bufs_path, curpath, top, left, st, cs, opts, diag_li, diag_msgs, lsp_info, modified, ts_spans_cache, yflash)
            frame_end()
            last_render = now_ms()
    if lsp_pid >= 0                       // tear the language server down
        let _ = proc.kill(lsp_pid, 15)
        proc.close(lsp_pid)
    novo_pty_restore_mode_h()
    csi()
    emit("0 q")          // restore the terminal's default cursor shape
    term_leave(want_color)   // restore cursor colour, disable mouse, leave the alternate screen

// ── Entry ───────────────────────────────────────────────────────

// Default config path: $NOVIM_CONFIG, else $XDG_CONFIG_HOME/novim/config.toml,
// else ~/.config/novim/config.toml.
fn default_config_path() -> Str [io]
    let envp = process.env("NOVIM_CONFIG") ?? ""
    if envp != ""
        return envp
    let xdg = process.env("XDG_CONFIG_HOME") ?? ""
    if xdg != ""
        return xdg + "/novim/config.toml"
    let home = process.env("HOME") ?? ""
    home + "/.config/novim/config.toml"

// ── Neovim keymap import ─────────────────────────────────────────────────────
// novim never runs Lua; it scrapes `vim.keymap.set` / `vim.g.mapleader` from the
// user's nvim config (see nvmap.nv).  These helpers own the `[io]` side: locate
// the config dir, slurp every `*.lua` recursively, and assemble a Keymap.

// $NVIM_CONFIG, else $XDG_CONFIG_HOME/nvim, else ~/.config/nvim.
fn default_nvim_dir() -> Str [io]
    let envp = process.env("NVIM_CONFIG") ?? ""
    if envp != ""
        return envp
    let xdg = process.env("XDG_CONFIG_HOME") ?? ""
    if xdg != ""
        return xdg + "/nvim"
    let home = process.env("HOME") ?? ""
    home + "/.config/nvim"

// ── System clipboard sync (`[options] clipboard = "unnamedplus"`) ────────────
// Mirrors a Neovim `clipboard=unnamedplus` setup so yank/paste crosses editors:
// a yank/delete is pushed to the OS clipboard via OSC 52 (a terminal escape — no
// helper process, works over SSH), and a paste pulls it back through xclip /
// wl-paste.  A trailing newline marks a linewise yank (the vim convention the
// receiving editor reads).

fn clip_ends_nl(s: Str) -> Bool
    str.len(s) > 0 and (str.byte_at(s, str.len(s) - 1) ?? 0) == '\n'

// True when `[options] clipboard = "unnamed[plus]"` is set — a proper section
// parse (whitespace / alignment / inline-comment tolerant), not a brittle
// fixed-spacing substring match.
fn clipboard_enabled(cfg_path: Str) -> Bool [fs]
    let Some(content) = fs.read(cfg_path) else return false
    let lines = str.split_lines(content)
    var in_opt = false
    var on = false
    var i = 0
    let n = list.len(lines)
    while i < n
        let raw = str.trim(lines[i])
        if str.len(raw) > 0 and (str.byte_at(raw, 0) ?? 0) != 35
            if (str.byte_at(raw, 0) ?? 0) == 91
                in_opt = raw == "[options]"
            elif in_opt
                let eq = util.index_of_byte(raw, 61)
                if eq > 0 and str.trim(str.slice(raw, 0, eq)) == "clipboard"
                    let v = util.strip_quotes(str.trim(util.strip_inline_comment(str.slice(raw, eq + 1, str.len(raw)))))
                    on = util.index_of_str(v, "unnamed") >= 0
        i = i + 1
    on

// Push `text` to the OS clipboard with OSC 52: ESC ] 52 ; c ; <base64> ESC \.
fn clip_copy(text: Str, linewise: Bool) [io]
    let payload = if linewise and not clip_ends_nl(text) then text + str.from_char('\n') else text
    let b64 = crypto.base64_encode(payload)
    emit(str.from_byte('\x1b') + "]52;c;" + b64 + str.from_byte('\x1b') + str.from_char('\\'))

// The argv that prints the OS clipboard to stdout: Wayland → wl-paste, else
// X11 → xclip (the same `+`/CLIPBOARD selection Neovim's `unnamedplus` uses).
fn clip_paste_argv() -> [Str] [io]
    let wl = process.env("WAYLAND_DISPLAY") ?? ""
    if str.len(wl) > 0
        ["wl-paste", "--no-newline"]
    else
        ["xclip", "-selection", "clipboard", "-o"]

// Read the OS clipboard: spawn the paste tool and drain its stdout (poll-gated
// so a stuck helper can't freeze the editor).  "" on spawn failure / empty.
fn clip_paste() -> Str [io, time]
    let Some(pid) = proc.spawn(clip_paste_argv()) else return ""
    let out = proc.stdout_fd(pid)
    let sb = str.builder_new()
    var more = true
    while more
        if proc.poll(out, 500) == 1
            let b = proc.read_byte(out)
            if b < 0
                more = false
            else
                str.builder_append_char(sb, b)
        else
            more = false                  // 500ms idle → EOF or stalled
    let r = str.builder_to_str(sb)
    str.builder_drop(sb)
    proc.close(pid)
    r

// ── `:files` picker source ──────────────────────────────────────────────────

// Read a child's stdout until `cap` lines have arrived, then kill and reap it.
// The cap has to bind DURING the read, not after: a producer can emit orders of
// magnitude more than the picker will ever hold (`rg --files` under a home
// directory), and reading it all first means the editor is unresponsive for as
// long as the producer runs, however small the cap is.  Poll-gated, so a child
// that stops producing without closing stdout cannot wedge the read either.
fn proc_take_lines(pid: Int, cap: Int) -> [Str] [io, time]
    let out = proc.stdout_fd(pid)
    let sb = str.builder_new()
    var nlines = 0
    var more = true
    while more and nlines < cap
        if proc.poll(out, 800) == 1
            let b = proc.read_byte(out)
            if b < 0
                more = false
            else
                str.builder_append_char(sb, b)
                if b == '\n'
                    nlines = nlines + 1
        else
            more = false                  // 800ms idle → EOF or stalled
    let text = str.builder_to_str(sb)
    str.builder_drop(sb)
    grep_child_kill(pid)                  // kill+reap; an already-exited child just reaps
    file_lines(text)

// Drain a child process's stdout to EOF (poll-gated so a stuck child can't
// freeze the editor), split into lines.  Reaps the child.
fn proc_drain_lines(pid: Int) -> [Str] [io, time]
    let out = proc.stdout_fd(pid)
    let sb = str.builder_new()
    var more = true
    while more
        if proc.poll(out, 800) == 1
            let b = proc.read_byte(out)
            if b < 0
                more = false
            else
                str.builder_append_char(sb, b)
        else
            more = false                  // 800ms idle → EOF or stalled
    let text = str.builder_to_str(sb)
    str.builder_drop(sb)
    proc.close(pid)
    file_lines(text)

// Internal recursive file walk (the no-ripgrep fallback for `:files`) —
// relative paths, skipping VCS/build dirs, bounded depth + count.
fn walk_files(dir: Str, prefix: Str, depth: Int, var acc: [Str], cap: Int) -> [Str] [fs]
    if depth > 12 or list.len(acc) >= cap
        return acc
    var a = acc
    let entries = fs.read_dir(dir)
    var i = 0
    while i < list.len(entries) and list.len(a) < cap
        let name = entries[i]
        if name != ".git" and name != "_novo" and name != "_build" and name != "node_modules"
            let full = path.join(dir, name)
            let rel = if str.len(prefix) == 0 then name else prefix + "/" + name
            if fs.is_dir(full)
                a = walk_files(full, rel, depth + 1, var a, cap)
            else
                a = list.push(a, rel)
        i = i + 1
    a

// Kill + reap a running `:grep` child (no-op when none; also used at EOF —
// killing an already-exited pid is harmless and close() reaps it).
fn grep_child_kill(pid: Int) [io]
    if pid >= 0
        let _ = proc.kill(pid, 15)
        proc.close(pid)

@intent("""Produce the `:files` candidate list: `rg --files` (respects
.gitignore) when ripgrep is available, else the internal walk.  Relative paths
either way (both are cwd-relative, matching `:e <rel>`).  Empty lines dropped;
capped at `cap` entries — and the cap bounds the READ as well as the result, so
opening the picker somewhere enormous costs `cap` lines rather than a full
traversal.  The walk fallback is bounded the same way, by its own `cap`.""")
fn files_candidates(cap: Int) -> [Str] [io, fs, time]
    match proc.spawn(["rg", "--files"])
        None =>
            walk_files(".", "", 0, [], cap)
        Some(pid) =>
            let raw = proc_take_lines(pid, cap)
            var out: [Str] = []
            var i = 0
            while i < list.len(raw) and list.len(out) < cap
                if str.len(raw[i]) > 0
                    out = list.push(out, raw[i])
                i = i + 1
            // let-bound, NOT a tail if/else: a statement-tail if returning a
            // push-rebound var reads its pre-push value under --llvm, so the
            // loop's appends to `out` would be invisible to the caller.
            let r = if list.len(out) == 0 then walk_files(".", "", 0, [], cap) else out
            r

// Recursively concatenate every `*.lua` under `dir` (newline-separated) into one
// buffer — scraping the combined text means a leader set in one file applies to
// maps declared in another.  Skips the `.git` dir; bounded depth guards loops.
fn collect_lua(dir: Str, depth: Int) -> Str [fs]
    if depth > 16
        return ""
    var acc = ""
    let entries = fs.read_dir(dir)
    var i = 0
    while i < list.len(entries)
        let name = entries[i]
        let full = path.join(dir, name)
        if name != ".git"
            if fs.is_dir(full)
                acc = acc + collect_lua(full, depth + 1)
            elif ends_with_lua(name)
                acc = acc + file_to_text(full) + str.from_char('\n')
        i = i + 1
    acc

fn ends_with_lua(p: Str) -> Bool
    let n = str.len(p)
    n >= 4 and str.slice(p, n - 4, n) == ".lua"

// Render a byte sequence printably for `--dump-keymaps` (control bytes as <C-x>,
// ESC/CR/TAB/space named) so the import is inspectable without a terminal.
fn show_bytes(s: Str) -> Str
    var o = ""
    var i = 0
    let n = str.len(s)
    while i < n
        let b = str.byte_at(s, i) ?? 0
        if b == '\r'
            o = o + "<CR>"
        elif b == '\x1b'
            o = o + "<Esc>"
        elif b == '\t'
            o = o + "<Tab>"
        elif b == '\x7f'
            o = o + "<BS>"
        elif b == ' '
            o = o + "<Space>"
        elif b >= 1 and b <= 26
            o = o + "<C-" + str.from_byte(b - 1 + 'a') + ">"
        else
            o = o + str.from_byte(b)
        i = i + 1
    o

// An LHS for `--dump-keymaps`: an Alt chord reads `<M-x>` (`<M-CR>` for a named
// key), anything else as show_bytes spells it.
fn show_lhs(s: Str) -> Str
    if is_alt_lhs(s)
        let inner = show_bytes(str.slice(s, 1, 2))
        let n = str.len(inner)
        if n > 2 and (str.byte_at(inner, 0) ?? 0) == '<' and (str.byte_at(inner, n - 1) ?? 0) == '>'
            "<M-" + str.slice(inner, 1, n)
        else
            "<M-" + inner + ">"
    else
        show_bytes(s)

@intent("""`--dump-keymaps` debug entry point: resolve the nvim config dir, scrape
its leader + Normal-mode maps, and print each `lhs -> rhs` with control bytes
shown printably — no TUI.  The headless test hook for the importer.""")
// `--fuzzy-rank <query> <file>` debug command: rank the file's lines as picker
// candidates and print `score<TAB>candidate`, best first (top 10) — the
// headless test hook for the fuzzy scorer (like --dump-keymaps for keymaps).
fn run_fuzzy_rank(query: Str, path: Str) [io, fs]
    let cands = buf_load(path)
    let top = fuzzy.rank(query, cands, 10)
    let m = list.len(top)
    var i = 0
    while i < m
        let idx = top[i]
        println(str.from_int(fuzzy.score(query, cands[idx])) + str.from_char('\t') + cands[idx])
        i = i + 1
    println("matches: " + str.from_int(fuzzy.match_count(query, cands)) + "/" + str.from_int(list.len(cands)))

fn run_dump_keymaps(cfg_path: Str) [io, fs]
    let dir = default_nvim_dir()
    let text = collect_lua(dir, 0)
    let ml = nvmap.find_mapleader(text)
    let leader = if str.len(ml) > 0 then ml else str.from_char('\\')
    println("nvim-dir: " + dir)
    // The dump reads the Neovim config whether or not the editor will: the maps
    // below load only when `[keymaps] import_nvim = true` is in the novim config.
    if not keymaps_import_nvim(cfg_path)
        println("import: off (no `[keymaps] import_nvim = true` in " + cfg_path + "); the editor loads none of these")
    println("leader: " + show_bytes(leader))
    let tl = nvmap.find_timeoutlen(text)
    if tl >= 0
        println("timeoutlen: " + str.from_int(tl))
    let pairs = nvmap.scrape_n_maps(text, leader)
    println("maps: " + str.from_int(list.len(pairs) / 2))
    var i = 0
    while i + 1 < list.len(pairs)
        println("  " + show_lhs(pairs[i]) + " -> " + show_bytes(pairs[i + 1]))
        i = i + 2
    // The other classes are listed only when the config has some, so a config
    // with Normal-mode maps alone prints what it always did.
    let ipairs = nvmap.scrape_mode_maps(text, leader, "i")
    if list.len(ipairs) > 0
        println("insert maps: " + str.from_int(list.len(ipairs) / 2))
        var j = 0
        while j + 1 < list.len(ipairs)
            println("  " + show_lhs(ipairs[j]) + " -> " + show_bytes(ipairs[j + 1]))
            j = j + 2
    let cpairs = cmdline_chord_maps(text, leader)
    if list.len(cpairs) > 0
        println("command-line maps: " + str.from_int(list.len(cpairs) / 2))
        var k = 0
        while k + 1 < list.len(cpairs)
            println("  " + show_lhs(cpairs[k]) + " -> " + show_bytes(cpairs[k + 1]))
            k = k + 2

// ── LSP (novols) client — JSON-RPC transport ───────────────────────────────
// novim talks JSON-RPC over stdio to `novols`.  All of this lives outside the
// pure `feed`; see orbit/novim/docs/LSP-DESIGN.md.

@intent("""Send one JSON-RPC message to the language server over `fd`, framed
with the LSP `Content-Length: N\\r\\n\\r\\n<body>` header.  Writes in bulk via
the host primitive, not byte-by-byte.""")
// ── Live diagnostics in run_interactive ─────────────────────────────────────
// Highest severity (1 = error wins over 2 = warning) on buffer line `line`,
// or 0 when the line is clean.  `diag_li` is the flat line/sev store.
fn diag_sev_for_line(diag_li: [Int], line: Int) -> Int
    var best = 0
    var i = 0
    while i + 1 < list.len(diag_li)
        if diag_li[i] == line
            let s = diag_li[i + 1]
            if best == 0 or s < best
                best = s
        i = i + 2
    best

// Count of diagnostics of a given severity.
fn diag_count(diag_li: [Int], sev: Int) -> Int
    var c = 0
    var i = 0
    while i + 1 < list.len(diag_li)
        if diag_li[i + 1] == sev
            c = c + 1
        i = i + 2
    c

// The first diagnostic message on buffer line `line`, or "" if none.
fn diag_msg_for_line(diag_li: [Int], diag_msgs: [Str], line: Int) -> Str
    var k = 0
    var i = 0
    while i + 1 < list.len(diag_li)
        if diag_li[i] == line and k < list.len(diag_msgs)
            return diag_msgs[k]
        k = k + 1
        i = i + 2
    ""

// ── Go-to-definition (gd) + hover (K) ───────────────────────────────────────
// ── definition: result is a Location (or Location[]); pull start pos + uri ──
// ── hover: result.contents is a MarkupContent { value } (markdown) ──
// ── document formatting (:fmt) ──────────────────────────────────────────────
// ── document symbols (:sym <name>) ──────────────────────────────────────────
// ── rename (:rename <newname>) ──────────────────────────────────────────────
// ── completion (Ctrl-N / Ctrl-P, inline cycle) ──────────────────────────────
// True when `s` begins with `prefix`.
fn starts_with(s: Str, prefix: Str) -> Bool
    let pl = str.len(prefix)
    if pl > str.len(s)
        return false
    str.slice(s, 0, pl) == prefix

// Column where the identifier ending at `col` begins (the completion prefix).
fn ident_start_before(line: Str, col: Int) -> Int
    var s = col
    while s > 0 and disp.nv_ident_char(str.byte_at(line, s - 1) ?? 0)
        s = s - 1
    s

// True when feeding `b` in the current state is a "jump" command (G, gg, n, N,
// {, }, %, *, #) — whose origin the driver records in the jumplist if the
// cursor actually moves.  These run inside the pure feed_edit, so the driver
// snapshots around the call rather than recording from within.
fn is_jump_key(st: InputState, b: Int) -> Bool
    if st.mode != 0
        return false
    if st.pending == 1
        return b == 'g'                                 // gg (second g)
    if st.pending == 0
        return b == 'G' or b == 'n' or b == 'N' or b == '{' or b == '}' or b == '%' or b == '*' or b == '#'
    false

// Drop the last two Ints (one packed [y, x] jumplist entry).
fn drop_last2(xs: [Int]) -> [Int]
    var out: [Int] = []
    var i = 0
    let n = list.len(xs) - 2
    while i < n
        out = list.push(out, xs[i])
        i = i + 1
    out

// Drop the last element of a [Str] (one jumplist entry).
fn drop_last_str(xs: [Str]) -> [Str]
    var out: [Str] = []
    var i = 0
    let n = list.len(xs) - 1
    while i < n
        out = list.push(out, xs[i])
        i = i + 1
    out

// A jumplist entry packs the origin as "y|x|path" — y/x first so the path
// (which may contain anything) is simply everything after the second '|'.
fn jentry(path: Str, y: Int, x: Int) -> Str
    str.from_int(y) + "|" + str.from_int(x) + "|" + path

fn jentry_y(e: Str) -> Int
    let p = util.index_of_byte(e, '|')
    if p < 0 then 0 else (str.to_int(str.slice(e, 0, p)) ?? 0)

fn jentry_x(e: Str) -> Int
    let p1 = util.index_of_byte(e, '|')
    let after = str.slice(e, p1 + 1, str.len(e))
    let p2 = util.index_of_byte(after, '|')
    if p2 < 0 then 0 else (str.to_int(str.slice(after, 0, p2)) ?? 0)

fn jentry_path(e: Str) -> Str
    let p1 = util.index_of_byte(e, '|')
    let after = str.slice(e, p1 + 1, str.len(e))
    let p2 = util.index_of_byte(after, '|')
    if p2 < 0 then "" else str.slice(after, p2 + 1, str.len(after))

// Strip a "file://" URI down to a filesystem path.
fn uri_to_path(uri: Str) -> Str
    if str.len(uri) >= 7 and str.slice(uri, 0, 7) == "file://" then str.slice(uri, 7, str.len(uri)) else uri

// Replace [start, endc) on the cursor line with `ins`; cursor lands after it.
fn comp_apply(ed: Editor, start: Int, endc: Int, ins: Str) -> Editor
    let line = line_at(ed, ed.cy)
    let e = if endc <= str.len(line) then endc else str.len(line)
    let nl = str.slice(line, 0, start) + ins + str.slice(line, e, str.len(line))
    Editor { lines: set_line(ed.lines, ed.cy, nl), cy: ed.cy, cx: start + str.len(ins) }

// Apply rename edits to the buffer.  Edits arrive in ascending (line, char)
// order, so iterating in REVERSE applies them right-to-left / bottom-to-top —
// earlier positions never shift.  Each edit replaces line[ln][schar..echar).
fn apply_rename(ed: Editor, triples: [Int], newtexts: [Str]) -> Editor
    var lines = ed.lines[:]
    var k = list.len(newtexts) - 1
    while k >= 0
        if k * 3 + 2 < list.len(triples)
            let ln = triples[k * 3]
            let sc = triples[k * 3 + 1]
            let ec = triples[k * 3 + 2]
            if ln >= 0 and ln < list.len(lines)
                let old = lines[ln]
                if sc >= 0 and sc <= ec and ec <= str.len(old)
                    let nw = str.slice(old, 0, sc) + newtexts[k] + str.slice(old, ec, str.len(old))
                    lines = set_line(lines, ln, nw)
        k = k - 1
    Editor { lines: lines, cy: ed.cy, cx: ed.cx }

@intent("""`--lsp-resolve <file>` debug entry point: print which language server
novim would drive for a file — its languageId, the resolved command (built-in
default, or a `[lsp]` config override), and the workspace rootUri — WITHOUT
spawning anything.  Lets users verify their `[lsp]` config and gives the
multi-language resolver a deterministic, dependency-free headless test.""")
fn run_lsp_resolve(cfg_path: Str, path: Str) [io, fs]
    let lang = lsp.lsp_lang_of(path)
    if str.len(lang) == 0
        println("language: (none)")
        println("command: (none)")
        println("rootUri: (none)")
    else
        let cfg = file_to_text(cfg_path)
        let root = lsp.lsp_root_uri_for(path)
        let rootshow = if str.len(root) == 0 then "null" else root
        println("language: " + lang)
        println("command: " + lsp.lsp_cmd_for(path, cfg))
        println("rootUri: " + rootshow)

@intent("""`--lsp-diag <file>` entry point: spawn the resolved server, run the
full initialize/didOpen handshake, wait for publishDiagnostics, and print them.
A deterministic, headless smoke test of the language-server transport (no TUI).""")
fn run_lsp_diag(path: Str) [io, fs, time]
    // Use the free `proc.*` surface (pid-keyed) rather than the Subprocess
    // methods: the method-return slot-type inference is fragile (an fd binder
    // gets a ptr slot for the i64 return) and breaks the build as unrelated
    // code shifts inference.  The free fns are what run_interactive uses.
    let pid = lsp.lsp_spawn_cmd(lsp.lsp_cmd_for(path, ""))
    if pid < 0
        println("language server: spawn failed")
    else
        let in_fd = proc.stdin_fd(pid)
        let out_fd = proc.stdout_fd(pid)
        let uri = "file://" + path
        lsp.lsp_send(in_fd, lsp.lsp_init_req(uri, lsp.lsp_root_uri_for(path)))
        let _ = lsp.lsp_poll_message(out_fd, 2000)               // initialize result
        lsp.lsp_send(in_fd, lsp.lsp_initialized())
        let text = buf_text(Editor { lines: buf_load(path), cy: 0, cx: 0 })
        lsp.lsp_send(in_fd, lsp.lsp_didopen(uri, lsp.lsp_lang_of(path), text))
        var iters = 0
        var shown = false
        while iters < 40 and not shown
            let msg = lsp.lsp_poll_message(out_fd, 500)
            if lsp.lsp_msg_diags(msg)
                shown = true
            iters = iters + 1
        if not shown
            println("diagnostics: (none received)")
        let _ = proc.kill(pid, 15)
        proc.close(pid)

// The command-line surface, declared once.  `std.cli` parses argv from
// this declaration and generates the usage text from the same records,
// so the two cannot drift (docs/stdlib/cli.md).
//
// The file list is a variadic positional: the first file is the active
// buffer and the rest open as additional buffers, which is why it is
// `<file>...` and not a fixed pair.
fn novim_cli() -> Cli
    Cli.new("novim", "modal terminal editor")
        .str_flag("config", "", "config file to read instead of the default", "")
        .value_name("toml")
        .str_flag("batch", "", "headless: feed these keys through the real input handler, then dump the buffer", "")
        .value_name("keys")
        .str_flag("fuzzy-rank", "", "rank the file's lines against this query and print the scores", "")
        .value_name("query")
        .bool_flag("lsp-diag", "", "language-server smoke test: open the file and print its diagnostics")
        .bool_flag("lsp-resolve", "", "print the language server novim would spawn for the file")
        .bool_flag("dump-keymaps", "", "print the keymaps parsed from the nvim config and exit")
        .bool_flag("no-color", "", "draw in the terminal's own colours (also honours NO_COLOR)")
        .rest_arg("file", "files to open; the first is the active buffer")

@intent("""CLI entry point.  Parse argv and dispatch: `--batch <keys> <file>`
(headless scripted edit), `--lsp-diag <file>` (language-server smoke test),
`--config <path>` to override the config file, or one-or-more file paths →
interactive mode (first file active, the rest opened as buffers).""")
fn main() [io, fs, time, ffi]
    // parse_or_exit answers --help / -h from the declaration and exits 2
    // on a mistyped flag or a missing flag value.  Both used to be data:
    // `novim --help` opened a file called `--help`, and `--batch` with
    // no following token opened one called `--batch`.
    let m = novim_cli().parse_env_or_exit()
    let batch_keys   = m.get_str("batch")
    let fuzzy_query  = m.get_str("fuzzy-rank")
    let cfg          = m.get_str("config")
    // `given`, not `!= ""`: `--batch ""` (load the file, feed no keys,
    // dump it) and `--fuzzy-rank ""` (keep the producer's order) are
    // both real invocations, and both carry an empty value.
    let is_batch     = m.given("batch")
    let fuzzy_rank   = m.given("fuzzy-rank")
    let lsp_diag     = m.get_bool("lsp-diag")
    let lsp_resolve  = m.get_bool("lsp-resolve")
    let dump_keymaps = m.get_bool("dump-keymaps")
    // NO_COLOR is honoured alongside the flag: it is the convention for
    // "this terminal has been told not to use colour", and a colour scheme
    // that ignores it is not a colour scheme anyone can turn off.
    let want_color = not m.get_bool("no-color") and env.get_or("NO_COLOR", "") == ""
    let file = m.arg(0)                  // first file (the initial buffer)
    var extra = ""                       // remaining files, newline-joined → extra buffers
    var i = 1
    while i < list.len(m.args)
        let f = m.args[i]
        extra = if str.len(extra) == 0 then f else extra + str.from_char('\n') + f
        i = i + 1
    let cfg_path = if cfg != "" then cfg else default_config_path()
    if dump_keymaps
        run_dump_keymaps(cfg_path)
    elif fuzzy_rank and file != ""
        run_fuzzy_rank(fuzzy_query, file)
    elif file == "" and (is_batch or lsp_diag or lsp_resolve or fuzzy_rank)
        // These modes operate ON a file; without one there is nothing to
        // do, so they still refuse.  Plain interactive does not — it
        // opens an empty unnamed buffer, like vim.
        print(novim_cli().help())
    elif lsp_resolve
        run_lsp_resolve(cfg_path, file)
    elif lsp_diag
        run_lsp_diag(file)
    elif is_batch
        run_batch(batch_keys, cfg_path, file)
    else
        run_interactive(cfg_path, file, extra, want_color)
