// novim — a modal terminal editor written in Novo.
//
// The buffer is a plain `[Str]` line vector.  The editor loads a file, drives
// an interactive ANSI TUI, and supports a deterministic `--batch` mode used by
// the test harness.  See features/orbits/novim/README.md for the feature
// overview.
//
// The interactive TUI uses the host-TTY primitives std.pty exposes (raw mode,
// host stdin/stdout byte, poll, winsize) — the same surface novomux/novoterm
// drive.  `novo_pty_` references also trip the stdlib's conditional-link so
// libutil is pulled in.

use util
use lsp
use nvregex

// Editor state.  The cursor is 0-based (line, col); the buffer is a line vector.
struct Editor
    lines: [Str]
    cy:    Int
    cx:    Int

// Normal-mode input state carried across bytes: `count` accumulates a numeric
// prefix (e.g. `5j`); `pending` is the awaiting-second-key operator (0 none,
// 1 `g` for gg, 2 `d` for dd, 3 `y` for yy); `mode` is Normal/Insert/Visual;
// `reg` + `reg_lw` are the unnamed yank/delete register (linewise when reg_lw,
// characterwise otherwise).
struct InputState
    count:   Int
    pending: Int
    mode:    Int          // 0 Normal, 1 Insert, 2 Visual-char, 3 Visual-line
    reg:     Str
    reg_lw:  Bool
    search:  Str          // last `/pattern`, for n / N
    avy:     Int          // visual-mode selection anchor: line / col
    avx:     Int

// feed()'s result: the new editor + the new input state.
struct Step
    ed: Editor
    st: InputState

// The clean initial state (empty register).  Used once at editor start.
fn ist_new() -> InputState
    InputState { count: 0, pending: 0, mode: 0, reg: "", reg_lw: false, search: "", avy: 0, avx: 0 }

// End-of-command reset: clear count/pending, return to Normal, but PRESERVE
// the register so a later `p` can paste an earlier `yy`/`dd`.
fn ist_done(st: InputState) -> InputState
    InputState { count: 0, pending: 0, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx }

// Enter Insert mode, preserving the register.
fn ist_insert(st: InputState) -> InputState
    InputState { count: 0, pending: 0, mode: 1, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx }

// Record the last search pattern (after `/pattern<Enter>`).
fn ist_set_search(st: InputState, pat: Str) -> InputState
    InputState { count: 0, pending: 0, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: pat, avy: st.avy, avx: st.avx }

// ── Buffer ──────────────────────────────────────────────────────

@intent("""Load `path` into a line vector.  A missing/unreadable file, or an
empty file, yields a single empty line — a fresh scratch buffer — so the cursor
always has somewhere to sit.""")
fn buf_load(path: Str) -> [Str] [io]
    match fs.read(path)
        None    => [""]
        Some(s) =>
            let ls = str.split_lines(s)
            if list.len(ls) == 0 then [""] else ls

@intent("""Clamp the cursor into the buffer bounds, following the vim
normal-mode rule: cx sits on the last glyph (len-1), or col 0 on an empty
line.""")
fn clamp(ed: Editor) -> Editor
    let n = list.len(ed.lines)
    var cy = ed.cy
    if cy < 0
        cy = 0
    if cy >= n
        cy = n - 1
    if cy < 0
        cy = 0
    let ll = if cy >= 0 and cy < n then str.len(ed.lines[cy]) else 0
    let maxx = if ll > 0 then ll - 1 else 0
    var cx = ed.cx
    if cx < 0
        cx = 0
    if cx > maxx
        cx = maxx
    Editor { lines: ed.lines, cy: cy, cx: cx }

// ── Input ───────────────────────────────────────────────────────

fn line_at(ed: Editor, y: Int) -> Str
    if y >= 0 and y < list.len(ed.lines) then ed.lines[y] else ""

// Column of the first non-blank glyph on `line` (0 if all blank/empty).
fn first_nonblank(line: Str) -> Int
    let n = str.len(line)
    let mut i = 0
    while i < n
        let c = str.byte_at(line, i) ?? 0
        if c != 32 and c != 9          // not space / tab
            return i
        i = i + 1
    0

// The leading whitespace (tabs + spaces) of a line, for auto-indent.  Returns
// the whole line when it is blank.
fn leading_ws(line: Str) -> Str
    let n = str.len(line)
    var i = 0
    while i < n and ((str.byte_at(line, i) ?? 0) == ' ' or (str.byte_at(line, i) ?? 0) == '\t')
        i = i + 1
    str.slice(line, 0, i)

// One h/j/k/l step (clamped).
fn motion_hjkl(ed: Editor, b: Int) -> Editor
    if b == 'h'          // 'h' — left
        clamp(Editor { lines: ed.lines, cy: ed.cy, cx: ed.cx - 1 })
    elif b == 'l'        // 'l' — right
        clamp(Editor { lines: ed.lines, cy: ed.cy, cx: ed.cx + 1 })
    elif b == 'j'        // 'j' — down
        clamp(Editor { lines: ed.lines, cy: ed.cy + 1, cx: ed.cx })
    elif b == 'k'        // 'k' — up
        clamp(Editor { lines: ed.lines, cy: ed.cy - 1, cx: ed.cx })
    else
        ed

fn repeat_hjkl(ed: Editor, b: Int, times: Int) -> Editor
    var e = ed
    let mut k = 0
    while k < times
        e = motion_hjkl(e, b)
        k = k + 1
    e

// ── Word motions (w / b / e) ────────────────────────────────────
// Vim word semantics: a "word" is a maximal run of word chars
// (alnum + `_`) OR a maximal run of other punctuation; whitespace
// separates.  class 0 = whitespace, 1 = word, 2 = punctuation.

fn char_class_of(c: Int) -> Int
    if c == ' ' or c == '\t'
        0
    elif (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
        1
    else
        2

// Class of the glyph at (y,x); out-of-range / past end-of-line reads as
// whitespace (the inter-line / trailing gap).
fn class_at(ed: Editor, y: Int, x: Int) -> Int
    let line = line_at(ed, y)
    if x >= 0 and x < str.len(line)
        char_class_of(str.byte_at(line, x) ?? ' ')
    else
        0

// Like `class_at`, but for WORD motions (`W`/`E`/`B`): `big` collapses
// punctuation into the word class, so a WORD is any whitespace-delimited run.
fn class_at_w(ed: Editor, y: Int, x: Int, big: Bool) -> Int
    let c = class_at(ed, y, x)
    if big and c == 2 then 1 else c

// `w` — forward to the start of the next word.  Skips the rest of the
// current run, then skips whitespace (crossing line boundaries), landing
// on the next non-blank; clamps at end-of-buffer.
fn motion_w(ed: Editor, big: Bool) -> Editor
    let nlines = list.len(ed.lines)
    var y = ed.cy
    var x = ed.cx
    let cc0 = class_at_w(ed, y, x, big)
    if cc0 != 0
        var go = true
        var g = 0
        while go and g < 1000000
            g = g + 1
            if x < str.len(line_at(ed, y)) and class_at_w(ed, y, x, big) == cc0
                x = x + 1
            else
                go = false
    var done = false
    var g2 = 0
    while not done and g2 < 1000000
        g2 = g2 + 1
        let ll = str.len(line_at(ed, y))
        if x < ll
            if class_at_w(ed, y, x, big) == 0
                x = x + 1
            else
                done = true
        elif y + 1 < nlines
            y = y + 1
            x = 0
        else
            x = if ll > 0 then ll - 1 else 0
            done = true
    clamp(Editor { lines: ed.lines, cy: y, cx: x })

// `e` — forward to the end of the next word.
fn motion_e(ed: Editor, big: Bool) -> Editor
    let nlines = list.len(ed.lines)
    var y = ed.cy
    var x = ed.cx
    // step one position forward
    if x + 1 < str.len(line_at(ed, y))
        x = x + 1
    elif y + 1 < nlines
        y = y + 1
        x = 0
    // skip whitespace forward to a word
    var done = false
    var g = 0
    while not done and g < 1000000
        g = g + 1
        let ll = str.len(line_at(ed, y))
        if x < ll
            if class_at_w(ed, y, x, big) == 0
                x = x + 1
            else
                done = true
        elif y + 1 < nlines
            y = y + 1
            x = 0
        else
            done = true
    // advance to the end of this run
    let cc = class_at_w(ed, y, x, big)
    if cc != 0
        var go = true
        var g2 = 0
        while go and g2 < 1000000
            g2 = g2 + 1
            if x + 1 < str.len(line_at(ed, y)) and class_at_w(ed, y, x + 1, big) == cc
                x = x + 1
            else
                go = false
    clamp(Editor { lines: ed.lines, cy: y, cx: x })

// `b` — backward to the start of the current/previous word.
fn motion_b(ed: Editor, big: Bool) -> Editor
    var y = ed.cy
    var x = ed.cx
    // step one position back
    if x > 0
        x = x - 1
    elif y > 0
        y = y - 1
        let pl = str.len(line_at(ed, y))
        x = if pl > 0 then pl - 1 else 0
    // skip whitespace backward
    var done = false
    var g = 0
    while not done and g < 1000000
        g = g + 1
        if class_at_w(ed, y, x, big) == 0 and not (y == 0 and x == 0)
            if x > 0
                x = x - 1
            elif y > 0
                y = y - 1
                let pl = str.len(line_at(ed, y))
                x = if pl > 0 then pl - 1 else 0
            else
                done = true
        else
            done = true
    // skip back to the start of this run (within the line)
    let cc = class_at_w(ed, y, x, big)
    if cc != 0
        var go = true
        var g2 = 0
        while go and g2 < 1000000
            g2 = g2 + 1
            if x > 0 and class_at_w(ed, y, x - 1, big) == cc
                x = x - 1
            else
                go = false
    clamp(Editor { lines: ed.lines, cy: y, cx: x })

// kind: 0=w 1=b 2=e (word, alnum/punct runs); 3=W 4=B 5=E (WORD, whitespace-
// delimited).
fn repeat_word(ed: Editor, kind: Int, times: Int) -> Editor
    var e = ed
    let big = kind >= 3
    let k = kind % 3
    let mut i = 0
    while i < times
        if k == 0
            e = motion_w(e, big)
        elif k == 1
            e = motion_b(e, big)
        else
            e = motion_e(e, big)
        i = i + 1
    e

// ── Editing (insert mode) ───────────────────────────────────────

// Replace line `y` with `s` (returns a fresh line vector).
fn set_line(lines: [Str], y: Int, s: Str) -> [Str]
    var ls: [Str] = []
    let mut i = 0
    let n = list.len(lines)
    while i < n
        if i == y
            ls = list.append(ls, [s])
        else
            ls = list.append(ls, [lines[i]])
        i = i + 1
    ls

// Clamp for INSERT mode: cx may sit one past the last glyph (cx == len)
// so text can be appended at the end of a line.
fn clamp_insert(ed: Editor) -> Editor
    let n = list.len(ed.lines)
    var cy = ed.cy
    if cy < 0
        cy = 0
    if cy >= n
        cy = n - 1
    if cy < 0
        cy = 0
    let ll = if cy >= 0 and cy < n then str.len(ed.lines[cy]) else 0
    var cx = ed.cx
    if cx < 0
        cx = 0
    if cx > ll
        cx = ll
    Editor { lines: ed.lines, cy: cy, cx: cx }

// Insert byte `b` at the cursor and advance one column.
fn insert_char(ed: Editor, b: Int) -> Editor
    let line = line_at(ed, ed.cy)
    let before = str.slice(line, 0, ed.cx)
    let after = str.slice(line, ed.cx, str.len(line))
    let merged = before + str.from_char(b) + after
    Editor { lines: set_line(ed.lines, ed.cy, merged), cy: ed.cy, cx: ed.cx + 1 }

// Split the current line at the cursor (Enter in insert mode).  Auto-indent:
// the new line inherits the current line's leading whitespace and the cursor
// lands just past it.
fn insert_newline(ed: Editor) -> Editor
    let line = line_at(ed, ed.cy)
    let before = str.slice(line, 0, ed.cx)
    let after = str.slice(line, ed.cx, str.len(line))
    let indent = leading_ws(line)
    let ilen = str.len(indent)            // snapshot before the concat (see bugs/codegen-llvm)
    let newafter = indent + after
    var ls: [Str] = []
    let mut i = 0
    let n = list.len(ed.lines)
    while i < n
        if i == ed.cy
            ls = list.append(ls, [before])
            ls = list.append(ls, [newafter])
        else
            ls = list.append(ls, [ed.lines[i]])
        i = i + 1
    Editor { lines: ls, cy: ed.cy + 1, cx: ilen }

// Backspace: delete the glyph before the cursor, or join with the line
// above when at column 0.
fn backspace(ed: Editor) -> Editor
    if ed.cx > 0
        let line = line_at(ed, ed.cy)
        let merged = str.slice(line, 0, ed.cx - 1) + str.slice(line, ed.cx, str.len(line))
        Editor { lines: set_line(ed.lines, ed.cy, merged), cy: ed.cy, cx: ed.cx - 1 }
    elif ed.cy > 0
        let prev = line_at(ed, ed.cy - 1)
        let cur = line_at(ed, ed.cy)
        let joincol = str.len(prev)
        var ls: [Str] = []
        let mut i = 0
        let n = list.len(ed.lines)
        while i < n
            if i == ed.cy - 1
                ls = list.append(ls, [prev + cur])
            elif i == ed.cy
                // skip — merged into the previous line
                i = i
            else
                ls = list.append(ls, [ed.lines[i]])
            i = i + 1
        Editor { lines: ls, cy: ed.cy - 1, cx: joincol }
    else
        ed

// Open a fresh line below (`o`) or above (`O`) and enter it.  Auto-indent: the
// new line inherits the current line's leading whitespace; the cursor lands
// just past it so typing begins at the matching indent.
fn open_line(ed: Editor, below: Bool) -> Editor
    let at = if below then ed.cy + 1 else ed.cy
    let indent = leading_ws(line_at(ed, ed.cy))
    var ls: [Str] = []
    let mut i = 0
    let n = list.len(ed.lines)
    while i < n
        if i == at
            ls = list.append(ls, [indent])
        ls = list.append(ls, [ed.lines[i]])
        i = i + 1
    if at >= n          // opening below the last line
        ls = list.append(ls, [indent])
    Editor { lines: ls, cy: at, cx: str.len(indent) }

// Delete the glyph under the cursor (`x`); cursor clamps onto the new
// last glyph if it ran off the end.
fn delete_char_at(ed: Editor) -> Editor
    let line = line_at(ed, ed.cy)
    if str.len(line) == 0
        ed
    else
        let merged = str.slice(line, 0, ed.cx) + str.slice(line, ed.cx + 1, str.len(line))
        clamp(Editor { lines: set_line(ed.lines, ed.cy, merged), cy: ed.cy, cx: ed.cx })

fn repeat_delete_char(ed: Editor, times: Int) -> Editor
    var e = ed
    let mut k = 0
    while k < times
        e = delete_char_at(e)
        k = k + 1
    e

// Delete from the cursor to end of line (`D`).
fn delete_to_eol(ed: Editor) -> Editor
    let line = line_at(ed, ed.cy)
    clamp(Editor { lines: set_line(ed.lines, ed.cy, str.slice(line, 0, ed.cx)), cy: ed.cy, cx: ed.cx })

// ── Register: yank / delete-lines / paste ─────────────

// Clear a pending operator but keep the count + register (used when the
// second key of d/y/g isn't the doubling key — reprocess it fresh).
fn ist_clear_pending(st: InputState) -> InputState
    InputState { count: st.count, pending: 0, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx }

// Join `n` lines starting at cy into a single Str with '\n' separators —
// the linewise register payload (round-trips through str.split_lines).
fn join_lines(ed: Editor, n: Int) -> Str
    let total = list.len(ed.lines)
    var acc = ""
    var i = ed.cy
    var cnt = 0
    while i < total and cnt < n
        if cnt > 0
            acc = acc + str.from_char('\n')
        acc = acc + ed.lines[i]
        i = i + 1
        cnt = cnt + 1
    acc

// `yy` / `Nyy` — yank `n` lines into the (linewise) register; cursor stays.
fn op_yank_lines(ed: Editor, st: InputState, n: Int) -> Step
    Step { ed: ed, st: InputState { count: 0, pending: 0, mode: 0, reg: join_lines(ed, n), reg_lw: true, search: st.search, avy: st.avy, avx: st.avx } }

// `dd` / `Ndd` — yank `n` lines into the register, then remove them.
fn op_delete_lines(ed: Editor, st: InputState, n: Int) -> Step
    let payload = join_lines(ed, n)
    let total = list.len(ed.lines)
    var ls: [Str] = []
    let mut i = 0
    while i < total
        if i < ed.cy or i >= ed.cy + n
            ls = list.append(ls, [ed.lines[i]])
        i = i + 1
    if list.len(ls) == 0
        ls = list.append(ls, [""])      // the buffer always keeps one line
    var ncy = ed.cy
    if ncy >= list.len(ls)
        ncy = list.len(ls) - 1
    Step { ed: clamp(Editor { lines: ls, cy: ncy, cx: 0 }), st: InputState { count: 0, pending: 0, mode: 0, reg: payload, reg_lw: true, search: st.search, avy: st.avy, avx: st.avx } }

// `p` / `P` — paste the register after/before the cursor.  Linewise inserts
// whole lines below/above; characterwise inserts text at the cursor.
fn paste(ed: Editor, st: InputState, after: Bool) -> Editor
    if str.len(st.reg) == 0
        return ed
    if st.reg_lw
        let plines = str.split_lines(st.reg)
        let np = list.len(plines)
        let at = if after then ed.cy + 1 else ed.cy
        var ls: [Str] = []
        let mut i = 0
        let total = list.len(ed.lines)
        while i < total
            if i == at
                let mut j = 0
                while j < np
                    ls = list.append(ls, [plines[j]])
                    j = j + 1
            ls = list.append(ls, [ed.lines[i]])
            i = i + 1
        if at >= total
            let mut j = 0
            while j < np
                ls = list.append(ls, [plines[j]])
                j = j + 1
        clamp(Editor { lines: ls, cy: at, cx: 0 })
    else
        let line = line_at(ed, ed.cy)
        let want = if after then ed.cx + 1 else ed.cx
        let col = if want > str.len(line) then str.len(line) else want
        let merged = str.slice(line, 0, col) + st.reg + str.slice(line, col, str.len(line))
        clamp(Editor { lines: set_line(ed.lines, ed.cy, merged), cy: ed.cy, cx: col + str.len(st.reg) - 1 })

// ── Char-level edits: ~ toggle case, r replace, J join ───────

// ASCII case toggle: A-Z ↔ a-z, other bytes unchanged.
fn toggle_case_byte(b: Int) -> Int
    if b >= 'A' and b <= 'Z'
        b + 32
    elif b >= 'a' and b <= 'z'
        b - 32
    else
        b

// `~` / `N~` — toggle the case of `n` chars from the cursor, advancing the
// cursor past the last one (vim).  Stops at end of line.
// `Ctrl-A` / `Ctrl-X` — increment / decrement the (decimal) number at or after
// the cursor on the current line by `delta`; cursor lands on its last digit.
fn op_incdec(ed: Editor, delta: Int) -> Editor
    let line = line_at(ed, ed.cy)
    let n = str.len(line)
    var s = ed.cx
    while s < n and not ((str.byte_at(line, s) ?? 0) >= '0' and (str.byte_at(line, s) ?? 0) <= '9')
        s = s + 1
    if s >= n
        return ed                                       // no number on the rest of the line
    var start = s
    while start > 0 and (str.byte_at(line, start - 1) ?? 0) >= '0' and (str.byte_at(line, start - 1) ?? 0) <= '9'
        start = start - 1
    var endd = s
    while endd < n and (str.byte_at(line, endd) ?? 0) >= '0' and (str.byte_at(line, endd) ?? 0) <= '9'
        endd = endd + 1
    let neg = start > 0 and (str.byte_at(line, start - 1) ?? 0) == '-'
    let numstart = if neg then start - 1 else start
    let mag = match str.to_int(str.slice(line, start, endd))
        None => 0
        Some(v) => v
    let signed = if neg then 0 - mag else mag
    let newstr = str.from_int(signed + delta)
    let newline = str.slice(line, 0, numstart) + newstr + str.slice(line, endd, n)
    clamp(Editor { lines: set_line(ed.lines, ed.cy, newline), cy: ed.cy, cx: numstart + str.len(newstr) - 1 })

fn op_toggle_case(ed: Editor, n: Int) -> Editor
    let line = line_at(ed, ed.cy)
    let ll = str.len(line)
    if ll == 0
        return ed
    var s = line
    var col = ed.cx
    var k = 0
    while k < n and col < ll
        let b = str.byte_at(s, col) ?? 0
        s = str.slice(s, 0, col) + str.from_char(toggle_case_byte(b)) + str.slice(s, col + 1, str.len(s))
        col = col + 1
        k = k + 1
    clamp(Editor { lines: set_line(ed.lines, ed.cy, s), cy: ed.cy, cx: col })

// `r<c>` / `Nr<c>` — replace `n` chars under/after the cursor with byte `rb`.
// Vim no-ops when fewer than `n` chars remain on the line; cursor ends on the
// last replaced char.
fn op_replace_char(ed: Editor, rb: Int, n: Int) -> Editor
    let line = line_at(ed, ed.cy)
    let ll = str.len(line)
    if ll == 0 or ed.cx + n > ll
        return ed
    var s = line
    var col = ed.cx
    var k = 0
    while k < n
        s = str.slice(s, 0, col) + str.from_char(rb) + str.slice(s, col + 1, str.len(s))
        col = col + 1
        k = k + 1
    clamp(Editor { lines: set_line(ed.lines, ed.cy, s), cy: ed.cy, cx: ed.cx + n - 1 })

// `J` / `NJ` — join the current line with the following line(s): `NJ` joins
// `n` lines (so `J` and `2J` both join 2).  With `space` (plain `J`) each
// pulled-up line's leading blanks collapse to a single separating space;
// without it (`gJ`) the lines are concatenated verbatim.  Cursor lands on the
// first join column.  No-op on the last line.
fn op_join_lines(ed: Editor, n: Int, space: Bool) -> Editor
    let joins = if n > 1 then n - 1 else 1
    var merged = line_at(ed, ed.cy)
    var dropped = 0
    var joincol = -1
    var k = 0
    while k < joins and (ed.cy + 1 + dropped) < list.len(ed.lines)
        let nxt = ed.lines[ed.cy + 1 + dropped]
        let piece = if space then str.slice(nxt, first_nonblank(nxt), str.len(nxt)) else nxt
        if joincol < 0
            joincol = str.len(merged)
        let sep = if space and str.len(merged) != 0 then " " else ""
        merged = merged + sep + piece
        dropped = dropped + 1
        k = k + 1
    if dropped == 0
        return ed
    let total = list.len(ed.lines)
    var ls: [Str] = []
    let mut i = 0
    while i < total
        let drop = i > ed.cy and i <= ed.cy + dropped
        if i == ed.cy
            ls = list.append(ls, [merged])
        elif not drop
            ls = list.append(ls, [ed.lines[i]])
        i = i + 1
    let cx = if joincol < 0 then 0 else joincol
    clamp(Editor { lines: ls, cy: ed.cy, cx: cx })

// ── Indent: >> and << ───────────────────────────────────────

// Add one indent level.  We indent with a real tab byte — its rendered width
// follows `tabstop` (see expand_tabs), so the indent respects the user's
// width without `feed` needing to see Options.  Blank lines are left alone
// (vim doesn't indent them).
fn indent_one(line: Str) -> Str
    if str.len(line) == 0 then line else str.from_char('\t') + line

// Remove one indent level: a single leading tab, or — for space-indented
// files — up to a tab's worth (capped at 8) of leading spaces.
fn dedent_one(line: Str) -> Str
    let n = str.len(line)
    if n == 0
        return line
    if (str.byte_at(line, 0) ?? 0) == '\t'
        return str.slice(line, 1, n)
    var k = 0
    while k < 8 and k < n and (str.byte_at(line, k) ?? 0) == ' '
        k = k + 1
    str.slice(line, k, n)

// `>>` / `N>>` (right) and `<<` / `N<<` (left): shift `n` lines from the
// cursor by one indent level.  Cursor lands on the first non-blank of the
// current line (vim).
fn op_indent(ed: Editor, st: InputState, n: Int, right: Bool) -> Step
    let total = list.len(ed.lines)
    var ls: [Str] = []
    let mut i = 0
    while i < total
        if i >= ed.cy and i < ed.cy + n
            ls = list.append(ls, [if right then indent_one(ed.lines[i]) else dedent_one(ed.lines[i])])
        else
            ls = list.append(ls, [ed.lines[i]])
        i = i + 1
    let fnb = first_nonblank(if ed.cy < list.len(ls) then ls[ed.cy] else "")
    Step { ed: clamp(Editor { lines: ls, cy: ed.cy, cx: fnb }), st: ist_done(st) }

// Indent/dedent the line range [lo, hi] (used by `>`/`<` over a motion).
fn op_indent_lines(ed: Editor, st: InputState, lo: Int, hi: Int, right: Bool) -> Step
    op_indent(Editor { lines: ed.lines, cy: lo, cx: 0 }, st, hi - lo + 1, right)

// Second key of a `>` / `<` operator: doubled → line(s), a linewise motion →
// that line range.
fn feed_indent(ed: Editor, st: InputState, right: Bool, b: Int) -> Step
    let trigger = if right then '>' else '<'
    if b == trigger                              // >> / <<
        return op_indent(ed, st, if st.count > 0 then st.count else 1, right)
    let tgt = motion_target(ed, b, st.count)
    if tgt.ok and tgt.linewise
        let lo = if ed.cy < tgt.ty then ed.cy else tgt.ty
        let hi = if ed.cy < tgt.ty then tgt.ty else ed.cy
        return op_indent_lines(ed, st, lo, hi, right)
    feed(ed, ist_clear_pending(st), b)           // not a linewise motion — cancel

// ── Find-char motions f/F/t/T ───────────────────────────────

// Index of the `count`-th `ch` strictly after `from` in `line`, or -1.
fn find_char_fwd(line: Str, ch: Int, from: Int, count: Int) -> Int
    let n = str.len(line)
    var found = 0
    var i = from + 1
    while i < n
        if (str.byte_at(line, i) ?? 0) == ch
            found = found + 1
            if found == count
                return i
        i = i + 1
    -1

// Index of the `count`-th `ch` strictly before `from` in `line`, or -1.
fn find_char_bwd(line: Str, ch: Int, from: Int, count: Int) -> Int
    var found = 0
    var i = from - 1
    while i >= 0
        if (str.byte_at(line, i) ?? 0) == ch
            found = found + 1
            if found == count
                return i
        i = i - 1
    -1

// Move the cursor to a found char.  forward/back; `till` stops one short
// (t/T vs f/F).  No move when the char isn't found on the line.
fn move_find(ed: Editor, ch: Int, forward: Bool, till: Bool, count: Int) -> Editor
    let line = line_at(ed, ed.cy)
    if forward
        let idx = find_char_fwd(line, ch, ed.cx, count)
        if idx < 0 then ed else clamp(Editor { lines: ed.lines, cy: ed.cy, cx: if till then idx - 1 else idx })
    else
        let idx = find_char_bwd(line, ch, ed.cx, count)
        if idx < 0 then ed else clamp(Editor { lines: ed.lines, cy: ed.cy, cx: if till then idx + 1 else idx })

// ── % matching pair ──────────────────────────────────────────

fn is_open_bracket(ch: Int) -> Bool
    ch == '(' or ch == '[' or ch == '{'            // ( [ {

fn is_close_bracket(ch: Int) -> Bool
    ch == ')' or ch == ']' or ch == '}'            // ) ] }

fn bracket_close_of(ch: Int) -> Int
    if ch == '(' then ')' elif ch == '[' then ']' else '}'       // ( [ {  → ) ] }

fn bracket_open_of(ch: Int) -> Int
    if ch == ')' then '(' elif ch == ']' then '[' else '{'       // ) ] }  → ( [ {

// Walk forward from (sy,sx) to the close that matches `open_ch`/`close_ch`.
fn scan_match_fwd(ed: Editor, sy: Int, sx: Int, open_ch: Int, close_ch: Int) -> Editor
    var depth = 0
    var y = sy
    var x = sx
    let ny = list.len(ed.lines)
    while y < ny
        let line = line_at(ed, y)
        let n = str.len(line)
        while x < n
            let ch = str.byte_at(line, x) ?? 0
            if ch == open_ch
                depth = depth + 1
            elif ch == close_ch
                if depth == 0
                    return clamp(Editor { lines: ed.lines, cy: y, cx: x })
                depth = depth - 1
            x = x + 1
        y = y + 1
        x = 0
    ed

// Walk backward from (sy,sx) to the open that matches.
fn scan_match_bwd(ed: Editor, sy: Int, sx: Int, open_ch: Int, close_ch: Int) -> Editor
    var depth = 0
    var y = sy
    var x = sx
    while y >= 0
        while x >= 0
            let ch = str.byte_at(line_at(ed, y), x) ?? 0
            if ch == close_ch
                depth = depth + 1
            elif ch == open_ch
                if depth == 0
                    return clamp(Editor { lines: ed.lines, cy: y, cx: x })
                depth = depth - 1
            x = x - 1
        y = y - 1
        if y >= 0
            x = str.len(line_at(ed, y)) - 1
    ed

// The (inner) word under the cursor, for `*` / `#`.
fn word_under_cursor(ed: Editor) -> Str
    let to = textobj_word(ed, false, false)
    if to.ok and to.vr.sy == to.vr.ey
        str.slice(line_at(ed, to.vr.sy), to.vr.sx, to.vr.ex + 1)
    else
        ""

// `%` — jump to the bracket matching the one at/after the cursor on the line.
fn match_pair(ed: Editor) -> Editor
    let line = line_at(ed, ed.cy)
    let n = str.len(line)
    var bx = ed.cx
    var bch = 0
    while bx < n and bch == 0
        let ch = str.byte_at(line, bx) ?? 0
        if is_open_bracket(ch) or is_close_bracket(ch)
            bch = ch
        else
            bx = bx + 1
    if bch == 0
        return ed
    if is_open_bracket(bch)
        scan_match_fwd(ed, ed.cy, bx + 1, bch, bracket_close_of(bch))
    else
        scan_match_bwd(ed, ed.cy, bx - 1, bracket_open_of(bch), bch)

// ── Operator + motion: d / c / y over a motion ───────────────

// A motion's resolved destination, as an operator target.  Charwise targets
// stay on the cursor's line (cross-line word motions clamp to the line edge);
// `inclusive` means the target glyph is part of the span (e / $-ish).
struct MTarget
    ty:        Int
    tx:        Int
    ok:        Bool
    linewise:  Bool
    inclusive: Bool

fn mt(ty: Int, tx: Int, lw: Bool, inc: Bool) -> MTarget
    MTarget { ty: ty, tx: tx, ok: true, linewise: lw, inclusive: inc }

fn mt_none(ed: Editor) -> MTarget
    MTarget { ty: ed.cy, tx: ed.cx, ok: false, linewise: false, inclusive: false }

// Find-char as an operator target (df{c} / dt{c} / dF{c} / dT{c}).  Forward
// f/t are inclusive (delete through the found char, or up to it for t);
// backward F/T are exclusive of the cursor's own glyph.  Not found → no span.
fn find_target(ed: Editor, ch: Int, forward: Bool, till: Bool, count: Int) -> MTarget
    let line = line_at(ed, ed.cy)
    if forward
        let idx = find_char_fwd(line, ch, ed.cx, count)
        if idx < 0 then mt_none(ed) else mt(ed.cy, if till then idx - 1 else idx, false, true)
    else
        let idx = find_char_bwd(line, ch, ed.cx, count)
        if idx < 0 then mt_none(ed) else mt(ed.cy, if till then idx + 1 else idx, false, false)

// Row of the `count`-th paragraph boundary (an empty line) below the cursor.
// Stops at the last line when the buffer ends first.
fn para_fwd(ed: Editor, count: Int) -> Int
    let n = list.len(ed.lines)
    var cy = ed.cy
    var c = 0
    while c < count
        var i = cy + 1
        while i < n and str.len(line_at(ed, i)) != 0
            i = i + 1
        cy = if i >= n then n - 1 else i
        c = c + 1
    cy

// Row of the `count`-th paragraph boundary above the cursor (or the first line).
fn para_bwd(ed: Editor, count: Int) -> Int
    var cy = ed.cy
    var c = 0
    while c < count
        var i = cy - 1
        while i >= 0 and str.len(line_at(ed, i)) != 0
            i = i - 1
        cy = if i < 0 then 0 else i
        c = c + 1
    cy

@intent("""Resolve a motion byte to an operator target (the range an operator
like d/c/y should act over) relative to the cursor, with charwise/linewise and
inclusive/exclusive flags set per vim's motion table.  `rawcount` is 0 when no
count was typed; most motions default it to 1, but `G` needs the raw value (no
count → last line, not line 1).""")
fn motion_target(ed: Editor, b: Int, rawcount: Int) -> MTarget
    let count = if rawcount > 0 then rawcount else 1
    let line = line_at(ed, ed.cy)
    let llen = str.len(line)
    if b == 'l'                                  // l
        return mt(ed.cy, if ed.cx + count > llen then llen else ed.cx + count, false, false)
    if b == 'h'                                  // h
        return mt(ed.cy, if ed.cx - count < 0 then 0 else ed.cx - count, false, false)
    if b == '0'                                  // 0
        return mt(ed.cy, 0, false, false)
    if b == '$'                                  // $
        return mt(ed.cy, llen, false, false)
    if b == '^'                                  // ^
        return mt(ed.cy, first_nonblank(line), false, false)
    if b == 'w'                                  // w
        let e = repeat_word(ed, 0, count)
        return mt(ed.cy, if e.cy > ed.cy then llen else e.cx, false, false)
    if b == 'e'                                  // e (inclusive)
        let e = repeat_word(ed, 2, count)
        return mt(ed.cy, if e.cy > ed.cy then (if llen > 0 then llen - 1 else 0) else e.cx, false, true)
    if b == 'b'                                  // b
        let e = repeat_word(ed, 1, count)
        return mt(ed.cy, if e.cy < ed.cy then 0 else e.cx, false, false)
    if b == 'W'                                  // W
        let e = repeat_word(ed, 3, count)
        return mt(ed.cy, if e.cy > ed.cy then llen else e.cx, false, false)
    if b == 'E'                                  // E (inclusive)
        let e = repeat_word(ed, 5, count)
        return mt(ed.cy, if e.cy > ed.cy then (if llen > 0 then llen - 1 else 0) else e.cx, false, true)
    if b == 'B'                                  // B
        let e = repeat_word(ed, 4, count)
        return mt(ed.cy, if e.cy < ed.cy then 0 else e.cx, false, false)
    if b == 'j'                                  // j — linewise down
        return mt(ed.cy + count, 0, true, false)
    if b == 'k'                                  // k — linewise up
        return mt(ed.cy - count, 0, true, false)
    if b == 'G'                                  // G — linewise to line
        return mt(if rawcount > 0 then rawcount - 1 else list.len(ed.lines) - 1, 0, true, false)
    if b == '}'                                  // } — paragraph forward (linewise)
        return mt(para_fwd(ed, count), 0, true, false)
    if b == '{'                                  // { — paragraph backward (linewise)
        return mt(para_bwd(ed, count), 0, true, false)
    MTarget { ty: ed.cy, tx: ed.cx, ok: false, linewise: false, inclusive: false }

// End-of-command state carrying a fresh CHARWISE register (used by d/c/y over
// a charwise motion).  `ins` selects Insert mode (the `c` operator).
fn ist_reg_cw(st: InputState, text: Str, ins: Bool) -> InputState
    InputState { count: 0, pending: 0, mode: if ins then 1 else 0, reg: text, reg_lw: false, search: st.search, avy: st.avy, avx: st.avx }

@intent("""Apply operator `opb` (d/c/y) over the LINEWISE range between the
cursor line and `ty`.  Yank loads the linewise register and parks the cursor at
the range top; delete removes the lines; change removes them, leaves one blank
line, and enters Insert.  The buffer always keeps at least one line.""")
fn apply_linewise_op(ed: Editor, st: InputState, opb: Int, ty: Int) -> Step
    let total = list.len(ed.lines)
    var lo = if ed.cy < ty then ed.cy else ty
    var hi = if ed.cy < ty then ty else ed.cy
    if lo < 0
        lo = 0
    if hi >= total
        hi = total - 1
    var payload = ""
    var i = lo
    while i <= hi
        if i > lo
            payload = payload + str.from_char('\n')
        payload = payload + ed.lines[i]
        i = i + 1
    if opb == 'y'                                // y — yank, cursor to lo
        return Step { ed: clamp(Editor { lines: ed.lines, cy: lo, cx: 0 }), st: InputState { count: 0, pending: 0, mode: 0, reg: payload, reg_lw: true, search: st.search, avy: st.avy, avx: st.avx } }
    // d / c — remove lines lo..hi; c leaves one blank line and enters Insert.
    var ls: [Str] = []
    let mut j = 0
    while j < total
        let keep = j < lo or j > hi
        if keep
            ls = list.append(ls, [ed.lines[j]])
        elif opb == 'c' and j == lo
            ls = list.append(ls, [""])            // c: the replacement blank line
        j = j + 1
    if list.len(ls) == 0
        ls = list.append(ls, [""])               // buffer always keeps one line
    var ncy = lo
    if ncy >= list.len(ls)
        ncy = list.len(ls) - 1
    let ins = opb == 'c'
    Step { ed: clamp_insert(Editor { lines: ls, cy: ncy, cx: 0 }), st: InputState { count: 0, pending: 0, mode: if ins then 1 else 0, reg: payload, reg_lw: true, search: st.search, avy: st.avy, avx: st.avx } }

@intent("""Apply operator `opb` (d/c/y) over a resolved motion target,
dispatching to the linewise path or the charwise path per the target's flags
and honouring inclusive/exclusive end handling.  A target with `ok == false` is
a no-op that just ends the command.""")
fn apply_motion_op(ed: Editor, st: InputState, opb: Int, tgt: MTarget) -> Step
    if not tgt.ok
        return Step { ed: ed, st: ist_done(st) }
    if tgt.linewise
        return apply_linewise_op(ed, st, opb, tgt.ty)
    let line = line_at(ed, ed.cy)
    let llen = str.len(line)
    var lo = if ed.cx < tgt.tx then ed.cx else tgt.tx
    var hi = if ed.cx < tgt.tx then tgt.tx else ed.cx
    if tgt.inclusive
        hi = hi + 1
    if hi > llen
        hi = llen
    if lo < 0
        lo = 0
    let removed = str.slice(line, lo, hi)
    if opb == 'y'                                // y — yank, cursor to span start
        return Step { ed: clamp(Editor { lines: ed.lines, cy: ed.cy, cx: lo }), st: ist_reg_cw(st, removed, false) }
    let newline = str.slice(line, 0, lo) + str.slice(line, hi, llen)
    let nls = set_line(ed.lines, ed.cy, newline)
    let ins = opb == 'c'                         // c enters Insert at the gap
    if ins
        return Step { ed: clamp_insert(Editor { lines: nls, cy: ed.cy, cx: lo }), st: ist_reg_cw(st, removed, true) }
    Step { ed: clamp(Editor { lines: nls, cy: ed.cy, cx: lo }), st: ist_reg_cw(st, removed, false) }

// Dispatch the second key of an operator (`pcode` is its pending code, `opb`
// its byte d/c/y).  Doubled operator → linewise; a count digit accumulates;
// `cw` is remapped to `ce` (vim); any other motion resolves + applies; an
// unknown key cancels the operator and is reprocessed fresh.
fn feed_operator(ed: Editor, st: InputState, opb: Int, pcode: Int, b: Int) -> Step
    if b == opb                                   // dd / cc / yy — linewise
        return apply_linewise_op(ed, st, opb, ed.cy + (if st.count > 1 then st.count - 1 else 0))
    if b >= '1' and b <= '9'                    // count digit after the operator
        return Step { ed: ed, st: InputState { count: st.count * 10 + (b - '0'), pending: pcode, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == '0' and st.count > 0                 // '0' continues a count
        return Step { ed: ed, st: InputState { count: st.count * 10, pending: pcode, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    // Multi-key motions: f/F/t/T await a target char, g awaits a second g.
    // Encode (operator, motion) in a paired pending code so the char/second-g
    // handler knows which operator to apply (df{c}, dt{c}, dgg, ...).
    let opidx = if opb == 'd' then 0 elif opb == 'c' then 1 else 2
    if b == 'f'                                  // f — pending 20/24/28
        return Step { ed: ed, st: InputState { count: st.count, pending: 20 + opidx * 4 + 0, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'F'                                  // F — pending 21/25/29
        return Step { ed: ed, st: InputState { count: st.count, pending: 20 + opidx * 4 + 1, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 't'                                  // t — pending 22/26/30
        return Step { ed: ed, st: InputState { count: st.count, pending: 20 + opidx * 4 + 2, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'T'                                  // T — pending 23/27/31
        return Step { ed: ed, st: InputState { count: st.count, pending: 20 + opidx * 4 + 3, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'g'                                  // g — await second g (dgg): pending 32/33/34
        return Step { ed: ed, st: InputState { count: st.count, pending: 32 + opidx, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'i'                                  // i — inner text object: pending 40/42/44
        return Step { ed: ed, st: InputState { count: st.count, pending: 40 + opidx * 2 + 0, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'a'                                  // a — around text object: pending 41/43/45
        return Step { ed: ed, st: InputState { count: st.count, pending: 40 + opidx * 2 + 1, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == '%'                                  // % — to the matching bracket (inclusive, may span lines)
        let m = match_pair(ed)
        if m.cy == ed.cy and m.cx == ed.cx
            return Step { ed: ed, st: ist_done(st) }   // no match — cancel
        let before = m.cy < ed.cy or (m.cy == ed.cy and m.cx < ed.cx)
        let vr = if before then VRange { sy: m.cy, sx: m.cx, ey: ed.cy, ex: ed.cx } else VRange { sy: ed.cy, sx: ed.cx, ey: m.cy, ex: m.cx }
        return apply_char_vr(ed, st, opb, vr)
    let mb = if opb == 'c' and b == 'w' then 'e' else b   // cw behaves like ce
    let tgt = motion_target(ed, mb, st.count)               // raw count (0 = none)
    if tgt.ok
        return apply_motion_op(ed, st, opb, tgt)
    feed(ed, ist_clear_pending(st), b)            // not a motion — cancel + reprocess

// ── Visual mode: v / V + motions + operators on a selection ──────

// Normalised selection bounds (start <= end) between the anchor (avy,avx) and
// the cursor.
struct VRange
    sy: Int
    sx: Int
    ey: Int
    ex: Int

fn visual_range(st: InputState, ed: Editor) -> VRange
    let a_first = st.avy < ed.cy or (st.avy == ed.cy and st.avx <= ed.cx)
    if a_first
        VRange { sy: st.avy, sx: st.avx, ey: ed.cy, ex: ed.cx }
    else
        VRange { sy: ed.cy, sx: ed.cx, ey: st.avy, ex: st.avx }

// Selected text for the register (charwise, inclusive of the end glyph).
fn vyank_char_text(ed: Editor, vr: VRange) -> Str
    if vr.sy == vr.ey
        let line = line_at(ed, vr.sy)
        let hi = if vr.ex + 1 > str.len(line) then str.len(line) else vr.ex + 1
        str.slice(line, vr.sx, hi)
    else
        let first = line_at(ed, vr.sy)
        var acc = str.slice(first, vr.sx, str.len(first))
        var i = vr.sy + 1
        while i < vr.ey
            acc = acc + str.from_char('\n') + line_at(ed, i)
            i = i + 1
        let last = line_at(ed, vr.ey)
        let hi = if vr.ex + 1 > str.len(last) then str.len(last) else vr.ex + 1
        acc + str.from_char('\n') + str.slice(last, 0, hi)

// Buffer after deleting a charwise selection (first/last partial line merged,
// middle lines removed).
fn vdelete_char_lines(ed: Editor, vr: VRange) -> [Str]
    if vr.sy == vr.ey
        let line = line_at(ed, vr.sy)
        let hi = if vr.ex + 1 > str.len(line) then str.len(line) else vr.ex + 1
        set_line(ed.lines, vr.sy, str.slice(line, 0, vr.sx) + str.slice(line, hi, str.len(line)))
    else
        let first = line_at(ed, vr.sy)
        let last = line_at(ed, vr.ey)
        let hi = if vr.ex + 1 > str.len(last) then str.len(last) else vr.ex + 1
        let merged = str.slice(first, 0, vr.sx) + str.slice(last, hi, str.len(last))
        let total = list.len(ed.lines)
        var ls: [Str] = []
        let mut i = 0
        while i < total
            if i < vr.sy
                ls = list.append(ls, [ed.lines[i]])
            elif i == vr.sy
                ls = list.append(ls, [merged])
            elif i > vr.ey
                ls = list.append(ls, [ed.lines[i]])
            i = i + 1
        ls

// Apply d / y / c (opb byte) over an arbitrary CHARWISE range `vr` (may span
// lines).  Single trailing return.
//
// `vr` is snapshotted into scalar Int locals BEFORE any call that allocates a
// heap string: passing a nested struct field (e.g. `to.vr` from a text object)
// into a helper that allocates can corrupt the still-live `vr` here under the
// LLVM backend — `vr.ex` was observed picking up a byte of freed string data
// (length-16+ lines only; the SSO→heap boundary).  Reading the four fields up
// front, then rebuilding a fresh VRange per callee, sidesteps it.  See
// bugs/codegen-llvm.
fn apply_char_vr(ed: Editor, st: InputState, opb: Int, vr: VRange) -> Step
    let vsy = vr.sy
    let vsx = vr.sx
    let vey = vr.ey
    let vex = vr.ex
    let txt = vyank_char_text(ed, VRange { sy: vsy, sx: vsx, ey: vey, ex: vex })
    let is_yank = opb == 'y'
    let ins = opb == 'c'
    let nls = if is_yank then ed.lines else vdelete_char_lines(ed, VRange { sy: vsy, sx: vsx, ey: vey, ex: vex })
    let ne = if ins then clamp_insert(Editor { lines: nls, cy: vsy, cx: vsx }) else clamp(Editor { lines: nls, cy: vsy, cx: vsx })
    Step { ed: ne, st: ist_reg_cw(st, txt, ins) }

fn visual_apply_char(ed: Editor, st: InputState, opb: Int) -> Step
    apply_char_vr(ed, st, opb, visual_range(st, ed))

// Apply d / y / c to a LINEWISE selection by delegating to apply_linewise_op
// over [sy, ey].
fn visual_apply_line(ed: Editor, st: InputState, opb: Int) -> Step
    let vr = visual_range(st, ed)
    apply_linewise_op(Editor { lines: ed.lines, cy: vr.sy, cx: 0 }, st, opb, vr.ey)

// ── Text objects: iw/aw, i"/a", i(/a(, i{/a{, i[/a[ ───────────
// A text object resolves to a charwise range (or ok=false when there's no
// object under the cursor).  Used by operators (diw, ci", yi(...) and visual
// (viw, vi"...).

struct TObj
    vr:       VRange
    ok:       Bool
    linewise: Bool        // paragraph objects (ip/ap) span whole lines

fn tobj(sy: Int, sx: Int, ey: Int, ex: Int) -> TObj
    TObj { vr: VRange { sy: sy, sx: sx, ey: ey, ex: ex }, ok: true, linewise: false }

fn tobj_none() -> TObj
    TObj { vr: VRange { sy: 0, sx: 0, ey: 0, ex: 0 }, ok: false, linewise: false }

// A linewise text object covering whole lines [lo, hi] (ip / ap).
fn tobj_lw(lo: Int, hi: Int) -> TObj
    TObj { vr: VRange { sy: lo, sx: 0, ey: hi, ex: 0 }, ok: true, linewise: true }

// Char class for word objects; `big` (WORD) folds punctuation into the word
// class so a WORD is any whitespace-delimited run.
fn wcls(c: Int, big: Bool) -> Int
    let k = char_class_of(c)
    if big and k == 2 then 1 else k

// iw / aw (and iW / aW when `big`) — the word/WORD (or whitespace run) under the
// cursor.  `around` adds trailing whitespace, or leading when there is none.
fn textobj_word(ed: Editor, around: Bool, big: Bool) -> TObj
    let line = line_at(ed, ed.cy)
    let n = str.len(line)
    if n == 0
        return tobj_none()
    let cx = if ed.cx >= n then n - 1 else ed.cx
    let cls = wcls(str.byte_at(line, cx) ?? ' ', big)
    var lo = cx
    while lo > 0 and wcls(str.byte_at(line, lo - 1) ?? ' ', big) == cls
        lo = lo - 1
    var hi = cx
    while hi + 1 < n and wcls(str.byte_at(line, hi + 1) ?? ' ', big) == cls
        hi = hi + 1
    if around
        var added = false
        while hi + 1 < n and wcls(str.byte_at(line, hi + 1) ?? ' ', big) == 0
            hi = hi + 1
            added = true
        if not added
            while lo > 0 and wcls(str.byte_at(line, lo - 1) ?? ' ', big) == 0
                lo = lo - 1
    tobj(ed.cy, lo, ed.cy, hi)

// i" / a" (and ' / `) — the first quote pair on the line at/after the cursor.
fn textobj_quote(ed: Editor, q: Int, around: Bool) -> TObj
    let line = line_at(ed, ed.cy)
    let n = str.len(line)
    var inq = false
    var qstart = 0 - 1
    var op = 0 - 1
    var cl = 0 - 1
    var i = 0
    while i < n and cl < 0
        if (str.byte_at(line, i) ?? 0) == q
            if not inq
                inq = true
                qstart = i
            else
                inq = false
                if i >= ed.cx
                    op = qstart
                    cl = i
        i = i + 1
    if cl < 0
        return tobj_none()
    if around
        tobj(ed.cy, op, ed.cy, cl)
    else
        tobj(ed.cy, op + 1, ed.cy, cl - 1)

// A buffer position with a found flag (bracket-pair search).
struct Pos
    y:  Int
    x:  Int
    ok: Bool

// Scan backward from (sy,sx) for the unmatched open bracket (the one enclosing
// the cursor), counting matched pairs.
fn match_open_back(ed: Editor, sy: Int, sx: Int, open_ch: Int, close_ch: Int) -> Pos
    var depth = 0
    var y = sy
    var x = sx
    while y >= 0
        while x >= 0
            let ch = str.byte_at(line_at(ed, y), x) ?? 0
            if ch == close_ch
                depth = depth + 1
            elif ch == open_ch
                if depth == 0
                    return Pos { y: y, x: x, ok: true }
                depth = depth - 1
            x = x - 1
        y = y - 1
        if y >= 0
            x = str.len(line_at(ed, y)) - 1
    Pos { y: 0, x: 0, ok: false }

// Scan forward from (sy,sx) for the close matching an already-open bracket.
fn match_close_fwd(ed: Editor, sy: Int, sx: Int, open_ch: Int, close_ch: Int) -> Pos
    var depth = 0
    var y = sy
    var x = sx
    let ny = list.len(ed.lines)
    while y < ny
        let line = line_at(ed, y)
        let n = str.len(line)
        while x < n
            let ch = str.byte_at(line, x) ?? 0
            if ch == open_ch
                depth = depth + 1
            elif ch == close_ch
                if depth == 0
                    return Pos { y: y, x: x, ok: true }
                depth = depth - 1
            x = x + 1
        y = y + 1
        x = 0
    Pos { y: 0, x: 0, ok: false }

// i( / a( etc. — the bracket pair enclosing the cursor, spanning lines.
fn textobj_bracket(ed: Editor, open_ch: Int, close_ch: Int, around: Bool) -> TObj
    let line = line_at(ed, ed.cy)
    let on_open = ed.cx < str.len(line) and (str.byte_at(line, ed.cx) ?? 0) == open_ch
    let op = if on_open then Pos { y: ed.cy, x: ed.cx, ok: true } else match_open_back(ed, ed.cy, ed.cx - 1, open_ch, close_ch)
    if not op.ok
        return tobj_none()
    let cl = match_close_fwd(ed, op.y, op.x + 1, open_ch, close_ch)
    if not cl.ok
        return tobj_none()
    if around
        tobj(op.y, op.x, cl.y, cl.x)
    else
        tobj(op.y, op.x + 1, cl.y, cl.x - 1)

// ip / ap — the paragraph under the cursor: a maximal run of non-blank lines
// (or of blank lines, when the cursor sits on one).  `around` also takes the
// trailing blank lines, or the leading ones when there is no trailing run.
fn textobj_paragraph(ed: Editor, around: Bool) -> TObj
    let n = list.len(ed.lines)
    let onblank = str.len(line_at(ed, ed.cy)) == 0
    var lo = ed.cy
    while lo > 0 and (str.len(line_at(ed, lo - 1)) == 0) == onblank
        lo = lo - 1
    var hi = ed.cy
    while hi + 1 < n and (str.len(line_at(ed, hi + 1)) == 0) == onblank
        hi = hi + 1
    if around
        var added = false
        while hi + 1 < n and (str.len(line_at(ed, hi + 1)) == 0) == (not onblank)
            hi = hi + 1
            added = true
        if not added
            while lo > 0 and (str.len(line_at(ed, lo - 1)) == 0) == (not onblank)
                lo = lo - 1
    tobj_lw(lo, hi)

// Resolve an object char (the byte after i / a) to a range.
fn text_object(ed: Editor, obj: Int, around: Bool) -> TObj
    if obj == 'p'                                          // p — paragraph (linewise)
        textobj_paragraph(ed, around)
    elif obj == 'w'                                        // w
        textobj_word(ed, around, false)
    elif obj == 'W'                                        // W — WORD (whitespace-delimited)
        textobj_word(ed, around, true)
    elif obj == '"' or obj == '\'' or obj == '`'          // " ' `
        textobj_quote(ed, obj, around)
    elif obj == '(' or obj == ')' or obj == 'b'          // ( ) b
        textobj_bracket(ed, '(', ')', around)
    elif obj == '{' or obj == '}' or obj == 'B'          // { } B
        textobj_bracket(ed, '{', '}', around)
    elif obj == '[' or obj == ']'                         // [ ]
        textobj_bracket(ed, '[', ']', around)
    else
        tobj_none()

// Apply an operator over a text object; no-op + reset if there's no object.
fn apply_text_object(ed: Editor, st: InputState, opb: Int, obj: Int, around: Bool) -> Step
    let to = text_object(ed, obj, around)
    if to.ok
        if to.linewise
            let lo = to.vr.sy
            let hi = to.vr.ey
            return apply_linewise_op(Editor { lines: ed.lines, cy: lo, cx: 0 }, st, opb, hi)
        return apply_char_vr(ed, st, opb, to.vr)
    Step { ed: ed, st: ist_done(st) }

fn visual_apply(ed: Editor, st: InputState, opb: Int) -> Step
    if st.mode == 3
        return visual_apply_line(ed, st, opb)
    visual_apply_char(ed, st, opb)

// `>` / `<` over the selected lines, then back to Normal on the first line.
fn visual_indent(ed: Editor, st: InputState, right: Bool) -> Step
    let vr = visual_range(st, ed)
    let total = list.len(ed.lines)
    var ls: [Str] = []
    let mut i = 0
    while i < total
        if i >= vr.sy and i <= vr.ey
            ls = list.append(ls, [if right then indent_one(ed.lines[i]) else dedent_one(ed.lines[i])])
        else
            ls = list.append(ls, [ed.lines[i]])
        i = i + 1
    let fnb = first_nonblank(if vr.sy < list.len(ls) then ls[vr.sy] else "")
    Step { ed: clamp(Editor { lines: ls, cy: vr.sy, cx: fnb }), st: ist_done(st) }

// Move the cursor for a (single-byte) motion in visual mode.
fn visual_motion(ed: Editor, b: Int, cnt: Int) -> Editor
    if b == 'h' or b == 'l' or b == 'j' or b == 'k'
        repeat_hjkl(ed, b, cnt)
    elif b == 'w'
        repeat_word(ed, 0, cnt)
    elif b == 'b'
        repeat_word(ed, 1, cnt)
    elif b == 'e'
        repeat_word(ed, 2, cnt)
    elif b == 'W'
        repeat_word(ed, 3, cnt)
    elif b == 'B'
        repeat_word(ed, 4, cnt)
    elif b == 'E'
        repeat_word(ed, 5, cnt)
    elif b == '0'
        clamp(Editor { lines: ed.lines, cy: ed.cy, cx: 0 })
    elif b == '$'
        let ll = str.len(line_at(ed, ed.cy))
        clamp(Editor { lines: ed.lines, cy: ed.cy, cx: if ll > 0 then ll - 1 else 0 })
    elif b == '^'
        clamp(Editor { lines: ed.lines, cy: ed.cy, cx: first_nonblank(line_at(ed, ed.cy)) })
    elif b == 'G'
        clamp(Editor { lines: ed.lines, cy: list.len(ed.lines) - 1, cx: ed.cx })
    elif b == '%'
        match_pair(ed)
    elif b == '}'
        clamp(Editor { lines: ed.lines, cy: para_fwd(ed, cnt), cx: 0 })
    elif b == '{'
        clamp(Editor { lines: ed.lines, cy: para_bwd(ed, cnt), cx: 0 })
    else
        ed

// State that stays in visual mode (preserve anchor + register, reset count).
fn ist_visual_keep(st: InputState, mode: Int) -> InputState
    InputState { count: 0, pending: 0, mode: mode, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx }

// Stay in visual mode but set a pending sub-state (await an f/F/t/T target
// char, or a second g) — preserves the count so `3fx` etc. work.
fn ist_visual_pending(st: InputState, pcode: Int) -> InputState
    InputState { count: st.count, pending: pcode, mode: st.mode, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx }

// Case map for a byte: kind 0 = toggle, 1 = lower, 2 = upper.
fn case_byte(b: Int, kind: Int) -> Int
    if kind == 0
        toggle_case_byte(b)
    elif kind == 1
        if b >= 'A' and b <= 'Z' then b + 32 else b
    else
        if b >= 'a' and b <= 'z' then b - 32 else b

// Apply a case map to byte range [lo, hi) of `line`.
fn case_line_range(line: Str, lo: Int, hi: Int, kind: Int) -> Str
    var out = ""
    let n = str.len(line)
    let mut i = 0
    while i < n
        let b = str.byte_at(line, i) ?? 0
        if i >= lo and i < hi
            out = out + str.from_char(case_byte(b, kind))
        else
            out = out + str.from_char(b)
        i = i + 1
    out

// `~` / `u` / `U` on the visual selection → back to Normal.
fn visual_case(ed: Editor, st: InputState, kind: Int) -> Step
    let vr = visual_range(st, ed)
    let total = list.len(ed.lines)
    var ls: [Str] = []
    let mut i = 0
    while i < total
        if i >= vr.sy and i <= vr.ey
            let line = ed.lines[i]
            let lo = if st.mode == 3 then 0 elif i == vr.sy then vr.sx else 0
            let hi = if st.mode == 3 then str.len(line) elif i == vr.ey then vr.ex + 1 else str.len(line)
            ls = list.append(ls, [case_line_range(line, lo, hi, kind)])
        else
            ls = list.append(ls, [ed.lines[i]])
        i = i + 1
    Step { ed: clamp(Editor { lines: ls, cy: vr.sy, cx: vr.sx }), st: ist_done(st) }

// ── Case operators gu / gU / g~ + motion ─────────────────────
// kind: 0 toggle, 1 lower, 2 upper.

// Apply a case map to whole lines [lo, hi].
fn case_line_span(ed: Editor, st: InputState, kind: Int, lo: Int, hi: Int) -> Step
    let total = list.len(ed.lines)
    var ls: [Str] = []
    let mut i = 0
    while i < total
        if i >= lo and i <= hi
            ls = list.append(ls, [case_line_range(ed.lines[i], 0, str.len(ed.lines[i]), kind)])
        else
            ls = list.append(ls, [ed.lines[i]])
        i = i + 1
    Step { ed: clamp(Editor { lines: ls, cy: if lo < 0 then 0 else lo, cx: 0 }), st: ist_done(st) }

// Apply a case map over a CHARWISE range `vr` (may span lines), like visual_case.
fn case_char_vr(ed: Editor, vr: VRange, kind: Int) -> [Str]
    let total = list.len(ed.lines)
    var ls: [Str] = []
    let mut i = 0
    while i < total
        if i >= vr.sy and i <= vr.ey
            let line = ed.lines[i]
            let lo = if i == vr.sy then vr.sx else 0
            let hi = if i == vr.ey then vr.ex + 1 else str.len(line)
            ls = list.append(ls, [case_line_range(line, lo, hi, kind)])
        else
            ls = list.append(ls, [ed.lines[i]])
        i = i + 1
    ls

// gu/gU/g~ over a text object (giw / gUi" / g~ip, ...).
fn apply_case_textobj(ed: Editor, st: InputState, kind: Int, obj: Int, around: Bool) -> Step
    let to = text_object(ed, obj, around)
    if not to.ok
        return Step { ed: ed, st: ist_done(st) }
    let vsy = to.vr.sy
    let vsx = to.vr.sx
    let vey = to.vr.ey
    let vex = to.vr.ex
    if to.linewise
        return case_line_span(ed, st, kind, vsy, vey)
    let ls = case_char_vr(ed, VRange { sy: vsy, sx: vsx, ey: vey, ex: vex }, kind)
    Step { ed: clamp(Editor { lines: ls, cy: vsy, cx: vsx }), st: ist_done(st) }

// The second part of a gu/gU/g~ command (pcode keeps the operator pending
// across a count).  Doubled (guu/gUU/g~~) → line; a charwise motion → that
// span; a linewise motion → those lines.
fn feed_case(ed: Editor, st: InputState, kind: Int, pcode: Int, b: Int) -> Step
    let trigger = if kind == 1 then 'u' elif kind == 2 then 'U' else '~'
    if b == trigger                              // guu / gUU / g~~ — line(s)
        let cnt = if st.count > 0 then st.count else 1
        return case_line_span(ed, st, kind, ed.cy, ed.cy + cnt - 1)
    if b >= '1' and b <= '9'
        return Step { ed: ed, st: InputState { count: st.count * 10 + (b - '0'), pending: pcode, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == '0' and st.count > 0
        return Step { ed: ed, st: InputState { count: st.count * 10, pending: pcode, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'i'                                 // i — inner text object (pending 53/55/57)
        return Step { ed: ed, st: InputState { count: st.count, pending: 53 + kind * 2 + 0, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'a'                                 // a — around text object (pending 54/56/58)
        return Step { ed: ed, st: InputState { count: st.count, pending: 53 + kind * 2 + 1, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    let tgt = motion_target(ed, b, st.count)
    if tgt.ok and tgt.linewise
        let lo = if ed.cy < tgt.ty then ed.cy else tgt.ty
        let hi = if ed.cy < tgt.ty then tgt.ty else ed.cy
        return case_line_span(ed, st, kind, lo, hi)
    if tgt.ok
        let lo = if ed.cx < tgt.tx then ed.cx else tgt.tx
        var hi = if ed.cx < tgt.tx then tgt.tx else ed.cx
        if tgt.inclusive
            hi = hi + 1
        return Step { ed: clamp(Editor { lines: set_line(ed.lines, ed.cy, case_line_range(line_at(ed, ed.cy), lo, hi, kind)), cy: ed.cy, cx: lo }), st: ist_done(st) }
    feed(ed, ist_clear_pending(st), b)           // invalid — cancel + reprocess

// `J` joins the selected lines → back to Normal.
fn visual_join(ed: Editor, st: InputState) -> Step
    let vr = visual_range(st, ed)
    let nlines = vr.ey - vr.sy + 1
    Step { ed: op_join_lines(Editor { lines: ed.lines, cy: vr.sy, cx: 0 }, nlines, true), st: ist_done(st) }

// `p` replaces the selection with the register's contents; the replaced text
// becomes the new register.  Delete then paste-before at the gap.
fn visual_paste(ed: Editor, st: InputState) -> Step
    let vr = visual_range(st, ed)
    let del = visual_apply(ed, st, 'd')               // del.st.reg = removed text
    let tmp = InputState { count: 0, pending: 0, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx }
    // For a charwise selection paste at the exact gap column (vr.sx, which
    // may be past end-of-line); paste-before clamps it to len → append.
    let ped = if st.mode == 2 then Editor { lines: del.ed.lines, cy: del.ed.cy, cx: vr.sx } else del.ed
    let pasted = paste(ped, tmp, false)
    Step { ed: pasted, st: del.st }

// `vi"` / `va(` … — set the selection to a text object, staying in visual.
fn visual_set_textobj(ed: Editor, st: InputState, obj: Int, around: Bool) -> Step
    let to = text_object(ed, obj, around)
    if to.ok
        if to.linewise                       // paragraph → switch to Visual-line
            let lo = to.vr.sy
            let hi = to.vr.ey
            return Step { ed: clamp(Editor { lines: ed.lines, cy: hi, cx: 0 }), st: InputState { count: 0, pending: 0, mode: 3, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: lo, avx: 0 } }
        return Step { ed: clamp(Editor { lines: ed.lines, cy: to.vr.ey, cx: to.vr.ex }), st: InputState { count: 0, pending: 0, mode: st.mode, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: to.vr.sy, avx: to.vr.sx } }
    Step { ed: ed, st: ist_visual_keep(st, st.mode) }

@intent("""Handle one byte in Visual mode (mode 2 = charwise, 3 = linewise):
motions extend the selection from its fixed anchor, operators (d/x/y/c/>/</~/u/U/J/p)
act on the selection and return to Normal, and text-object keys reshape the
selection.""")
fn feed_visual(ed: Editor, st: InputState, b: Int) -> Step
    let cntp = if st.count > 0 then st.count else 1
    // Pending multi-key motions (extend the selection, stay visual).
    if st.pending == '\b'                           // f<char>
        return Step { ed: move_find(ed, b, true, false, cntp), st: ist_visual_keep(st, st.mode) }
    if st.pending == '\t'                           // F<char>
        return Step { ed: move_find(ed, b, false, false, cntp), st: ist_visual_keep(st, st.mode) }
    if st.pending == '\n'                          // t<char>
        return Step { ed: move_find(ed, b, true, true, cntp), st: ist_visual_keep(st, st.mode) }
    if st.pending == 11                          // T<char>
        return Step { ed: move_find(ed, b, false, true, cntp), st: ist_visual_keep(st, st.mode) }
    if st.pending == 1                           // g<g> — gg (to line / count)
        if b == 'g'
            let tgt = if st.count > 0 then st.count - 1 else 0
            return Step { ed: clamp(Editor { lines: ed.lines, cy: tgt, cx: ed.cx }), st: ist_visual_keep(st, st.mode) }
        return Step { ed: ed, st: ist_visual_keep(st, st.mode) }   // not gg — drop
    if st.pending == 48                          // i<obj> — inner text object
        return visual_set_textobj(ed, st, b, false)
    if st.pending == 49                          // a<obj> — around text object
        return visual_set_textobj(ed, st, b, true)
    if b == '\e'                                   // Esc — leave visual
        return Step { ed: ed, st: ist_done(st) }
    if b == 'v'                                 // v
        if st.mode == 2
            return Step { ed: ed, st: ist_done(st) }
        return Step { ed: ed, st: ist_visual_keep(st, 2) }
    if b == 'V'                                 // V
        if st.mode == 3
            return Step { ed: ed, st: ist_done(st) }
        return Step { ed: ed, st: ist_visual_keep(st, 3) }
    if b == 'o'                                 // o — swap anchor and cursor
        return Step { ed: clamp(Editor { lines: ed.lines, cy: st.avy, cx: st.avx }), st: InputState { count: 0, pending: 0, mode: st.mode, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: ed.cy, avx: ed.cx } }
    if b >= '1' and b <= '9'                    // count digit
        return Step { ed: ed, st: InputState { count: st.count * 10 + (b - '0'), pending: 0, mode: st.mode, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == '0' and st.count > 0
        return Step { ed: ed, st: InputState { count: st.count * 10, pending: 0, mode: st.mode, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'd' or b == 'x'                     // d / x — delete selection
        return visual_apply(ed, st, 'd')
    if b == 'y'                                  // y — yank selection
        return visual_apply(ed, st, 'y')
    if b == 'c' or b == 's'                      // c / s — change selection
        return visual_apply(ed, st, 'c')
    if b == '>'                                  // > — indent selection
        return visual_indent(ed, st, true)
    if b == '<'                                  // < — dedent selection
        return visual_indent(ed, st, false)
    if b == '~'                                  // ~ — toggle case of selection
        return visual_case(ed, st, 0)
    if b == 'u'                                  // u — lowercase selection
        return visual_case(ed, st, 1)
    if b == 'U'                                  // U — uppercase selection
        return visual_case(ed, st, 2)
    if b == 'J'                                  // J — join the selected lines
        return visual_join(ed, st)
    if b == 'p'                                  // p — replace selection with register
        return visual_paste(ed, st)
    if b == 'o'                                  // o — swap the cursor and the anchor
        return Step { ed: clamp(Editor { lines: ed.lines, cy: st.avy, cx: st.avx }), st: InputState { count: 0, pending: 0, mode: st.mode, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: ed.cy, avx: ed.cx } }
    // Multi-key motion entry: await a target char (f/F/t/T) or a second g.
    if b == 'f'
        return Step { ed: ed, st: ist_visual_pending(st, 8) }
    if b == 'F'
        return Step { ed: ed, st: ist_visual_pending(st, 9) }
    if b == 't'
        return Step { ed: ed, st: ist_visual_pending(st, 10) }
    if b == 'T'
        return Step { ed: ed, st: ist_visual_pending(st, 11) }
    if b == 'g'
        return Step { ed: ed, st: ist_visual_pending(st, 1) }
    if b == 'i'                                 // i — await inner text-object char
        return Step { ed: ed, st: ist_visual_pending(st, 48) }
    if b == 'a'                                 // a — await around text-object char
        return Step { ed: ed, st: ist_visual_pending(st, 49) }
    // Single-byte motion: move the cursor, stay in visual mode (anchor fixed).
    Step { ed: visual_motion(ed, b, cntp), st: ist_visual_keep(st, st.mode) }

@intent("""Handle one byte in Insert mode: Esc returns to Normal (stepping the
cursor left, vim-style), Enter splits the line, Backspace deletes back, and
printables (plus tab) insert at the cursor.  Other control bytes are ignored.""")
fn feed_insert(ed: Editor, st: InputState, b: Int) -> Step
    if b == '\e'                         // Esc → Normal (cursor steps left, vim)
        let e = clamp(Editor { lines: ed.lines, cy: ed.cy, cx: ed.cx - 1 })
        return Step { ed: e, st: ist_done(st) }
    if b == '\r' or b == '\n'              // Enter → split line
        return Step { ed: insert_newline(ed), st: st }
    if b == '\x7f' or b == '\b'              // Backspace / DEL
        return Step { ed: backspace(ed), st: st }
    if b == '\t' or (b >= ' ' and b < '\x7f') // printable (+ tab) → insert
        return Step { ed: insert_char(ed, b), st: st }
    Step { ed: ed, st: st }            // ignore other control bytes

// Overtype the char at the cursor (Replace mode), advancing one column;
// appends when already at end-of-line.
fn overtype_char(ed: Editor, b: Int) -> Editor
    let line = line_at(ed, ed.cy)
    let n = str.len(line)
    let newline = if ed.cx < n then str.slice(line, 0, ed.cx) + str.from_char(b) + str.slice(line, ed.cx + 1, n) else line + str.from_char(b)
    clamp_insert(Editor { lines: set_line(ed.lines, ed.cy, newline), cy: ed.cy, cx: ed.cx + 1 })

@intent("""Handle one byte in Replace mode (`R`): printables overwrite the char
at the cursor instead of inserting.  Backspace just steps left (it does not
restore the overwritten character).""")
fn feed_replace(ed: Editor, st: InputState, b: Int) -> Step
    if b == '\e'                         // Esc → Normal (cursor steps left)
        return Step { ed: clamp(Editor { lines: ed.lines, cy: ed.cy, cx: ed.cx - 1 }), st: ist_done(st) }
    if b == '\r' or b == '\n'              // Enter → split line
        return Step { ed: insert_newline(ed), st: st }
    if b == '\x7f' or b == '\b'              // Backspace → step left
        return Step { ed: clamp_insert(Editor { lines: ed.lines, cy: ed.cy, cx: ed.cx - 1 }), st: st }
    if b == '\t' or (b >= ' ' and b < '\x7f') // printable → overwrite
        return Step { ed: overtype_char(ed, b), st: st }
    Step { ed: ed, st: st }

@intent("""The pure input core: fold one input byte into (editor, input-state).
Dispatches by mode — Insert/Visual/Replace delegate to their handlers; Normal
mode resolves counts (`5j`, `10G`), motions, operators, and pending multi-key
commands.  No I/O: the driver owns the buffer, registers, undo, and the screen;
`feed` only transforms editor + input state so it stays deterministic and
testable.""")
fn feed(ed: Editor, st: InputState, b: Int) -> Step
    // Insert mode owns every byte until Esc.
    if st.mode == 1
        return feed_insert(ed, st, b)
    // Visual mode: charwise (2) / linewise (3).
    if st.mode == 2 or st.mode == 3
        return feed_visual(ed, st, b)
    // Replace mode: overtype.
    if st.mode == 4
        return feed_replace(ed, st, b)
    // Operators awaiting a second key (pending: 1=g, 2=d, 3=y).
    if st.pending == 1
        if b == 'g'                   // `gg` — go to line (count or 1)
            let tgt = if st.count > 0 then st.count - 1 else 0
            return Step { ed: clamp(Editor { lines: ed.lines, cy: tgt, cx: ed.cx }), st: ist_done(st) }
        if b == 'u'                   // `gu` — lowercase operator
            return Step { ed: ed, st: InputState { count: st.count, pending: 51, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
        if b == 'U'                   // `gU` — uppercase operator
            return Step { ed: ed, st: InputState { count: st.count, pending: 52, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
        if b == '~'                   // `g~` — toggle-case operator
            return Step { ed: ed, st: InputState { count: st.count, pending: 50, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
        if b == 'J'                   // `gJ` — join line(s) without a space
            return Step { ed: op_join_lines(ed, if st.count > 0 then st.count else 1, false), st: ist_done(st) }
        return feed(ed, ist_clear_pending(st), b)     // not g-command — reprocess fresh
    if st.pending == 50                // g~<motion> — toggle case
        return feed_case(ed, st, 0, 50, b)
    if st.pending == 51                // gu<motion> — lowercase
        return feed_case(ed, st, 1, 51, b)
    if st.pending == 52                // gU<motion> — uppercase
        return feed_case(ed, st, 2, 52, b)
    if st.pending >= 53 and st.pending <= 58   // g~/gu/gU + text object; byte = object char
        let code = st.pending - 53
        let ckind = code / 2
        let around = (code - ckind * 2) == 1
        return apply_case_textobj(ed, st, ckind, b, around)
    if st.pending == 2                 // `d` — operator awaiting a motion (or dd)
        return feed_operator(ed, st, 'd', 2, b)
    if st.pending == 3                 // `y` — operator awaiting a motion (or yy)
        return feed_operator(ed, st, 'y', 3, b)
    if st.pending == 7                 // `c` — operator awaiting a motion (or cc)
        return feed_operator(ed, st, 'c', 7, b)
    if st.pending == 4                 // `r<c>` — next byte is the replacement
        if b == '\e'                     // Esc cancels the replace
            return Step { ed: ed, st: ist_done(st) }
        return Step { ed: op_replace_char(ed, b, if st.count > 0 then st.count else 1), st: ist_done(st) }
    if st.pending == 5                 // `>` — indent right (>> or >motion)
        return feed_indent(ed, st, true, b)
    if st.pending == 6                 // `<` — indent left (<< or <motion)
        return feed_indent(ed, st, false, b)
    // Find-char motions: pending 8=f 9=F 10=t 11=T await the target.
    if st.pending == '\b'                 // f<char>
        if b == '\e'
            return Step { ed: ed, st: ist_done(st) }
        return Step { ed: move_find(ed, b, true, false, if st.count > 0 then st.count else 1), st: ist_done(st) }
    if st.pending == '\t'                 // F<char>
        if b == '\e'
            return Step { ed: ed, st: ist_done(st) }
        return Step { ed: move_find(ed, b, false, false, if st.count > 0 then st.count else 1), st: ist_done(st) }
    if st.pending == '\n'                // t<char>
        if b == '\e'
            return Step { ed: ed, st: ist_done(st) }
        return Step { ed: move_find(ed, b, true, true, if st.count > 0 then st.count else 1), st: ist_done(st) }
    if st.pending == 11                // T<char>
        if b == '\e'
            return Step { ed: ed, st: ist_done(st) }
        return Step { ed: move_find(ed, b, false, true, if st.count > 0 then st.count else 1), st: ist_done(st) }
    // Operator + find-char: pending 20..31 encodes (operator,
    // find-type); the byte is the target char.  df{c} / dt{c} / dF{c} / dT{c}
    // for d / c / y.
    if st.pending >= 20 and st.pending <= 31
        if b == '\e'
            return Step { ed: ed, st: ist_done(st) }
        let code = st.pending - 20
        let opidx = code / 4
        let ftidx = code - opidx * 4
        let opb = if opidx == 0 then 'd' elif opidx == 1 then 'c' else 'y'
        let forward = ftidx == 0 or ftidx == 2
        let till = ftidx == 2 or ftidx == 3
        let tgt = find_target(ed, b, forward, till, if st.count > 0 then st.count else 1)
        return apply_motion_op(ed, st, opb, tgt)
    // Operator + gg: pending 32/33/34 = d/c/y awaiting the second g.
    if st.pending >= ' ' and st.pending <= 34
        if b == 'g'                   // second g — linewise [top, cursor]
            let opb = if st.pending == ' ' then 'd' elif st.pending == 33 then 'c' else 'y'
            return apply_linewise_op(ed, st, opb, if st.count > 0 then st.count - 1 else 0)
        return feed(ed, ist_clear_pending(st), b)   // not gg — cancel + reprocess
    // Operator + text object: pending 40..45 encodes (operator,
    // inner/around); the byte is the object char (w " ' ` ( ) b { } B [ ]).
    if st.pending >= 40 and st.pending <= 45
        let code = st.pending - 40
        let opidx = code / 2
        let around = (code - opidx * 2) == 1
        let opb = if opidx == 0 then 'd' elif opidx == 1 then 'c' else 'y'
        return apply_text_object(ed, st, opb, b, around)
    // Count digits.  `0` is a count digit only when a count is already
    // building; otherwise `0` is the "first column" motion.
    if b >= '1' and b <= '9'         // '1'-'9'
        return Step { ed: ed, st: InputState { count: st.count * 10 + (b - '0'), pending: 0, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == '0' and st.count > 0      // '0' continues a count
        return Step { ed: ed, st: InputState { count: st.count * 10, pending: 0, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    let cnt = if st.count > 0 then st.count else 1
    if b == 'h' or b == 'l' or b == 'j' or b == 'k'      // h l j k
        return Step { ed: repeat_hjkl(ed, b, cnt), st: ist_done(st) }
    if b == 'w'                       // 'w' — next word start
        return Step { ed: repeat_word(ed, 0, cnt), st: ist_done(st) }
    if b == 'b'                       // 'b' — previous word start
        return Step { ed: repeat_word(ed, 1, cnt), st: ist_done(st) }
    if b == 'e'                       // 'e' — next word end
        return Step { ed: repeat_word(ed, 2, cnt), st: ist_done(st) }
    if b == 'W'                       // 'W' — next WORD start (whitespace-delimited)
        return Step { ed: repeat_word(ed, 3, cnt), st: ist_done(st) }
    if b == 'B'                       // 'B' — previous WORD start
        return Step { ed: repeat_word(ed, 4, cnt), st: ist_done(st) }
    if b == 'E'                       // 'E' — next WORD end
        return Step { ed: repeat_word(ed, 5, cnt), st: ist_done(st) }
    if b == '0'                       // '0' — first column
        return Step { ed: clamp(Editor { lines: ed.lines, cy: ed.cy, cx: 0 }), st: ist_done(st) }
    if b == '$'                       // '$' — end of line
        let ll = str.len(line_at(ed, ed.cy))
        let ex = if ll > 0 then ll - 1 else 0
        return Step { ed: clamp(Editor { lines: ed.lines, cy: ed.cy, cx: ex }), st: ist_done(st) }
    if b == '^'                       // '^' — first non-blank
        return Step { ed: clamp(Editor { lines: ed.lines, cy: ed.cy, cx: first_nonblank(line_at(ed, ed.cy)) }), st: ist_done(st) }
    if b == '}'                       // '}' — next paragraph (blank line)
        return Step { ed: clamp(Editor { lines: ed.lines, cy: para_fwd(ed, cnt), cx: 0 }), st: ist_done(st) }
    if b == '{'                       // '{' — previous paragraph (blank line)
        return Step { ed: clamp(Editor { lines: ed.lines, cy: para_bwd(ed, cnt), cx: 0 }), st: ist_done(st) }
    if b == 'g'                       // 'g' — await second g
        return Step { ed: ed, st: InputState { count: st.count, pending: 1, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'd'                       // 'd' — await operator target (dd)
        return Step { ed: ed, st: InputState { count: st.count, pending: 2, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'y'                       // 'y' — await operator target (yy)
        return Step { ed: ed, st: InputState { count: st.count, pending: 3, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'p'                       // 'p' — paste after
        return Step { ed: paste(ed, st, true), st: ist_done(st) }
    if b == 'P'                       // 'P' — paste before
        return Step { ed: paste(ed, st, false), st: ist_done(st) }
    if b == 'n'                       // 'n' — repeat search forward
        return Step { ed: find_next(ed, st.search, true), st: ist_done(st) }
    if b == 'N'                       // 'N' — repeat search backward
        return Step { ed: find_next(ed, st.search, false), st: ist_done(st) }
    if b == '*' or b == '#'          // '*' / '#' — search the word under the cursor
        let w = word_under_cursor(ed)
        if str.len(w) == 0
            return Step { ed: ed, st: ist_done(st) }
        return Step { ed: find_next(ed, w, b == '*'), st: ist_set_search(st, w) }
    if b == 'G'                       // 'G' — go to line (count or last)
        let tgt = if st.count > 0 then st.count - 1 else list.len(ed.lines) - 1
        return Step { ed: clamp(Editor { lines: ed.lines, cy: tgt, cx: ed.cx }), st: ist_done(st) }
    if b == '%'                       // '%' — jump to the matching bracket
        return Step { ed: match_pair(ed), st: ist_done(st) }
    if b == 'R'                       // 'R' — enter Replace (overtype) mode
        return Step { ed: ed, st: InputState { count: 0, pending: 0, mode: 4, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    // Insert-mode entry.  Position the cursor (insert-clamped so
    // it may sit at end-of-line) and switch to Insert.
    if b == 'i'                       // 'i' — insert before cursor
        return Step { ed: ed, st: ist_insert(st) }
    if b == 'a'                       // 'a' — append after cursor
        return Step { ed: clamp_insert(Editor { lines: ed.lines, cy: ed.cy, cx: ed.cx + 1 }), st: ist_insert(st) }
    if b == 'I'                       // 'I' — insert at first non-blank
        return Step { ed: Editor { lines: ed.lines, cy: ed.cy, cx: first_nonblank(line_at(ed, ed.cy)) }, st: ist_insert(st) }
    if b == 'A'                       // 'A' — append at end of line
        return Step { ed: Editor { lines: ed.lines, cy: ed.cy, cx: str.len(line_at(ed, ed.cy)) }, st: ist_insert(st) }
    if b == 'o'                       // 'o' — open line below
        return Step { ed: open_line(ed, true), st: ist_insert(st) }
    if b == 'O'                       // 'O' — open line above
        return Step { ed: open_line(ed, false), st: ist_insert(st) }
    // Deletes.
    if b == 'x'                       // 'x' — delete char(s) under cursor (→ register)
        let xl = line_at(ed, ed.cy)
        let xhi = if ed.cx + cnt > str.len(xl) then str.len(xl) else ed.cx + cnt
        return Step { ed: repeat_delete_char(ed, cnt), st: ist_reg_cw(st, str.slice(xl, ed.cx, xhi), false) }
    if b == 'D'                       // 'D' — delete to end of line (→ register)
        let dl = line_at(ed, ed.cy)
        return Step { ed: delete_to_eol(ed), st: ist_reg_cw(st, str.slice(dl, ed.cx, str.len(dl)), false) }
    if b == 'X'                       // 'X' — delete char(s) before the cursor (→ register)
        let xline = line_at(ed, ed.cy)
        let lo = if ed.cx - cnt < 0 then 0 else ed.cx - cnt
        let nls = set_line(ed.lines, ed.cy, str.slice(xline, 0, lo) + str.slice(xline, ed.cx, str.len(xline)))
        return Step { ed: clamp(Editor { lines: nls, cy: ed.cy, cx: lo }), st: ist_reg_cw(st, str.slice(xline, lo, ed.cx), false) }
    if b == 'Y'                       // 'Y' — yank line(s) (= yy)
        return apply_linewise_op(ed, st, 'y', ed.cy + (if cnt > 1 then cnt - 1 else 0))
    if b == 'S'                       // 'S' — change whole line(s) (= cc)
        return apply_linewise_op(ed, st, 'c', ed.cy + (if cnt > 1 then cnt - 1 else 0))
    if b == '\x01'                       // Ctrl-A — increment the number
        return Step { ed: op_incdec(ed, cnt), st: ist_done(st) }
    if b == '\x18'                       // Ctrl-X — decrement the number
        return Step { ed: op_incdec(ed, 0 - cnt), st: ist_done(st) }
    // Visual mode entry: anchor the selection at the cursor.  A
    // count pre-extends the selection (`3v` = 3 chars, `2V` = 2 lines).
    if b == 'v'                       // 'v' — charwise visual
        let ne = clamp(Editor { lines: ed.lines, cy: ed.cy, cx: ed.cx + cnt - 1 })
        return Step { ed: ne, st: InputState { count: 0, pending: 0, mode: 2, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: ed.cy, avx: ed.cx } }
    if b == 'V'                       // 'V' — linewise visual
        let ne = clamp(Editor { lines: ed.lines, cy: ed.cy + cnt - 1, cx: ed.cx })
        return Step { ed: ne, st: InputState { count: 0, pending: 0, mode: 3, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: ed.cy, avx: ed.cx } }
    // Char-level edits.
    if b == '~'                       // '~' — toggle case (count chars), advance
        return Step { ed: op_toggle_case(ed, cnt), st: ist_done(st) }
    if b == 'J'                       // 'J' — join line(s) with a space
        return Step { ed: op_join_lines(ed, cnt, true), st: ist_done(st) }
    if b == 'r'                       // 'r' — await the replacement byte
        return Step { ed: ed, st: InputState { count: st.count, pending: 4, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == '>'                       // '>' — await second '>' (indent right)
        return Step { ed: ed, st: InputState { count: st.count, pending: 5, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == '<'                       // '<' — await second '<' (indent left)
        return Step { ed: ed, st: InputState { count: st.count, pending: 6, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    // Operator + motion: c awaits a motion (like d/y); f/F/t/T
    // await a target char.
    if b == 'c'                       // 'c' — change operator (awaits motion)
        return Step { ed: ed, st: InputState { count: st.count, pending: 7, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'f'                       // 'f' — find char forward
        return Step { ed: ed, st: InputState { count: st.count, pending: 8, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'F'                       // 'F' — find char backward
        return Step { ed: ed, st: InputState { count: st.count, pending: 9, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 't'                       // 't' — till char forward
        return Step { ed: ed, st: InputState { count: st.count, pending: 10, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'T'                       // 'T' — till char backward
        return Step { ed: ed, st: InputState { count: st.count, pending: 11, mode: 0, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: st.avy, avx: st.avx } }
    if b == 'C'                       // 'C' — change to end of line
        let cline = line_at(ed, ed.cy)
        let tail = str.slice(cline, ed.cx, str.len(cline))
        let nls = set_line(ed.lines, ed.cy, str.slice(cline, 0, ed.cx))
        return Step { ed: clamp_insert(Editor { lines: nls, cy: ed.cy, cx: ed.cx }), st: ist_reg_cw(st, tail, true) }
    if b == 's'                       // 's' — substitute char(s): delete then insert
        let sline = line_at(ed, ed.cy)
        let sl = str.len(sline)
        let shi = if ed.cx + cnt > sl then sl else ed.cx + cnt
        let sremoved = str.slice(sline, ed.cx, shi)
        let snls = set_line(ed.lines, ed.cy, str.slice(sline, 0, ed.cx) + str.slice(sline, shi, sl))
        return Step { ed: clamp_insert(Editor { lines: snls, cy: ed.cy, cx: ed.cx }), st: ist_reg_cw(st, sremoved, true) }
    Step { ed: ed, st: ist_done(st) }     // unknown — reset

// ── Ex command line (`:w :q :wq`) ───────────────────────────────

// Result of running an Ex command: the (possibly unchanged) editor plus
// quit / save signals the driver acts on (the driver owns the file path
// and the loop, so the [io] save stays out of the pure feed path).
struct ExResult
    quit: Bool
    save: Bool

@intent("""Parse the text after `:` into quit/save signals: `w` save, `q`/`q!`
quit, `wq`/`x` save+quit.  Returns an ExResult the driver acts on; commands it
doesn't recognise are ignored here (richer Ex commands are dispatched before
this fallback).""")
fn exec_ex(cmd: Str) -> ExResult
    let c = str.trim(cmd)
    if c == "w"
        ExResult { quit: false, save: true }
    elif c == "q" or c == "q!"
        ExResult { quit: true, save: false }
    elif c == "wq" or c == "x" or c == "wq!"
        ExResult { quit: true, save: true }
    else
        ExResult { quit: false, save: false }

// ── :s substitute ────────────────────────────────────────────
// Plain-substring substitute (novim has no regex yet): `:s/pat/repl/[g]` on
// the current line, `:%s/pat/repl/[g]` on every line.  `g` replaces every
// occurrence on a line; without it, just the first.

// Is `cmd` a substitute command (`s<delim>…` / `%s<delim>…`)?
// The current-line form of a substitute command (drop a leading `%`), for `&`.
fn subst_current_line(cmd: Str) -> Str
    let c = str.trim(cmd)
    if str.len(c) > 0 and (str.byte_at(c, 0) ?? 0) == '%'
        str.slice(c, 1, str.len(c))
    else
        c

fn is_substitute(cmd: Str) -> Bool
    let c = str.trim(cmd)
    let n = str.len(c)
    let p = if n > 0 and (str.byte_at(c, 0) ?? 0) == '%' then 1 else 0   // optional %
    if p < n and (str.byte_at(c, p) ?? 0) == 's' and p + 1 < n           // 's' + delimiter
        char_class_of(str.byte_at(c, p + 1) ?? 0) == 2                     // punctuation delim
    else
        false

// Replace `pat` with `repl` in `line` (first occurrence, or all if global).
fn replace_in_line(line: Str, pat: Str, repl: Str, global: Bool) -> Str
    if str.len(pat) == 0
        return line
    var out = ""
    var i = 0
    let n = str.len(line)
    let pl = str.len(pat)
    var did = false
    while i < n
        if (global or not did) and i + pl <= n and str.slice(line, i, i + pl) == pat
            out = out + repl
            i = i + pl
            did = true
        else
            out = out + str.from_char(str.byte_at(line, i) ?? 0)
            i = i + 1
    out

@intent("""Apply a `:s` / `:%s` substitution and return the new editor.  Honours
the leading `%` (whole buffer vs current line), any delimiter, and the `g`
(global-in-line) flag; the pattern is a vim-magic-subset regex and the
replacement supports `&` (whole match) and `\\1`-`\\9` backrefs.""")
fn ex_substitute(ed: Editor, cmd: Str) -> Editor
    let c = str.trim(cmd)
    let alllines = (str.byte_at(c, 0) ?? 0) == '%'
    let p = if alllines then 1 else 0
    let delim = str.byte_at(c, p + 1) ?? 0
    let body = str.slice(c, p + 2, str.len(c))                  // after "s<delim>"
    let d1 = util.index_of_byte(body, delim)
    let pat = if d1 < 0 then body else str.slice(body, 0, d1)
    let after1 = if d1 < 0 then "" else str.slice(body, d1 + 1, str.len(body))
    let d2 = util.index_of_byte(after1, delim)
    let repl = if d2 < 0 then after1 else str.slice(after1, 0, d2)
    let flags = if d2 < 0 then "" else str.slice(after1, d2 + 1, str.len(after1))
    let global = util.index_of_byte(flags, 'g') >= 0                // 'g'
    let atoms = nvregex.re_compile(pat)
    if alllines
        var ls: [Str] = []
        let total = list.len(ed.lines)
        let mut i = 0
        while i < total
            ls = list.append(ls, [nvregex.re_replace_line(atoms, ed.lines[i], repl, global)])
            i = i + 1
        clamp(Editor { lines: ls, cy: ed.cy, cx: 0 })
    else
        clamp(Editor { lines: set_line(ed.lines, ed.cy, nvregex.re_replace_line(atoms, line_at(ed, ed.cy), repl, global)), cy: ed.cy, cx: 0 })

// ── :g / :v global delete ────────────────────────────────────
// `:g/pat/d` deletes every line containing `pat`; `:v/pat/d` (or `:g!/pat/d`)
// deletes every line NOT containing it.  Only the `d` command is supported.

// ── :N goto-line ─────────────────────────────────────────────
// `:N` (a line number) or `:$` (last line) moves the cursor to that line's
// first non-blank.  Driver-level, like :s / :g.

fn is_goto(cmd: Str) -> Bool
    let c = str.trim(cmd)
    let n = str.len(c)
    if n == 0
        return false
    if c == "$"
        return true
    var i = 0
    while i < n
        let b = str.byte_at(c, i) ?? 0
        if b < '0' or b > '9'
            return false
        i = i + 1
    true

// `:fmt` / `:format` — reformat the buffer via the language server.
fn is_fmt(cmd: Str) -> Bool
    let c = str.trim(cmd)
    c == "fmt" or c == "format"

// `:sym <name>` — jump to a document symbol whose name contains <name>.
fn is_sym(cmd: Str) -> Bool
    let c = str.trim(cmd)
    c == "sym" or (str.len(c) > 4 and str.slice(c, 0, 4) == "sym ")

// The query fragment after `:sym` (trimmed; "" jumps to the first symbol).
fn sym_query(cmd: Str) -> Str
    let c = str.trim(cmd)
    if str.len(c) <= 4 then "" else str.trim(str.slice(c, 4, str.len(c)))

// `:e <file>` / `:edit <file>` (with optional `!` to discard unsaved changes).
fn is_edit_cmd(cmd: Str) -> Bool
    let c = str.trim(cmd)
    let h2 = if str.len(c) >= 2 then str.slice(c, 0, 2) else ""
    let h3 = if str.len(c) >= 3 then str.slice(c, 0, 3) else ""
    let h5 = if str.len(c) >= 5 then str.slice(c, 0, 5) else ""
    let h6 = if str.len(c) >= 6 then str.slice(c, 0, 6) else ""
    h2 == "e " or h3 == "e! " or h5 == "edit " or h6 == "edit! "

fn edit_cmd_bang(cmd: Str) -> Bool
    let c = str.trim(cmd)
    util.index_of_byte(c, '!') >= 0          // contains '!'

// The path after `:e`/`:edit` (and optional `!`), trimmed.
fn edit_cmd_path(cmd: Str) -> Str
    let c = str.trim(cmd)
    let sp = util.index_of_byte(c, ' ')      // first space
    if sp < 0 then "" else str.trim(str.slice(c, sp + 1, str.len(c)))

// Bare `:e`/`:e!`/`:edit`/`:edit!` (no filename) — reload the current file from
// disk (`!` discards unsaved changes).
fn is_reload(cmd: Str) -> Bool
    let c = str.trim(cmd)
    c == "e" or c == "e!" or c == "edit" or c == "edit!"

// `:split` / `:sp` / `:new` — open a horizontal (stacked) window split.
fn is_split(cmd: Str) -> Bool
    let c = str.trim(cmd)
    c == "split" or c == "sp" or c == "new"

// `:vsplit` / `:vs` / `:vnew` — open a vertical (side-by-side) window split.
fn is_vsplit(cmd: Str) -> Bool
    let c = str.trim(cmd)
    c == "vsplit" or c == "vs" or c == "vsp" or c == "vnew"

// `:only` / `:on` — close every window except the active one.
fn is_only(cmd: Str) -> Bool
    let c = str.trim(cmd)
    c == "only" or c == "on"

// `:close` / `:clo` / `:q` / `:quit` — close the current window.  Only treated
// as a window-close when more than one window is open; with a single window
// `:q` falls through to the normal quit-the-editor path.
fn is_winclose(cmd: Str) -> Bool
    let c = str.trim(cmd)
    c == "close" or c == "clo" or c == "q" or c == "quit"

// The argument after the first space of an Ex command, trimmed.
fn cmd_arg(cmd: Str) -> Str
    let c = str.trim(cmd)
    let sp = util.index_of_byte(c, ' ')
    if sp < 0 then "" else str.trim(str.slice(c, sp + 1, str.len(c)))

// `:bufdo <subcmd>` — run a substitution across every buffer (v1: `:s`/`:%s`).
fn is_bufdo(cmd: Str) -> Bool
    let c = str.trim(cmd)
    str.len(c) > 6 and str.slice(c, 0, 6) == "bufdo "

// `:badd <file>` — add a buffer without switching to it.
fn is_badd(cmd: Str) -> Bool
    let c = str.trim(cmd)
    str.len(c) > 5 and str.slice(c, 0, 5) == "badd "

// Argument-list navigation (the CLI file list).  0 = not an arglist command,
// 1 = :args (show), 2 = :next, 3 = :prev, 4 = :first, 5 = :last,
// 6 = :wnext (write+next), 7 = :wprev (write+prev).
fn argcmd_kind(cmd: Str) -> Int
    let c = str.trim(cmd)
    if c == "args" or c == "ar" then 1 elif c == "next" or c == "n" or c == "n!" or c == "next!" then 2 elif c == "prev" or c == "previous" or c == "N" or c == "Next" or c == "prev!" then 3 elif c == "first" or c == "rewind" or c == "fir" then 4 elif c == "last" or c == "la" then 5 elif c == "wn" or c == "wnext" then 6 elif c == "wN" or c == "wp" or c == "wprev" then 7 else 0

// Render the argument list with the current entry bracketed: `a [b] c`.
fn arglist_str(args: [Str], cur: Int) -> Str
    var s = ""
    var i = 0
    while i < list.len(args)
        if i > 0
            s = s + " "
        let nm = basename_of(args[i])
        s = if i == cur then s + "[" + nm + "]" else s + nm
        i = i + 1
    s

// Buffer-list commands: `:ls`/`:buffers`, `:bn`/`:bnext`, `:bp`/`:bprev`.
fn is_bufcmd(cmd: Str) -> Bool
    let c = str.trim(cmd)
    c == "ls" or c == "buffers" or c == "bn" or c == "bnext" or c == "bp" or c == "bprev" or c == "bprevious" or c == "bd" or c == "bdelete" or c == "bf" or c == "bfirst" or c == "bl" or c == "blast"

// `:wa`/`:wqa`/`:xa`/`:qa` family — commands that act on *all* buffers at once.
// 0 = not one, 1 = write all (`:wa`/`:wall`), 2 = write all + quit
// (`:wqa`/`:wqall`/`:xa`/`:xall`), 3 = quit all guarded (`:qa`/`:qall`),
// 4 = quit all forced (`:qa!`/`:qall!`).
fn writeall_kind(cmd: Str) -> Int
    let c = str.trim(cmd)
    if c == "wa" or c == "wall" then 1 elif c == "wqa" or c == "wqall" or c == "xa" or c == "xall" then 2 elif c == "qa" or c == "qall" then 3 elif c == "qa!" or c == "qall!" then 4 else 0

// 0 = :ls, 1 = :bn (next), 2 = :bp (prev), 3 = :bd (close), 4 = :bfirst, 5 = :blast.
fn bufcmd_kind(cmd: Str) -> Int
    let c = str.trim(cmd)
    if c == "bn" or c == "bnext" then 1 elif c == "bp" or c == "bprev" or c == "bprevious" then 2 elif c == "bd" or c == "bdelete" then 3 elif c == "bf" or c == "bfirst" then 4 elif c == "bl" or c == "blast" then 5 else 0

// `:b <n>` / `:buffer <n>` — switch to buffer number <n> (1-based); the
// space-free `:b#` / `:buffer#` (alternate buffer) form is accepted too.
fn is_bgoto(cmd: Str) -> Bool
    let c = str.trim(cmd)
    (str.len(c) > 2 and str.slice(c, 0, 2) == "b ") or (str.len(c) > 7 and str.slice(c, 0, 7) == "buffer ") or c == "b#" or c == "buffer#"

// The argument string after `:b`/`:buffer`, trimmed (`:b#` → "#").
fn bgoto_arg(cmd: Str) -> Str
    let c = str.trim(cmd)
    if c == "b#" or c == "buffer#"
        return "#"
    let sp = util.index_of_byte(c, ' ')
    if sp < 0 then "" else str.trim(str.slice(c, sp + 1, str.len(c)))

// The 1-based buffer number from `:b <n>`, or -1 if the arg isn't a number.
fn bgoto_target(cmd: Str) -> Int
    str.to_int(bgoto_arg(cmd)) ?? (0 - 1)

// True if any buffer has unsaved changes (active vs disk, or a stored buffer
// vs its saved text).  Used by the `:q` guard.
fn buffers_modified(bt: [Str], bd: [Str], cur: Int, atext: Str, adisk: Str) -> Bool
    if atext != adisk
        return true
    var i = 0
    while i < list.len(bt)
        if i != cur and bt[i] != bd[i]
            return true
        i = i + 1
    false

// Write every modified buffer to disk; returns the count written.  The active
// buffer's live copy is `ed` (vs `adisk`); stored buffers compare their joined
// text to their saved text.
fn write_all_bufs(paths: [Str], texts: [Str], disks: [Str], cur: Int, ed: Editor, adisk: Str) -> Int [io]
    var wrote = 0
    var i = 0
    let nb = list.len(paths)
    while i < nb
        if i == cur
            if buf_text(ed) != adisk
                save_buf(paths[i], ed.lines)
                wrote = wrote + 1
        else
            if texts[i] != disks[i]
                save_buf_text(paths[i], texts[i])
                wrote = wrote + 1
        i = i + 1
    wrote

// Apply a `:s`/`:%s` substitution to newline-joined buffer text (for `:bufdo`
// over a stored, non-active buffer).  Editor construction stays in this shallow
// helper to keep the struct-after-call shape out of the deep dispatch nesting.
fn sub_text(text: Str, sub: Str) -> Str
    let plines = str.split_lines(text)
    let bed = ex_substitute(Editor { lines: plines, cy: 0, cx: 0 }, sub)
    buf_text(bed)

// Append a whole-buffer undo record (pre-change text) to a serialized undo
// stack — lets `:bufdo` edits on stored buffers stay undoable after a switch.
fn undo_push_text(serial_undo: Str, pretext: Str) -> Str
    let plines = str.split_lines(pretext)
    serial_undo + snap_ser(Snapshot { lines: plines, cy: 0, cx: 0 })

// Mark every buffer clean (saved-text := current-text) after a write-all.
fn mark_all_saved(texts: [Str], disks: [Str]) -> [Str]
    var d = disks
    var i = 0
    while i < list.len(texts)
        d = util.set_str_at(d, i, texts[i])
        i = i + 1
    d

// Index of the first buffer whose basename or path contains `name`, or -1.
fn buf_find_by_name(paths: [Str], name: Str) -> Int
    var i = 0
    while i < list.len(paths)
        if util.index_of_str(basename_of(paths[i]), name) >= 0 or util.index_of_str(paths[i], name) >= 0
            return i
        i = i + 1
    0 - 1

// The basename (last path component) of `p`.
fn basename_of(p: Str) -> Str
    var last = 0
    var i = 0
    let n = str.len(p)
    while i < n
        if (str.byte_at(p, i) ?? 0) == '/'        // '/'
            last = i + 1
        i = i + 1
    str.slice(p, last, n)

// A one-line buffer list for `:ls`, marking the current with [..].
// Render the `:ls` buffer-list overlay over the top rows; the current buffer is
// marked with `>`.  Dismissed by the next keypress (the normal render repaints).
fn draw_buflist(paths: [Str], cur: Int, rows: Int) [io]
    var bi = 0
    let maxn = if rows - 2 > 0 then rows - 2 else 1
    while bi < list.len(paths) and bi < maxn
        cup(bi + 1, 1)
        csi()
        emit("K")
        let mark = if bi == cur then "> " else "  "
        emit(mark + str.from_int(bi + 1) + "  " + basename_of(paths[bi]))
        bi = bi + 1
    cup(bi + 1, 1)
    csi()
    emit("K")
    emit("-- :b <n> to switch · any key to dismiss --")

// `:rename <newname>` — rename the symbol under the cursor across the file.
fn is_rename(cmd: Str) -> Bool
    let c = str.trim(cmd)
    c == "rename" or (str.len(c) > 7 and str.slice(c, 0, 7) == "rename ")

fn rename_query(cmd: Str) -> Str
    let c = str.trim(cmd)
    if str.len(c) <= 7 then "" else str.trim(str.slice(c, 7, str.len(c)))

fn ex_goto(ed: Editor, cmd: Str) -> Editor
    let c = str.trim(cmd)
    let nl = list.len(ed.lines)
    var target = nl - 1
    if c != "$"
        var v = 0
        var i = 0
        let n = str.len(c)
        while i < n
            v = v * 10 + ((str.byte_at(c, i) ?? 0) - '0')
            i = i + 1
        target = v - 1                      // :N is 1-indexed
    if target < 0
        target = 0
    if target > nl - 1
        target = nl - 1
    clamp(Editor { lines: ed.lines, cy: target, cx: first_nonblank(line_at(ed, target)) })

fn is_global(cmd: Str) -> Bool
    let c = str.trim(cmd)
    let n = str.len(c)
    let c0 = if n > 0 then str.byte_at(c, 0) ?? 0 else 0
    if n >= 2 and (c0 == 'g' or c0 == 'v')                    // g or v
        let p = if c0 == 'g' and (str.byte_at(c, 1) ?? 0) == '!' then 2 else 1   // g!
        if p < n then char_class_of(str.byte_at(c, p) ?? 0) == 2 else false
    else
        false

@intent("""Apply a `:g/pat/d` family command: delete every line matching `pat`
(`:g!`/`:v` invert to delete non-matching lines).  The pattern is the same
vim-magic-subset regex used by search and `:s`.""")
fn ex_global(ed: Editor, cmd: Str) -> Editor
    let c = str.trim(cmd)
    let c0 = str.byte_at(c, 0) ?? 0
    let bang = c0 == 'g' and (str.byte_at(c, 1) ?? 0) == '!'
    let invert = c0 == 'v' or bang                            // v / g! → keep matching
    let p = if bang then 2 else 1
    let delim = str.byte_at(c, p) ?? 0
    let body = str.slice(c, p + 1, str.len(c))
    let d1 = util.index_of_byte(body, delim)
    let pat = if d1 < 0 then body else str.slice(body, 0, d1)
    let cmdpart = if d1 < 0 then "" else str.trim(str.slice(body, d1 + 1, str.len(body)))
    if cmdpart != "d" or str.len(pat) == 0
        return ed                                             // only :…/d supported
    let atoms = nvregex.re_compile(pat)
    var ls: [Str] = []
    let total = list.len(ed.lines)
    let mut i = 0
    while i < total
        let matches = nvregex.re_matches_line(atoms, ed.lines[i])
        let keep = if invert then matches else not matches
        if keep
            ls = list.append(ls, [ed.lines[i]])
        i = i + 1
    if list.len(ls) == 0
        ls = list.append(ls, [""])                            // buffer keeps one line
    var ncy = ed.cy
    if ncy >= list.len(ls)
        ncy = list.len(ls) - 1
    clamp(Editor { lines: ls, cy: ncy, cx: 0 })

// Serialise the line buffer to file text (one trailing newline per line).
fn buf_to_str(lines: [Str]) -> Str
    var s = ""
    let n = list.len(lines)
    let mut i = 0
    while i < n
        s = s + lines[i] + str.from_char('\n')
        i = i + 1
    s

fn save_buf(path: Str, lines: [Str]) [io]
    fs.write(path, buf_to_str(lines))

// Save a buffer held as newline-joined text (a stored, non-active buffer) —
// splits to lines so the on-disk form matches `:w` (one trailing newline/line).
fn save_buf_text(path: Str, text: Str) [io]
    save_buf(path, str.split_lines(text))

// ── Key-sequence decoding + keymaps ───────────────────

// Decode `\e`=Esc `\n`/`\r`=Enter `\t`=Tab `\b`=Backspace `\\`=backslash
// into their real bytes, returning a new string.  Used for both `--batch`
// key strings and `[keymaps]` right-hand sides.
// Hex digit value, or -1 if `b` isn't a hex digit.
fn hex_val(b: Int) -> Int
    if b >= '0' and b <= '9'
        b - '0'
    elif b >= 'a' and b <= 'f'
        b - 'a' + 10
    elif b >= 'A' and b <= 'F'
        b - 'A' + 10
    else
        0 - 1

fn decode_escapes(s: Str) -> Str
    var out = ""
    let n = str.len(s)
    let mut i = 0
    while i < n
        let b = str.byte_at(s, i) ?? 0
        if b == '\\' and i + 1 < n
            let nx = str.byte_at(s, i + 1) ?? 0
            if nx == 'e'
                out = out + str.from_char('\e')
                i = i + 2
            elif nx == 'n' or nx == 'r'
                out = out + str.from_char('\r')
                i = i + 2
            elif nx == 't'
                out = out + str.from_char('\t')
                i = i + 2
            elif nx == 'b'
                out = out + str.from_char('\x7f')
                i = i + 2
            elif nx == '\\'
                out = out + str.from_char(92)
                i = i + 2
            elif nx == 'x' and i + 3 < n and hex_val(str.byte_at(s, i + 2) ?? 0) >= 0 and hex_val(str.byte_at(s, i + 3) ?? 0) >= 0
                out = out + str.from_char(hex_val(str.byte_at(s, i + 2) ?? 0) * 16 + hex_val(str.byte_at(s, i + 3) ?? 0))
                i = i + 4
            else
                out = out + str.from_char(b)
                i = i + 1
        else
            out = out + str.from_char(b)
            i = i + 1
    out

// A user keymap: single Normal-mode key `lhs[i]` is replaced by the
// (already-decoded) key sequence `rhs[i]`.  Single-key LHS only; multi-key
// LHS like `jk` is not supported.
struct Keymap
    lhs: [Int]
    rhs: [Str]

fn keymap_empty() -> Keymap
    Keymap { lhs: [], rhs: [] }

// The remapped sequence for byte `b`, or "" if `b` isn't remapped.
fn keymap_lookup(km: Keymap, b: Int) -> Str
    let n = list.len(km.lhs)
    let mut i = 0
    while i < n
        if km.lhs[i] == b
            return km.rhs[i]
        i = i + 1
    ""

// Strip a single pair of surrounding double-quotes from `s`.
fn strip_quotes(s: Str) -> Str
    let n = str.len(s)
    if n >= 2 and (str.byte_at(s, 0) ?? 0) == '"' and (str.byte_at(s, n - 1) ?? 0) == '"'
        str.slice(s, 1, n - 1)
    else
        s

// Drop an inline `#` comment from a TOML value (a `#` outside double quotes
// starts a comment), so `number = true   # note` parses as `true`.
fn strip_inline_comment(s: Str) -> Str
    var i = 0
    let n = str.len(s)
    var inq = false
    while i < n
        let b = str.byte_at(s, i) ?? 0
        if b == '"'
            inq = not inq
        elif b == 35 and (not inq)
            return str.slice(s, 0, i)
        i = i + 1
    s

// Load `[keymaps]` from a config file: lines `lhs = "rhs"` (rhs may use
// `\e` etc.).  Comments (`#`) and blank lines are skipped; section headers
// (`[name]`) gate which section we're in.  Missing file → empty keymap.
fn load_keymaps(cfg_path: Str) -> Keymap [io]
    match fs.read(cfg_path)
        None => keymap_empty()
        Some(content) =>
            var lhs: [Int] = []
            var rhs: [Str] = []
            let lines = str.split_lines(content)
            var in_km = false
            let mut i = 0
            let n = list.len(lines)
            while i < n
                let raw = str.trim(lines[i])
                if str.len(raw) > 0 and (str.byte_at(raw, 0) ?? 0) != 35    // not a '#' comment
                    if (str.byte_at(raw, 0) ?? 0) == 91                     // '[' section
                        in_km = raw == "[keymaps]"
                    elif in_km
                        let eq = util.index_of_byte(raw, 61)                     // '='
                        if eq > 0
                            let lkey = strip_quotes(str.trim(str.slice(raw, 0, eq)))
                            let rseq = strip_quotes(str.trim(strip_inline_comment(str.slice(raw, eq + 1, str.len(raw)))))
                            if str.len(lkey) >= 1
                                lhs = list.append(lhs, [str.byte_at(lkey, 0) ?? 0])
                                rhs = list.append(rhs, [decode_escapes(rseq)])
                i = i + 1
            Keymap { lhs: lhs, rhs: rhs }

// ── Colorscheme ───────────────────────────────────────
// `[colorscheme]` sets 256-colour SGR indices for chrome elements; -1 =
// use the default.  v1 colours the status line (fg/bg) and the `~`
// end-of-buffer markers; syntax-token classes inherit this once
// highlighting lands (v2).

struct Colorscheme
    status_fg: Int
    status_bg: Int
    tilde_fg:  Int
    kw_fg:     Int      // syntax: keyword (-1 = built-in default)
    str_fg:    Int      // syntax: string
    cmt_fg:    Int      // syntax: comment
    num_fg:    Int      // syntax: number

fn colorscheme_default() -> Colorscheme
    Colorscheme { status_fg: 0 - 1, status_bg: 0 - 1, tilde_fg: 0 - 1, kw_fg: 0 - 1, str_fg: 0 - 1, cmt_fg: 0 - 1, num_fg: 0 - 1 }

// Resolve a colour index, falling back to `dflt` when unset (-1).
fn cs_or(v: Int, dflt: Int) -> Int
    if v >= 0 then v else dflt

fn parse_color_val(s: Str) -> Int
    match str.to_int(str.trim(strip_quotes(str.trim(s))))
        None => 0 - 1
        Some(v) => v

fn load_colorscheme(cfg_path: Str) -> Colorscheme [io]
    match fs.read(cfg_path)
        None => colorscheme_default()
        Some(content) =>
            var sfg = 0 - 1
            var sbg = 0 - 1
            var tfg = 0 - 1
            var kwf = 0 - 1
            var strf = 0 - 1
            var cmtf = 0 - 1
            var numf = 0 - 1
            let lines = str.split_lines(content)
            var in_cs = false
            let mut i = 0
            let n = list.len(lines)
            while i < n
                let raw = str.trim(lines[i])
                if str.len(raw) > 0 and (str.byte_at(raw, 0) ?? 0) != 35
                    if (str.byte_at(raw, 0) ?? 0) == 91
                        in_cs = raw == "[colorscheme]"
                    elif in_cs
                        let eq = util.index_of_byte(raw, 61)
                        if eq > 0
                            let key = str.trim(str.slice(raw, 0, eq))
                            let cv = parse_color_val(strip_inline_comment(str.slice(raw, eq + 1, str.len(raw))))
                            if key == "status_fg"
                                sfg = cv
                            elif key == "status_bg"
                                sbg = cv
                            elif key == "tilde_fg"
                                tfg = cv
                            elif key == "keyword"
                                kwf = cv
                            elif key == "string"
                                strf = cv
                            elif key == "comment"
                                cmtf = cv
                            elif key == "number"
                                numf = cv
                i = i + 1
            Colorscheme { status_fg: sfg, status_bg: sbg, tilde_fg: tfg, kw_fg: kwf, str_fg: strf, cmt_fg: cmtf, num_fg: numf }

// SGR parameter string for the status line: 256-colour fg/bg if set, else
// reverse-video (`7`).
fn status_sgr(cs: Colorscheme) -> Str
    var codes = ""
    if cs.status_fg >= 0
        codes = codes + "38;5;" + str.from_int(cs.status_fg)
    if cs.status_bg >= 0
        if str.len(codes) > 0
            codes = codes + ";"
        codes = codes + "48;5;" + str.from_int(cs.status_bg)
    if str.len(codes) == 0
        "7"
    else
        codes

// ── Options ──────────────────────────────────────────
// `[options]` toggles editor settings.  v1: `number` (a line-number
// gutter) and `tabstop` (loaded; tab expansion in render is a follow-on).

struct Options
    number:         Bool
    relativenumber: Bool
    hlsearch:       Bool
    wrap:           Bool
    syntax:         Bool
    tabstop:        Int

fn options_default() -> Options
    Options { number: false, relativenumber: false, hlsearch: true, wrap: false, syntax: true, tabstop: 8 }

fn parse_bool_val(s: Str) -> Bool
    str.trim(strip_quotes(str.trim(s))) == "true"

fn load_options(cfg_path: Str) -> Options [io]
    match fs.read(cfg_path)
        None => options_default()
        Some(content) =>
            var number = false
            var relativenumber = false
            var hlsearch = true
            var wrap = false
            var syntax = true
            var tabstop = 8
            let lines = str.split_lines(content)
            var in_opt = false
            let mut i = 0
            let n = list.len(lines)
            while i < n
                let raw = str.trim(lines[i])
                if str.len(raw) > 0 and (str.byte_at(raw, 0) ?? 0) != 35
                    if (str.byte_at(raw, 0) ?? 0) == 91
                        in_opt = raw == "[options]"
                    elif in_opt
                        let eq = util.index_of_byte(raw, 61)
                        if eq > 0
                            let key = str.trim(str.slice(raw, 0, eq))
                            let valr = strip_inline_comment(str.slice(raw, eq + 1, str.len(raw)))
                            if key == "number" or key == "nu"
                                number = parse_bool_val(valr)
                            elif key == "relativenumber" or key == "rnu"
                                relativenumber = parse_bool_val(valr)
                            elif key == "hlsearch" or key == "hls"
                                hlsearch = parse_bool_val(valr)
                            elif key == "wrap"
                                wrap = parse_bool_val(valr)
                            elif key == "syntax" or key == "syn"
                                syntax = parse_bool_val(valr)
                            elif key == "tabstop" or key == "ts"
                                let tv = parse_color_val(valr)
                                if tv > 0
                                    tabstop = tv
                i = i + 1
            Options { number: number, relativenumber: relativenumber, hlsearch: hlsearch, wrap: wrap, syntax: syntax, tabstop: tabstop }

// Right-align `n` in a `width`-char field (space-padded).
fn pad_num(n: Int, width: Int) -> Str
    var s = str.from_int(n)
    while str.len(s) < width
        s = " " + s
    s

// Left-justify a number in `width` columns (pad spaces on the right).  Used
// for the active line number in hybrid number+relativenumber mode, where
// neovim pins the cursor line's absolute number flush-left — most-significant
// digit fixed at the gutter's left edge, extending rightward.
fn pad_num_l(n: Int, width: Int) -> Str
    var s = str.from_int(n)
    while str.len(s) < width
        s = s + " "
    s

// Decimal digit count of a non-negative Int (min 1).
fn num_digits(n: Int) -> Int
    var v = if n < 0 then 0 - n else n
    var d = 1
    while v >= 10
        v = v / 10
        d = d + 1
    d

// A run of `n` spaces.
fn nspaces(n: Int) -> Str
    var s = ""
    var i = 0
    while i < n
        s = s + " "
        i = i + 1
    s

// ── `:set` (runtime options) ────────────────────────────────────────────
// `:set number`, `:set nonumber`, `:set rnu!`, `:set tabstop=4`, and several
// space-separated at once.  Booleans: `<opt>` on, `no<opt>` off, `<opt>!`
// toggle.  Aliases: nu rnu hls ts.

fn is_set(cmd: Str) -> Bool
    let c = str.trim(cmd)
    c == "set" or (str.len(c) >= 4 and str.slice(c, 0, 4) == "set ")

// Apply one `:set` token to the options.
fn apply_set_token(o: Options, tok: Str) -> Options
    let t = str.trim(tok)
    if str.len(t) == 0
        return o
    let eq = util.index_of_byte(t, '=')
    if eq > 0                                       // name=value (tabstop=4)
        let nm = str.trim(str.slice(t, 0, eq))
        let v = parse_color_val(str.slice(t, eq + 1, str.len(t)))
        if (nm == "tabstop" or nm == "ts") and v > 0
            return Options { number: o.number, relativenumber: o.relativenumber, hlsearch: o.hlsearch, wrap: o.wrap, syntax: o.syntax, tabstop: v }
        return o
    let n = str.len(t)
    let bang = (str.byte_at(t, n - 1) ?? 0) == '!'          // trailing !
    let body = if bang then str.slice(t, 0, n - 1) else t
    let neg = str.len(body) >= 2 and str.slice(body, 0, 2) == "no"
    let name = if neg then str.slice(body, 2, str.len(body)) else body
    if name == "number" or name == "nu"
        return Options { number: if bang then (not o.number) elif neg then false else true, relativenumber: o.relativenumber, hlsearch: o.hlsearch, wrap: o.wrap, syntax: o.syntax, tabstop: o.tabstop }
    elif name == "relativenumber" or name == "rnu"
        return Options { number: o.number, relativenumber: if bang then (not o.relativenumber) elif neg then false else true, hlsearch: o.hlsearch, wrap: o.wrap, syntax: o.syntax, tabstop: o.tabstop }
    elif name == "hlsearch" or name == "hls"
        return Options { number: o.number, relativenumber: o.relativenumber, hlsearch: if bang then (not o.hlsearch) elif neg then false else true, wrap: o.wrap, syntax: o.syntax, tabstop: o.tabstop }
    elif name == "wrap"
        return Options { number: o.number, relativenumber: o.relativenumber, hlsearch: o.hlsearch, wrap: if bang then (not o.wrap) elif neg then false else true, syntax: o.syntax, tabstop: o.tabstop }
    elif name == "syntax" or name == "syn"
        return Options { number: o.number, relativenumber: o.relativenumber, hlsearch: o.hlsearch, wrap: o.wrap, syntax: if bang then (not o.syntax) elif neg then false else true, tabstop: o.tabstop }
    else
        o

// Apply a `:set a b c` command (space-separated tokens) to the options.
fn apply_set(o: Options, cmd: Str) -> Options
    let c = str.trim(cmd)
    if str.len(c) <= 3
        return o
    let args = str.slice(c, 4, str.len(c))
    var result = o
    var tok = ""
    var i = 0
    let m = str.len(args)
    while i < m
        let b = str.byte_at(args, i) ?? 0
        if b == ' '
            if str.len(tok) > 0
                result = apply_set_token(result, tok)
                tok = ""
        else
            tok = tok + str.from_char(b)
        i = i + 1
    if str.len(tok) > 0
        result = apply_set_token(result, tok)
    result

// ── Search (/pattern, n / N) ─────────────────────────

// First occurrence of `needle` in `hay` at or after column `from`; -1 if
// none.  Plain substring (no regex in v1).
fn find_in_line(hay: Str, needle: Str, from: Int) -> Int
    let hl = str.len(hay)
    let nl = str.len(needle)
    if nl == 0
        return 0 - 1
    var i = if from < 0 then 0 else from
    while i + nl <= hl
        if str.slice(hay, i, i + nl) == needle
            return i
        i = i + 1
    0 - 1

// Last occurrence of `needle` in `hay` strictly before column `before`
// (before < 0 → search the whole line); -1 if none.
fn find_last_in_line(hay: Str, needle: Str, before: Int) -> Int
    let hl = str.len(hay)
    let nl = str.len(needle)
    if nl == 0
        return 0 - 1
    let cap = if before < 0 then hl else before
    var found = 0 - 1
    var i = 0
    while i + nl <= hl and i < cap
        if str.slice(hay, i, i + nl) == needle
            found = i
        i = i + 1
    found

// Move the cursor to the next (`forward`) / previous occurrence of
// `pattern`, wrapping around the buffer.  Unchanged if no match anywhere.
fn find_next(ed: Editor, pattern: Str, forward: Bool) -> Editor
    if str.len(pattern) == 0
        return ed
    let atoms = nvregex.re_compile(pattern)
    let total = list.len(ed.lines)
    if forward
        var y = ed.cy
        var startcol = ed.cx + 1
        var steps = 0
        while steps <= total
            let col = nvregex.re_find_in_line(atoms, line_at(ed, y), startcol)
            if col >= 0
                return Editor { lines: ed.lines, cy: y, cx: col }
            y = (y + 1) % total
            startcol = 0
            steps = steps + 1
        ed
    else
        var y = ed.cy
        var before = ed.cx
        var steps = 0
        while steps <= total
            let col = nvregex.re_find_last_in_line(atoms, line_at(ed, y), before)
            if col >= 0
                return Editor { lines: ed.lines, cy: y, cx: col }
            y = y - 1
            if y < 0
                y = total - 1
            before = 0 - 1
            steps = steps + 1
        ed

// ── Batch (headless test) mode ──────────────────────────────────

// `novim --batch "<keys>" <file>`: load, feed each key byte through the
// same handler the interactive loop uses, then print the final buffer
// followed by `cursor=<line>:<col>` and exit.  Fully deterministic.
// Decodes `\e`=Esc, `\n`/`\r`=Enter, `\t`=Tab, `\b`=Backspace,
// `\\`=backslash so test sequences embed control keys in ASCII
// (e.g. `iHello\e`, `:w\n`).  `:` opens the Ex command line.
@intent("""Feed one already-decoded byte through `feed`, first expanding any
Normal-mode keymap remap of `b` into its byte sequence (replayed through `feed`
so remapped sequences behave exactly like typed ones).""")
fn feed_mapped(ed: Editor, st: InputState, km: Keymap, b: Int) -> Step
    let seq = if st.mode == 0 then keymap_lookup(km, b) else ""
    if str.len(seq) == 0
        return feed(ed, st, b)
    var e = ed
    var s = st
    let mut j = 0
    let m = str.len(seq)
    while j < m
        let step = feed(e, s, str.byte_at(seq, j) ?? 0)
        e = step.ed
        s = step.st
        j = j + 1
    Step { ed: e, st: s }

// ── `.` repeat ──────────────────────────────────────────────────────────
// Repeat the last buffer-changing command.  Kept in the DRIVER (not the pure
// feed) by recording the raw byte sequence of each change command and
// replaying it on `.`.  The recorded bytes re-run through the same feed_mapped
// (keymaps included), so insert-mode text, counts, and operator+motion all
// repeat faithfully.

// Perf: str.join is one O(n) pass.  `acc = acc + line` would be O(n²), and
// since this runs several times per keystroke (undo + dot change-detection) it
// made insert mode crawl on large files.
@intent("Serialize the buffer's lines to a single newline-joined string.")
fn buf_text(ed: Editor) -> Str
    str.join(str.from_char('\n'), ed.lines)

// Counts are included (a leading digit may precede an edit, e.g. `3x`).  Yank
// (`y`) is excluded: it changes no buffer text, so `.` never repeats it.
// `g`/`v`/`V` may start a command that doesn't change the buffer (gg, vy, v
// cancel) — change detection below only records an undo when buf_text actually
// changed, so those no-op cases push nothing.
@intent("True if byte `b` can begin a buffer-changing command — lets navigation keystrokes skip the per-keystroke snapshot/compare.")
fn is_edit_start(b: Int) -> Bool
    if b >= '0' and b <= '9'                               // count digit (may precede an edit)
        return true
    // i a I A · o O · x X D · J ~ r · s S c C · p P · d > < · R · ^A ^X · g · v V
    let edits = ['i', 'a', 'I', 'A', 'o', 'O', 'x', 'X', 'D', 'J', '~', 'r', 's', 'S', 'c', 'C', 'p', 'P', 'd', '>', '<', 'R', '\x01', '\x18', 'g', 'v', 'V']
    var found = false
    let mut i = 0
    let n = list.len(edits)
    while i < n
        if edits[i] == b
            found = true
        i = i + 1
    found

// The per-session dot state: `last` = the recorded change to repeat; `cur` =
// bytes of the in-progress command; `snap` = buffer text when it began;
// `active` = whether a command is being recorded right now.
// Replay a recorded byte sequence through feed_mapped.
fn replay_seq(ed: Editor, st: InputState, km: Keymap, seq: Str) -> Step
    var e = ed
    var s = st
    let m = str.len(seq)
    let mut j = 0
    while j < m
        let step = feed_mapped(e, s, km, str.byte_at(seq, j) ?? 0)
        e = step.ed
        s = step.st
        j = j + 1
    Step { ed: e, st: s }

// ── `.` repeat + undo/redo ──────────────────────────────────────────────
// Both are DRIVER-level session state so `feed` stays pure.  `EditState`
// carries the dot-repeat recording (`last`/`cur`/`snaptxt`/`active`) plus an
// undo/redo stack of buffer snapshots.  This is sound because novim never
// mutates a line vector in place — every edit rebuilds it via list.append —
// so a Snapshot that holds the old `[Str]` reference stays valid forever.

// A point-in-time buffer + cursor, pushed onto the undo/redo stacks.
struct Snapshot
    lines: [Str]
    cy:    Int
    cx:    Int

struct EditState
    last:     Str          // dot: last change command's bytes
    cur:      Str          // dot: in-progress command bytes
    snaptxt:  Str          // dot: buf_text at command start (change detection)
    active:   Bool         // a command is being recorded
    snaped:   Snapshot     // undo: editor at command start
    undos:    [Snapshot]   // undo stack (last = most recent pre-change state)
    redos:    [Snapshot]   // redo stack
    regs:     [Str]        // named registers a-z: contents
    reglw:    [Bool]       // named registers a-z: linewise flag
    rreg:     Int          // register selected for the current command (0 = none, 1-26 = a-z)
    awaitreg: Bool         // true after `"`, awaiting the register letter
    marky:    [Int]        // marks a-z: line (-1 = unset)
    markx:    [Int]        // marks a-z: column
    awaitmark: Int         // 0 none, 1 set (m), 2 jump-exact (`), 3 jump-line (')
    recording: Int         // macros: register being recorded into (0 none, 1-26)
    macrobuf:  Str         // keystrokes recorded so far
    awaitmac:  Int         // 0 none, 1 await q-register, 2 await @-register
    lastmacro: Int         // last replayed macro register (for @@), 0 none
    lvy:       Int         // gv: last visual selection — anchor line
    lvx:       Int         // gv: anchor column
    lvey:      Int         // gv: cursor-end line
    lvex:      Int         // gv: cursor-end column
    lvmode:    Int         // gv: 0 none, 2 charwise, 3 linewise
    findc:     Int         // ; / , : last f/F/t/T target char (0 = none yet)
    findt:     Int         // ; / , : last find type (8 f, 9 F, 10 t, 11 T)
    giy:       Int         // gi: last insert-leave position — line (-1 = none)
    gix:       Int         // gi: last insert-leave column

struct EditStep
    ed: Editor
    st: InputState
    es: EditState

fn lines_empty() -> [Str]
    var x: [Str] = []
    x

fn snaps_empty() -> [Snapshot]
    var x: [Snapshot] = []
    x

fn snap_empty() -> Snapshot
    Snapshot { lines: lines_empty(), cy: 0, cx: 0 }

fn snap_of(ed: Editor) -> Snapshot
    Snapshot { lines: ed.lines, cy: ed.cy, cx: ed.cx }

// ── per-buffer undo: serialize a snapshot stack to a flat Str ────────────
// Buffers keep their own undo/redo history across `:bn`/`:e`/etc.  Each
// buffer's stacks are stashed as serialized strings in parallel `[Str]` arrays,
// the same flat storage shape `bufs_text` uses — a deliberately simple,
// uniform representation rather than threading `[[Snapshot]]` through the driver.

// Serialize one snapshot as "cy,cx,LEN:TEXT" (TEXT = lines joined by \n; the
// LEN prefix makes each record self-delimiting whatever TEXT contains).
fn snap_ser(s: Snapshot) -> Str
    let text = str.join(str.from_char('\n'), s.lines)
    str.from_int(s.cy) + "," + str.from_int(s.cx) + "," + str.from_int(str.len(text)) + ":" + text

// Serialize a snapshot stack as the concatenation of its records.
fn snaps_ser(ss: [Snapshot]) -> Str
    var out = ""
    var i = 0
    while i < list.len(ss)
        out = out + snap_ser(ss[i])
        i = i + 1
    out

// Parse a snapshot stack back from snaps_ser's output.
fn snaps_de(s: Str) -> [Snapshot]
    var out = snaps_empty()
    let n = str.len(s)
    var p = 0
    while p < n
        let c1 = util.index_of_byte_from(s, ',', p)         // ','
        let c2 = util.index_of_byte_from(s, ',', c1 + 1)    // ','
        let c3 = util.index_of_byte_from(s, ':', c2 + 1)    // ':'
        if c1 < 0 or c2 < 0 or c3 < 0
            return out
        let cy = str.to_int(str.slice(s, p, c1)) ?? 0
        let cx = str.to_int(str.slice(s, c1 + 1, c2)) ?? 0
        let ln = str.to_int(str.slice(s, c2 + 1, c3)) ?? 0
        let tstart = c3 + 1
        let text = str.slice(s, tstart, tstart + ln)
        let lns = str.split_lines(text)
        let lines = if list.len(lns) == 0 then [""] else lns
        out = list.append(out, [Snapshot { lines: lines, cy: cy, cx: cx }])
        p = tstart + ln
    out

// Serialize an Int list as comma-joined decimals (per-buffer marks storage).
fn ints_ser(xs: [Int]) -> Str
    var out = ""
    var i = 0
    while i < list.len(xs)
        if i > 0
            out = out + ","
        out = out + str.from_int(xs[i])
        i = i + 1
    out

// Parse a comma-joined Int list back into the 26 mark slots (-1 = unset; an
// empty string — a buffer with no marks set yet — yields a fresh slot array).
fn marks_de(s: Str) -> [Int]
    if str.len(s) == 0
        return marks_empty()
    var out: [Int] = []
    let n = str.len(s)
    var p = 0
    while p <= n
        let c = util.index_of_byte_from(s, ',', p)
        let endp = if c < 0 then n else c
        let v = str.to_int(str.slice(s, p, endp)) ?? (0 - 1)
        out = list.append(out, [v])
        p = if c < 0 then n + 1 else c + 1
    while list.len(out) < 26
        out = list.append(out, [0 - 1])
    out

// Parse a comma-joined Int list of variable length (no padding) — used for the
// per-buffer diagnostic line/severity store.
fn ints_de_csv(s: Str) -> [Int]
    var out: [Int] = []
    if str.len(s) == 0
        return out
    let n = str.len(s)
    var p = 0
    while p <= n
        let c = util.index_of_byte_from(s, ',', p)
        let endp = if c < 0 then n else c
        let v = str.to_int(str.slice(s, p, endp)) ?? 0
        out = list.append(out, [v])
        p = if c < 0 then n + 1 else c + 1
    out

// Split `s` on byte '\x01' into fields (the per-buffer diagnostic message store).
fn str_split_b1(s: Str) -> [Str]
    var out: [Str] = []
    let n = str.len(s)
    var start = 0
    var i = 0
    while i < n
        if (str.byte_at(s, i) ?? 0) == 1
            out = list.append(out, [str.slice(s, start, i)])
            start = i + 1
        i = i + 1
    out = list.append(out, [str.slice(s, start, n)])
    out

// Serialize a buffer's diagnostics: the flat line/sev ints (comma-joined), a
// NUL separator, then the messages joined by '\x01'.  Per-buffer diagnostics let
// every open document keep its own diagnostics live across switches.
fn diag_ser(li: [Int], msgs: [Str]) -> Str
    ints_ser(li) + str.from_char(0) + str.join(str.from_char(1), msgs)

fn diag_de_li(s: Str) -> [Int]
    let z = util.index_of_byte(s, 0)
    let head = if z < 0 then s else str.slice(s, 0, z)
    ints_de_csv(head)

fn diag_de_msgs(s: Str) -> [Str]
    let z = util.index_of_byte(s, 0)
    if z < 0
        var e: [Str] = []
        return e
    let tail = str.slice(s, z + 1, str.len(s))
    if str.len(tail) == 0
        var e2: [Str] = []
        return e2
    str_split_b1(tail)

// 37 register slots: 0-25 = named a-z, 26-35 = numbered "0-"9 ("0 yank, "1-"9
// delete ring), 36 = "- (small charwise-delete register).
fn regs_empty() -> [Str]
    var x: [Str] = []
    let mut i = 0
    while i < 37
        x = list.append(x, [""])
        i = i + 1
    x

fn reglw_empty() -> [Bool]
    var x: [Bool] = []
    let mut i = 0
    while i < 37
        x = list.append(x, [false])
        i = i + 1
    x

// Index of `p` in a list of buffer paths, or -1.
fn buf_index_of(paths: [Str], p: Str) -> Int
    var i = 0
    while i < list.len(paths)
        if paths[i] == p
            return i
        i = i + 1
    0 - 1

// Load a file from disk as one newline-joined string (a buffer's stored text).
fn file_to_text(path: Str) -> Str [io]
    str.join(str.from_char('\n'), buf_load(path))

// 26 unset marks (a-z), value -1.
fn marks_empty() -> [Int]
    var x: [Int] = []
    let mut i = 0
    while i < 26
        x = list.append(x, [0 - 1])
        i = i + 1
    x

fn edit_new() -> EditState
    EditState { last: "", cur: "", snaptxt: "", active: false, snaped: snap_empty(), undos: snaps_empty(), redos: snaps_empty(), regs: regs_empty(), reglw: reglw_empty(), rreg: 0, awaitreg: false, marky: marks_empty(), markx: marks_empty(), awaitmark: 0, recording: 0, macrobuf: "", awaitmac: 0, lastmacro: 0, lvy: 0 - 1, lvx: 0 - 1, lvey: 0 - 1, lvex: 0 - 1, lvmode: 0, findc: 0, findt: 0, giy: 0 - 1, gix: 0 - 1 }

// A fresh EditState seeded with a buffer's restored undo/redo history and marks
// (both buffer-local in vim) plus the session-global registers (used on buffer
// switch so each buffer keeps its own `u` / Ctrl-R stacks and `a-z` marks while
// yanks/macros remain shared — registers are global in vim).
fn edit_new_undo(undos: [Snapshot], redos: [Snapshot], regs: [Str], reglw: [Bool], marky: [Int], markx: [Int]) -> EditState
    EditState { last: "", cur: "", snaptxt: "", active: false, snaped: snap_empty(), undos: undos, redos: redos, regs: regs, reglw: reglw, rreg: 0, awaitreg: false, marky: marky, markx: markx, awaitmark: 0, recording: 0, macrobuf: "", awaitmac: 0, lastmacro: 0, lvy: 0 - 1, lvx: 0 - 1, lvey: 0 - 1, lvex: 0 - 1, lvmode: 0, findc: 0, findt: 0, giy: 0 - 1, gix: 0 - 1 }

// Push a manual undo snapshot (for buffer-changing Ex commands like :s, which
// run in the driver outside the feed/feed_edit recording path) and clear redo.
fn edit_push_undo(es: EditState, ed: Editor) -> EditState
    EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: list.append(es.undos, [snap_of(ed)]), redos: snaps_empty(), regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix }

// First `k` snapshots of `xs` (the stack minus its top).
fn take_snaps(xs: [Snapshot], k: Int) -> [Snapshot]
    var out: [Snapshot] = []
    let mut i = 0
    while i < k
        out = list.append(out, [xs[i]])
        i = i + 1
    out

// Begin recording a command: snapshot the buffer text (for change detection)
// and the full editor (for undo).
fn edit_start(es: EditState, ed: Editor) -> EditState
    EditState { last: es.last, cur: "", snaptxt: buf_text(ed), active: true, snaped: snap_of(ed), undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix }

// Feed one byte mid/within a tracked command; on completion record the dot
// `last` and push the pre-change snapshot onto the undo stack if it changed.
fn edit_record(ed: Editor, st: InputState, km: Keymap, es: EditState, b: Int) -> EditStep
    let step = feed_mapped(ed, st, km, b)
    let s2 = step.st
    let cur2 = es.cur + str.from_char(b)
    let done = s2.mode == 0 and s2.pending == 0 and s2.count == 0
    let push = done and (buf_text(step.ed) != es.snaptxt)
    let newlast    = if push then cur2 else es.last
    let newcur     = if done then "" else cur2
    let newsnaptxt = if done then "" else es.snaptxt
    let newundos   = if push then list.append(es.undos, [es.snaped]) else es.undos
    let newredos   = if push then snaps_empty() else es.redos
    EditStep { ed: step.ed, st: s2, es: EditState { last: newlast, cur: newcur, snaptxt: newsnaptxt, active: not done, snaped: es.snaped, undos: newundos, redos: newredos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix } }

// Untracked byte (pure motion / navigation): feed without touching dot/undo.
fn edit_pass(ed: Editor, st: InputState, km: Keymap, es: EditState, b: Int) -> EditStep
    let step = feed_mapped(ed, st, km, b)
    EditStep { ed: step.ed, st: step.st, es: es }

// Remember the visual selection that was just left (for `gv`).  `st`/`ed` are
// the PRE-command state: anchor (avy,avx) + cursor (ed.cy,ed.cx) + mode.
fn edit_save_visual(es: EditState, st: InputState, ed: Editor) -> EditState
    EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: st.avy, lvx: st.avx, lvey: ed.cy, lvex: ed.cx, lvmode: st.mode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix }

// `gv` — re-enter the last visual selection (mode + anchor + cursor).
fn edit_regv(ed: Editor, st: InputState, es: EditState) -> EditStep
    let ne = clamp(Editor { lines: ed.lines, cy: es.lvey, cx: es.lvex })
    EditStep { ed: ne, st: InputState { count: 0, pending: 0, mode: es.lvmode, reg: st.reg, reg_lw: st.reg_lw, search: st.search, avy: es.lvy, avx: es.lvx }, es: es }

// A yank → the "0 register (slot 26).
fn edit_numreg_yank(es: EditState, text: Str, lw: Bool) -> EditState
    var r = es.regs
    var w = es.reglw
    r = util.set_str_at(r, 26, text)
    w = util.set_bool_at(w, 26, lw)
    EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: r, reglw: w, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix }

// A linewise delete → shift the "1-"9 ring (slots 27-35) and store at "1.
fn edit_numreg_del(es: EditState, text: Str) -> EditState
    var r = es.regs
    var w = es.reglw
    var i = 35
    while i >= 28
        r = util.set_str_at(r, i, r[i - 1])
        w = util.set_bool_at(w, i, w[i - 1])
        i = i - 1
    r = util.set_str_at(r, 27, text)
    w = util.set_bool_at(w, 27, true)
    EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: r, reglw: w, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix }

// A charwise (sub-line) delete → the small-delete register "- (slot 36).
fn edit_numreg_small(es: EditState, text: Str) -> EditState
    var r = es.regs
    var w = es.reglw
    r = util.set_str_at(r, 36, text)
    w = util.set_bool_at(w, 36, false)
    EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: r, reglw: w, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix }

// Remember the f/F/t/T that just completed (target `c`, pending `t`) for ; / ,.
fn edit_save_find(es: EditState, c: Int, t: Int) -> EditState
    EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: c, findt: t, giy: es.giy, gix: es.gix }

// Remember where Insert mode was just left (for `gi`).  `ed` is the PRE-Esc
// editor — the cursor sits where the next character would have gone.
fn edit_save_gi(es: EditState, ed: Editor) -> EditState
    EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: ed.cy, gix: ed.cx }

// `gi` — jump to the last insert-leave position and re-enter Insert mode.
fn edit_gi(ed: Editor, st: InputState, es: EditState) -> EditStep
    let ne = clamp_insert(Editor { lines: ed.lines, cy: es.giy, cx: es.gix })
    EditStep { ed: ne, st: ist_insert(st), es: es }

// `;` repeats the last find; `,` repeats it reversed.  findt: 8 f, 9 F, 10 t,
// 11 T (f/t go forward; t/T stop one short of the target).
fn edit_repeat_find(ed: Editor, st: InputState, es: EditState, reverse: Bool) -> EditStep
    let cnt = if st.count > 0 then st.count else 1
    let fwd0 = es.findt == '\b' or es.findt == '\n'
    let till = es.findt == '\n' or es.findt == 11
    let fwd = if reverse then not fwd0 else fwd0
    // ; / , is motion-only; reset any recording a leading count digit started.
    EditStep { ed: move_find(ed, es.findc, fwd, till, cnt), st: ist_done(st), es: EditState { last: es.last, cur: "", snaptxt: "", active: false, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix } }

// `u` — pop the undo stack onto the redo stack and restore the buffer.
fn edit_undo(ed: Editor, st: InputState, es: EditState) -> EditStep
    let nu = list.len(es.undos)
    let can = nu > 0
    let snap = if can then es.undos[nu - 1] else snap_of(ed)
    let undos2 = if can then take_snaps(es.undos, nu - 1) else es.undos
    let redos2 = if can then list.append(es.redos, [snap_of(ed)]) else es.redos
    let nede = if can then clamp(Editor { lines: snap.lines, cy: snap.cy, cx: snap.cx }) else ed
    EditStep { ed: nede, st: ist_done(st), es: EditState { last: es.last, cur: "", snaptxt: "", active: false, snaped: es.snaped, undos: undos2, redos: redos2, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix } }

// Ctrl-R — pop the redo stack onto the undo stack and restore the buffer.
fn edit_redo(ed: Editor, st: InputState, es: EditState) -> EditStep
    let nr = list.len(es.redos)
    let can = nr > 0
    let snap = if can then es.redos[nr - 1] else snap_of(ed)
    let redos2 = if can then take_snaps(es.redos, nr - 1) else es.redos
    let undos2 = if can then list.append(es.undos, [snap_of(ed)]) else es.undos
    let nede = if can then clamp(Editor { lines: snap.lines, cy: snap.cy, cx: snap.cx }) else ed
    EditStep { ed: nede, st: ist_done(st), es: EditState { last: es.last, cur: "", snaptxt: "", active: false, snaped: es.snaped, undos: undos2, redos: redos2, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix } }

// `.` — replay the last change `count` times; it is itself an undoable change,
// so snapshot the pre-replay buffer and push it on the undo stack if it changed.
fn edit_dot(ed: Editor, st: InputState, km: Keymap, es: EditState) -> EditStep
    let reps = if st.count > 0 then st.count else 1
    let presnap = snap_of(ed)
    let pretxt = buf_text(ed)
    var e = ed
    var s = ist_done(st)
    var r = 0
    while r < reps
        let step = replay_seq(e, s, km, es.last)
        e = step.ed
        s = step.st
        r = r + 1
    let push = buf_text(e) != pretxt
    let newundos = if push then list.append(es.undos, [presnap]) else es.undos
    let newredos = if push then snaps_empty() else es.redos
    EditStep { ed: e, st: s, es: EditState { last: es.last, cur: "", snaptxt: "", active: false, snaped: es.snaped, undos: newundos, redos: newredos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix } }

@intent("""Drive one input byte through feed_mapped with dot-repeat and
undo/redo bookkeeping: `u`/Ctrl-R restore from the snapshot stacks; any other
byte runs the edit, and a snapshot is pushed onto the undo stack when the buffer
actually changed.""")
fn feed_edit_inner(ed: Editor, st: InputState, km: Keymap, es: EditState, b: Int) -> EditStep
    if st.mode == 0 and st.pending == 0 and b == 'u'            // 'u' — undo
        return edit_undo(ed, st, es)
    if st.mode == 0 and st.pending == 0 and b == '\x12'            // Ctrl-R — redo
        return edit_redo(ed, st, es)
    if st.mode == 0 and st.pending == 0 and b == '.'            // '.' — repeat
        return edit_dot(ed, st, km, es)
    if st.pending == 1 and b == 'v' and es.lvmode != 0         // `gv` — reselect last visual
        return edit_regv(ed, st, es)
    if st.pending == 1 and b == 'i' and es.giy >= 0            // `gi` — resume Insert at the last position
        return edit_gi(ed, st, es)
    if st.mode == 0 and st.pending == 0 and (b == ';' or b == ',') and es.findt >= 8   // ; / , — repeat find (count ok)
        return edit_repeat_find(ed, st, es, b == ',')
    if es.active                                                // mid-command
        return edit_record(ed, st, km, es, b)
    if st.mode == 0 and st.pending == 0 and st.count == 0 and is_edit_start(b)
        return edit_record(ed, st, km, edit_start(es, ed), b)
    edit_pass(ed, st, km, es, b)

// ── Named registers: `"a` selects register a for the next op ──────
// The `"<letter>` prefix is handled here in the driver: it loads the named
// register into the unnamed register (so a following p reads it) and marks
// `rreg`; after the command completes, the unnamed register is stored back
// into the named slot (so a preceding y/d writes it).  The named store lives
// in EditState; feed stays pure (it only ever touches the unnamed register).

// Begin a `"` register prefix — await the register letter.
fn edit_await_reg(ed: Editor, st: InputState, es: EditState) -> EditStep
    EditStep { ed: ed, st: st, es: EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: true, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix } }

// The byte after `"`: a-z selects that register (loaded into the unnamed
// register for reads); anything else cancels.
fn edit_select_reg(ed: Editor, st: InputState, es: EditState, b: Int) -> EditStep
    if (b >= 'a' and b <= 'z') or (b >= '0' and b <= '9') or (b >= 'A' and b <= 'Z') or b == '-'
        let upper = b >= 'A' and b <= 'Z'                         // A-Z → append to a-z
        let idx = if b == '-' then 36 elif b <= '9' then 26 + (b - '0') elif upper then b - 'A' else b - 'a'
        let rr = if upper then 0 - (idx + 1) else idx + 1          // negative rreg = append mode
        let loaded = InputState { count: st.count, pending: st.pending, mode: st.mode, reg: es.regs[idx], reg_lw: es.reglw[idx], search: st.search, avy: st.avy, avx: st.avx }
        EditStep { ed: ed, st: loaded, es: EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: rr, awaitreg: false, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix } }
    else
        EditStep { ed: ed, st: st, es: EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: false, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix } }

// After a command completes with a register selected, persist the unnamed
// register into the named slot, then clear the selection.
fn edit_persist_reg(step: EditStep) -> EditStep
    if step.es.rreg != 0 and step.st.mode == 0 and step.st.pending == 0 and step.st.count == 0
        let app = step.es.rreg < 0                                  // append (A-Z)
        let idx = (if app then 0 - step.es.rreg else step.es.rreg) - 1
        let old = step.es.regs[idx]
        // Replace always writes (idempotent for read-only ops); append writes
        // only when the unnamed register actually changed (an actual yank/delete,
        // not a read like "Ap).
        let same = step.st.reg == old
        let wrote = if app then (not same) else true
        // Line-wise append joins with a newline (registers hold lines without a
        // trailing \n); skip the separator when the target is still empty.
        let sep = if step.st.reg_lw and str.len(old) > 0 then str.from_char('\n') else ""
        let newval = if app then old + sep + step.st.reg else step.st.reg
        let newlw = step.st.reg_lw     // append keeps the appended chunk's line-wise flag
        let regs2 = if wrote then util.set_str_at(step.es.regs, idx, newval) else step.es.regs
        let lw2 = if wrote then util.set_bool_at(step.es.reglw, idx, newlw) else step.es.reglw
        EditStep { ed: step.ed, st: step.st, es: EditState { last: step.es.last, cur: step.es.cur, snaptxt: step.es.snaptxt, active: step.es.active, snaped: step.es.snaped, undos: step.es.undos, redos: step.es.redos, regs: regs2, reglw: lw2, rreg: 0, awaitreg: step.es.awaitreg, marky: step.es.marky, markx: step.es.markx, awaitmark: step.es.awaitmark, recording: step.es.recording, macrobuf: step.es.macrobuf, awaitmac: step.es.awaitmac, lastmacro: step.es.lastmacro, lvy: step.es.lvy, lvx: step.es.lvx, lvey: step.es.lvey, lvex: step.es.lvex, lvmode: step.es.lvmode, findc: step.es.findc, findt: step.es.findt, giy: step.es.giy, gix: step.es.gix } }
    else
        step

// ── Marks: m<a-z> set, `<a-z> jump exact, '<a-z> jump line ────────

// Begin a mark prefix (op: 1 set, 2 jump-exact, 3 jump-line).
fn edit_await_mark(ed: Editor, st: InputState, es: EditState, op: Int) -> EditStep
    EditStep { ed: ed, st: st, es: EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: op, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix } }

// The mark letter after m / ` / ' — set or jump.
fn edit_mark_op(ed: Editor, st: InputState, es: EditState, b: Int) -> EditStep
    if b >= 'a' and b <= 'z'
        let idx = b - 'a'
        if es.awaitmark == 1                                    // set mark at cursor
            EditStep { ed: ed, st: st, es: EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: util.set_int_at(es.marky, idx, ed.cy), markx: util.set_int_at(es.markx, idx, ed.cx), awaitmark: 0, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix } }
        else                                                    // jump to mark
            let ly = es.marky[idx]
            let nede = if ly < 0 then ed elif es.awaitmark == 2 then clamp(Editor { lines: ed.lines, cy: ly, cx: es.markx[idx] }) else clamp(Editor { lines: ed.lines, cy: ly, cx: first_nonblank(line_at(ed, ly)) })
            EditStep { ed: nede, st: st, es: EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: 0, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix } }
    else
        EditStep { ed: ed, st: st, es: EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: 0, recording: es.recording, macrobuf: es.macrobuf, awaitmac: es.awaitmac, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix } }

fn feed_edit_core(ed: Editor, st: InputState, km: Keymap, es: EditState, b: Int) -> EditStep
    if es.awaitmark != 0                                        // byte after m / ` / '
        return edit_mark_op(ed, st, es, b)
    if st.mode == 0 and st.pending == 0 and b == 'm'           // 'm' — set mark
        return edit_await_mark(ed, st, es, 1)
    if st.mode == 0 and st.pending == 0 and b == '`'           // ` — jump to mark (exact)
        return edit_await_mark(ed, st, es, 2)
    if st.mode == 0 and st.pending == 0 and b == '\''           // ' — jump to mark (line)
        return edit_await_mark(ed, st, es, 3)
    if es.awaitreg                                              // byte after `"`
        return edit_select_reg(ed, st, es, b)
    if st.mode == 0 and st.pending == 0 and b == '"'           // `"` — register prefix
        return edit_await_reg(ed, st, es)
    edit_persist_reg(feed_edit_inner(ed, st, km, es, b))

// ── Macros: q<reg> … q record, @<reg> / @@ replay ─────────────
// Recorded keystrokes are stored in the named-register slot (vim shares them),
// so q stop writes `macrobuf` into regs[reg].  Replay re-feeds the bytes
// through feed_edit.  Limitation (v1): `:` / `/` lines inside a macro aren't
// replayed (those are handled by the drivers, not feed).

// Set the await-macro state (1 = after q, 2 = after @).
fn macro_await(es: EditState, op: Int) -> EditState
    EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: op, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix }

// The register letter after q — begin recording (or cancel on a bad name).
fn macro_start(es: EditState, b: Int) -> EditState
    let rec = if b >= 'a' and b <= 'z' then b - 'a' + 1 else 0
    EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: rec, macrobuf: "", awaitmac: 0, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix }

// Stop recording — store the recorded keystrokes into the register slot.
fn macro_stop(es: EditState) -> EditState
    let regs2 = util.set_str_at(es.regs, es.recording - 1, es.macrobuf)
    EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: regs2, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: 0, macrobuf: "", awaitmac: 0, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix }

// Append a keystroke to the in-progress recording.
fn macro_capture(es: EditState, b: Int) -> EditState
    EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf + str.from_char(b), awaitmac: 0, lastmacro: es.lastmacro, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix }

// Clear awaitmac and remember the last replayed register (for @@).
fn macro_done_await(es: EditState, last: Int) -> EditState
    EditState { last: es.last, cur: es.cur, snaptxt: es.snaptxt, active: es.active, snaped: es.snaped, undos: es.undos, redos: es.redos, regs: es.regs, reglw: es.reglw, rreg: es.rreg, awaitreg: es.awaitreg, marky: es.marky, markx: es.markx, awaitmark: es.awaitmark, recording: es.recording, macrobuf: es.macrobuf, awaitmac: 0, lastmacro: last, lvy: es.lvy, lvx: es.lvx, lvey: es.lvey, lvex: es.lvex, lvmode: es.lvmode, findc: es.findc, findt: es.findt, giy: es.giy, gix: es.gix }

// The register letter after @ — replay it (`@@` = last) through feed_edit.
fn macro_replay(ed: Editor, st: InputState, km: Keymap, es: EditState, b: Int) -> EditStep
    let idx = if b == '@' then es.lastmacro - 1 elif b >= 'a' and b <= 'z' then b - 'a' else 0 - 1
    if idx < 0
        return EditStep { ed: ed, st: st, es: macro_done_await(es, es.lastmacro) }
    let seq = es.regs[idx]
    var e = ed
    var s = st
    var ess = macro_done_await(es, idx + 1)
    let m = str.len(seq)
    let mut j = 0
    while j < m
        let step = feed_edit(e, s, km, ess, str.byte_at(seq, j) ?? 0)
        e = step.ed
        s = step.st
        ess = step.es
        j = j + 1
    EditStep { ed: e, st: s, es: ess }

@intent("""The driver-facing edit entry point: wraps feed_edit_core with macro
recording/replay (`q<reg>…q`, `@<reg>`) and remembers the last f/F/t/T target
for `;`/`,`.  Returns an EditStep carrying the new editor, input state, and the
session EditState (registers, marks, undo/redo, dot, macros).""")
fn feed_edit(ed: Editor, st: InputState, km: Keymap, es: EditState, b: Int) -> EditStep
    if es.awaitmac == 1                                         // byte after q — register
        return EditStep { ed: ed, st: st, es: macro_start(es, b) }
    if es.awaitmac == 2                                         // byte after @ — replay
        return macro_replay(ed, st, km, es, b)
    if st.mode == 0 and st.pending == 0 and b == 'q'          // 'q'
        if es.recording != 0
            return EditStep { ed: ed, st: st, es: macro_stop(es) }
        return EditStep { ed: ed, st: st, es: macro_await(es, 1) }
    if st.mode == 0 and st.pending == 0 and b == '@'          // '@'
        return EditStep { ed: ed, st: st, es: macro_await(es, 2) }
    let result = feed_edit_core(ed, st, km, es, b)
    // A completed f/F/t/T (pending 8-11 + a target byte) → remember for ; / ,.
    let result1 = if st.pending >= 8 and st.pending <= 11 and b != '\e'
        EditStep { ed: result.ed, st: result.st, es: edit_save_find(result.es, b, st.pending) }
    else
        result
    // Leaving Visual mode → remember the selection for `gv`.
    let result2 = if (st.mode == 2 or st.mode == 3) and result1.st.mode == 0
        EditStep { ed: result1.ed, st: result1.st, es: edit_save_visual(result1.es, st, ed) }
    else
        result1
    // A completed yank → "0; a completed linewise delete → the "1-"9 ring.
    // (buf_text is only computed when the unnamed register actually changed.)
    let regchg = str.len(result2.st.reg) > 0 and result2.st.reg != st.reg and result2.st.mode == 0 and result2.st.pending == 0 and result2.st.count == 0
    let result3 = if regchg and buf_text(result2.ed) == buf_text(ed)
        EditStep { ed: result2.ed, st: result2.st, es: edit_numreg_yank(result2.es, result2.st.reg, result2.st.reg_lw) }
    elif regchg and result2.st.reg_lw
        EditStep { ed: result2.ed, st: result2.st, es: edit_numreg_del(result2.es, result2.st.reg) }
    elif regchg
        EditStep { ed: result2.ed, st: result2.st, es: edit_numreg_small(result2.es, result2.st.reg) }
    else
        result2
    // Leaving Insert mode → remember the position for `gi` (ed = pre-Esc cursor).
    let result4 = if st.mode == 1 and result3.st.mode == 0
        EditStep { ed: result3.ed, st: result3.st, es: edit_save_gi(result3.es, ed) }
    else
        result3
    if es.recording != 0                                       // capture the keystroke
        return EditStep { ed: result4.ed, st: result4.st, es: macro_capture(result4.es, b) }
    result4

@intent("""`--batch <keys> <file>` entry point: load the file, feed each decoded
key through the same edit pipeline as interactive mode (no TUI, no LSP), and
print the resulting buffer + cursor.  Deterministic — the test harness drives
editor behaviour through this path.""")
fn run_batch(keys: Str, cfg_path: Str, path: Str) [io]
    var ed = Editor { lines: buf_load(path), cy: 0, cx: 0 }
    var st = ist_new()
    var es = edit_new()
    let km = load_keymaps(cfg_path)
    let batch_rows = term_rows()         // 24 off-tty — makes paging deterministic
    let decoded = decode_escapes(keys)
    var cmd_mode = false
    var cmd_buf = ""
    var search_mode = false
    var search_buf = ""
    var search_back = false
    var last_subst = ""
    var quit = false
    let n = str.len(decoded)
    let mut i = 0
    while i < n and not quit
        let b = str.byte_at(decoded, i) ?? 0
        if cmd_mode
            if b == '\r' or b == '\n'            // Enter — run the command
                if is_substitute(cmd_buf)
                    es = edit_push_undo(es, ed)
                    ed = ex_substitute(ed, cmd_buf)
                    last_subst = cmd_buf
                elif is_global(cmd_buf)
                    es = edit_push_undo(es, ed)
                    ed = ex_global(ed, cmd_buf)
                elif is_goto(cmd_buf)
                    ed = ex_goto(ed, cmd_buf)
                else
                    let r = exec_ex(cmd_buf)
                    if r.save
                        save_buf(path, ed.lines)
                    if r.quit
                        quit = true
                cmd_mode = false
                cmd_buf = ""
            elif b == '\e'                     // Esc — cancel
                cmd_mode = false
                cmd_buf = ""
            elif b == '\x7f' or b == '\b'          // Backspace
                if str.len(cmd_buf) > 0
                    cmd_buf = str.slice(cmd_buf, 0, str.len(cmd_buf) - 1)
            elif b >= ' ' and b < '\x7f'
                cmd_buf = cmd_buf + str.from_char(b)
        elif search_mode
            if b == '\r' or b == '\n'            // Enter — run the search
                st = ist_set_search(st, search_buf)
                ed = find_next(ed, search_buf, not search_back)
                search_mode = false
                search_buf = ""
            elif b == '\e'                     // Esc — cancel
                search_mode = false
                search_buf = ""
            elif b == '\x7f' or b == '\b'
                if str.len(search_buf) > 0
                    search_buf = str.slice(search_buf, 0, str.len(search_buf) - 1)
            elif b >= ' ' and b < '\x7f'
                search_buf = search_buf + str.from_char(b)
        elif b == 58 and st.mode == 0        // ':' — open the Ex line
            cmd_mode = true
            cmd_buf = ""
        elif b == 47 and st.mode == 0        // '/' — search forward
            search_mode = true
            search_buf = ""
            search_back = false
        elif b == 63 and st.mode == 0        // '?' — search backward
            search_mode = true
            search_buf = ""
            search_back = true
        elif scroll_idle(st, es) and key_free(km, b) and scroll_ctrl_kind(b) >= 0   // Ctrl-D/U/F/B paging
            ed = clamp(Editor { lines: ed.lines, cy: scroll_new_cy(ed, batch_rows, scroll_ctrl_kind(b)), cx: ed.cx })
        elif scroll_idle(st, es) and key_free(km, b) and screen_kind(b) >= 0        // H / M / L (top=0 in batch)
            let ty = screen_target(0, batch_rows, list.len(ed.lines), screen_kind(b))
            ed = clamp(Editor { lines: ed.lines, cy: ty, cx: first_nonblank(line_at(ed, ty)) })
        elif scroll_idle(st, es) and key_free(km, b) and b == '&' and str.len(last_subst) > 0   // & — repeat last :s on this line
            es = edit_push_undo(es, ed)
            ed = ex_substitute(ed, subst_current_line(last_subst))
        else
            let estep = feed_edit(ed, st, km, es, b)
            ed = estep.ed
            st = estep.st
            es = estep.es
        i = i + 1
    let mut li = 0
    let nl = list.len(ed.lines)
    while li < nl
        println(ed.lines[li])
        li = li + 1
    println("cursor=" + str.from_int(ed.cy) + ":" + str.from_int(ed.cx))

// ── Interactive TUI ─────────────────────────────────────────────

fn emit_byte(b: Int) [io]
    let _ = novo_pty_stdout_write_byte_h(b)

// Write a string to stdout byte-by-byte (raw mode — no libc buffering
// surprises with control sequences).
fn emit(s: Str) [io]
    let n = str.len(s)
    let mut i = 0
    while i < n
        emit_byte(str.byte_at(s, i) ?? 0)
        i = i + 1

// ESC [ — start a CSI sequence.  ESC is spelled as byte 27 rather than
// a string escape (Novo source convention; see novomux/render.nv).
fn csi() [io]
    emit_byte('\e')
    emit_byte(91)         // '['

fn cup(row: Int, col: Int) [io]   // 1-based cursor position
    csi()
    emit(str.from_int(row) + ";" + str.from_int(col) + "H")

fn sgr(code: Str) [io]            // ESC [ <code> m
    csi()
    emit(code + "m")

fn el() [io]                      // ESC [ K — erase from cursor to end of line
    csi()
    emit("K")

// End-of-row clear for one window's row.  A window flush against the terminal's
// right edge can erase to end-of-line (`el`) cheaply; a window with a neighbour
// to its right (a vsplit's left pane) must NOT — `el` would wipe the neighbour —
// so it pads with `pad` spaces to its own right edge instead.  `clip` is true
// exactly when the window's right edge is left of the terminal's.
fn eol(clip: Bool, pad: Int) [io]
    if clip
        if pad > 0
            emit(nspaces(pad))
    else
        el()

// DECSCUSR — set the cursor shape to match the mode: a steady block for
// Normal/Visual, a steady bar (I-beam) for Insert, a steady underline for
// Replace.  `ESC [ <n> SP q`; n=2 block, n=6 bar, n=4 underline.
fn cursor_shape(mode: Int) [io]
    csi()
    if mode == 1
        emit("6 q")          // insert → bar
    elif mode == 4
        emit("4 q")          // replace → underline
    else
        emit("2 q")          // normal / visual → block

// Expand tab bytes ('\t') to spaces up to the next `ts`-column stop, so a
// buffer line renders with consistent indentation regardless of the
// terminal's own tab stops.  Byte-oriented, matching the rest of the editor
// (cx is a byte index).  ts <= 0 leaves the line untouched.
// A UTF-8 continuation byte (10xxxxxx) — part of a multi-byte character, so it
// occupies no display column of its own.
fn is_utf8_cont(b: Int) -> Bool
    bits.band(b, 0xC0) == 0x80

fn expand_tabs(s: Str, ts: Int) -> Str
    if ts <= 0
        return s
    var out = ""
    var col = 0
    let n = str.len(s)
    let mut i = 0
    while i < n
        let b = str.byte_at(s, i) ?? 0
        if b == '\t'
            let nextstop = ((col / ts) + 1) * ts
            while col < nextstop
                out = out + " "
                col = col + 1
        else
            out = out + str.from_char(b)
            if not is_utf8_cont(b)               // count one column per character
                col = col + 1
        i = i + 1
    out

// Visual column of byte index `cx` within `s` once tabs are expanded — used
// to place the hardware cursor over the rendered (tab-expanded) text.
fn vis_col(s: Str, cx: Int, ts: Int) -> Int
    var col = 0
    let mut i = 0
    let stop = if cx > str.len(s) then str.len(s) else cx
    while i < stop
        let b = str.byte_at(s, i) ?? 0
        if b == '\t' and ts > 0
            col = ((col / ts) + 1) * ts
        elif not is_utf8_cont(b)               // UTF-8 continuation bytes add no column
            col = col + 1
        i = i + 1
    col

// Horizontal counterpart of `scroll_to`: shift the visual-column viewport
// offset `left` so the cursor's visual column stays within a `width`-wide
// text area.  No side margin (cursor sits at the very edge before scrolling).
fn hscroll_to(left: Int, viscol: Int, width: Int) -> Int
    let w = if width < 1 then 1 else width
    var l = left
    if viscol < l
        l = viscol
    if viscol >= l + w
        l = viscol - w + 1
    if l < 0
        l = 0
    l

// Clear the whole screen (ESC [ 2J).  Only used once at startup and on a
// resize — NOT per frame: a per-frame clear blanks the screen between the
// erase and the repaint, which the eye sees as flicker on every keystroke.
fn clear_screen() [io]
    csi()
    emit("2J")

// Flicker-free full repaint.  Instead of clearing the screen (which blanks
// then repaints — visible flicker on every cursor move), we hide the cursor,
// overwrite every row in place, and erase each row's tail with ESC [ K so no
// stale glyphs from a longer previous line survive.  Draws up to (rows-1)
// buffer lines (a `~` past end-of-buffer), a reverse-video status line on the
// last row, then places the hardware cursor at the editor cursor.
// Emit visual columns [left, left+width) of an (already tab-expanded) line,
// reverse-videoing the selected visual-column span [vlo, vhi) (vlo>=vhi → no
// highlight, e.g. outside visual mode).
fn emit_line_hl(expanded: Str, left: Int, width: Int, vlo: Int, vhi: Int) [io]
    let elen = str.len(expanded)
    let endc = if left + width < elen then left + width else elen
    var c = left
    var insel = false
    while c < endc
        let want = c >= vlo and c < vhi
        if want and not insel
            sgr("7")
            insel = true
        if not want and insel
            sgr("0")
            insel = false
        emit_byte(str.byte_at(expanded, c) ?? ' ')
        c = c + 1
    if insel
        sgr("0")

// Is visual column `c` inside any [start,end) range of the flat list `sr`?
fn col_in_ranges(sr: [Int], c: Int) -> Bool
    var k = 0
    let m = list.len(sr)
    while k + 1 < m
        if c >= sr[k] and c < sr[k + 1]
            return true
        k = k + 2
    false

// Convert a regex match's byte ranges on `raw` to visual-column ranges.
fn search_vis_ranges(atoms: [nvregex.ReAtom], raw: Str, ts: Int) -> [Int]
    let br = nvregex.re_match_ranges(atoms, raw)
    var out: [Int] = []
    var k = 0
    let m = list.len(br)
    while k + 1 < m
        out = list.append(out, [vis_col(raw, br[k], ts)])
        out = list.append(out, [vis_col(raw, br[k + 1], ts)])
        k = k + 2
    out

// Like emit_line_hl but also paints search matches (`sr` = flat visual ranges)
// with `scol`.  Selection (reverse) wins over a search match on the same column.
// ── Novo syntax highlighting (.nv files) ────────────────────────────────────
fn nv_ident_start(b: Int) -> Bool
    (b >= 'a' and b <= 'z') or (b >= 'A' and b <= 'Z') or b == '_'

fn nv_ident_char(b: Int) -> Bool
    nv_ident_start(b) or (b >= '0' and b <= '9')

fn nv_keyword(w: Str) -> Bool
    w == "fn" or w == "let" or w == "var" or w == "mut" or w == "if" or w == "elif" or w == "else" or w == "while" or w == "for" or w == "in" or w == "return" or w == "struct" or w == "enum" or w == "trait" or w == "impl" or w == "match" or w == "and" or w == "or" or w == "not" or w == "true" or w == "false" or w == "async" or w == "await" or w == "import" or w == "type" or w == "break" or w == "continue" or w == "then" or w == "pub" or w == "as" or w == "None" or w == "Some"

// Per-column 256-colour fg index for a (tab-expanded) Novo line.  0 = default.
// `kw`/`strc`/`cmt`/`num` are the keyword/string/comment/number colours.
fn syntax_colors(s: Str, kw: Int, strc: Int, cmt: Int, num: Int) -> [Int]
    var col: [Int] = []
    let n = str.len(s)
    var i = 0
    while i < n
        let b = str.byte_at(s, i) ?? 0
        if b == '/' and i + 1 < n and (str.byte_at(s, i + 1) ?? 0) == '/'   // // comment
            while i < n
                col = list.append(col, [cmt])
                i = i + 1
        elif b == '"'                                                       // " string
            col = list.append(col, [strc])
            i = i + 1
            while i < n and (str.byte_at(s, i) ?? 0) != '"'
                col = list.append(col, [strc])
                i = i + 1
            if i < n
                col = list.append(col, [strc])
                i = i + 1
        elif nv_ident_start(b)                                              // identifier / keyword
            let start = i
            while i < n and nv_ident_char(str.byte_at(s, i) ?? 0)
                i = i + 1
            let c = if nv_keyword(str.slice(s, start, i)) then kw else 0
            var j = start
            while j < i
                col = list.append(col, [c])
                j = j + 1
        elif b >= '0' and b <= '9'                                        // number
            while i < n and ((str.byte_at(s, i) ?? 0) >= '0' and (str.byte_at(s, i) ?? 0) <= '9' or (str.byte_at(s, i) ?? 0) == '.' or (str.byte_at(s, i) ?? 0) == '_')
                col = list.append(col, [num])
                i = i + 1
        else
            col = list.append(col, [0])
            i = i + 1
    col

// Paint a line: syntax colours (`syncols`, per-column fg index) as the base,
// search matches (`sr`/`scol`) over them, the Visual selection (reverse) on top.
fn emit_line_styled(expanded: Str, left: Int, width: Int, vlo: Int, vhi: Int, sr: [Int], scol: Str, syncols: [Int]) [io]
    let elen = str.len(expanded)
    let endc = if left + width < elen then left + width else elen
    let sn = list.len(syncols)
    var c = left
    var cur = 0                      // 0 none, 1 selection, 2 search, 1000+idx syntax
    while c < endc
        let want = if c >= vlo and c < vhi
            1
        elif col_in_ranges(sr, c)
            2
        elif c < sn and syncols[c] > 0
            1000 + syncols[c]
        else
            0
        if want != cur
            sgr("0")
            if want == 1
                sgr("7")
            elif want == 2
                sgr(scol)
            elif want >= 1000
                sgr("38;5;" + str.from_int(want - 1000))
            cur = want
        emit_byte(str.byte_at(expanded, c) ?? ' ')
        c = c + 1
    if cur != 0
        sgr("0")

// Highlight Novo source (`.nv`).
fn ends_with_nv(p: Str) -> Bool
    let n = str.len(p)
    n >= 3 and str.slice(p, n - 3, n) == ".nv"

@intent("""A screen rectangle (1-based-friendly, but stored 0-based): origin
(x, y) and size (w, h) in terminal cells.  A window draws into one of these.""")
struct Rect
    x: Int
    y: Int
    w: Int
    h: Int

@intent("""The window layout as a recursive tree.  `LWin` is a leaf holding a
window id (index into the win_* parallel arrays); `LRow` tiles its parts
side-by-side (a `:vsplit`), `LCol` stacks them top-to-bottom (a `:split`).
A single full-screen window is just `LWin(0)` — the v1 default.""")
enum Layout
    LWin(id: Int)
    LRow(parts: [Layout])
    LCol(parts: [Layout])

@intent("""Compute the cell rectangle of every leaf window under `lay`, given
the screen rect `r`.  Returns a flat [Int] of 5-tuples (winid, x, y, w, h) —
flat so it sidesteps [[Int]] / struct-list return shapes.  `LRow` divides
width evenly (last part absorbs the rounding remainder); `LCol` divides
height.  For `LWin(0)` over the full screen this yields exactly the
single-window geometry, keeping the v1 render byte-identical.""")
fn layout_rects(lay: Layout, r: Rect, acc: [Int]) -> [Int]
    match lay
        LWin(id) =>
            var a = acc
            a = list.push(a, id)
            a = list.push(a, r.x)
            a = list.push(a, r.y)
            a = list.push(a, r.w)
            a = list.push(a, r.h)
            a
        LRow(parts) =>
            var a = acc
            let n = list.len(parts)
            if n == 0
                return a
            let each = r.w / n
            var i = 0
            while i < n
                let wx = r.x + i * each
                let ww = if i == n - 1 then r.x + r.w - wx else each
                a = layout_rects(parts[i], Rect { x: wx, y: r.y, w: ww, h: r.h }, a)
                i = i + 1
            a
        LCol(parts) =>
            var a = acc
            let n = list.len(parts)
            if n == 0
                return a
            let each = r.h / n
            var i = 0
            while i < n
                let wy = r.y + i * each
                let wh = if i == n - 1 then r.y + r.h - wy else each
                a = layout_rects(parts[i], Rect { x: r.x, y: wy, w: r.w, h: wh }, a)
                i = i + 1
            a

@intent("""The cell rect of window `winid` within `lay` over `screen`, via
layout_rects.  Falls back to the whole screen if the id isn't present (so a
stale active-window id can never produce an empty draw rect).""")
fn window_rect(lay: Layout, winid: Int, screen: Rect) -> Rect
    let rects = layout_rects(lay, screen, [])
    var i = 0
    let n = list.len(rects)
    while i < n
        if rects[i] == winid
            return Rect { x: rects[i + 1], y: rects[i + 2], w: rects[i + 3], h: rects[i + 4] }
        i = i + 5
    screen

@intent("""Split the leaf window `winid` into a pair (the old window plus a new
`newid`), `vertical` → side-by-side LRow (`:vsplit`), else stacked LCol
(`:split`).  Recurses the tree rebuilding each LRow/LCol so the split lands at
the right leaf regardless of nesting.  Adjacent same-orientation splits nest
(no flattening) — fine for v1.""")
fn layout_split(lay: Layout, winid: Int, newid: Int, vertical: Bool) -> Layout
    match lay
        LWin(id) =>
            if id == winid
                if vertical
                    LRow([LWin(id), LWin(newid)])
                else
                    LCol([LWin(id), LWin(newid)])
            else
                LWin(id)
        LRow(parts) =>
            var np: [Layout] = []
            var i = 0
            while i < list.len(parts)
                np = list.push(np, layout_split(parts[i], winid, newid, vertical))
                i = i + 1
            LRow(np)
        LCol(parts) =>
            var np: [Layout] = []
            var i = 0
            while i < list.len(parts)
                np = list.push(np, layout_split(parts[i], winid, newid, vertical))
                i = i + 1
            LCol(np)

@intent("""Number of leaf windows in the layout tree.""")
fn layout_count(lay: Layout) -> Int
    match lay
        LWin(id) => 1
        LRow(parts) =>
            var n = 0
            var i = 0
            while i < list.len(parts)
                n = n + layout_count(parts[i])
                i = i + 1
            n
        LCol(parts) =>
            var n = 0
            var i = 0
            while i < list.len(parts)
                n = n + layout_count(parts[i])
                i = i + 1
            n

@intent("""The ordered list of leaf window ids, left-to-right / top-to-bottom as
they appear in the tree.  Used for `Ctrl-W w` focus cycling (next id after the
active one, wrapping) and to pick a survivor after a close.""")
fn layout_winids(lay: Layout, acc: [Int]) -> [Int]
    match lay
        LWin(id) => list.push(acc, id)
        LRow(parts) =>
            var a = acc
            var i = 0
            while i < list.len(parts)
                a = layout_winids(parts[i], a)
                i = i + 1
            a
        LCol(parts) =>
            var a = acc
            var i = 0
            while i < list.len(parts)
                a = layout_winids(parts[i], a)
                i = i + 1
            a

@intent("""The next window id after `awin` in tree order, wrapping — the target
for `Ctrl-W w`.  Returns `awin` unchanged when there is only one window.""")
fn win_cycle_next(lay: Layout, awin: Int) -> Int
    let ids = layout_winids(lay, [])
    let nw = list.len(ids)
    if nw <= 1
        return awin
    var pos = 0
    var k = 0
    while k < nw
        if ids[k] == awin
            pos = k
        k = k + 1
    ids[(pos + 1) % nw]

@intent("""The window to move focus to from `awin` in a direction (`Ctrl-W h/j/k/l`):
dir 0=left 1=down 2=up 3=right.  Scans the computed rects for the nearest window
that lies in that direction AND overlaps the active window on the perpendicular
axis, by gap distance.  Returns `awin` unchanged when there is no window that
way (edge of the layout).""")
fn window_in_dir(lay: Layout, awin: Int, screen: Rect, dir: Int) -> Int
    let rects = layout_rects(lay, screen, [])
    var ax = 0
    var ay = 0
    var aw = 0
    var ah = 0
    var k = 0
    while k < list.len(rects)
        if rects[k] == awin
            ax = rects[k + 1]
            ay = rects[k + 2]
            aw = rects[k + 3]
            ah = rects[k + 4]
        k = k + 5
    var best = awin
    var bestd = 1000000
    var j = 0
    while j < list.len(rects)
        let wid = rects[j]
        let wx = rects[j + 1]
        let wy = rects[j + 2]
        let ww = rects[j + 3]
        let wh = rects[j + 4]
        // overlap on the axis perpendicular to the move
        let voverlap = wy < ay + ah and wy + wh > ay
        let hoverlap = wx < ax + aw and wx + ww > ax
        let indir = if dir == 0
            wx + ww <= ax and voverlap
        elif dir == 3
            wx >= ax + aw and voverlap
        elif dir == 2
            wy + wh <= ay and hoverlap
        else
            wy >= ay + ah and hoverlap
        if wid != awin and indir
            let d = if dir == 0
                ax - (wx + ww)
            elif dir == 3
                wx - (ax + aw)
            elif dir == 2
                ay - (wy + wh)
            else
                wy - (ay + ah)
            if d < bestd
                bestd = d
                best = wid
        j = j + 5
    best

@intent("""Remove window `winid` from the tree, returning a 0-or-1 element list
(the surviving subtree, or empty if `winid` was the whole tree).  An LRow/LCol
that loses a child and is left with exactly one collapses to that child (no
empty or single-child rows linger).  Returns a LIST so a removed leaf yields
`[]` and the parent flattens — relies on the perceus empty-vec-singleton fix
(closed/llvm-recursive-fn-returning-list-of-recursive-enum-segfault).""")
fn layout_remove(lay: Layout, winid: Int) -> [Layout]
    match lay
        LWin(id) =>
            if id == winid then [] else [LWin(id)]
        LRow(parts) =>
            var np: [Layout] = []
            var i = 0
            while i < list.len(parts)
                np = list.append(np, layout_remove(parts[i], winid))
                i = i + 1
            if list.len(np) == 0
                []
            elif list.len(np) == 1
                [np[0]]
            else
                [LRow(np)]
        LCol(parts) =>
            var np: [Layout] = []
            var i = 0
            while i < list.len(parts)
                np = list.append(np, layout_remove(parts[i], winid))
                i = i + 1
            if list.len(np) == 0
                []
            elif list.len(np) == 1
                [np[0]]
            else
                [LCol(np)]

@intent("""Draw ONE window's frame into its rect: the text viewport (scrolled
to `top`/`left`, optional line-number gutter, tab expansion, Novo syntax
highlighting, search-match and visual-selection highlighting, per-line
diagnostic colouring) plus that window's status line.  All positioning is
offset by the window origin (rx, ry) and bounded to the window size (cols,
rows); for a single full-screen window (rx=ry=0) these reduce to absolute
coordinates.  Does NOT touch cursor visibility or place the hardware cursor —
the orchestrator (`render` / `render_all`) hides the cursor once, draws every
window, then places it in the active window.""")
fn draw_window(ed: Editor, win: Rect, path: Str, top: Int, left: Int, mode: Int, avy: Int, avx: Int, search: Str, cs: Colorscheme, opts: Options, diag_li: [Int], diag_msgs: [Str], info: Str, modified: Bool, clip: Bool, active: Bool) [io]
    let rows = win.h
    let cols = win.w
    let rx = win.x
    let ry = win.y
    let body = rows - 1
    let nl = list.len(ed.lines)
    let dohl = opts.hlsearch and str.len(search) > 0     // search highlighting
    let satoms = if dohl then nvregex.re_compile(search) else []
    let dosyn = opts.syntax and ends_with_nv(path)        // Novo syntax highlighting
    let synkw = cs_or(cs.kw_fg, 170)
    let synstr = cs_or(cs.str_fg, 150)
    let syncmt = cs_or(cs.cmt_fg, 245)
    let synnum = cs_or(cs.num_fg, 215)
    let numbered = opts.number or opts.relativenumber
    // Gutter width tracks the largest line number (min 3 digits) so the text
    // column stays put when the cursor crosses a digit boundary on a 1000+
    // line file — numbers are right-aligned (least-significant digit fixed).
    let numw = if num_digits(nl) > 3 then num_digits(nl) else 3
    let gutter = if numbered then numw + 1 else 0
    let width = if cols - gutter > 0 then cols - gutter else 1   // text area width
    // Normalised visual selection bounds (start <= end), used for highlighting.
    let a_first = avy < ed.cy or (avy == ed.cy and avx <= ed.cx)
    let ssy = if a_first then avy else ed.cy
    let ssx = if a_first then avx else ed.cx
    let sey = if a_first then ed.cy else avy
    let sex = if a_first then ed.cx else avx
    let vis = mode == 2 or mode == 3
    // `r` = screen row, `li` = buffer line.  With `wrap` a long line occupies
    // several screen rows, so the two are tracked separately.
    var r = 0
    var li = top
    while r < body
        if li < nl
            let raw = ed.lines[li]
            let expanded = expand_tabs(raw, opts.tabstop)
            let vlen = str.len(expanded)
            var vlo = 0
            var vhi = 0
            if vis and li >= ssy and li <= sey
                if mode == 3
                    vlo = 0
                    vhi = vlen
                else
                    let blo = if li == ssy then ssx else 0
                    let bhi = if li == sey then sex + 1 else str.len(raw)
                    vlo = vis_col(raw, blo, opts.tabstop)
                    vhi = vis_col(raw, bhi, opts.tabstop)
            let srng = if dohl then search_vis_ranges(satoms, raw, opts.tabstop) else []
            let syncols = if dosyn then syntax_colors(expanded, synkw, synstr, syncmt, synnum) else []
            let segs = if opts.wrap and vlen > width then (vlen + width - 1) / width else 1
            var seg = 0
            while seg < segs and r < body
                cup(ry + r + 1, rx + 1)
                if numbered
                    if seg == 0
                        // relativenumber → distance from the cursor line; with
                        // `number` too the cursor line shows its absolute number.
                        let gnum = if opts.relativenumber and li != ed.cy
                            if li > ed.cy then li - ed.cy else ed.cy - li
                        elif opts.relativenumber and (not opts.number)
                            0
                        else
                            li + 1
                        // A line with a diagnostic colours its number red (error)
                        // or yellow (warning) — a zero-width gutter sign.
                        let dsev = diag_sev_for_line(diag_li, li)
                        let iscur = li == ed.cy        // the active line gets a bold number
                        // In hybrid number+relativenumber the active line shows
                        // its absolute number flush-LEFT (neovim style); every
                        // other line stays right-aligned.
                        let numtxt = if iscur and opts.relativenumber and opts.number
                            pad_num_l(gnum, numw)
                        else
                            pad_num(gnum, numw)
                        if dsev == 1
                            sgr(if iscur then "1;38;5;9" else "38;5;9")
                            emit(numtxt)
                            sgr("0")
                            emit(" ")
                        elif dsev >= 2
                            sgr(if iscur then "1;38;5;11" else "38;5;11")
                            emit(numtxt)
                            sgr("0")
                            emit(" ")
                        elif iscur
                            sgr("1;38;5;15")           // active line number — bold bright white
                            emit(numtxt)
                            sgr("0")
                            emit(" ")
                        else
                            emit(numtxt + " ")
                    else
                        emit(nspaces(numw + 1))   // blank gutter on continuation rows
                let segleft = if opts.wrap then seg * width else left
                emit_line_styled(expanded, segleft, width, vlo, vhi, srng, "30;43", syncols)
                // chars emitted by emit_line_styled = clamp(vlen - segleft, 0, width)
                let shown = if vlen - segleft < 0 then 0 elif vlen - segleft > width then width else vlen - segleft
                eol(clip, width - shown)
                r = r + 1
                seg = seg + 1
            li = li + 1
        else
            cup(ry + r + 1, rx + 1)
            if cs.tilde_fg >= 0
                sgr("38;5;" + str.from_int(cs.tilde_fg))
                emit("~")
                sgr("0")
            else
                emit("~")
            eol(clip, cols - 1)          // "~" took 1 column; fill the rest
            r = r + 1
            li = li + 1
    cup(ry + rows, rx + 1)
    // The focused window keeps the full status styling (reverse / colourscheme
    // colours); inactive panes draw a plain status bar so the focus is obvious.
    sgr(if active then status_sgr(cs) else "0")
    let modestr = if mode == 1 then "-- INSERT -- " elif mode == 2 then "-- VISUAL -- " elif mode == 3 then "-- VISUAL LINE -- " elif mode == 4 then "-- REPLACE -- " else "-- NORMAL -- "
    // Diagnostics summary (E:n W:m) plus, when the cursor sits on a diagnostic
    // line, that diagnostic's message — the low-effort surface before any popup.
    let ndiag = list.len(diag_li) / 2
    let dsum = if ndiag > 0 then "  E:" + str.from_int(diag_count(diag_li, 1)) + " W:" + str.from_int(diag_count(diag_li, 2)) else ""
    // Base status (path/pos/mode/count) is emitted in full — only the on-cursor
    // diagnostic message is bounded to the remaining width so it can't wrap.
    let modflag = if modified then " [+]" else ""
    var statusln = " " + path + modflag + "  " + str.from_int(ed.cy + 1) + ":" + str.from_int(ed.cx + 1) + "  " + modestr + dsum
    // An explicit `info` line (a gd/K result) wins over the passive on-cursor
    // diagnostic message; either is bounded to the remaining width.
    let cmsg = diag_msg_for_line(diag_li, diag_msgs, ed.cy)
    let showmsg = if str.len(info) > 0 then info else cmsg
    let room = cols - 1 - str.len(statusln)
    if str.len(showmsg) > 0 and room > 6
        let mm = if str.len(showmsg) > room - 2 then str.slice(showmsg, 0, room - 2) else showmsg
        statusln = statusln + "  " + mm
    emit(statusln)
    eol(clip, cols - str.len(statusln))   // fill the rest of the status bar with the status bg
    sgr("0")

@intent("""Place the hardware cursor at the active window's text cursor,
offset by the window origin and the (recomputed) gutter width, wrap-aware.
Split out of draw_window so a multi-window frame draws every window first,
then homes the cursor in the focused one.""")
fn place_cursor(ed: Editor, win: Rect, top: Int, left: Int, opts: Options) [io]
    let rx = win.x
    let ry = win.y
    let cols = win.w
    let nl = list.len(ed.lines)
    let numbered = opts.number or opts.relativenumber
    let numw = if num_digits(nl) > 3 then num_digits(nl) else 3
    let gutter = if numbered then numw + 1 else 0
    let width = if cols - gutter > 0 then cols - gutter else 1
    let curline = if ed.cy < nl then ed.lines[ed.cy] else ""
    let cviscol = vis_col(curline, ed.cx, opts.tabstop)
    if opts.wrap
        // screen row = rows used by lines [top, cy) + the cursor's own segment
        var crow = 0
        var ci = top
        while ci < ed.cy
            let cvl = str.len(expand_tabs(ed.lines[ci], opts.tabstop))
            crow = crow + (if cvl > width then (cvl + width - 1) / width else 1)
            ci = ci + 1
        cup(ry + crow + cviscol / width + 1, rx + (cviscol % width) + gutter + 1)
    else
        cup(ry + ed.cy - top + 1, rx + (cviscol - left) + gutter + 1)

@intent("""Single-window frame: hide the cursor, draw the one window, place the
cursor, restore it.  Byte-identical to the pre-split render — the interactive
driver calls this whenever there is exactly one window.""")
fn render(ed: Editor, win: Rect, path: Str, top: Int, left: Int, mode: Int, avy: Int, avx: Int, search: Str, cs: Colorscheme, opts: Options, diag_li: [Int], diag_msgs: [Str], info: Str, modified: Bool) [io]
    csi()
    emit("?25l")         // hide cursor while we repaint
    draw_window(ed, win, path, top, left, mode, avy, avx, search, cs, opts, diag_li, diag_msgs, info, modified, false, true)
    place_cursor(ed, win, top, left, opts)
    cursor_shape(mode)   // block in normal/visual, bar in insert, underline in replace
    csi()
    emit("?25h")         // show the cursor at its new home

// Split joined buffer text into lines, guaranteeing at least one (empty) line
// so an empty buffer still renders a cursor row.
fn lines_of(text: Str) -> [Str]
    let bl = str.split_lines(text)
    if list.len(bl) == 0 then [""] else bl

@intent("""Multi-window frame: hide the cursor once, draw every window in the
layout into its computed rect, then home the cursor in the active window.  Each
window draws its OWN buffer (win_buf): the active window and any pane showing
the same buffer draw the live `ed.lines`; a pane on a different buffer draws
that buffer's stored text (bufs_text), with its own path in the status line.
The active window draws from the live ed cursor / top / left and the real mode
(selection, INSERT, gd/K info); every other pane draws from its saved win_*
cursor/viewport in plain NORMAL mode.  Diagnostics + modified flag only follow
the live active buffer for now.""")
fn render_all(ed: Editor, lay: Layout, awin: Int, screen: Rect, win_cy: [Int], win_cx: [Int], win_top: [Int], win_left: [Int], win_buf: [Int], cur_buf: Int, bufs_text: [Str], bufs_path: [Str], path: Str, top: Int, left: Int, mode: Int, avy: Int, avx: Int, search: Str, cs: Colorscheme, opts: Options, diag_li: [Int], diag_msgs: [Str], info: Str, modified: Bool) [io]
    csi()
    emit("?25l")
    let rects = layout_rects(lay, screen, [])
    var i = 0
    while i < list.len(rects)
        let wid = rects[i]
        let wr = Rect { x: rects[i + 1], y: rects[i + 2], w: rects[i + 3], h: rects[i + 4] }
        let isact = wid == awin
        let bi = win_buf[wid]
        let same = bi == cur_buf            // shows the live (active) buffer
        let wcy = if isact then ed.cy else win_cy[wid]
        let wcx = if isact then ed.cx else win_cx[wid]
        let wtop = if isact then top else win_top[wid]
        let wleft = if isact then left else win_left[wid]
        let wmode = if isact then mode else 0
        let wavy = if isact then avy else wcy
        let wavx = if isact then avx else wcx
        let winfo = if isact then info else ""
        let wpath = if same then path else bufs_path[bi]
        let wlines = if same then ed.lines else lines_of(bufs_text[bi])
        let wdiag_li = if same then diag_li else []
        let wdiag_msgs = if same then diag_msgs else []
        let wmod = if same then modified else false
        let view = Editor { lines: wlines, cy: wcy, cx: wcx }
        // A window whose right edge is left of the screen edge (a vsplit's left
        // pane) must bounded-fill its rows, not erase-to-EOL into its neighbour.
        let clip = wr.x + wr.w < screen.w
        draw_window(view, wr, wpath, wtop, wleft, wmode, wavy, wavx, search, cs, opts, wdiag_li, wdiag_msgs, winfo, wmod, clip, isact)
        i = i + 5
    place_cursor(ed, window_rect(lay, awin, screen), top, left, opts)
    cursor_shape(mode)
    csi()
    emit("?25h")

@intent("""Paint one frame, dispatching on window count: a single window keeps
the proven byte-identical render path; two or more go through render_all.  (Not
named `frame` — that is a reserved word in Novo.)""")
fn paint_frame(ed: Editor, lay: Layout, awin: Int, cols: Int, rows: Int, win_cy: [Int], win_cx: [Int], win_top: [Int], win_left: [Int], win_buf: [Int], cur_buf: Int, bufs_text: [Str], bufs_path: [Str], path: Str, top: Int, left: Int, st: InputState, cs: Colorscheme, opts: Options, diag_li: [Int], diag_msgs: [Str], info: Str, modified: Bool) [io]
    let screen = Rect { x: 0, y: 0, w: cols, h: rows }
    if layout_count(lay) == 1
        render(ed, window_rect(lay, awin, screen), path, top, left, st.mode, st.avy, st.avx, st.search, cs, opts, diag_li, diag_msgs, info, modified)
    else
        render_all(ed, lay, awin, screen, win_cy, win_cx, win_top, win_left, win_buf, cur_buf, bufs_text, bufs_path, path, top, left, st.mode, st.avy, st.avx, st.search, cs, opts, diag_li, diag_msgs, info, modified)

fn term_rows() -> Int [io]
    let packed = novo_pty_get_winsize_h()
    let r = int.shr_logical(packed, 16)
    if r > 0 then r else 24

fn term_cols() -> Int [io]
    let packed = novo_pty_get_winsize_h()
    let c = bits.band(packed, 65535)
    if c > 0 then c else 80

// Drain the rest of a CSI/SS3 escape sequence (after the leading `ESC [` or
// `ESC O`) and return `param * 256 + finalByte`, or a negative value if the
// stream ended mid-sequence.  `param` is the leading decimal number (0 if none)
// — needed because the tilde-final keys share one final byte and differ only by
// it: `ESC[3~` Delete, `ESC[5~` PageUp, `ESC[6~` PageDown.  Remaining parameter
// / intermediate bytes (e.g. the `;5` of a `ESC[1;5A` Ctrl-arrow) are skipped.
// Recognising these stops their letters being fed in as editor commands —
// e.g. a focus-in `ESC[I` would otherwise read as `I` (insert mode).
fn csi_seq() -> Int [io]
    var param = 0
    var b = novo_pty_stdin_read_byte_h()
    while b >= '0' and b <= '9'                 // leading decimal parameter
        param = param * 10 + (b - '0')
        b = novo_pty_stdin_read_byte_h()
    while b >= ' ' and b <= '?'                 // further params / intermediates
        b = novo_pty_stdin_read_byte_h()
    if b < 0 then b else param * 256 + b

// Apply an arrow / Home / End key (decoded from a CSI/SS3 final byte) as a
// cursor move; any other final byte is ignored (returns `ed` unchanged), so
// focus events and report replies are harmless no-ops.  `allow_eol` lets the
// cursor sit one past the last char (insert/replace mode); otherwise it clamps
// to the last char like normal-mode motions.
fn arrow_move(ed: Editor, fin: Int, allow_eol: Bool) -> Editor
    let nl = list.len(ed.lines)
    if fin == 'D'                                  // ← left
        Editor { lines: ed.lines, cy: ed.cy, cx: if ed.cx > 0 then ed.cx - 1 else 0 }
    elif fin == 'C'                                // → right
        let m = str.len(line_at(ed, ed.cy))
        let cap = if allow_eol then m elif m > 0 then m - 1 else 0
        Editor { lines: ed.lines, cy: ed.cy, cx: if ed.cx < cap then ed.cx + 1 else cap }
    elif fin == 'A'                                // ↑ up
        let ny = if ed.cy > 0 then ed.cy - 1 else 0
        let m = str.len(line_at(ed, ny))
        let cap = if allow_eol then m elif m > 0 then m - 1 else 0
        Editor { lines: ed.lines, cy: ny, cx: if ed.cx < cap then ed.cx else cap }
    elif fin == 'B'                                // ↓ down
        let ny = if ed.cy + 1 < nl then ed.cy + 1 else nl - 1
        let m = str.len(line_at(ed, ny))
        let cap = if allow_eol then m elif m > 0 then m - 1 else 0
        Editor { lines: ed.lines, cy: ny, cx: if ed.cx < cap then ed.cx else cap }
    elif fin == 'H'                                // Home
        Editor { lines: ed.lines, cy: ed.cy, cx: 0 }
    elif fin == 'F'                                // End
        let m = str.len(line_at(ed, ed.cy))
        Editor { lines: ed.lines, cy: ed.cy, cx: if allow_eol then m elif m > 0 then m - 1 else 0 }
    else
        ed

// Recompute the horizontal offset for the current cursor: the text area is
// `cols` minus the line-number gutter, and the cursor's visual column must
// stay inside it.  Pure wrapper around hscroll_to used at each repaint site.
fn hscroll_for(left: Int, ed: Editor, opts: Options, cols: Int) -> Int
    if opts.wrap                                  // wrapped lines never scroll horizontally
        return 0
    let nl = list.len(ed.lines)
    let numw = if num_digits(nl) > 3 then num_digits(nl) else 3
    let gutter = if opts.number or opts.relativenumber then numw + 1 else 0
    hscroll_to(left, vis_col(line_at(ed, ed.cy), ed.cx, opts.tabstop), cols - gutter)

// Adjust the viewport top so the cursor line is visible in `body` rows.
fn scroll_to(top: Int, cy: Int, body: Int) -> Int
    var t = top
    if cy < t
        t = cy
    if cy >= t + body
        t = cy - body + 1
    if t < 0
        t = 0
    t

// ── Viewport scrolling: Ctrl-D/U/F/B + zz/zt/zb ───────────────────
// These are driver-level (they touch the `top` viewport, which `feed` does not
// know about).  `kind`: 0 Ctrl-D (½ down), 1 Ctrl-U (½ up), 2 Ctrl-F (page
// down), 3 Ctrl-B (page up), 4 zz (centre), 5 zt (cursor→top), 6 zb (→bottom).

// Only treat a scroll key as a scroll when input is idle — otherwise `z` would
// steal the register/mark name from `qz` / `"z` / `mz`, and Ctrl-D a find target.
fn scroll_idle(st: InputState, es: EditState) -> Bool
    st.mode == 0 and st.pending == 0 and st.count == 0 and es.awaitmac == 0 and (not es.awaitreg) and es.awaitmark == 0

// New cursor line after a paging command (zz/zt/zb leave the cursor put).
fn scroll_new_cy(ed: Editor, rows: Int, kind: Int) -> Int
    let body = rows - 1
    let half = if body / 2 > 0 then body / 2 else 1
    let page = if body - 2 > 0 then body - 2 else 1
    let nl = list.len(ed.lines)
    var ncy = ed.cy
    if kind == 0
        ncy = ed.cy + half
    elif kind == 1
        ncy = ed.cy - half
    elif kind == 2
        ncy = ed.cy + page
    elif kind == 3
        ncy = ed.cy - page
    if ncy < 0
        ncy = 0
    if ncy > nl - 1
        ncy = nl - 1
    ncy

// New viewport top after a scroll command.
fn scroll_new_top(cy: Int, top: Int, rows: Int, kind: Int) -> Int
    let body = rows - 1
    let half = if body / 2 > 0 then body / 2 else 1
    let page = if body - 2 > 0 then body - 2 else 1
    var t = top
    if kind == 0
        t = top + half
    elif kind == 1
        t = top - half
    elif kind == 2
        t = top + page
    elif kind == 3
        t = top - page
    elif kind == 4                       // zz — centre the cursor
        t = cy - body / 2
    elif kind == 5                       // zt — cursor to the top
        t = cy
    elif kind == 6                       // zb — cursor to the bottom
        t = cy - body + 1
    if t < 0
        t = 0
    t

// Decode a z-prefix second byte into a kind (4/5/6), or -1 if not z/t/b.
fn scroll_z_kind(b: Int) -> Int
    if b == 'z' then 4 elif b == 't' then 5 elif b == 'b' then 6 else 0 - 1

// Decode a Ctrl paging byte into a kind (0..3), or -1 if not a paging key.
fn scroll_ctrl_kind(b: Int) -> Int
    if b == '\x04' then 0 elif b == '\x15' then 1 elif b == '\x06' then 2 elif b == '\x02' then 3 else 0 - 1

// Target buffer line for the screen motions H / M / L (kind 0/1/2) given the
// current viewport [top, top+body) clamped to the buffer.
fn screen_target(top: Int, rows: Int, nl: Int, kind: Int) -> Int
    let body = rows - 1
    let last_vis = if top + body - 1 < nl - 1 then top + body - 1 else nl - 1
    var t = top
    if kind == 1
        t = top + (last_vis - top) / 2       // M — middle of the visible lines
    elif kind == 2
        t = last_vis                         // L — bottom visible line
    if t < 0
        t = 0
    if t > nl - 1
        t = nl - 1
    t

// Decode H / M / L into a kind (0/1/2), or -1.
fn screen_kind(b: Int) -> Int
    if b == 'H' then 0 elif b == 'M' then 1 elif b == 'L' then 2 else 0 - 1

// A scroll / screen key is only handled by the driver when the user hasn't
// remapped it — otherwise the keymap (applied inside feed) must win.
fn key_free(km: Keymap, b: Int) -> Bool
    str.len(keymap_lookup(km, b)) == 0

@intent("""The interactive editor driver: set raw mode, load config + the first
file (plus any `extra` newline-joined files as additional buffers), then loop —
poll stdin and the language server, fold input bytes through `feed_edit`, run
the deferred buffer/window switches, debounce `didChange`, route diagnostics by
URI, and repaint.  Owns ALL session state the pure `feed` must not: the buffer
list and per-buffer view/undo/marks/diagnostics, registers, the jumplist, the
LSP connection, and the screen.  `path` is the first file; `extra` carries the
rest (a Str, not [Str] — a [Str] param here reproducibly corrupted the
buffer-switch codegen; see the bug filed in features/orbits/novim).""")
fn run_interactive(cfg_path: Str, path: Str, extra: Str) [io, time]
    let _ = novo_pty_set_raw_mode_h()
    var curpath = path                   // the open file; `:e` switches it
    var ed = Editor { lines: buf_load(path), cy: 0, cx: 0 }
    var disk_text = buf_text(ed)         // last-saved/loaded text, for the :e dirty guard
    var st = ist_new()
    var es = edit_new()
    let km = load_keymaps(cfg_path)
    let cs = load_colorscheme(cfg_path)
    var opts = load_options(cfg_path)
    var rows = term_rows()
    var cols = term_cols()
    var top = 0
    var left = 0
    var cmd_mode = false
    var cmd_buf = ""
    var search_mode = false
    var search_buf = ""
    var search_back = false
    var zpend = false                    // awaiting the 2nd byte of a `z` scroll command
    var esc_pushback = 0 - 99            // one-byte pushback: the key after a lone ESC
    var last_subst = ""                  // last :s command, for `&`
    // ── LSP (novols) live state.  All async I/O lives here in the
    // driver, never in the pure `feed` path.  `lsp_pid < 0` means no server.
    var lsp_pid = 0 - 1
    var lsp_in = 0
    var lsp_out = 0
    var lsp_ver = 1
    var lsp_uri = "file://" + path
    var lsp_lasttext = ""
    var diag_li: [Int] = []
    var diag_msgs: [Str] = []
    var lsp_reqid = 1                    // monotonic id for gd/K requests (init used 1)
    var lsp_info = ""                    // transient status message (gd/K result)
    var gpend = false                    // awaiting the 2nd byte of a `g` command (gd)
    // ── Window splits (slice 102: stacked `:split` only) ────────────────────
    // `lay` is the window-layout tree; `awin` is the focused window id (also an
    // index into the win_* arrays).  Every window views the one active buffer
    // (ed.lines); only the cursor/viewport differ per window.  The active
    // window's live state is ed.cy/ed.cx/top/left; win_* holds the OTHER
    // windows' saved state, synced on every focus change / split.
    var lay = LWin(0)
    var awin = 0
    var win_cy: [Int] = [0]
    var win_cx: [Int] = [0]
    var win_top: [Int] = [0]
    var win_left: [Int] = [0]
    var win_buf: [Int] = [0]             // which buffer index each window displays
    var wpend = false                    // awaiting the 2nd byte of a Ctrl-W command
    var comp_active = false              // Ctrl-N/P completion cycle in progress
    var comp_cands: [Str] = []           // filtered candidate labels
    var comp_idx = 0                     // current candidate
    var comp_start = 0                   // column where the completed prefix begins
    // Jumplist (browser-style back/forward) for Ctrl-O / Ctrl-I.  Each stack
    // holds "y|x|path" entries (file-aware, so a jump across files round-trips);
    // a jump pushes the origin onto `jback` and clears `jfwd`.
    var jback: [Str] = []
    var jfwd: [Str] = []
    // ── Buffer list (multiple files open at once) ───────────────────────────
    // Each buffer's working copy lives in the active `ed`/`top`/`left`/`curpath`/
    // `disk_text`; on switch it's saved back into these parallel stores and the
    // target restored.  Content is stored joined (`bufs_text`) to avoid nesting
    // `[[Str]]`.  `cur_buf` indexes the active buffer.
    var bufs_text: [Str] = [buf_text(ed)]
    var bufs_path: [Str] = [path]
    var bufs_cy: [Int] = [0]
    var bufs_cx: [Int] = [0]
    var bufs_top: [Int] = [0]
    var bufs_left: [Int] = [0]
    var bufs_disk: [Str] = [disk_text]
    var bufs_undo: [Str] = [""]      // per-buffer serialized undo stack
    var bufs_redo: [Str] = [""]      // per-buffer serialized redo stack
    var bufs_marky: [Str] = [""]     // per-buffer marks a-z: serialized lines
    var bufs_markx: [Str] = [""]     // per-buffer marks a-z: serialized columns
    var bufs_diag: [Str] = [""]      // per-buffer serialized diagnostics (multi-doc LSP)
    var bufs_lspopen: [Bool] = [false]  // whether each buffer's doc is open in novols
    var cur_buf = 0
    var alt_buf = 0 - 1              // alternate buffer (last visited) for Ctrl-^ / :b#
    var arglist: [Str] = [path]     // the CLI argument list (:args / :next / :prev)
    var arg_idx = 0                 // current position in the argument list
    // Extra command-line files (`novim a b c`) become additional buffers.  They
    // arrive newline-joined in `extra` (a Str — passing a `[Str]` parameter to
    // this function reproducibly corrupted the buffer-switch codegen).
    let extra_files = str.split_lines(extra)
    var efi = 0
    while efi < list.len(extra_files)
        let ef = extra_files[efi]
        if str.len(ef) > 0
            let eft = file_to_text(ef)
            bufs_text = list.push(bufs_text, eft)
            bufs_path = list.push(bufs_path, ef)
            bufs_cy = list.push(bufs_cy, 0)
            bufs_cx = list.push(bufs_cx, 0)
            bufs_top = list.push(bufs_top, 0)
            bufs_left = list.push(bufs_left, 0)
            bufs_disk = list.push(bufs_disk, eft)
            bufs_undo = list.push(bufs_undo, "")
            bufs_redo = list.push(bufs_redo, "")
            bufs_marky = list.push(bufs_marky, "")
            bufs_markx = list.push(bufs_markx, "")
            bufs_diag = list.push(bufs_diag, "")
            bufs_lspopen = list.push(bufs_lspopen, false)
            arglist = list.push(arglist, ef)
        efi = efi + 1
    // Deferred buffer switch: `:e`/`:bn`/`:bp`/cross-file gd / cross-file
    // Ctrl-O all set `want_path` (+ target cursor, or `want_y < 0` to restore the
    // buffer's saved cursor); one block after the input drain finds-or-creates
    // the buffer, saves the current one, and activates it (LSP didClose/didOpen).
    var want_path = ""
    var want_y = 0
    var want_x = 0
    var want_close = ""
    // Deferred window command (set by `:split` / `:vsplit` / `Ctrl-W s/v/c/q`,
    // run after the input drain): 0 none · 1 hsplit · 3 close · 4 vsplit.
    var pending_wcmd = 0
    // Deferred focus change to this window id (Ctrl-W w / h / j / k / l); -1 none.
    var pending_focus = 0 - 1
    var buflist = false                  // `:ls` — show the buffer-list overlay until the next key
    var modified = false                 // active buffer differs from disk → status `[+]`
    var lsp_dirty = false                // buffer changed since the last didChange
    var lsp_idle = 0                      // consecutive idle poll cycles (debounce)
    var lsp_phase = 0                    // 0 none · 1 init sent (awaiting result) · 2 ready
    if ends_with_nv(path)
        lsp_pid = lsp.lsp_spawn()
        if lsp_pid >= 0
            lsp_in = proc.stdin_fd(lsp_pid)
            lsp_out = proc.stdout_fd(lsp_pid)
            // Fire `initialize` and move on — the handshake completes
            // asynchronously in the loop so a big file appears instantly
            // instead of blocking on novols' (slow) initialize result.
            lsp.lsp_send(lsp_in, lsp.lsp_init_req(lsp_uri))
            lsp_phase = 1
    clear_screen()       // one-time clear of whatever was on screen before
    left = hscroll_for(left, ed, opts, cols)
    paint_frame(ed, lay, awin, cols, rows, win_cy, win_cx, win_top, win_left, win_buf, cur_buf, bufs_text, bufs_path, curpath, top, left, st, cs, opts, diag_li, diag_msgs, lsp_info, modified)
    var running = true
    while running
        // Short stdin poll keeps the editor responsive while leaving slack to
        // drain novols' stdout each iteration (combined two-fd poll).
        let m = novo_pty_poll_h(0, 50)       // poll host stdin (fd 0)
        var changed = false
        if m % 2 == 1
            lsp_info = ""                 // a transient gd/K message lasts until the next key
            buflist = false               // the :ls overlay is dismissed by the next key
            var done = false
            while not done
                var b = 0
                if esc_pushback != 0 - 99             // a key stashed after a lone ESC
                    b = esc_pushback
                    esc_pushback = 0 - 99
                else
                    b = novo_pty_stdin_read_byte_h()
                // Resolve terminal escape sequences (CSI `ESC [`, SS3 `ESC O`)
                // before dispatch so their final letters aren't read as editor
                // commands.  Arrow / Home / End move the cursor; everything else
                // (focus events, device-attribute / cursor-position replies) is
                // ignored.  A lone ESC, or ESC + another key, is delivered as ESC.
                var esc_skip = false
                if b == '\e'
                    let nx = novo_pty_stdin_read_byte_h()
                    if nx == '[' or nx == 'O'
                        let packed = csi_seq()
                        if packed >= 0 and not cmd_mode and not search_mode
                            let fin = packed % 256
                            let prm = packed / 256
                            let ins = st.mode == 1 or st.mode == 4
                            if fin == '~' and prm == 5         // PageUp (~ Ctrl-B)
                                ed = clamp(Editor { lines: ed.lines, cy: scroll_new_cy(ed, rows, 3), cx: ed.cx })
                                top = scroll_new_top(ed.cy, top, rows, 3)
                            elif fin == '~' and prm == 6       // PageDown (~ Ctrl-F)
                                ed = clamp(Editor { lines: ed.lines, cy: scroll_new_cy(ed, rows, 2), cx: ed.cx })
                                top = scroll_new_top(ed.cy, top, rows, 2)
                            elif fin == '~' and prm == 3       // Delete — forward-delete the char at the cursor
                                if ins
                                    let ln = line_at(ed, ed.cy)
                                    if ed.cx < str.len(ln)
                                        es = edit_push_undo(es, ed)
                                        let newln = str.slice(ln, 0, ed.cx) + str.slice(ln, ed.cx + 1, str.len(ln))
                                        ed = Editor { lines: set_line(ed.lines, ed.cy, newln), cy: ed.cy, cx: ed.cx }
                                else
                                    let dstep = feed_edit(ed, st, km, es, 'x')   // normal/visual: like `x`
                                    ed = dstep.ed
                                    st = dstep.st
                                    es = dstep.es
                            elif fin == '~' and (prm == 1 or prm == 7)   // Home
                                ed = arrow_move(ed, 'H', ins)
                            elif fin == '~' and (prm == 4 or prm == '\b')   // End
                                ed = arrow_move(ed, 'F', ins)
                            elif fin != '~'                    // arrows / Home(H) / End(F)
                                ed = arrow_move(ed, fin, ins)
                        esc_skip = true
                    elif nx >= 0
                        esc_pushback = nx
                if esc_skip
                    done = done                      // sequence consumed — no editor action
                elif b == -2
                    done = true
                elif b == -1
                    done = true
                    running = false
                elif cmd_mode
                    if b == '\r' or b == '\n'            // Enter — run command
                        if is_substitute(cmd_buf)
                            es = edit_push_undo(es, ed)
                            ed = ex_substitute(ed, cmd_buf)
                            last_subst = cmd_buf
                        elif is_global(cmd_buf)
                            es = edit_push_undo(es, ed)
                            ed = ex_global(ed, cmd_buf)
                        elif is_goto(cmd_buf)
                            jback = list.push(jback, jentry(curpath, ed.cy, ed.cx))
                            jfwd = []
                            ed = ex_goto(ed, cmd_buf)
                        elif is_set(cmd_buf)
                            opts = apply_set(opts, cmd_buf)
                            left = hscroll_for(left, ed, opts, cols)
                        elif is_fmt(cmd_buf)
                            if lsp_phase == 2
                                lsp_reqid = lsp_reqid + 1
                                lsp.lsp_send(lsp_in, lsp.lsp_formatting_req(lsp_reqid, lsp_uri, opts.tabstop))
                                let fresp = lsp.lsp_pump(lsp_out, lsp_reqid, 40)
                                if str.len(fresp) == 0
                                    lsp_info = "format: no response"
                                else
                                    let nt = lsp.lsp_fmt_newtext(fresp)
                                    if str.len(nt) == 0
                                        lsp_info = "format: no changes"
                                    else
                                        es = edit_push_undo(es, ed)
                                        let nls = str.split_lines(nt)
                                        ed = clamp(Editor { lines: if list.len(nls) == 0 then [""] else nls, cy: ed.cy, cx: ed.cx })
                                        // refresh diagnostics for the reformatted buffer
                                        lsp_lasttext = buf_text(ed)
                                        lsp_ver = lsp_ver + 1
                                        lsp.lsp_send(lsp_in, lsp.lsp_didchange(lsp_uri, lsp_ver, lsp_lasttext))
                                        lsp_info = "formatted"
                            else
                                lsp_info = "format: LSP not ready"
                        elif is_sym(cmd_buf)
                            if lsp_phase == 2
                                let q = sym_query(cmd_buf)
                                lsp_reqid = lsp_reqid + 1
                                lsp.lsp_send(lsp_in, lsp.lsp_documentsymbol_req(lsp_reqid, lsp_uri))
                                let sresp = lsp.lsp_pump(lsp_out, lsp_reqid, 40)
                                if str.len(sresp) == 0
                                    lsp_info = "sym: no response"
                                else
                                    let snames = lsp.lsp_sym_names(sresp)
                                    let spos = lsp.lsp_sym_pos(sresp)
                                    var found = 0 - 1
                                    var si = 0
                                    while si < list.len(snames) and found < 0
                                        if str.len(q) == 0 or util.index_of_str(snames[si], q) >= 0
                                            found = si
                                        si = si + 1
                                    if found >= 0 and found * 2 + 1 < list.len(spos)
                                        jback = list.push(jback, jentry(curpath, ed.cy, ed.cx))
                                        jfwd = []
                                        ed = clamp(Editor { lines: ed.lines, cy: spos[found * 2], cx: spos[found * 2 + 1] })
                                        lsp_info = "sym: " + snames[found]
                                    else
                                        lsp_info = "sym: no match"
                            else
                                lsp_info = "sym: LSP not ready"
                        elif is_rename(cmd_buf)
                            if lsp_phase != 2
                                lsp_info = "rename: LSP not ready"
                            else
                                let nn = rename_query(cmd_buf)
                                if str.len(nn) == 0
                                    lsp_info = "rename: usage :rename <newname>"
                                else
                                    lsp_reqid = lsp_reqid + 1
                                    lsp.lsp_send(lsp_in, lsp.lsp_rename_req(lsp_reqid, lsp_uri, ed.cy, ed.cx, nn))
                                    let rresp = lsp.lsp_pump(lsp_out, lsp_reqid, 40)
                                    if str.len(rresp) == 0
                                        lsp_info = "rename: no response"
                                    else
                                        let nts = lsp.lsp_rename_newtexts(rresp)
                                        if list.len(nts) == 0
                                            lsp_info = "rename: no occurrences"
                                        else
                                            let trips = lsp.lsp_rename_triples(rresp)
                                            es = edit_push_undo(es, ed)
                                            ed = clamp(apply_rename(ed, trips, nts))
                                            lsp_lasttext = buf_text(ed)
                                            lsp_ver = lsp_ver + 1
                                            lsp.lsp_send(lsp_in, lsp.lsp_didchange(lsp_uri, lsp_ver, lsp_lasttext))
                                            lsp_info = "renamed " + str.from_int(list.len(nts)) + " sites"
                        elif is_reload(cmd_buf)            // bare :e / :e! — reload from disk
                            let bang = util.index_of_byte(cmd_buf, '!') >= 0
                            if (not bang) and buf_text(ed) != disk_text
                                lsp_info = "unsaved changes (:e! to override)"
                            else
                                let fresh = file_to_text(curpath)
                                es = edit_push_undo(es, ed)
                                let fl = str.split_lines(fresh)
                                ed = clamp(Editor { lines: if list.len(fl) == 0 then [""] else fl, cy: ed.cy, cx: ed.cx })
                                disk_text = buf_text(ed)
                                if lsp_phase == 2
                                    lsp_lasttext = buf_text(ed)
                                    lsp_ver = lsp_ver + 1
                                    lsp.lsp_send(lsp_in, lsp.lsp_didchange(lsp_uri, lsp_ver, lsp_lasttext))
                                lsp_info = "reloaded " + basename_of(curpath)
                        elif is_edit_cmd(cmd_buf)
                            let tgt = edit_cmd_path(cmd_buf)
                            if str.len(tgt) == 0
                                lsp_info = "edit: usage :e <file>"
                            else                          // open/switch the buffer (edits are preserved in memory)
                                jback = list.push(jback, jentry(curpath, ed.cy, ed.cx))
                                jfwd = []
                                want_path = tgt
                                want_y = 0 - 1            // restore the buffer's saved cursor
                                want_x = 0
                                lsp_info = str.from_char('"') + tgt + str.from_char('"')
                        elif is_bufdo(cmd_buf)            // :bufdo <subcmd> — substitute across all buffers
                            let sub = cmd_arg(cmd_buf)
                            if not is_substitute(sub)
                                lsp_info = "bufdo: only :s/:%s supported"
                            else
                                es = edit_push_undo(es, ed)   // active buffer
                                ed = ex_substitute(ed, sub)
                                var bi = 0                     // stored buffers
                                while bi < list.len(bufs_text)
                                    if bi != cur_buf
                                        let pre = bufs_text[bi]
                                        let nt = sub_text(pre, sub)
                                        if nt != pre
                                            bufs_undo = util.set_str_at(bufs_undo, bi, undo_push_text(bufs_undo[bi], pre))
                                            bufs_redo = util.set_str_at(bufs_redo, bi, "")
                                            bufs_text = util.set_str_at(bufs_text, bi, nt)
                                    bi = bi + 1
                                if lsp_phase == 2
                                    lsp_lasttext = buf_text(ed)
                                    lsp_ver = lsp_ver + 1
                                    lsp.lsp_send(lsp_in, lsp.lsp_didchange(lsp_uri, lsp_ver, lsp_lasttext))
                                lsp_info = "bufdo: " + str.from_int(list.len(bufs_text)) + " buffers"
                        elif is_badd(cmd_buf)            // :badd <file> — add buffer without switching
                            let tgt = cmd_arg(cmd_buf)
                            if str.len(tgt) == 0
                                lsp_info = "badd: usage :badd <file>"
                            elif buf_index_of(bufs_path, tgt) >= 0
                                lsp_info = "already open: " + basename_of(tgt)
                            else
                                bufs_text = list.push(bufs_text, file_to_text(tgt))
                                bufs_path = list.push(bufs_path, tgt)
                                bufs_cy = list.push(bufs_cy, 0)
                                bufs_cx = list.push(bufs_cx, 0)
                                bufs_top = list.push(bufs_top, 0)
                                bufs_left = list.push(bufs_left, 0)
                                bufs_disk = list.push(bufs_disk, file_to_text(tgt))
                                bufs_undo = list.push(bufs_undo, "")
                                bufs_redo = list.push(bufs_redo, "")
                                bufs_marky = list.push(bufs_marky, "")
                                bufs_markx = list.push(bufs_markx, "")
                                bufs_diag = list.push(bufs_diag, "")
                                bufs_lspopen = list.push(bufs_lspopen, false)
                                if ends_with_nv(tgt) and lsp_phase == 2   // open the doc so its diagnostics go live
                                    lsp.lsp_send(lsp_in, lsp.lsp_didopen("file://" + tgt, file_to_text(tgt)))
                                    bufs_lspopen = util.set_bool_at(bufs_lspopen, list.len(bufs_path) - 1, true)
                                lsp_info = "added " + basename_of(tgt) + "; " + str.from_int(list.len(bufs_path)) + " buffers"
                        elif argcmd_kind(cmd_buf) > 0    // :args / :next / :prev / :first / :last / :wn / :wN
                            let ak = argcmd_kind(cmd_buf)
                            let na = list.len(arglist)
                            if ak == 1                    // :args — show the list
                                lsp_info = arglist_str(arglist, arg_idx)
                            else
                                let tgt = if ak == 2 or ak == 6 then arg_idx + 1 elif ak == 3 or ak == 7 then arg_idx - 1 elif ak == 4 then 0 else na - 1
                                if tgt < 0 or tgt >= na
                                    lsp_info = if tgt < 0 then "at first arg" else "at last arg"
                                else
                                    if ak == 6 or ak == 7     // :wn / :wN — write current first
                                        save_buf(curpath, ed.lines)
                                        disk_text = buf_text(ed)
                                    arg_idx = tgt
                                    jback = list.push(jback, jentry(curpath, ed.cy, ed.cx))
                                    jfwd = []
                                    want_path = arglist[tgt]
                                    want_y = 0 - 1
                                    want_x = 0
                        elif is_bufcmd(cmd_buf)
                            let nb = list.len(bufs_path)
                            let bk = bufcmd_kind(cmd_buf)
                            if bk == 0                    // :ls — show the buffer list overlay
                                buflist = true
                            elif bk == 3                  // :bd — close current
                                if nb <= 1
                                    lsp_info = "cannot close the last buffer"
                                else
                                    let surv = if cur_buf > 0 then cur_buf - 1 else 1
                                    want_close = curpath
                                    want_path = bufs_path[surv]
                                    want_y = 0 - 1
                                    want_x = 0
                            else                          // navigation: bn/bp/bfirst/blast
                                let tgt2 = if bk == 1 then (cur_buf + 1) % nb elif bk == 2 then (cur_buf + nb - 1) % nb elif bk == 4 then 0 else nb - 1
                                jback = list.push(jback, jentry(curpath, ed.cy, ed.cx))
                                jfwd = []
                                want_path = bufs_path[tgt2]
                                want_y = 0 - 1
                                want_x = 0
                        elif is_bgoto(cmd_buf)             // :b <n> / :b <name> / :b#
                            let barg = bgoto_arg(cmd_buf)
                            let bn2 = bgoto_target(cmd_buf)
                            // `#` = alternate buffer; a number switches by index;
                            // otherwise match a filename
                            let bidx = if barg == "#" then alt_buf elif bn2 >= 1 and bn2 <= list.len(bufs_path) then bn2 - 1 else buf_find_by_name(bufs_path, barg)
                            if bidx >= 0
                                jback = list.push(jback, jentry(curpath, ed.cy, ed.cx))
                                jfwd = []
                                want_path = bufs_path[bidx]
                                want_y = 0 - 1
                                want_x = 0
                            else
                                lsp_info = "no buffer matching " + barg
                        elif writeall_kind(cmd_buf) > 0   // :wa / :wqa / :xa / :qa
                            let wk = writeall_kind(cmd_buf)
                            if wk == 1 or wk == 2
                                let n = write_all_bufs(bufs_path, bufs_text, bufs_disk, cur_buf, ed, disk_text)
                                disk_text = buf_text(ed)
                                bufs_disk = mark_all_saved(bufs_text, bufs_disk)
                                lsp_info = "wrote " + str.from_int(n) + " buffer(s)"
                            let blocked = wk == 3 and buffers_modified(bufs_text, bufs_disk, cur_buf, buf_text(ed), disk_text)
                            if blocked
                                lsp_info = "unsaved buffers (:qa! to override)"
                            elif wk == 2 or wk == 3 or wk == 4
                                running = false
                                done = true
                        elif is_split(cmd_buf)            // :split / :sp — stacked window split
                            pending_wcmd = 1
                        elif is_vsplit(cmd_buf)           // :vsplit / :vs — side-by-side split
                            pending_wcmd = 4
                        elif is_winclose(cmd_buf) and layout_count(lay) > 1   // :close / :q with splits → close window
                            pending_wcmd = 3
                        elif is_only(cmd_buf)            // :only — keep just the active window
                            pending_wcmd = 5
                        else
                            let r = exec_ex(cmd_buf)
                            if r.save
                                save_buf(curpath, ed.lines)
                                disk_text = buf_text(ed)
                            if r.quit
                                if (not r.save) and util.index_of_byte(cmd_buf, '!') < 0 and buffers_modified(bufs_text, bufs_disk, cur_buf, buf_text(ed), disk_text)
                                    lsp_info = "unsaved buffers (:q! to override)"
                                else
                                    running = false
                                    done = true
                        cmd_mode = false
                        cmd_buf = ""
                    elif b == '\e'                     // Esc — cancel
                        cmd_mode = false
                        cmd_buf = ""
                    elif b == '\x7f' or b == '\b'
                        if str.len(cmd_buf) > 0
                            cmd_buf = str.slice(cmd_buf, 0, str.len(cmd_buf) - 1)
                    elif b >= ' ' and b < '\x7f'
                        cmd_buf = cmd_buf + str.from_char(b)
                elif search_mode
                    if b == '\r' or b == '\n'
                        st = ist_set_search(st, search_buf)
                        jback = list.push(jback, jentry(curpath, ed.cy, ed.cx))
                        jfwd = []
                        ed = find_next(ed, search_buf, not search_back)
                        search_mode = false
                        search_buf = ""
                    elif b == '\e'
                        search_mode = false
                        search_buf = ""
                    elif b == '\x7f' or b == '\b'
                        if str.len(search_buf) > 0
                            search_buf = str.slice(search_buf, 0, str.len(search_buf) - 1)
                    elif b >= ' ' and b < '\x7f'
                        search_buf = search_buf + str.from_char(b)
                elif zpend                            // 2nd byte of a `z` command
                    zpend = false
                    let zk = scroll_z_kind(b)
                    if zk >= 0
                        top = scroll_new_top(ed.cy, top, rows, zk)
                elif wpend                            // 2nd byte of a Ctrl-W window command
                    wpend = false
                    if b == 's' or b == 'S' or b == 19   // Ctrl-W s / S / Ctrl-S — horizontal split
                        pending_wcmd = 1
                    elif b == 'v' or b == 'V' or b == 22 // Ctrl-W v / V / Ctrl-V — vertical split
                        pending_wcmd = 4
                    elif b == 'w' or b == 23             // Ctrl-W w / Ctrl-W Ctrl-W — cycle focus
                        pending_focus = win_cycle_next(lay, awin)
                    elif b == 'h'                        // Ctrl-W h — focus window to the left
                        pending_focus = window_in_dir(lay, awin, Rect { x: 0, y: 0, w: cols, h: rows }, 0)
                    elif b == 'j'                        // Ctrl-W j — focus window below
                        pending_focus = window_in_dir(lay, awin, Rect { x: 0, y: 0, w: cols, h: rows }, 1)
                    elif b == 'k'                        // Ctrl-W k — focus window above
                        pending_focus = window_in_dir(lay, awin, Rect { x: 0, y: 0, w: cols, h: rows }, 2)
                    elif b == 'l'                        // Ctrl-W l — focus window to the right
                        pending_focus = window_in_dir(lay, awin, Rect { x: 0, y: 0, w: cols, h: rows }, 3)
                    elif b == 'c' or b == 'q' or b == 17 // Ctrl-W c / q / Ctrl-Q — close active window
                        pending_wcmd = 3
                    elif b == 'o' or b == 15             // Ctrl-W o / Ctrl-O — close all but the active window
                        pending_wcmd = 5
                elif gpend                            // 2nd byte of a `g` (gd intercept)
                    gpend = false
                    if b == 'd' and lsp_phase == 2      // `gd` — go to definition
                        lsp_reqid = lsp_reqid + 1
                        lsp.lsp_send(lsp_in, lsp.lsp_pos_req(lsp_reqid, "textDocument/definition", lsp_uri, ed.cy, ed.cx))
                        let resp = lsp.lsp_pump(lsp_out, lsp_reqid, 20)
                        if str.len(resp) == 0
                            lsp_info = "definition: no response"
                        else
                            let dpos = lsp.lsp_def_pos(resp)
                            if list.len(dpos) >= 2
                                let duri = lsp.lsp_def_uri(resp)
                                if duri == lsp_uri or duri == ""
                                    jback = list.push(jback, jentry(curpath, ed.cy, ed.cx))
                                    jfwd = []
                                    ed = clamp(Editor { lines: ed.lines, cy: dpos[0], cx: dpos[1] })
                                    lsp_info = "definition"
                                else                               // cross-file: record + switch buffer
                                    jback = list.push(jback, jentry(curpath, ed.cy, ed.cx))
                                    jfwd = []
                                    want_path = uri_to_path(duri)
                                    want_y = dpos[0]
                                    want_x = dpos[1]
                                    lsp_info = "definition"
                            else
                                lsp_info = "no definition found"
                    else                              // not `gd` — replay g + this byte
                        let jy = ed.cy
                        let jx = ed.cx
                        let g1 = feed_edit(ed, st, km, es, 'g')
                        ed = g1.ed
                        st = g1.st
                        es = g1.es
                        let g2 = feed_edit(ed, st, km, es, b)
                        ed = g2.ed
                        st = g2.st
                        es = g2.es
                        if b == 'g' and ed.cy != jy   // gg moved — record the jump
                            jback = list.push(jback, jentry(curpath, jy, jx))
                            jfwd = []
                elif scroll_idle(st, es) and key_free(km, 23) and b == 23   // Ctrl-W — window command prefix
                    wpend = true
                elif lsp_phase == 2 and scroll_idle(st, es) and key_free(km, 'g') and b == 'g'   // 'g' — await d (gd)
                    gpend = true
                elif lsp_phase == 2 and scroll_idle(st, es) and key_free(km, 'K') and b == 'K'   // K — hover
                    lsp_reqid = lsp_reqid + 1
                    lsp.lsp_send(lsp_in, lsp.lsp_pos_req(lsp_reqid, "textDocument/hover", lsp_uri, ed.cy, ed.cx))
                    let hresp = lsp.lsp_pump(lsp_out, lsp_reqid, 20)
                    if str.len(hresp) == 0
                        lsp_info = "hover: no response"
                    else
                        let htext = lsp.hover_oneline(lsp.lsp_hover_text(hresp))
                        lsp_info = if str.len(htext) > 0 then htext else "no hover info"
                elif scroll_idle(st, es) and key_free(km, b) and b == 'z'   // 'z' — await z/t/b
                    zpend = true
                elif scroll_idle(st, es) and key_free(km, b) and scroll_ctrl_kind(b) >= 0   // Ctrl-D/U/F/B
                    let k = scroll_ctrl_kind(b)
                    ed = clamp(Editor { lines: ed.lines, cy: scroll_new_cy(ed, rows, k), cx: ed.cx })
                    top = scroll_new_top(ed.cy, top, rows, k)
                elif scroll_idle(st, es) and key_free(km, b) and screen_kind(b) >= 0        // H / M / L
                    let ty = screen_target(top, rows, list.len(ed.lines), screen_kind(b))
                    ed = clamp(Editor { lines: ed.lines, cy: ty, cx: first_nonblank(line_at(ed, ty)) })
                elif scroll_idle(st, es) and key_free(km, b) and b == '&' and str.len(last_subst) > 0   // & — repeat last :s
                    es = edit_push_undo(es, ed)
                    ed = ex_substitute(ed, subst_current_line(last_subst))
                elif scroll_idle(st, es) and key_free(km, b) and (b == '\x05' or b == '\x19')   // Ctrl-E / Ctrl-Y — scroll one line
                    let body = rows - 1
                    let nl = list.len(ed.lines)
                    if b == '\x05'                     // Ctrl-E — view down
                        top = if top + 1 < nl then top + 1 else top
                    else                             // Ctrl-Y — view up
                        top = if top - 1 > 0 then top - 1 else 0
                    var ncy = ed.cy                  // keep the cursor on screen
                    if ncy < top
                        ncy = top
                    if ncy > top + body - 1
                        ncy = top + body - 1
                    ed = clamp(Editor { lines: ed.lines, cy: ncy, cx: ed.cx })
                elif scroll_idle(st, es) and key_free(km, b) and b == '\x0f' and list.len(jback) >= 1   // Ctrl-O — jump back
                    let e = jback[list.len(jback) - 1]
                    let tf = jentry_path(e)
                    if tf == curpath                       // in-buffer jump
                        jfwd = list.push(jfwd, jentry(curpath, ed.cy, ed.cx))
                        jback = drop_last_str(jback)
                        ed = clamp(Editor { lines: ed.lines, cy: jentry_y(e), cx: jentry_x(e) })
                    else                                   // cross-file — switch buffer
                        jfwd = list.push(jfwd, jentry(curpath, ed.cy, ed.cx))
                        jback = drop_last_str(jback)
                        want_path = tf
                        want_y = jentry_y(e)
                        want_x = jentry_x(e)
                elif scroll_idle(st, es) and key_free(km, b) and b == '\t' and list.len(jfwd) >= 1   // Ctrl-I / Tab — jump forward
                    let e = jfwd[list.len(jfwd) - 1]
                    let tf = jentry_path(e)
                    if tf == curpath
                        jback = list.push(jback, jentry(curpath, ed.cy, ed.cx))
                        jfwd = drop_last_str(jfwd)
                        ed = clamp(Editor { lines: ed.lines, cy: jentry_y(e), cx: jentry_x(e) })
                    else
                        jback = list.push(jback, jentry(curpath, ed.cy, ed.cx))
                        jfwd = drop_last_str(jfwd)
                        want_path = tf
                        want_y = jentry_y(e)
                        want_x = jentry_x(e)
                elif scroll_idle(st, es) and key_free(km, b) and b == '\x1e' and alt_buf >= 0 and alt_buf < list.len(bufs_path) and alt_buf != cur_buf   // Ctrl-^ — alternate buffer
                    jback = list.push(jback, jentry(curpath, ed.cy, ed.cx))
                    jfwd = []
                    want_path = bufs_path[alt_buf]
                    want_y = 0 - 1
                    want_x = 0
                elif b == 58 and st.mode == 0        // ':' — open the Ex line
                    cmd_mode = true
                    cmd_buf = ""
                elif b == 47 and st.mode == 0        // '/' — search forward
                    search_mode = true
                    search_buf = ""
                    search_back = false
                elif b == 63 and st.mode == 0        // '?' — search backward
                    search_mode = true
                    search_buf = ""
                    search_back = true
                elif st.mode == 1 and lsp_phase == 2 and (b == '\x0e' or b == '\x10')   // Ctrl-N/P — completion
                    if not comp_active
                        let curline = line_at(ed, ed.cy)
                        comp_start = ident_start_before(curline, ed.cx)
                        let prefix = str.slice(curline, comp_start, ed.cx)
                        lsp_reqid = lsp_reqid + 1
                        lsp.lsp_send(lsp_in, lsp.lsp_completion_req(lsp_reqid, lsp_uri, ed.cy, ed.cx))
                        let cresp = lsp.lsp_pump(lsp_out, lsp_reqid, 40)
                        var cands: [Str] = []
                        let labels = lsp.lsp_comp_labels(cresp)
                        var ci = 0
                        while ci < list.len(labels)
                            if starts_with(labels[ci], prefix)
                                cands = list.push(cands, labels[ci])
                            ci = ci + 1
                        if list.len(cands) == 0
                            lsp_info = "no completions"
                        else
                            comp_cands = cands
                            comp_idx = if b == '\x10' then list.len(cands) - 1 else 0
                            ed = comp_apply(ed, comp_start, ed.cx, comp_cands[comp_idx])
                            lsp_info = "match " + str.from_int(comp_idx + 1) + "/" + str.from_int(list.len(comp_cands)) + ": " + comp_cands[comp_idx]
                            comp_active = true
                    else
                        let n = list.len(comp_cands)
                        if n > 0
                            if b == '\x0e'
                                comp_idx = (comp_idx + 1) % n
                            else
                                comp_idx = (comp_idx + n - 1) % n
                            ed = comp_apply(ed, comp_start, ed.cx, comp_cands[comp_idx])
                            lsp_info = "match " + str.from_int(comp_idx + 1) + "/" + str.from_int(n) + ": " + comp_cands[comp_idx]
                else
                    if comp_active                   // any other key commits the candidate
                        comp_active = false
                    let jy = ed.cy                    // record G/gg/n/N/{/}/%/*/# jumps
                    let jx = ed.cx
                    let wasjump = is_jump_key(st, b)
                    let estep = feed_edit(ed, st, km, es, b)
                    ed = estep.ed
                    st = estep.st
                    es = estep.es
                    if wasjump and ed.cy != jy
                        jback = list.push(jback, jentry(curpath, jy, jx))
                        jfwd = []
            changed = true
        // ── Deferred window + buffer commands ───────────────────────────────
        // Order matters: window split/close/focus run FIRST and may set
        // `want_path` (when a focus/close move lands on a window showing a
        // different buffer); the buffer-switch block runs AFTER so the switch
        // completes in the same iteration, before the next keystroke is read.
        // A window owns its view (win_cy/cx/top/left) and which buffer it shows
        // (win_buf); a buffer owns its content + history (bufs_*).
        if pending_wcmd == 1 or pending_wcmd == 4   // :split/Ctrl-W s (stacked) · :vsplit/Ctrl-W v (side-by-side)
            let vertical = pending_wcmd == 4
            win_cy = util.set_int_at(win_cy, awin, ed.cy)
            win_cx = util.set_int_at(win_cx, awin, ed.cx)
            win_top = util.set_int_at(win_top, awin, top)
            win_left = util.set_int_at(win_left, awin, left)
            let newid = list.len(win_cy)
            win_cy = list.push(win_cy, ed.cy)
            win_cx = list.push(win_cx, ed.cx)
            win_top = list.push(win_top, top)
            win_left = list.push(win_left, left)
            win_buf = list.push(win_buf, cur_buf)   // new window shows the current buffer
            lay = layout_split(lay, awin, newid, vertical)
            awin = newid                                   // focus the new window
            lsp_info = (if vertical then "vsplit (" else "split (") + str.from_int(layout_count(lay)) + " windows)"
            changed = true
        elif pending_wcmd == 3                // Ctrl-W c / Ctrl-W q / :close / :q — close active window
            if layout_count(lay) > 1
                let rem = layout_remove(lay, awin)
                if list.len(rem) > 0
                    lay = rem[0]
                    let ids = layout_winids(lay, [])
                    let surv = ids[0]            // first surviving window takes focus
                    awin = surv
                    if win_buf[surv] == cur_buf
                        ed = clamp(Editor { lines: ed.lines, cy: win_cy[surv], cx: win_cx[surv] })
                        top = win_top[surv]
                        left = win_left[surv]
                    else                         // survivor shows another buffer → route via want_path
                        let tb = win_buf[surv]
                        bufs_top = util.set_int_at(bufs_top, tb, win_top[surv])
                        bufs_left = util.set_int_at(bufs_left, tb, win_left[surv])
                        want_path = bufs_path[tb]
                        want_y = win_cy[surv]
                        want_x = win_cx[surv]
                    lsp_info = "closed (" + str.from_int(layout_count(lay)) + " windows)"
                    changed = true
        elif pending_wcmd == 5                // Ctrl-W o / :only — keep just the active window
            if layout_count(lay) > 1
                lay = LWin(awin)              // active window keeps its live ed/top/left
                lsp_info = "only"
                changed = true
        pending_wcmd = 0
        // Deferred focus change (Ctrl-W w / h / j / k / l): save the active
        // window's view, then activate the target — directly when it shows the
        // same buffer, else by routing a buffer switch through `want_path` below.
        if pending_focus >= 0 and pending_focus != awin
            let tgt = pending_focus
            win_cy = util.set_int_at(win_cy, awin, ed.cy)
            win_cx = util.set_int_at(win_cx, awin, ed.cx)
            win_top = util.set_int_at(win_top, awin, top)
            win_left = util.set_int_at(win_left, awin, left)
            if win_buf[tgt] == cur_buf
                awin = tgt
                ed = clamp(Editor { lines: ed.lines, cy: win_cy[tgt], cx: win_cx[tgt] })
                top = win_top[tgt]
                left = win_left[tgt]
            else
                let tb = win_buf[tgt]
                bufs_top = util.set_int_at(bufs_top, tb, win_top[tgt])
                bufs_left = util.set_int_at(bufs_left, tb, win_left[tgt])
                want_path = bufs_path[tb]
                want_y = win_cy[tgt]
                want_x = win_cx[tgt]
                awin = tgt
            changed = true
        pending_focus = 0 - 1
        // Deferred buffer switch — find-or-create the buffer for `want_path`,
        // save the current buffer's working copy, and activate the target
        // (restoring its content/cursor and retargeting the language server).
        if str.len(want_path) > 0
            var idx = buf_index_of(bufs_path, want_path)
            let creating = idx < 0
            if creating                        // open a new buffer from disk
                bufs_text = list.push(bufs_text, file_to_text(want_path))
                bufs_path = list.push(bufs_path, want_path)
                bufs_cy = list.push(bufs_cy, 0)
                bufs_cx = list.push(bufs_cx, 0)
                bufs_top = list.push(bufs_top, 0)
                bufs_left = list.push(bufs_left, 0)
                bufs_disk = list.push(bufs_disk, "")
                bufs_undo = list.push(bufs_undo, "")
                bufs_redo = list.push(bufs_redo, "")
                bufs_marky = list.push(bufs_marky, "")
                bufs_markx = list.push(bufs_markx, "")
                bufs_diag = list.push(bufs_diag, "")
                bufs_lspopen = list.push(bufs_lspopen, false)
                idx = list.len(bufs_path) - 1
            if idx != cur_buf
                // save the buffer we're leaving (incl. its undo/redo history)
                bufs_text = util.set_str_at(bufs_text, cur_buf, buf_text(ed))
                bufs_cy = util.set_int_at(bufs_cy, cur_buf, ed.cy)
                bufs_cx = util.set_int_at(bufs_cx, cur_buf, ed.cx)
                bufs_top = util.set_int_at(bufs_top, cur_buf, top)
                bufs_left = util.set_int_at(bufs_left, cur_buf, left)
                bufs_disk = util.set_str_at(bufs_disk, cur_buf, disk_text)
                bufs_undo = util.set_str_at(bufs_undo, cur_buf, snaps_ser(es.undos))
                bufs_redo = util.set_str_at(bufs_redo, cur_buf, snaps_ser(es.redos))
                bufs_marky = util.set_str_at(bufs_marky, cur_buf, ints_ser(es.marky))
                bufs_markx = util.set_str_at(bufs_markx, cur_buf, ints_ser(es.markx))
                bufs_diag = util.set_str_at(bufs_diag, cur_buf, diag_ser(diag_li, diag_msgs))
                // documents stay open in novols (multi-doc) — no didClose on switch
                alt_buf = cur_buf             // the buffer we leave becomes the alternate
                cur_buf = idx
                let nls = str.split_lines(bufs_text[idx])
                let ny = if want_y >= 0 then want_y else bufs_cy[idx]
                let nx = if want_y >= 0 then want_x else bufs_cx[idx]
                ed = clamp(Editor { lines: if list.len(nls) == 0 then [""] else nls, cy: ny, cx: nx })
                curpath = want_path
                top = bufs_top[idx]
                left = bufs_left[idx]
                disk_text = if creating then buf_text(ed) else bufs_disk[idx]
                // restore the target buffer's own undo/redo history + marks;
                // carry the registers forward (global) but reset dot/macros
                let usaved = bufs_undo[idx]
                let rsaved = bufs_redo[idx]
                let mysaved = bufs_marky[idx]
                let mxsaved = bufs_markx[idx]
                let gregs = es.regs
                let greglw = es.reglw
                es = edit_new_undo(snaps_de(usaved), snaps_de(rsaved), gregs, greglw, marks_de(mysaved), marks_de(mxsaved))
                let dsaved = bufs_diag[idx]   // restore the target's live diagnostics
                diag_li = diag_de_li(dsaved)
                diag_msgs = diag_de_msgs(dsaved)
                lsp_uri = "file://" + curpath
                lsp_lasttext = buf_text(ed)   // debounced didChange now diffs against THIS buffer
                let already = bufs_lspopen[idx]
                if ends_with_nv(curpath)
                    if lsp_pid < 0             // no server yet — spawn + init async (opens all docs at handshake)
                        lsp_pid = lsp.lsp_spawn()
                        if lsp_pid >= 0
                            lsp_in = proc.stdin_fd(lsp_pid)
                            lsp_out = proc.stdout_fd(lsp_pid)
                            lsp.lsp_send(lsp_in, lsp.lsp_init_req(lsp_uri))
                            lsp_phase = 1
                    elif lsp_phase == 2 and not already   // first visit since server ready — open it
                        lsp_ver = lsp_ver + 1
                        lsp.lsp_send(lsp_in, lsp.lsp_didopen(lsp_uri, lsp_lasttext))
                        bufs_lspopen = util.set_bool_at(bufs_lspopen, idx, true)
            elif want_y >= 0                   // same buffer — just move the cursor
                ed = clamp(Editor { lines: ed.lines, cy: want_y, cx: want_x })
            win_buf = util.set_int_at(win_buf, awin, cur_buf)   // active window now shows cur_buf
            want_path = ""
            changed = true
        if str.len(want_close) > 0
            let ci = buf_index_of(bufs_path, want_close)
            if ci >= 0 and list.len(bufs_path) > 1
                bufs_text = util.remove_at_str(bufs_text, ci)
                bufs_path = util.remove_at_str(bufs_path, ci)
                bufs_cy = util.remove_at_int(bufs_cy, ci)
                bufs_cx = util.remove_at_int(bufs_cx, ci)
                bufs_top = util.remove_at_int(bufs_top, ci)
                bufs_left = util.remove_at_int(bufs_left, ci)
                bufs_disk = util.remove_at_str(bufs_disk, ci)
                bufs_undo = util.remove_at_str(bufs_undo, ci)
                bufs_redo = util.remove_at_str(bufs_redo, ci)
                bufs_marky = util.remove_at_str(bufs_marky, ci)
                bufs_markx = util.remove_at_str(bufs_markx, ci)
                if ends_with_nv(want_close) and bufs_lspopen[ci] and lsp_phase == 2
                    lsp.lsp_send(lsp_in, lsp.lsp_didclose("file://" + want_close))
                bufs_diag = util.remove_at_str(bufs_diag, ci)
                bufs_lspopen = util.remove_at_bool(bufs_lspopen, ci)
                if ci < cur_buf
                    cur_buf = cur_buf - 1
                if ci == alt_buf            // alternate closed — invalidate
                    alt_buf = 0 - 1
                elif ci < alt_buf
                    alt_buf = alt_buf - 1
                // shift win_buf past the removed buffer; a window that showed it
                // falls back to the now-active buffer so no window dangles
                var wbi = 0
                while wbi < list.len(win_buf)
                    if win_buf[wbi] == ci
                        win_buf = util.set_int_at(win_buf, wbi, cur_buf)
                    elif win_buf[wbi] > ci
                        win_buf = util.set_int_at(win_buf, wbi, win_buf[wbi] - 1)
                    wbi = wbi + 1
                lsp_info = "closed; " + str.from_int(list.len(bufs_path)) + " left"
            want_close = ""
            changed = true
        // Live document sync, TIME-debounced: mark the buffer dirty on any
        // input, and only send `didChange` after typing pauses (~150 ms of idle
        // poll cycles).  This coalesces a burst of insert-mode keystrokes into a
        // single full-document sync instead of rebuilding + re-sending the whole
        // buffer (a byte-at-a-time pipe write) on every keypress.
        if m % 2 == 1
            lsp_dirty = true
            lsp_idle = 0
        else
            lsp_idle = lsp_idle + 1
        if lsp_phase == 2 and lsp_dirty and lsp_idle >= 3
            let cur = buf_text(ed)
            if cur != lsp_lasttext
                lsp_lasttext = cur
                lsp_ver = lsp_ver + 1
                lsp.lsp_send(lsp_in, lsp.lsp_didchange(lsp_uri, lsp_ver, cur))
            lsp_dirty = false
        // Drain whatever novols has sent (non-blocking).  The init result
        // (id 1) completes the handshake asynchronously — initialized +
        // didOpen (with the buffer's current text, edits-during-init included);
        // publishDiagnostics notifications rebuild the diagnostics store.
        if lsp_pid >= 0
            var more = true
            while more
                let msg = lsp.lsp_poll_message(lsp_out, 0)
                if str.len(msg) == 0
                    more = false
                elif lsp_phase == 1 and lsp.lsp_msg_id(msg) == 1
                    lsp.lsp_send(lsp_in, lsp.lsp_initialized())
                    lsp_phase = 2
                    var oi = 0                  // open EVERY .nv buffer (multi-doc)
                    while oi < list.len(bufs_path)
                        let opath = bufs_path[oi]
                        if ends_with_nv(opath)
                            let otext = if oi == cur_buf then buf_text(ed) else bufs_text[oi]
                            lsp.lsp_send(lsp_in, lsp.lsp_didopen("file://" + opath, otext))
                            bufs_lspopen = util.set_bool_at(bufs_lspopen, oi, true)
                        oi = oi + 1
                    lsp_lasttext = buf_text(ed)
                elif lsp.lsp_is_diag(msg)
                    // route diagnostics to the buffer they belong to (by URI);
                    // only the active buffer's update the live display.
                    let dpath = uri_to_path(lsp.lsp_diag_uri(msg))
                    let dbi = buf_index_of(bufs_path, dpath)
                    if dbi >= 0
                        let dli = lsp.lsp_collect_diag_ints(msg)
                        let dmsgs = lsp.lsp_collect_diag_msgs(msg)
                        bufs_diag = util.set_str_at(bufs_diag, dbi, diag_ser(dli, dmsgs))
                        if dbi == cur_buf
                            diag_li = dli
                            diag_msgs = dmsgs
                            changed = true
        if changed
            top = scroll_to(top, ed.cy, rows - 1)
            left = hscroll_for(left, ed, opts, cols)
            modified = buf_text(ed) != disk_text
            paint_frame(ed, lay, awin, cols, rows, win_cy, win_cx, win_top, win_left, win_buf, cur_buf, bufs_text, bufs_path, curpath, top, left, st, cs, opts, diag_li, diag_msgs, lsp_info, modified)
            if cmd_mode
                cup(rows, 1)
                csi()
                emit("K")
                emit(":" + cmd_buf)
            if search_mode
                cup(rows, 1)
                csi()
                emit("K")
                emit("/" + search_buf)
            if buflist
                draw_buflist(bufs_path, cur_buf, rows)
        if novo_pty_winsize_changed_h() == 1
            rows = term_rows()
            cols = term_cols()
            top = scroll_to(top, ed.cy, rows - 1)
            left = hscroll_for(left, ed, opts, cols)
            clear_screen()   // dimensions changed — clear stale content once
            paint_frame(ed, lay, awin, cols, rows, win_cy, win_cx, win_top, win_left, win_buf, cur_buf, bufs_text, bufs_path, curpath, top, left, st, cs, opts, diag_li, diag_msgs, lsp_info, modified)
    if lsp_pid >= 0                       // tear the language server down
        let _ = proc.kill(lsp_pid, 15)
        proc.close(lsp_pid)
    novo_pty_restore_mode_h()
    csi()
    emit("0 q")          // restore the terminal's default cursor shape
    csi()
    emit("2J")
    cup(1, 1)

// ── Entry ───────────────────────────────────────────────────────

// Default config path: $NOVIM_CONFIG, else $XDG_CONFIG_HOME/novim/config.toml,
// else ~/.config/novim/config.toml.
fn default_config_path() -> Str [io]
    let envp = process.env("NOVIM_CONFIG") ?? ""
    if envp != ""
        return envp
    let xdg = process.env("XDG_CONFIG_HOME") ?? ""
    if xdg != ""
        return xdg + "/novim/config.toml"
    let home = process.env("HOME") ?? ""
    home + "/.config/novim/config.toml"

// ── LSP (novols) client — JSON-RPC transport ───────────────────────────────
// novim talks JSON-RPC over stdio to `novols`.  All of this lives outside the
// pure `feed`; see orbit/novim/docs/LSP-DESIGN.md.

@intent("""Send one JSON-RPC message to the language server over `fd`, framed
with the LSP `Content-Length: N\\r\\n\\r\\n<body>` header.  Writes in bulk via
the host primitive, not byte-by-byte.""")
// ── Live diagnostics in run_interactive ─────────────────────────────────────
// Highest severity (1 = error wins over 2 = warning) on buffer line `line`,
// or 0 when the line is clean.  `diag_li` is the flat line/sev store.
fn diag_sev_for_line(diag_li: [Int], line: Int) -> Int
    var best = 0
    var i = 0
    while i + 1 < list.len(diag_li)
        if diag_li[i] == line
            let s = diag_li[i + 1]
            if best == 0 or s < best
                best = s
        i = i + 2
    best

// Count of diagnostics of a given severity.
fn diag_count(diag_li: [Int], sev: Int) -> Int
    var c = 0
    var i = 0
    while i + 1 < list.len(diag_li)
        if diag_li[i + 1] == sev
            c = c + 1
        i = i + 2
    c

// The first diagnostic message on buffer line `line`, or "" if none.
fn diag_msg_for_line(diag_li: [Int], diag_msgs: [Str], line: Int) -> Str
    var k = 0
    var i = 0
    while i + 1 < list.len(diag_li)
        if diag_li[i] == line and k < list.len(diag_msgs)
            return diag_msgs[k]
        k = k + 1
        i = i + 2
    ""

// ── Go-to-definition (gd) + hover (K) ───────────────────────────────────────
// ── definition: result is a Location (or Location[]); pull start pos + uri ──
// ── hover: result.contents is a MarkupContent { value } (markdown) ──
// ── document formatting (:fmt) ──────────────────────────────────────────────
// ── document symbols (:sym <name>) ──────────────────────────────────────────
// ── rename (:rename <newname>) ──────────────────────────────────────────────
// ── completion (Ctrl-N / Ctrl-P, inline cycle) ──────────────────────────────
// True when `s` begins with `prefix`.
fn starts_with(s: Str, prefix: Str) -> Bool
    let pl = str.len(prefix)
    if pl > str.len(s)
        return false
    str.slice(s, 0, pl) == prefix

// Column where the identifier ending at `col` begins (the completion prefix).
fn ident_start_before(line: Str, col: Int) -> Int
    var s = col
    while s > 0 and nv_ident_char(str.byte_at(line, s - 1) ?? 0)
        s = s - 1
    s

// True when feeding `b` in the current state is a "jump" command (G, gg, n, N,
// {, }, %, *, #) — whose origin the driver records in the jumplist if the
// cursor actually moves.  These run inside the pure feed_edit, so the driver
// snapshots around the call rather than recording from within.
fn is_jump_key(st: InputState, b: Int) -> Bool
    if st.mode != 0
        return false
    if st.pending == 1
        return b == 'g'                                 // gg (second g)
    if st.pending == 0
        return b == 'G' or b == 'n' or b == 'N' or b == '{' or b == '}' or b == '%' or b == '*' or b == '#'
    false

// Drop the last two Ints (one packed [y, x] jumplist entry).
fn drop_last2(xs: [Int]) -> [Int]
    var out: [Int] = []
    var i = 0
    let n = list.len(xs) - 2
    while i < n
        out = list.push(out, xs[i])
        i = i + 1
    out

// Drop the last element of a [Str] (one jumplist entry).
fn drop_last_str(xs: [Str]) -> [Str]
    var out: [Str] = []
    var i = 0
    let n = list.len(xs) - 1
    while i < n
        out = list.push(out, xs[i])
        i = i + 1
    out

// A jumplist entry packs the origin as "y|x|path" — y/x first so the path
// (which may contain anything) is simply everything after the second '|'.
fn jentry(path: Str, y: Int, x: Int) -> Str
    str.from_int(y) + "|" + str.from_int(x) + "|" + path

fn jentry_y(e: Str) -> Int
    let p = util.index_of_byte(e, '|')
    if p < 0 then 0 else (str.to_int(str.slice(e, 0, p)) ?? 0)

fn jentry_x(e: Str) -> Int
    let p1 = util.index_of_byte(e, '|')
    let after = str.slice(e, p1 + 1, str.len(e))
    let p2 = util.index_of_byte(after, '|')
    if p2 < 0 then 0 else (str.to_int(str.slice(after, 0, p2)) ?? 0)

fn jentry_path(e: Str) -> Str
    let p1 = util.index_of_byte(e, '|')
    let after = str.slice(e, p1 + 1, str.len(e))
    let p2 = util.index_of_byte(after, '|')
    if p2 < 0 then "" else str.slice(after, p2 + 1, str.len(after))

// Strip a "file://" URI down to a filesystem path.
fn uri_to_path(uri: Str) -> Str
    if str.len(uri) >= 7 and str.slice(uri, 0, 7) == "file://" then str.slice(uri, 7, str.len(uri)) else uri

// Replace [start, endc) on the cursor line with `ins`; cursor lands after it.
fn comp_apply(ed: Editor, start: Int, endc: Int, ins: Str) -> Editor
    let line = line_at(ed, ed.cy)
    let e = if endc <= str.len(line) then endc else str.len(line)
    let nl = str.slice(line, 0, start) + ins + str.slice(line, e, str.len(line))
    Editor { lines: set_line(ed.lines, ed.cy, nl), cy: ed.cy, cx: start + str.len(ins) }

// Apply rename edits to the buffer.  Edits arrive in ascending (line, char)
// order, so iterating in REVERSE applies them right-to-left / bottom-to-top —
// earlier positions never shift.  Each edit replaces line[ln][schar..echar).
fn apply_rename(ed: Editor, triples: [Int], newtexts: [Str]) -> Editor
    var lines = ed.lines
    var k = list.len(newtexts) - 1
    while k >= 0
        if k * 3 + 2 < list.len(triples)
            let ln = triples[k * 3]
            let sc = triples[k * 3 + 1]
            let ec = triples[k * 3 + 2]
            if ln >= 0 and ln < list.len(lines)
                let old = lines[ln]
                if sc >= 0 and sc <= ec and ec <= str.len(old)
                    let nw = str.slice(old, 0, sc) + newtexts[k] + str.slice(old, ec, str.len(old))
                    lines = set_line(lines, ln, nw)
        k = k - 1
    Editor { lines: lines, cy: ed.cy, cx: ed.cx }

@intent("""`--lsp-diag <file>` entry point: spawn novols, run the full
initialize/didOpen handshake, wait for publishDiagnostics, and print them.  A
deterministic, headless smoke test of the language-server transport (no TUI).""")
fn run_lsp_diag(path: Str) [io, time]
    // Use the free `proc.*` surface (pid-keyed) rather than the Subprocess
    // methods: the method-return slot-type inference is fragile (an fd binder
    // gets a ptr slot for the i64 return) and breaks the build as unrelated
    // code shifts inference.  The free fns are what run_interactive uses.
    let pid = lsp.lsp_spawn()
    if pid < 0
        println("novols: spawn failed")
    else
        let in_fd = proc.stdin_fd(pid)
        let out_fd = proc.stdout_fd(pid)
        let uri = "file://" + path
        lsp.lsp_send(in_fd, lsp.lsp_init_req(uri))
        let _ = lsp.lsp_poll_message(out_fd, 2000)               // initialize result
        lsp.lsp_send(in_fd, lsp.lsp_initialized())
        let text = buf_text(Editor { lines: buf_load(path), cy: 0, cx: 0 })
        lsp.lsp_send(in_fd, lsp.lsp_didopen(uri, text))
        var iters = 0
        var shown = false
        while iters < 40 and not shown
            let msg = lsp.lsp_poll_message(out_fd, 500)
            if lsp.lsp_msg_diags(msg)
                shown = true
            iters = iters + 1
        if not shown
            println("diagnostics: (none received)")
        let _ = proc.kill(pid, 15)
        proc.close(pid)

@intent("""CLI entry point.  Parse argv and dispatch: `--batch <keys> <file>`
(headless scripted edit), `--lsp-diag <file>` (language-server smoke test),
`--config <path>` to override the config file, or one-or-more file paths →
interactive mode (first file active, the rest opened as buffers).""")
fn main() [io, time]
    let argv = env.args()
    let n = list.len(argv)
    var is_batch = false
    var batch_keys = ""
    var file = ""                        // first file (the initial buffer)
    var extra = ""                        // remaining files, newline-joined → extra buffers
    var cfg = ""
    var lsp_diag = false
    let mut i = 1
    while i < n
        let a = argv[i]
        if a == "--batch" and i + 1 < n
            is_batch = true
            batch_keys = argv[i + 1]
            i = i + 2
        elif a == "--config" and i + 1 < n
            cfg = argv[i + 1]
            i = i + 2
        elif a == "--lsp-diag"
            lsp_diag = true
            i = i + 1
        elif file == ""
            file = a
            i = i + 1
        else
            extra = if str.len(extra) == 0 then a else extra + str.from_char('\n') + a
            i = i + 1
    let cfg_path = if cfg != "" then cfg else default_config_path()
    if file == ""
        println("usage: novim [--config <toml>] [--batch <keys>] [--lsp-diag] <file>...")
    elif lsp_diag
        run_lsp_diag(file)
    elif is_batch
        run_batch(batch_keys, cfg_path, file)
    else
        run_interactive(cfg_path, file, extra)
