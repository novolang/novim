// novim — modal terminal editor written in Novo.
//
// v1 slice 1: a [Str] line-vector buffer, file load, h/j/k/l cursor
// motion, an interactive ANSI TUI viewer, and a deterministic `--batch`
// mode used by the test harness.  See features/orbits/novim/README.md
// for the full v1 scope + 10-slice plan (piece-tree / novols LSP /
// novo-treesitter / plugins are v2; the buffer is a plain line vector
// in v1).
//
// The interactive TUI uses the host-TTY primitives std.pty already
// exposes (raw mode, host stdin byte, host stdout byte, poll, winsize)
// — the same surface novomux/novoterm drive.  `novo_pty_` references
// also trip the stdlib's conditional-link so libutil is pulled in.

// Editor state.  Cursor is 0-based (line, col); the buffer is a plain
// line vector in v1.
struct Editor
    lines: [Str]
    cy:    Int
    cx:    Int

// Normal-mode input state carried across bytes: `count` accumulates a
// numeric prefix (e.g. `5j`); `pending_g` is set after a lone `g`, so the
// next `g` completes `gg`.  (slice 2)
struct InputState
    count:     Int
    pending_g: Bool
    mode:      Int        // 0 = Normal, 1 = Insert  (slice 4)

// feed()'s result: the new editor + the new input state.
struct Step
    ed: Editor
    st: InputState

// Reset to a clean Normal-mode state (count/pending cleared).  Used at the
// end of every completed Normal-mode command.
fn ist_new() -> InputState
    InputState { count: 0, pending_g: false, mode: 0 }

fn ist_insert() -> InputState
    InputState { count: 0, pending_g: false, mode: 1 }

// ── Buffer ──────────────────────────────────────────────────────

// Load `path` into a line vector.  Missing/unreadable file → a single
// empty line (a fresh scratch buffer); an empty split keeps one line so
// the cursor always has somewhere to sit.
fn buf_load(path: Str) -> [Str] [io]
    match fs.read(path)
        None    => [""]
        Some(s) =>
            let ls = str.split_lines(s)
            if list.len(ls) == 0 then [""] else ls

// Clamp the cursor into the buffer.  Vim normal-mode rule: cx sits on
// the last glyph (len-1), or col 0 on an empty line.
fn clamp(ed: Editor) -> Editor
    let n = list.len(ed.lines)
    var cy = ed.cy
    if cy < 0
        cy = 0
    if cy >= n
        cy = n - 1
    if cy < 0
        cy = 0
    let ll = if cy >= 0 and cy < n then str.len(ed.lines[cy]) else 0
    let maxx = if ll > 0 then ll - 1 else 0
    var cx = ed.cx
    if cx < 0
        cx = 0
    if cx > maxx
        cx = maxx
    Editor { lines: ed.lines, cy: cy, cx: cx }

// ── Input ───────────────────────────────────────────────────────

fn line_at(ed: Editor, y: Int) -> Str
    if y >= 0 and y < list.len(ed.lines) then ed.lines[y] else ""

// Column of the first non-blank glyph on `line` (0 if all blank/empty).
fn first_nonblank(line: Str) -> Int
    let n = str.len(line)
    let mut i = 0
    while i < n
        let c = str.byte_at(line, i) ?? 0
        if c != 32 and c != 9          // not space / tab
            return i
        i = i + 1
    0

// One h/j/k/l step (clamped).
fn motion_hjkl(ed: Editor, b: Int) -> Editor
    if b == 0x68          // 'h' — left
        clamp(Editor { lines: ed.lines, cy: ed.cy, cx: ed.cx - 1 })
    elif b == 0x6C        // 'l' — right
        clamp(Editor { lines: ed.lines, cy: ed.cy, cx: ed.cx + 1 })
    elif b == 0x6A        // 'j' — down
        clamp(Editor { lines: ed.lines, cy: ed.cy + 1, cx: ed.cx })
    elif b == 0x6B        // 'k' — up
        clamp(Editor { lines: ed.lines, cy: ed.cy - 1, cx: ed.cx })
    else
        ed

fn repeat_hjkl(ed: Editor, b: Int, times: Int) -> Editor
    var e = ed
    let mut k = 0
    while k < times
        e = motion_hjkl(e, b)
        k = k + 1
    e

// ── Word motions (w / b / e) ────────────────────────────────────
// Vim word semantics: a "word" is a maximal run of word chars
// (alnum + `_`) OR a maximal run of other punctuation; whitespace
// separates.  class 0 = whitespace, 1 = word, 2 = punctuation.

fn char_class_of(c: Int) -> Int
    if c == 32 or c == 9
        0
    elif (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
        1
    else
        2

// Class of the glyph at (y,x); out-of-range / past end-of-line reads as
// whitespace (the inter-line / trailing gap).
fn class_at(ed: Editor, y: Int, x: Int) -> Int
    let line = line_at(ed, y)
    if x >= 0 and x < str.len(line)
        char_class_of(str.byte_at(line, x) ?? 32)
    else
        0

// `w` — forward to the start of the next word.  Skips the rest of the
// current run, then skips whitespace (crossing line boundaries), landing
// on the next non-blank; clamps at end-of-buffer.
fn motion_w(ed: Editor) -> Editor
    let nlines = list.len(ed.lines)
    var y = ed.cy
    var x = ed.cx
    let cc0 = class_at(ed, y, x)
    if cc0 != 0
        var go = true
        var g = 0
        while go and g < 1000000
            g = g + 1
            if x < str.len(line_at(ed, y)) and class_at(ed, y, x) == cc0
                x = x + 1
            else
                go = false
    var done = false
    var g2 = 0
    while not done and g2 < 1000000
        g2 = g2 + 1
        let ll = str.len(line_at(ed, y))
        if x < ll
            if class_at(ed, y, x) == 0
                x = x + 1
            else
                done = true
        elif y + 1 < nlines
            y = y + 1
            x = 0
        else
            x = if ll > 0 then ll - 1 else 0
            done = true
    clamp(Editor { lines: ed.lines, cy: y, cx: x })

// `e` — forward to the end of the next word.
fn motion_e(ed: Editor) -> Editor
    let nlines = list.len(ed.lines)
    var y = ed.cy
    var x = ed.cx
    // step one position forward
    if x + 1 < str.len(line_at(ed, y))
        x = x + 1
    elif y + 1 < nlines
        y = y + 1
        x = 0
    // skip whitespace forward to a word
    var done = false
    var g = 0
    while not done and g < 1000000
        g = g + 1
        let ll = str.len(line_at(ed, y))
        if x < ll
            if class_at(ed, y, x) == 0
                x = x + 1
            else
                done = true
        elif y + 1 < nlines
            y = y + 1
            x = 0
        else
            done = true
    // advance to the end of this run
    let cc = class_at(ed, y, x)
    if cc != 0
        var go = true
        var g2 = 0
        while go and g2 < 1000000
            g2 = g2 + 1
            if x + 1 < str.len(line_at(ed, y)) and class_at(ed, y, x + 1) == cc
                x = x + 1
            else
                go = false
    clamp(Editor { lines: ed.lines, cy: y, cx: x })

// `b` — backward to the start of the current/previous word.
fn motion_b(ed: Editor) -> Editor
    var y = ed.cy
    var x = ed.cx
    // step one position back
    if x > 0
        x = x - 1
    elif y > 0
        y = y - 1
        let pl = str.len(line_at(ed, y))
        x = if pl > 0 then pl - 1 else 0
    // skip whitespace backward
    var done = false
    var g = 0
    while not done and g < 1000000
        g = g + 1
        if class_at(ed, y, x) == 0 and not (y == 0 and x == 0)
            if x > 0
                x = x - 1
            elif y > 0
                y = y - 1
                let pl = str.len(line_at(ed, y))
                x = if pl > 0 then pl - 1 else 0
            else
                done = true
        else
            done = true
    // skip back to the start of this run (within the line)
    let cc = class_at(ed, y, x)
    if cc != 0
        var go = true
        var g2 = 0
        while go and g2 < 1000000
            g2 = g2 + 1
            if x > 0 and class_at(ed, y, x - 1) == cc
                x = x - 1
            else
                go = false
    clamp(Editor { lines: ed.lines, cy: y, cx: x })

fn repeat_word(ed: Editor, kind: Int, times: Int) -> Editor
    var e = ed
    let mut k = 0
    while k < times
        if kind == 0
            e = motion_w(e)
        elif kind == 1
            e = motion_b(e)
        else
            e = motion_e(e)
        k = k + 1
    e

// ── Editing (insert mode) ───────────────────────────────────────

// Replace line `y` with `s` (returns a fresh line vector).
fn set_line(lines: [Str], y: Int, s: Str) -> [Str]
    var ls: [Str] = []
    let mut i = 0
    let n = list.len(lines)
    while i < n
        if i == y
            ls = list.append(ls, [s])
        else
            ls = list.append(ls, [lines[i]])
        i = i + 1
    ls

// Clamp for INSERT mode: cx may sit one past the last glyph (cx == len)
// so text can be appended at the end of a line.
fn clamp_insert(ed: Editor) -> Editor
    let n = list.len(ed.lines)
    var cy = ed.cy
    if cy < 0
        cy = 0
    if cy >= n
        cy = n - 1
    if cy < 0
        cy = 0
    let ll = if cy >= 0 and cy < n then str.len(ed.lines[cy]) else 0
    var cx = ed.cx
    if cx < 0
        cx = 0
    if cx > ll
        cx = ll
    Editor { lines: ed.lines, cy: cy, cx: cx }

// Insert byte `b` at the cursor and advance one column.
fn insert_char(ed: Editor, b: Int) -> Editor
    let line = line_at(ed, ed.cy)
    let before = str.slice(line, 0, ed.cx)
    let after = str.slice(line, ed.cx, str.len(line))
    let merged = before + str.from_char(b) + after
    Editor { lines: set_line(ed.lines, ed.cy, merged), cy: ed.cy, cx: ed.cx + 1 }

// Split the current line at the cursor (Enter in insert mode).
fn insert_newline(ed: Editor) -> Editor
    let line = line_at(ed, ed.cy)
    let before = str.slice(line, 0, ed.cx)
    let after = str.slice(line, ed.cx, str.len(line))
    var ls: [Str] = []
    let mut i = 0
    let n = list.len(ed.lines)
    while i < n
        if i == ed.cy
            ls = list.append(ls, [before])
            ls = list.append(ls, [after])
        else
            ls = list.append(ls, [ed.lines[i]])
        i = i + 1
    Editor { lines: ls, cy: ed.cy + 1, cx: 0 }

// Backspace: delete the glyph before the cursor, or join with the line
// above when at column 0.
fn backspace(ed: Editor) -> Editor
    if ed.cx > 0
        let line = line_at(ed, ed.cy)
        let merged = str.slice(line, 0, ed.cx - 1) + str.slice(line, ed.cx, str.len(line))
        Editor { lines: set_line(ed.lines, ed.cy, merged), cy: ed.cy, cx: ed.cx - 1 }
    elif ed.cy > 0
        let prev = line_at(ed, ed.cy - 1)
        let cur = line_at(ed, ed.cy)
        let joincol = str.len(prev)
        var ls: [Str] = []
        let mut i = 0
        let n = list.len(ed.lines)
        while i < n
            if i == ed.cy - 1
                ls = list.append(ls, [prev + cur])
            elif i == ed.cy
                // skip — merged into the previous line
                i = i
            else
                ls = list.append(ls, [ed.lines[i]])
            i = i + 1
        Editor { lines: ls, cy: ed.cy - 1, cx: joincol }
    else
        ed

// Open a fresh empty line below (`o`) or above (`O`) and enter it.
fn open_line(ed: Editor, below: Bool) -> Editor
    let at = if below then ed.cy + 1 else ed.cy
    var ls: [Str] = []
    let mut i = 0
    let n = list.len(ed.lines)
    while i < n
        if i == at
            ls = list.append(ls, [""])
        ls = list.append(ls, [ed.lines[i]])
        i = i + 1
    if at >= n          // opening below the last line
        ls = list.append(ls, [""])
    Editor { lines: ls, cy: at, cx: 0 }

// Handle one byte while in Insert mode.
fn feed_insert(ed: Editor, st: InputState, b: Int) -> Step
    if b == 27                         // Esc → Normal (cursor steps left, vim)
        let e = clamp(Editor { lines: ed.lines, cy: ed.cy, cx: ed.cx - 1 })
        return Step { ed: e, st: ist_new() }
    if b == 13 or b == 10              // Enter → split line
        return Step { ed: insert_newline(ed), st: st }
    if b == 127 or b == 8              // Backspace / DEL
        return Step { ed: backspace(ed), st: st }
    if b == 9 or (b >= 32 and b < 127) // printable (+ tab) → insert
        return Step { ed: insert_char(ed, b), st: st }
    Step { ed: ed, st: st }            // ignore other control bytes

// Feed one byte through the Normal-mode handler, threading InputState.
// Counts (`5j`, `10G`), line motions (`0 $ ^`), and buffer motions
// (`gg G`) join the slice-1 `h j k l`.  (slices 1-2)
fn feed(ed: Editor, st: InputState, b: Int) -> Step
    // Insert mode owns every byte until Esc.  (slice 4)
    if st.mode == 1
        return feed_insert(ed, st, b)
    // Completing `gg`?
    if st.pending_g
        if b == 0x67                   // second 'g' — go to line (count or 1)
            let tgt = if st.count > 0 then st.count - 1 else 0
            return Step { ed: clamp(Editor { lines: ed.lines, cy: tgt, cx: ed.cx }), st: ist_new() }
        else
            // Not `gg` — drop the pending g and reprocess this byte fresh.
            return feed(ed, InputState { count: st.count, pending_g: false, mode: 0 }, b)
    // Count digits.  `0` is a count digit only when a count is already
    // building; otherwise `0` is the "first column" motion.
    if b >= 0x31 and b <= 0x39         // '1'-'9'
        return Step { ed: ed, st: InputState { count: st.count * 10 + (b - 0x30), pending_g: false, mode: 0 } }
    if b == 0x30 and st.count > 0      // '0' continues a count
        return Step { ed: ed, st: InputState { count: st.count * 10, pending_g: false, mode: 0 } }
    let cnt = if st.count > 0 then st.count else 1
    if b == 0x68 or b == 0x6C or b == 0x6A or b == 0x6B      // h l j k
        return Step { ed: repeat_hjkl(ed, b, cnt), st: ist_new() }
    if b == 0x77                       // 'w' — next word start
        return Step { ed: repeat_word(ed, 0, cnt), st: ist_new() }
    if b == 0x62                       // 'b' — previous word start
        return Step { ed: repeat_word(ed, 1, cnt), st: ist_new() }
    if b == 0x65                       // 'e' — next word end
        return Step { ed: repeat_word(ed, 2, cnt), st: ist_new() }
    if b == 0x30                       // '0' — first column
        return Step { ed: clamp(Editor { lines: ed.lines, cy: ed.cy, cx: 0 }), st: ist_new() }
    if b == 0x24                       // '$' — end of line
        let ll = str.len(line_at(ed, ed.cy))
        let ex = if ll > 0 then ll - 1 else 0
        return Step { ed: clamp(Editor { lines: ed.lines, cy: ed.cy, cx: ex }), st: ist_new() }
    if b == 0x5E                       // '^' — first non-blank
        return Step { ed: clamp(Editor { lines: ed.lines, cy: ed.cy, cx: first_nonblank(line_at(ed, ed.cy)) }), st: ist_new() }
    if b == 0x67                       // 'g' — await second g
        return Step { ed: ed, st: InputState { count: st.count, pending_g: true, mode: 0 } }
    if b == 0x47                       // 'G' — go to line (count or last)
        let tgt = if st.count > 0 then st.count - 1 else list.len(ed.lines) - 1
        return Step { ed: clamp(Editor { lines: ed.lines, cy: tgt, cx: ed.cx }), st: ist_new() }
    // Insert-mode entry (slice 4).  Position the cursor (insert-clamped so
    // it may sit at end-of-line) and switch to Insert.
    if b == 0x69                       // 'i' — insert before cursor
        return Step { ed: ed, st: ist_insert() }
    if b == 0x61                       // 'a' — append after cursor
        return Step { ed: clamp_insert(Editor { lines: ed.lines, cy: ed.cy, cx: ed.cx + 1 }), st: ist_insert() }
    if b == 0x49                       // 'I' — insert at first non-blank
        return Step { ed: Editor { lines: ed.lines, cy: ed.cy, cx: first_nonblank(line_at(ed, ed.cy)) }, st: ist_insert() }
    if b == 0x41                       // 'A' — append at end of line
        return Step { ed: Editor { lines: ed.lines, cy: ed.cy, cx: str.len(line_at(ed, ed.cy)) }, st: ist_insert() }
    if b == 0x6F                       // 'o' — open line below
        return Step { ed: open_line(ed, true), st: ist_insert() }
    if b == 0x4F                       // 'O' — open line above
        return Step { ed: open_line(ed, false), st: ist_insert() }
    Step { ed: ed, st: ist_new() }     // unknown — reset

// ── Batch (headless test) mode ──────────────────────────────────

// `novim --batch "<keys>" <file>`: load, feed each key byte through the
// same apply_key the interactive loop uses (ignoring 'q'), then print
// the final buffer followed by `cursor=<line>:<col>` and exit.  Fully
// deterministic — the test harness asserts on this output.
// Decode a batch key string into bytes on the fly: `\e`=Esc, `\n`/`\r`=
// Enter, `\t`=Tab, `\\`=backslash.  Lets test sequences embed control
// keys in plain ASCII (e.g. `iHello\e`).
fn run_batch(keys: Str, path: Str) [io]
    var ed = Editor { lines: buf_load(path), cy: 0, cx: 0 }
    var st = ist_new()
    let n = str.len(keys)
    let mut i = 0
    while i < n
        var b = str.byte_at(keys, i) ?? 0
        if b == 92 and i + 1 < n       // backslash escape
            let nx = str.byte_at(keys, i + 1) ?? 0
            if nx == 0x65              // \e → Esc
                b = 27
                i = i + 1
            elif nx == 0x6E or nx == 0x72   // \n / \r → Enter
                b = 13
                i = i + 1
            elif nx == 0x74            // \t → Tab
                b = 9
                i = i + 1
            elif nx == 0x62            // \b → Backspace (DEL)
                b = 127
                i = i + 1
            elif nx == 0x5C            // \\ → backslash
                b = 92
                i = i + 1
        let step = feed(ed, st, b)
        ed = step.ed
        st = step.st
        i = i + 1
    let mut li = 0
    let nl = list.len(ed.lines)
    while li < nl
        println(ed.lines[li])
        li = li + 1
    println("cursor=" + str.from_int(ed.cy) + ":" + str.from_int(ed.cx))

// ── Interactive TUI ─────────────────────────────────────────────

fn emit_byte(b: Int) [io]
    let _ = novo_pty_stdout_write_byte_h(b)

// Write a string to stdout byte-by-byte (raw mode — no libc buffering
// surprises with control sequences).
fn emit(s: Str) [io]
    let n = str.len(s)
    let mut i = 0
    while i < n
        emit_byte(str.byte_at(s, i) ?? 0)
        i = i + 1

// ESC [ — start a CSI sequence.  ESC is spelled as byte 27 rather than
// a string escape (Novo source convention; see novomux/render.nv).
fn csi() [io]
    emit_byte(27)
    emit_byte(91)         // '['

fn cup(row: Int, col: Int) [io]   // 1-based cursor position
    csi()
    emit(str.from_int(row) + ";" + str.from_int(col) + "H")

fn sgr(code: Str) [io]            // ESC [ <code> m
    csi()
    emit(code + "m")

// Full repaint: clear, draw up to (rows-1) buffer lines (a `~` past
// end-of-buffer), a reverse-video status line on the last row, then
// place the hardware cursor at the editor cursor.
fn render(ed: Editor, rows: Int, cols: Int, path: Str, top: Int, mode: Int) [io]
    csi()
    emit("2J")            // clear screen
    let body = rows - 1
    let nl = list.len(ed.lines)
    let mut r = 0
    while r < body
        cup(r + 1, 1)
        let li = top + r
        if li < nl
            emit(ed.lines[li])
        else
            emit("~")
        r = r + 1
    cup(rows, 1)
    sgr("7")              // reverse video
    let modestr = if mode == 1 then "-- INSERT -- " else "-- NORMAL -- "
    emit(" " + path + "  " + str.from_int(ed.cy + 1) + ":" + str.from_int(ed.cx + 1) + "  " + modestr)
    sgr("0")
    cup(ed.cy - top + 1, ed.cx + 1)

fn term_rows() -> Int [io]
    let packed = novo_pty_get_winsize_h()
    let r = int.shr_logical(packed, 16)
    if r > 0 then r else 24

fn term_cols() -> Int [io]
    let packed = novo_pty_get_winsize_h()
    let c = bits.band(packed, 65535)
    if c > 0 then c else 80

// Adjust the viewport top so the cursor line is visible in `body` rows.
fn scroll_to(top: Int, cy: Int, body: Int) -> Int
    var t = top
    if cy < t
        t = cy
    if cy >= t + body
        t = cy - body + 1
    if t < 0
        t = 0
    t

fn run_interactive(path: Str) [io, time]
    let _ = novo_pty_set_raw_mode_h()
    var ed = Editor { lines: buf_load(path), cy: 0, cx: 0 }
    var st = ist_new()
    var rows = term_rows()
    var cols = term_cols()
    var top = 0
    render(ed, rows, cols, path, top, st.mode)
    var running = true
    while running
        let m = novo_pty_poll_h(0, 100)      // poll host stdin (fd 0)
        if m % 2 == 1
            var done = false
            while not done
                let b = novo_pty_stdin_read_byte_h()
                if b == -2
                    done = true
                elif b == -1
                    done = true
                    running = false
                elif b == 0x71 and st.mode == 0   // 'q' quits in Normal mode only
                    running = false
                    done = true
                else
                    let step = feed(ed, st, b)
                    ed = step.ed
                    st = step.st
            top = scroll_to(top, ed.cy, rows - 1)
            render(ed, rows, cols, path, top, st.mode)
        if novo_pty_winsize_changed_h() == 1
            rows = term_rows()
            cols = term_cols()
            top = scroll_to(top, ed.cy, rows - 1)
            render(ed, rows, cols, path, top, st.mode)
    novo_pty_restore_mode_h()
    csi()
    emit("2J")
    cup(1, 1)

// ── Entry ───────────────────────────────────────────────────────

fn main() [io, time]
    let argv = env.args()
    let n = list.len(argv)
    var is_batch = false
    var batch_keys = ""
    var file = ""
    let mut i = 1
    while i < n
        let a = argv[i]
        if a == "--batch" and i + 1 < n
            is_batch = true
            batch_keys = argv[i + 1]
            i = i + 2
        else
            file = a
            i = i + 1
    if file == ""
        println("usage: novim [--batch <keys>] <file>")
    elif is_batch
        run_batch(batch_keys, file)
    else
        run_interactive(file)
