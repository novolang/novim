// util.nv — low-level string / list helpers shared across novim's modules.
//
// Pure functions only (no Editor or driver state), so any module can `use util`
// and call them as `util.<name>`.  Novo's value semantics mean the list setters
// and removers return a fresh list rather than mutating in place.

@intent("Index of the first occurrence of byte `b` in `s`, or -1 if absent.")
fn index_of_byte(s: Str, b: Int) -> Int
    let n = str.len(s)
    var i = 0
    while i < n
        if (str.byte_at(s, i) ?? 0) == b
            return i
        i = i + 1
    0 - 1

@intent("First byte offset of byte `b` at or after `from` in `s`, or -1.")
fn index_of_byte_from(s: Str, b: Int, from: Int) -> Int
    let n = str.len(s)
    var i = from
    while i < n
        if (str.byte_at(s, i) ?? 0) == b
            return i
        i = i + 1
    0 - 1

@intent("First byte offset of substring `needle` in `s`, or -1 if absent (0 for an empty needle).")
fn index_of_str(s: Str, needle: Str) -> Int
    let n = str.len(s)
    let m = str.len(needle)
    if m == 0
        return 0
    var i = 0
    while i + m <= n
        var j = 0
        var ok = true
        while j < m and ok
            if (str.byte_at(s, i + j) ?? 0) != (str.byte_at(needle, j) ?? 0)
                ok = false
            j = j + 1
        if ok
            return i
        i = i + 1
    0 - 1

@intent("Return a copy of `xs` with element `idx` replaced by `v`.")
fn set_at<T>(xs: [T], idx: Int, v: T) -> [T]
    var out: [T] = []
    let n = list.len(xs)
    var i = 0
    while i < n
        if i == idx
            out = list.append(out, [v])
        else
            out = list.append(out, [xs[i]])
        i = i + 1
    out

// Typed delegates over the generic set_at — kept so the existing call
// sites (set_str_at / set_int_at / set_bool_at) need no change.
fn set_str_at(xs: [Str], idx: Int, v: Str) -> [Str]
    set_at(xs, idx, v)

fn set_int_at(xs: [Int], idx: Int, v: Int) -> [Int]
    set_at(xs, idx, v)

fn set_bool_at(xs: [Bool], idx: Int, v: Bool) -> [Bool]
    set_at(xs, idx, v)

@intent("Return a copy of `xs` with element `idx` removed.")
fn remove_at<T>(xs: [T], idx: Int) -> [T]
    var out: [T] = []
    var i = 0
    while i < list.len(xs)
        if i != idx
            out = list.push(out, xs[i])
        i = i + 1
    out

// Typed delegates over the generic remove_at — kept so existing call
// sites (remove_at_str / remove_at_int / remove_at_bool) need no change.
fn remove_at_str(xs: [Str], idx: Int) -> [Str]
    remove_at(xs, idx)

fn remove_at_int(xs: [Int], idx: Int) -> [Int]
    remove_at(xs, idx)

fn remove_at_bool(xs: [Bool], idx: Int) -> [Bool]
    remove_at(xs, idx)

// ── Config / colour value helpers (shared by the colorscheme, options, and
// keymap loaders) ──────────────────────────────────────────────────────────

// Strip a surrounding pair of double quotes from a TOML scalar.
fn strip_quotes(s: Str) -> Str
    let n = str.len(s)
    if n >= 2 and (str.byte_at(s, 0) ?? 0) == '"' and (str.byte_at(s, n - 1) ?? 0) == '"'
        str.slice(s, 1, n - 1)
    else
        s

// Drop an inline `#` comment from a TOML value (a `#` outside double quotes
// starts a comment), so `number = true   # note` parses as `true`.
fn strip_inline_comment(s: Str) -> Str
    var i = 0
    let n = str.len(s)
    var inq = false
    while i < n
        let b = str.byte_at(s, i) ?? 0
        if b == '"'
            inq = not inq
        else if b == 35 and not inq
            return str.slice(s, 0, i)
        i = i + 1
    s

// Parse a 256-colour SGR index from a TOML value; -1 (= terminal default) when
// it isn't an integer.
fn parse_color_val(s: Str) -> Int
    match str.to_int(str.trim(strip_quotes(str.trim(s))))
        None    => 0 - 1
        Some(v) => v

// Resolve a colour index, falling back to `dflt` when unset (-1).
fn cs_or(v: Int, dflt: Int) -> Int
    if v >= 0
        v
    else
        dflt

// Byte class for word motions and command-delimiter detection: 0 = whitespace
// (space / tab), 1 = word byte (alphanumeric or `_`), 2 = punctuation.  Shared
// by main.nv's word motions and excmd.nv's `:s` / `:g` delimiter checks.
fn char_class_of(c: Int) -> Int
    if c == ' ' or c == '\t'
        0
    else if c >= 48 and c <= 57 or c >= 65 and c <= 90 or c >= 97 and c <= 122 or c == 95
        1
    else
        2

// The basename (last `/`-separated component) of a path.
fn basename_of(p: Str) -> Str
    var last = 0
    var i = 0
    let n = str.len(p)
    while i < n
        if (str.byte_at(p, i) ?? 0) == '/'
            last = i + 1
        i = i + 1
    str.slice(p, last, n)
